{"id":"impersonation","title":"Impersonation","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/social-engineering/impersenation-mp4.mp4","page":"/academics/other-courses/ethcs303/video-explanations/impersonation/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/impersonation.vtt","chapters":[{"time":0,"title":"What is impersonation?"},{"time":47.44,"title":"Delivery person impersonation"},{"time":156.32,"title":"Tech support impersonation"},{"time":201.34,"title":"Tech support example"}],"transcript":[{"start":0.0,"end":2.16,"text":"السلام عليكم، اليوم نكمل عند impersonation"},{"start":2.16,"end":6.32,"text":"impersonation هو بكل معناتها أنك تتوي نفسك\nشخص ثاني"},{"start":6.32,"end":9.0,"text":"يعني بدلا ما شيء يصير مثلا"},{"start":9.0,"end":11.16,"text":"إحنا كلنا قبل أن تتكلمنا عنه"},{"start":11.16,"end":12.72,"text":"يصير بالجوال صح؟"},{"start":12.72,"end":15.0,"text":"impersonation لا يصير جسديا"},{"start":15.0,"end":16.3,"text":"يعني يتوفوني قدامكم"},{"start":16.3,"end":17.68,"text":"إيش كيف؟"},{"start":17.68,"end":18.8,"text":"يقول لكم أني أمثل"},{"start":18.8,"end":22.393,"text":"pretexting as another person with a goal\nof obtaining information or access to a"},{"start":22.393,"end":23.92,"text":"person, company or computer system"},{"start":23.92,"end":25.98,"text":"يا أني أصير delivery person"},{"start":25.98,"end":28.54,"text":"مثلا تخيلوا أني أنا قاد أمثل أني جاهز"},{"start":28.54,"end":30.02,"text":"والأمثل أني أنا أمازون"},{"start":30.02,"end":32.66,"text":"يعني أنا أجي وأدخل ألعب عليكم عرفتوا"},{"start":32.66,"end":34.12,"text":"أو أني tech support"},{"start":34.12,"end":37.88,"text":"تخيلوا أني أنا قاد أمثل أني والله تبع أبل"},{"start":37.88,"end":39.38,"text":"يعني أنتم عندكم مشكلة"},{"start":39.38,"end":40.76,"text":"أنا أسوي نفسي أبل"},{"start":40.76,"end":42.32,"text":"ألبس اليونيفورم"},{"start":42.32,"end":43.38,"text":"أسوي نفسي فاهمة"},{"start":43.38,"end":45.24,"text":"أتكلم نفس أسلوبهم"},{"start":45.24,"end":46.08,"text":"وتصدقوني"},{"start":46.08,"end":47.44,"text":"فوش يصير هنا؟"},{"start":47.44,"end":49.02,"text":"أوش يخلنا نتكلم عن delivery person"},{"start":49.02,"end":49.9,"text":"قال لكم هنا"},{"start":49.9,"end":52.9,"text":"impersonating a delivery person is an\neffective and easy attack"},{"start":52.9,"end":54.78,"text":"because not much acting is required"},{"start":54.78,"end":57.9,"text":"يعني ما يحتاج صدق واحد يمثل مرة"},{"start":57.9,"end":59.06,"text":"أهم شيء وشو"},{"start":59.06,"end":62.814,"text":"usually the hardest thing about\nimpersonating a delivery person is looking"},{"start":62.814,"end":63.22,"text":"the part"},{"start":63.22,"end":66.38,"text":"and having all your credentials papers and\ndeliveries in order"},{"start":66.38,"end":68.02,"text":"يعني يصير ماسك الطلب"},{"start":68.02,"end":69.5,"text":"يصير معي أوراقي"},{"start":69.5,"end":71.5,"text":"يعني هذا أصحب شيء في الموضوع"},{"start":71.5,"end":72.84,"text":"طبعا هي قال لكم مثال"},{"start":72.84,"end":74.6,"text":"إنه واحد لابس ملابس"},{"start":74.6,"end":75.72,"text":"ministry of interior"},{"start":75.72,"end":76.12,"text":"أوكي"},{"start":76.12,"end":77.03999999999999,"text":"الوزارة الداخلية"},{"start":77.03999999999999,"end":78.74,"text":"والله هذا الشخص طبعا"},{"start":78.74,"end":79.66,"text":"يعني إذا شفناه"},{"start":79.66,"end":80.22,"text":"على طول"},{"start":80.22,"end":81.82,"text":"بنثق فيه"},{"start":81.82,"end":83.16,"text":"ومو بشاكين فيه صح"},{"start":83.16,"end":84.2,"text":"فإشان كده وشو"},{"start":84.2,"end":85.36,"text":"ومو بشاكين في الموضوع"},{"start":85.36,"end":98.52000000000001,"text":"دائما خلاص هذا الشخص مع الوزارة"},{"start":98.52000000000001,"end":100.1,"text":"ما نشك فيه"},{"start":100.1,"end":101.06,"text":"على طول"},{"start":101.06,"end":102.34,"text":"نرحبه وندخله"},{"start":102.34,"end":103.2,"text":"في أي مكان"},{"start":103.2,"end":104.36,"text":"عشان يوصل أي شيء صح"},{"start":104.36,"end":106.66,"text":"فهذا واحد من المأمثلة"},{"start":106.66,"end":107.4,"text":"اللي هو"},{"start":107.4,"end":108.34,"text":"delivery person"},{"start":108.34,"end":109.52000000000001,"text":"يعني من بس جاهز"},{"start":109.52000000000001,"end":110.53999999999999,"text":"إن جاهز ممكن"},{"start":110.53999999999999,"end":112.38,"text":"حتى أبسط فكرة"},{"start":112.38,"end":114.14,"text":"فتخيلوا الشخص يصير"},{"start":114.14,"end":115.12,"text":"فوزارة داخلية"},{"start":115.12,"end":116.06,"text":"يمثل إنه كده"},{"start":116.06,"end":117.52000000000001,"text":"وطبعا هذا وشو"},{"start":117.52000000000001,"end":118.12,"text":"يقول لكم"},{"start":118.12,"end":119.75999999999999,"text":"this is a perfect attack vector"},{"start":119.75999999999999,"end":120.76,"text":"for a criminal to take"},{"start":120.76,"end":122.18,"text":"since trust is already built"},{"start":122.18,"end":123.16,"text":"into the uniform"},{"start":123.16,"end":124.38,"text":"يعني الثقة"},{"start":124.38,"end":125.08,"text":"أورادي"},{"start":125.08,"end":126.84,"text":"يعني موجودة"},{"start":126.84,"end":128.3,"text":"عشان كده أصلا لاحظته"},{"start":128.3,"end":129.98,"text":"دائما مثلا خلنقول"},{"start":129.98,"end":131.7,"text":"في المدارس"},{"start":131.7,"end":133.08,"text":"بيسوون يعني رقصة"},{"start":133.08,"end":133.78,"text":"أو شيء"},{"start":133.78,"end":135.16,"text":"ويجوون يلبسون"},{"start":135.16,"end":136.92000000000002,"text":"اللي يونفورم"},{"start":136.92000000000002,"end":137.7,"text":"حق العسكريين"},{"start":137.7,"end":138.76,"text":"تدرون إنه"},{"start":138.76,"end":139.52,"text":"قبل ما يشترون"},{"start":139.52,"end":140.12,"text":"هذا اللي يونفورم"},{"start":140.12,"end":141.26,"text":"ويعطون هوياتهم"},{"start":141.26,"end":141.82,"text":"ومدري إيش"},{"start":141.82,"end":142.62,"text":"يعني مو بأن"},{"start":142.62,"end":143.56,"text":"آه خلاص بروح"},{"start":143.56,"end":145.14,"text":"أشتري لبس كده"},{"start":145.14,"end":146.34,"text":"حق العسكريين"},{"start":146.34,"end":147.0,"text":"وإنتهى الموضوع"},{"start":147.0,"end":147.76,"text":"لا لا لا"},{"start":147.76,"end":149.62,"text":"فيه بروتوكول"},{"start":149.62,"end":150.8,"text":"وفيه إجراءات"},{"start":150.8,"end":152.28,"text":"يعني مو بهذه السهولة"},{"start":152.28,"end":152.76,"text":"ليش"},{"start":152.76,"end":153.78,"text":"عشان يمنعون"},{"start":153.78,"end":154.36,"text":"هذا الشيء"},{"start":154.36,"end":155.02,"text":"من أن يصير"},{"start":155.02,"end":156.32,"text":"وحين عندنا"},{"start":156.32,"end":157.64,"text":"impersonation and tech support"},{"start":157.64,"end":158.12,"text":"تقال لكم"},{"start":158.12,"end":158.68,"text":"هنا a person"},{"start":158.68,"end":159.96,"text":"who uses social engineering"},{"start":159.96,"end":162.12,"text":"to impersonate a tech support worker"},{"start":162.12,"end":163.92000000000002,"text":"can have devastating consequences"},{"start":163.92000000000002,"end":164.74,"text":"on a network"},{"start":164.74,"end":165.54,"text":"ليش النتورك"},{"start":165.54,"end":166.28,"text":"مو بس الجهاز"},{"start":166.28,"end":167.6,"text":"لأن عندهم"},{"start":167.6,"end":169.07999999999998,"text":"physical access"},{"start":169.07999999999998,"end":170.04,"text":"لإيش"},{"start":170.04,"end":170.98,"text":"داحظة physical access"},{"start":170.98,"end":171.57999999999998,"text":"خلونا نسوي لكم"},{"start":171.57999999999998,"end":172.16,"text":"يا highlight"},{"start":172.16,"end":174.94,"text":"هنا physical access"},{"start":174.94,"end":176.4,"text":"للجهاز"},{"start":176.4,"end":177.18,"text":"فهوش معنات"},{"start":177.18,"end":177.6,"text":"إذا كان عندهم"},{"start":177.6,"end":178.66,"text":"physical access للجهاز"},{"start":178.66,"end":179.36,"text":"خلاص عندهم"},{"start":179.36,"end":180.42,"text":"للنتورك"},{"start":180.42,"end":181.0,"text":"كله"},{"start":181.0,"end":181.62,"text":"ويقدرون"},{"start":181.62,"end":182.18,"text":"ينسوون في"},{"start":182.18,"end":183.46,"text":"اللي يبون"},{"start":183.46,"end":185.22,"text":"it only takes a matter of seconds"},{"start":185.22,"end":185.8,"text":"for someone"},{"start":185.8,"end":187.2,"text":"to compromise a network"},{"start":187.2,"end":188.46,"text":"with physical access"},{"start":188.46,"end":188.8,"text":"شفوون"},{"start":188.8,"end":189.58,"text":"physical access"},{"start":189.58,"end":190.86,"text":"هنا كرروا لكلمة"},{"start":190.86,"end":191.2,"text":"مرتين"},{"start":191.2,"end":192.48,"text":"لأن مرة مرة مهم"},{"start":192.48,"end":193.38,"text":"خلونا نسوي لحيلايت"},{"start":193.38,"end":194.22,"text":"ولاحظوا هنا"},{"start":194.22,"end":195.3,"text":"seconds"},{"start":195.3,"end":196.4,"text":"ثواني"},{"start":196.4,"end":197.2,"text":"مبتقائق"},{"start":197.2,"end":198.04,"text":"ثواني"},{"start":198.04,"end":199.1,"text":"عشان يخربون"},{"start":199.1,"end":200.22,"text":"الدعوة كلها"},{"start":200.22,"end":201.34,"text":"طبعا"},{"start":201.34,"end":202.46,"text":"هنا قال لكم مثال"},{"start":202.46,"end":202.88,"text":"والله"},{"start":202.88,"end":204.1,"text":"أنا قال لكم شرح زيادة"},{"start":204.1,"end":205.36,"text":"gaining physical access"},{"start":205.36,"end":205.92000000000002,"text":"to computer"},{"start":205.92000000000002,"end":207.04,"text":"through technical support"},{"start":207.04,"end":208.46,"text":"is the best case scenario"},{"start":208.46,"end":209.5,"text":"for an attacker"},{"start":209.5,"end":210.82,"text":"since puts them"},{"start":210.82,"end":211.82,"text":"right in the computer"},{"start":211.82,"end":212.96,"text":"يعني حرفين"},{"start":212.96,"end":213.98,"text":"ما في"},{"start":213.98,"end":214.88,"text":"يعني تعب"},{"start":214.88,"end":215.52,"text":"مبارس ميروحون"},{"start":215.52,"end":216.24,"text":"يحملون شي"},{"start":216.24,"end":217.24,"text":"عشان يدخنون"},{"start":217.24,"end":218.18,"text":"على السيستم"},{"start":218.18,"end":218.84,"text":"على طول"},{"start":218.84,"end":219.57999999999998,"text":"هم داخلين"},{"start":219.57999999999998,"end":220.28,"text":"direct"},{"start":220.28,"end":221.7,"text":"ما في طريقة"},{"start":221.7,"end":222.0,"text":"direct"},{"start":222.0,"end":222.56,"text":"اكترون كذا"},{"start":222.56,"end":224.12,"text":"this is a perfect opportunity"},{"start":224.12,"end":224.64,"text":"to download"},{"start":224.64,"end":226.07999999999998,"text":"an anti-virus program"},{"start":226.07999999999998,"end":227.76,"text":"or some sort of scanner"},{"start":227.76,"end":228.82,"text":"to clean the computer"},{"start":228.82,"end":230.16,"text":"wants the helping"},{"start":230.16,"end":230.62,"text":"يعني هو ترك"},{"start":230.62,"end":231.26,"text":"عن يمثل"},{"start":231.26,"end":232.36,"text":"انه قد يساعدك"},{"start":232.36,"end":233.02,"text":"ترى لاحظوا"},{"start":233.02,"end":234.24,"text":"once the helping"},{"start":234.24,"end":235.14,"text":"file is installed"},{"start":235.14,"end":235.78,"text":"it creates"},{"start":235.78,"end":236.5,"text":"an opportunity"},{"start":236.5,"end":237.16,"text":"for the attacker"},{"start":237.16,"end":237.8,"text":"to infect them"},{"start":237.8,"end":238.3,"text":"computer"},{"start":238.3,"end":239.28,"text":"so they can gain"},{"start":239.28,"end":239.94,"text":"further access"},{"start":239.94,"end":240.56,"text":"to the computer"},{"start":240.56,"end":241.28,"text":"or the network"},{"start":241.28,"end":242.52,"text":"الزبدة"},{"start":242.52,"end":243.88,"text":"فكروا بالسلسلة"},{"start":243.88,"end":244.76,"text":"هو كأن"},{"start":244.76,"end":245.32,"text":"سلسلة"},{"start":245.32,"end":245.8,"text":"سلسلة"},{"start":245.8,"end":246.22,"text":"سلسلة"},{"start":246.22,"end":247.08,"text":"أو"},{"start":247.08,"end":248.4,"text":"يعني تخيلوا"},{"start":248.4,"end":249.08,"text":"أنتم لو أن"},{"start":249.08,"end":249.72,"text":"ما كان عنده"},{"start":249.72,"end":250.38,"text":"physical access"},{"start":250.38,"end":251.0,"text":"كان بدأ هنا"},{"start":251.0,"end":251.32,"text":"صح"},{"start":251.32,"end":252.32,"text":"بس الحين"},{"start":252.32,"end":252.78,"text":"لأنه صار"},{"start":252.78,"end":253.6,"text":"عنده physical access"},{"start":253.6,"end":254.3,"text":"بدأ هنا"},{"start":254.3,"end":255.22,"text":"وعادي"},{"start":255.22,"end":255.94,"text":"يقدر أكمل"},{"start":255.94,"end":256.36,"text":"عرفتوا"},{"start":256.36,"end":256.94,"text":"بس أنه بدأ"},{"start":256.94,"end":258.16,"text":"يعني سوى skip"},{"start":258.16,"end":259.56,"text":"خطوات كثيرة"},{"start":259.56,"end":260.74,"text":"فمرة مرة"},{"start":260.74,"end":261.36,"text":"أنتبهوا"},{"start":261.36,"end":262.08,"text":"فخلونا"},{"start":262.08,"end":265.54,"text":"بعدين نكمل الدمستر دايفينج في المقطع الجاي"}]}