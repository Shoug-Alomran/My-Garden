{"id":"utilitarianism-part-2","title":"Utilitarianism — Part 2","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/Moral%20Systems%2C%20Ethical%20Concepts%2C%20and%20Theories/Utilitarianism%20p2.mp4","page":"/academics/other-courses/ethcs303/video-explanations/slides/utilitarianism-part-2/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/utilitarianism-part-2.vtt","chapters":[{"time":0,"title":"Rule utilitarianism"},{"time":62.54,"title":"Evaluating a rule"},{"time":155.32,"title":"Contrast with act utilitarianism"},{"time":165.44,"title":"Classroom example"},{"time":225.76,"title":"Rules and collective happiness"},{"time":346.3,"title":"Rule utilitarianism versus Kantianism"}],"transcript":[{"start":0.0,"end":5.842,"text":"السلام عليكم اليوم بنكمل عند النوع الثاني\nاللي هو rule uterism هو واحد من انواع"},{"start":5.842,"end":6.36,"text":"uterism"},{"start":6.36,"end":15.553,"text":"كيف قبل ما ابدأ هنا اشرح لكم عشان بعد صدق\nصدق يصير نغطي اي يعني لخبطة بين rule"},{"start":15.553,"end":16.26,"text":"والاكت"},{"start":16.26,"end":23.948,"text":"الاكت فكروا ان الحين الاكشن اللي انا قاعدة\nسويه هل هو بهذا الموقف بهذا الحالة بيؤدي"},{"start":23.948,"end":26.82,"text":"الى اكثر عدد سعادل اكثر عدد ناس"},{"start":26.82,"end":27.9,"text":"اي لا"},{"start":27.9,"end":30.1,"text":"رول يقولك والله شف"},{"start":30.1,"end":32.22,"text":"هل القانون هذا العام"},{"start":32.22,"end":34.66,"text":"زي مثلا اننا نحن نحترم"},{"start":34.66,"end":35.74,"text":"بالقوانين الشارع"},{"start":35.74,"end":38.02,"text":"حطوا ايشها كثيرة"},{"start":38.02,"end":40.76,"text":"بس انه بشكل عام هو كذا قوانين شارع صح"},{"start":40.76,"end":42.8,"text":"هل اذا اتبعناه"},{"start":42.8,"end":44.34,"text":"يعني كلنا جميعا"},{"start":44.34,"end":46.74,"text":"بيجيب نتيجة كويسة"},{"start":46.74,"end":48.74,"text":"هل يعني بيجيب سعادة"},{"start":48.74,"end":50.72,"text":"اكثر لعدد الناس اكثر"},{"start":50.72,"end":51.64,"text":"ولا لا"},{"start":51.64,"end":54.54,"text":"شفون كيف الاكت كان يقص على الموقف نفسه"},{"start":54.54,"end":62.54,"text":"الرول يقول لك لا هل القانون بشكل عام يفيد\nويجيب نتيجة كثيرة ام لا"},{"start":62.54,"end":70.254,"text":"فالحين دائمنا فرقنا خلونا نتكلم زيادة عن\nالرول كيف نحن نقيس اذا هو الرول صح ام لا"},{"start":70.254,"end":70.53999999999999,"text":"بصح"},{"start":70.53999999999999,"end":74.818,"text":"اول شي قال لكم ان الاكشن is a right if it\nfollows to a rule that leads to the"},{"start":74.818,"end":75.53999999999999,"text":"greatest good"},{"start":75.53999999999999,"end":78.53999999999999,"text":"طبعا احنا في اليوتوريزم دائمنا نبغى هدفنا\nthe greatest good"},{"start":78.53999999999999,"end":80.53999999999999,"text":"هذا بغض النظر اذا كان الرول ام الا اكت"},{"start":80.53999999999999,"end":82.53999999999999,"text":"بس كيف نقيس اذا هذا شي صح ام لا"},{"start":82.53999999999999,"end":85.12,"text":"قال لكم which means that correctness"},{"start":85.12,"end":86.0,"text":"هنا الكلمة الرمزية"},{"start":86.0,"end":87.72,"text":"of a rule is determined"},{"start":87.72,"end":90.76,"text":"by the amount of good"},{"start":90.76,"end":92.06,"text":"it brings when failed"},{"start":92.06,"end":94.12,"text":"يعني احنا ممكن"},{"start":94.12,"end":95.32,"text":"نضايق من والله"},{"start":95.32,"end":97.88,"text":"قوانين الشارع والسرعة"},{"start":97.88,"end":99.32,"text":"والإشارات"},{"start":99.32,"end":101.86,"text":"نحس انه نقعد عشر سنوات"},{"start":101.86,"end":103.66,"text":"بالإشارة يعني فيه"},{"start":103.66,"end":105.94,"text":"اشياء ممكن ضايقنا بس دامها"},{"start":105.94,"end":107.72,"text":"هي قاعدة تأدي"},{"start":107.72,"end":110.03999999999999,"text":"إلى the greatest good اللي هو أقل وفاة"},{"start":110.03999999999999,"end":112.25999999999999,"text":"أقل مشاكل أقل حوادث"},{"start":112.25999999999999,"end":116.72,"text":"معناته أن هذا القانون صحيح مئة بالمئة"},{"start":116.72,"end":118.02000000000001,"text":"ونحن مفروض نتبعه"},{"start":118.02000000000001,"end":123.34,"text":"ليش خصوصا أنه إحنا قاعد يجيب لنا النسبة\nعالية"},{"start":123.34,"end":126.16,"text":"وليش لأنه إحنا تبعناه"},{"start":126.16,"end":128.04,"text":"وقال لكم من زيادة هنا أن"},{"start":128.04,"end":136.82,"text":"يعني مثلا في قوانين ما لها سنع"},{"start":136.82,"end":138.0,"text":"ممكن خنقول"},{"start":138.0,"end":141.24,"text":"وبالعكس هي قاعدة تطلع النتائج شينا"},{"start":141.24,"end":144.76,"text":"فإحنا كيف نعرف إذا المoral correctness كان\nصح"},{"start":144.76,"end":148.8,"text":"إذا كان القانون نفسه الرول نفسه هو صح ولا\nلا"},{"start":148.8,"end":151.86,"text":"وطبعا إذا كان صح هو اللي بيخلينا يعني\nيساعدنا"},{"start":151.86,"end":153.52,"text":"إن نأتيف the greatest good"},{"start":153.52,"end":155.32,"text":"وباليين بتشوفون هنا يقول يقول لكم"},{"start":155.32,"end":159.06,"text":"in contrast يعني الأكت هو عكسه تماما ترى"},{"start":159.06,"end":163.14,"text":"يقول لكم أن الأكت يشوف العقابات للأكت\nalone"},{"start":163.14,"end":165.44,"text":"يعني الموقف نفسه specific"},{"start":165.44,"end":170.1,"text":"يعني مثلا الحين والله مدرسة راحت طق الطفل"},{"start":170.1,"end":172.42000000000002,"text":"هم في الأكت بشوفون هذا"},{"start":172.42000000000002,"end":174.18,"text":"مو بمسوي مثلا قانون"},{"start":174.18,"end":175.22,"text":"سنقول الحين رول"},{"start":175.22,"end":176.57999999999998,"text":"والله أنا طلحت قانون"},{"start":176.57999999999998,"end":179.04,"text":"المعلمة ممنوع تطق الأطفال"},{"start":179.04,"end":179.46,"text":"صح؟"},{"start":179.46,"end":182.12,"text":"إن خلاص هذا بيجيب أكثر عدد سعادة"},{"start":182.12,"end":184.02,"text":"لأكثر ستيكهودرز"},{"start":184.02,"end":185.3,"text":"اللي هم الأهالي"},{"start":185.3,"end":185.96,"text":"الأطفال"},{"start":185.96,"end":187.62,"text":"المدرسة بشكل عام"},{"start":187.62,"end":188.86,"text":"ما يقدوني واجههم قضايا"},{"start":188.86,"end":189.26,"text":"و هكذا"},{"start":189.26,"end":189.94,"text":"صح؟"},{"start":189.94,"end":190.9,"text":"وأكثر عدد ناس"},{"start":190.9,"end":191.96,"text":"بس هذا"},{"start":191.96,"end":193.38,"text":"إذا كان هو طبق"},{"start":193.38,"end":194.56,"text":"بس الأكت تقول لك"},{"start":194.56,"end":197.64,"text":"أنا الحين بشوف على هذا الموقف"},{"start":197.64,"end":198.7,"text":"خلال نقول مثلا"},{"start":198.7,"end":200.7,"text":"المدرسة مريم"},{"start":200.7,"end":202.7,"text":"مريم خبطت الطفول"},{"start":202.7,"end":207.7,"text":"أنا في الأكت أرى هل كان لها منطق"},{"start":207.7,"end":210.7,"text":"من يجب أن يتعاقب"},{"start":210.7,"end":213.7,"text":"ومن يجب أن يجب أكثر سعادة"},{"start":213.7,"end":215.7,"text":"وعرفت أن يجب أن يجب أكثر ضرر"},{"start":215.7,"end":222.72,"text":"لذلك فالطبع يجب أن يقوم بإمكانكم بإمكانكم\nبإمكانكم بإمكانكم الحكومة"},{"start":222.72,"end":224.62,"text":"لذلك هم كتبوا كلمة \"أكت\""},{"start":224.62,"end":225.76,"text":"و بعدين لدينا \"إن شورت\""},{"start":225.76,"end":229.481,"text":"\"We should base our behaviors on rules\nthat are understood to maximize collective"},{"start":229.481,"end":229.94,"text":"happiness\""},{"start":229.94,"end":230.94,"text":"يعني إيش؟"},{"start":230.94,"end":232.38,"text":"ماذا قلتهم \"understood\"؟"},{"start":232.38,"end":235.98,"text":"يعني تخيلوا أنكم تضعوا قوانين لا أحد\nيفهمها"},{"start":235.98,"end":237.66,"text":"طبيعي أن لا أحد يطبقها"},{"start":237.66,"end":241.42,"text":"لازم يعني أن نوضح القوانين بطريقة سهلة\nوبسيطة"},{"start":241.42,"end":243.42,"text":"من حيث الجميع يعني يفهم"},{"start":243.42,"end":250.42,"text":"وكي نحاول إستثمار قليل ونكسب كثير"},{"start":250.42,"end":255.42,"text":"نفس الفكرة نبغى نضع قوانين ونفهم الجميع\nلكي يتبعه"},{"start":255.42,"end":258.42,"text":"وطبعاً يؤدي الى collective happiness"},{"start":258.42,"end":259.42,"text":"يعني كلنا نصير سعيدين"},{"start":259.42,"end":261.42,"text":"وبعدين عندنا الوش الفرق"},{"start":261.42,"end":265.42,"text":"لازم ضروري ضروري ضروري انكم تعرفون الفرق\nوشو"},{"start":265.42,"end":268.694,"text":"قال لكم: \"for rule uterians the\ncorrectness of a rule is determined by the"},{"start":268.694,"end":270.42,"text":"amount of good it brings when followed\""},{"start":270.42,"end":273.42,"text":"سأضع لكم هايلايت على الجملة الأساسية"},{"start":273.42,"end":277.42,"text":"وان فاللون ثاني"},{"start":277.42,"end":279.42,"text":"أضع لكم لون ثاني"},{"start":279.42,"end":281.42,"text":"قال لكم"},{"start":281.42,"end":285.42,"text":"judge an act in terms of consequences of\nthe act alone"},{"start":285.42,"end":287.42,"text":"شوفون كيف"},{"start":287.42,"end":290.42,"text":"يعني هو قاعد يقيس على العقابات للموقف هذا"},{"start":290.42,"end":293.42,"text":"وليس يعني بشكل عام"},{"start":293.42,"end":295.42,"text":"فقال لكم بعد أن أضعت لكم نوت"},{"start":295.42,"end":297.42,"text":"للقانون"},{"start":297.42,"end":303.22,"text":"مثل القوانين الشارع"},{"start":303.22,"end":304.52,"text":"قوانين المجتمع"},{"start":304.52,"end":307.74,"text":"هناك قوانين معينة وطيبة بالعادة كويسة"},{"start":307.74,"end":311.2,"text":"وللأكت يقول لك على حسب الأكت نفسه"},{"start":311.2,"end":312.42,"text":"مثلا أنا قطعت إشارة"},{"start":312.42,"end":313.6,"text":"أنا رحت تخبط طفل"},{"start":313.6,"end":315.6,"text":"أنا رحت تذبحت إنسان"},{"start":315.6,"end":316.92,"text":"على حسب وشو"},{"start":316.92,"end":317.52,"text":"قال لكم هنا"},{"start":317.52,"end":318.0,"text":"الأكتشن"},{"start":318.0,"end":320.64,"text":"يعني الأفعال"},{"start":320.64,"end":321.68,"text":"لنه بقانون"},{"start":321.68,"end":325.42,"text":"عرفتوا القانون هو دائما يطمح للأشياء\nالكويسة"},{"start":325.42,"end":328.4,"text":"يطمح لان نكون the best version of\nourselves"},{"start":328.4,"end":330.9,"text":"ان نسخه المرة كويسة صح"},{"start":330.9,"end":333.82,"text":"هذا الروز يعني احنا حاطينها عشان نبغى\nالمثال"},{"start":333.82,"end":334.84000000000003,"text":"بس الاكت"},{"start":334.84000000000003,"end":337.14,"text":"الاكت احنا ما يعني احنا بنا بشر"},{"start":337.14,"end":339.94,"text":"ذكروا الاكت ان احنا we act like humans"},{"start":339.94,"end":341.6,"text":"فاحنا البشر نغلط"},{"start":341.6,"end":343.74,"text":"واذا غلطنا يصير في consequences"},{"start":343.74,"end":346.3,"text":"بعدين احيان عندنا زيادة يقول لكم"},{"start":346.3,"end":348.78,"text":"ان both rule uterism and cantonism"},{"start":348.78,"end":349.68,"text":"يعني هنا كده قارنهم"},{"start":349.68,"end":351.06,"text":"are focused on rules"},{"start":351.06,"end":352.76,"text":"يعني كلهم عبارة عن القوانين"},{"start":352.76,"end":353.76,"text":"بس وشو"},{"start":353.76,"end":356.82,"text":"\"and the rules of these two ethical\ntheories may have significant overlap\""},{"start":356.82,"end":360.8,"text":"يعني اوكي يجون فاشة معينة متناسقة مع بعض"},{"start":360.8,"end":361.86,"text":"بس قال ليك"},{"start":361.86,"end":365.96,"text":"\"however the two ethical theories derive\nmoral rules in completely different ways\""},{"start":365.96,"end":370.339,"text":"\"a rule uterian chooses to follow a moral\nrule because its universal adaptation will"},{"start":370.339,"end":372.06,"text":"result in the greatest happiness\""},{"start":372.06,"end":373.16,"text":"ايش"},{"start":373.16,"end":375.36,"text":"اول شي خلونا نسوي highlight"},{"start":375.36,"end":377.56,"text":"ضروري نسوي highlight على الرول"},{"start":377.56,"end":379.06,"text":"لاحظونا الرول اوكي"},{"start":379.06,"end":389.10699999999997,"text":"قال لكم أنه إذا كان عالمياً مطبقينها بيأدي\nإلى أقصى عدد سعادة مثلاً زي الحين ذا السجن"},{"start":389.10699999999997,"end":389.58,"text":"أوكي"},{"start":389.58,"end":397.367,"text":"هم حطين السجن مثلاً للناس اللي والله\nيقتلون اللي ينشرون أشياء ما الهداعي تنشر"},{"start":397.367,"end":398.58,"text":"اللي يذبح صح"},{"start":398.58,"end":402.58,"text":"فإحنا تخيلوا لو ما سوينا\n\"universalization\" على السجن"},{"start":402.58,"end":408.58,"text":"كان الحين الدنيا فوضى وإرهاب وخوف يعني مرة\nصح"},{"start":408.58,"end":414.58,"text":"نحن عندما نقوم بإمكاننا بإمكاننا بعمل\nمرحلة"},{"start":414.58,"end":420.58,"text":"و لو جميع في كل عالم فإنه يؤدي إلى أقصى\nسعادة ممكنة"},{"start":420.58,"end":422.58,"text":"و لديكم الآن الكانتينيزم"},{"start":422.58,"end":424.58,"text":"قال لكم"},{"start":434.58,"end":436.58,"text":"هذا ما قلت لكم"},{"start":436.58,"end":457.2,"text":"ترجمة نانسي قد ترجمة نانسي قد ترجمة نانسي\nقد ترجمة واحدة"}]}