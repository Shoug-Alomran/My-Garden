{"id":"moral-systems-and-ethical-theories-part-1","title":"Moral Systems, Ethical Concepts, and Theories — Part 1","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/Moral%20Systems%2C%20Ethical%20Concepts%2C%20and%20Theories/Moral%20Systems%2C%20Ethical%20Concepts%2C%20and%20Theories.mp4","page":"/academics/other-courses/ethcs303/video-explanations/slides/moral-systems-and-ethical-theories-part-1/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/moral-systems-and-ethical-theories-part-1.vtt","chapters":[{"time":0,"title":"Introduction"},{"time":16,"title":"Morality"},{"time":120.4,"title":"Ethics and morality"},{"time":452,"title":"Four features of a moral system"},{"time":672.04,"title":"Deriving and justifying moral principles"},{"time":958.02,"title":"Comparing ethical theories"}],"transcript":[{"start":0.0,"end":0.66,"text":"السلام عليكم"},{"start":0.66,"end":2.34,"text":"اليوم نبدأ في اول درس"},{"start":2.34,"end":2.64,"text":"اللي هو"},{"start":2.64,"end":3.54,"text":"Moral Systems"},{"start":3.54,"end":4.98,"text":"Ethical Concepts"},{"start":4.98,"end":5.98,"text":"والTheories"},{"start":5.98,"end":6.98,"text":"هلو نبدأ"},{"start":6.98,"end":7.86,"text":"اول شي وشو"},{"start":7.86,"end":8.28,"text":"الـ Topics"},{"start":8.28,"end":8.9,"text":"نتكلم عن"},{"start":8.9,"end":9.72,"text":"Moral System"},{"start":9.72,"end":10.62,"text":"مبدئيا"},{"start":10.62,"end":11.66,"text":"بعدين نتكلم عن"},{"start":11.66,"end":12.58,"text":"Ethical Theories"},{"start":12.58,"end":14.04,"text":"في ستة نواع"},{"start":14.04,"end":15.02,"text":"هلو نبدأ"},{"start":15.02,"end":16.0,"text":"اول شي وشو"},{"start":16.0,"end":17.04,"text":"كلمة Morality"},{"start":17.04,"end":18.12,"text":"وش معنات لكم"},{"start":18.12,"end":19.26,"text":"هو يقول لكم"},{"start":19.26,"end":21.22,"text":"A society is an association"},{"start":21.22,"end":22.1,"text":"of people organized"},{"start":22.1,"end":23.16,"text":"under a system of rules"},{"start":23.16,"end":23.84,"text":"يعني"},{"start":23.84,"end":24.64,"text":"قوانين"},{"start":24.64,"end":25.52,"text":"احنا قاعدين"},{"start":25.52,"end":26.4,"text":"كلنا جميعين"},{"start":26.4,"end":27.42,"text":"انت وانتو"},{"start":27.42,"end":28.32,"text":"زميلك"},{"start":28.32,"end":29.38,"text":"واملك"},{"start":29.38,"end":31.96,"text":"كل العالم"},{"start":31.96,"end":34.06,"text":"كلهم قاعدين عايشين"},{"start":34.06,"end":35.6,"text":"تحت قوانين معينة"},{"start":35.6,"end":36.1,"text":"فهذا هو"},{"start":36.1,"end":41.68,"text":"تخيلوا"},{"start":41.68,"end":43.52,"text":"قوانين"},{"start":43.52,"end":45.16,"text":"قوانين عن ايش عن conduct"},{"start":45.16,"end":46.3,"text":"conduct معناته"},{"start":46.3,"end":49.02,"text":"كيف انت يعني تتحكم"},{"start":49.02,"end":51.48,"text":"وتنفذ بقراراتك"},{"start":51.48,"end":52.34,"text":"كيف تتخذها"},{"start":52.34,"end":55.04,"text":"وش الاشياء اللي مسموح لك تسويها"},{"start":55.04,"end":57.32,"text":"وش الاشياء اللي ممسموح لك تسويها"},{"start":57.32,"end":58.04,"text":"فتقول لكم"},{"start":58.04,"end":59.72,"text":"ما هو روالة الوصف؟ فكروا"},{"start":59.72,"end":60.22,"text":"الوصف"},{"start":60.22,"end":61.66,"text":"كيف تقوم بإمكانك"},{"start":61.66,"end":63.54,"text":"ما هو الأشياء المسموح"},{"start":63.54,"end":64.54,"text":"و ما هو الأشياء المسموح"},{"start":64.54,"end":66.02,"text":"بنا طبعا عندكم قوانين"},{"start":66.02,"end":67.4,"text":"ما هو قوانين؟"},{"start":67.4,"end":68.24,"text":"واضحة صح؟"},{"start":68.24,"end":74.03999999999999,"text":"إنه مصممة عشان يحسن جودة الحياة للجميع"},{"start":74.03999999999999,"end":75.38,"text":"يعني مو بس لك أنا شخصيا"},{"start":75.38,"end":76.0,"text":"للجميع"},{"start":76.0,"end":79.36,"text":"يعني أكيد في البداية"},{"start":79.36,"end":80.76,"text":"بيكون والله مضايق"},{"start":80.76,"end":81.94,"text":"ولا ممريح"},{"start":81.94,"end":83.44,"text":"مثلا الحين ساهر"},{"start":83.44,"end":85.0,"text":"اللي يقعد يصورنا مثلا"},{"start":85.0,"end":85.8,"text":"لو أسرعنا"},{"start":85.8,"end":87.4,"text":"ولا تجاوز المسارات"},{"start":87.4,"end":89.38,"text":"وله هذا الأشياء أكيد في البداية"},{"start":89.38,"end":92.52000000000001,"text":"كانت يعني الناس إذا جاتتهم المخارفة\nينقهرون صح"},{"start":92.52000000000001,"end":94.52000000000001,"text":"بس وشه هو في النهاية"},{"start":94.52000000000001,"end":97.06,"text":"To advance the good of the people"},{"start":97.06,"end":98.3,"text":"خلال الوقت"},{"start":98.3,"end":99.0,"text":"طبعا"},{"start":99.0,"end":101.94,"text":"وهذا القوانين اللي هنا قاعدين يقولون لكم"},{"start":101.94,"end":103.14,"text":"وشه هو في النهاية"},{"start":103.14,"end":104.12,"text":"Morality"},{"start":104.12,"end":105.52000000000001,"text":"لهذا هو"},{"start":105.52000000000001,"end":106.88,"text":"كيف تربطونا"},{"start":106.88,"end":107.68,"text":"Morality"},{"start":107.68,"end":110.02000000000001,"text":"هو القوانين اللي حنا نعيش تحتها"},{"start":110.02000000000001,"end":112.52000000000001,"text":"من حيث أن نحسن جودة البشر"},{"start":112.52000000000001,"end":114.9,"text":"خلال المدة يعني over time"},{"start":114.9,"end":120.4,"text":"قال لكم هنا بسيكلي انه يعني كتاب قوانين\nاللي الناس يتبعونا"},{"start":120.4,"end":126.48,"text":"بنين عندكم حين study of morality اللي هو\nethics كلمة ethics صح"},{"start":126.48,"end":128.84,"text":"احنا اصلا ما هذا العبارة عن هذا الشي قال\nلكم هنا"},{"start":128.84,"end":133.344,"text":"morality is a system whose purpose is to\nprevent harm and evils in addition to"},{"start":133.344,"end":135.48,"text":"aiming at promoting human flourishing"},{"start":135.48,"end":138.48,"text":"وش معناته يعني او الشي prevent harm and\nevils"},{"start":138.48,"end":142.7,"text":"تخيلوا مثلا زي السرقة او القتل طبعا هذا\nاشياء شهنا"},{"start":142.7,"end":146.36,"text":"فهذا قاعد يقول لكم المورالتي قاعد يمنح هذا\nالشيء من يصير"},{"start":146.36,"end":147.5,"text":"برضو قاعد يقول لكم"},{"start":147.5,"end":150.94,"text":"كيف يعني يحسن جودة الإنسان"},{"start":150.94,"end":153.02,"text":"خنقول اللي مثلا"},{"start":153.02,"end":154.7,"text":"نساعد الناس المعاقين"},{"start":154.7,"end":156.34,"text":"أو مثلا الحين"},{"start":156.34,"end":158.14,"text":"شوفهم أحيانا في الإشارة"},{"start":158.14,"end":160.02,"text":"عندي قبل ما يجي ستايدوك"},{"start":160.02,"end":162.72,"text":"يصير كذا في مطبات أو أشياء"},{"start":162.72,"end":164.34,"text":"نشوفها حنا كناس"},{"start":164.34,"end":165.94,"text":"اللي نشوف عادة نقول وش هذا"},{"start":165.94,"end":168.32,"text":"بس هو واقعيا"},{"start":168.32,"end":170.14,"text":"عشان اللي ما يقدر يشوف"},{"start":170.14,"end":170.98,"text":"يصير مع عصا"},{"start":170.98,"end":172.96,"text":"إذا طق هذا يعرف أن هنا"},{"start":172.96,"end":174.52,"text":"في قطع شارع"},{"start":174.52,"end":176.78,"text":"وأن ترى انتبهوا"},{"start":176.78,"end":179.24,"text":"لا تقطعون إلا ذكان الإشارة خضرة"},{"start":179.24,"end":179.92000000000002,"text":"هذا"},{"start":179.92000000000002,"end":184.44,"text":"من ضمنه أنك تساعد الناس"},{"start":184.44,"end":185.5,"text":"هذا مثال"},{"start":185.5,"end":187.16,"text":"طبعا قالوا لكم هنا"},{"start":187.16,"end":189.58,"text":"Ethics and philosophical study of morality"},{"start":189.58,"end":191.56,"text":"a rational examination into people's\nmorals"},{"start":191.56,"end":193.36,"text":"and beliefs and behavior"},{"start":193.36,"end":195.58,"text":"كيف ندرس البشر"},{"start":195.58,"end":196.57999999999998,"text":"سلوكهم"},{"start":196.57999999999998,"end":198.6,"text":"اعتقاداتهم"},{"start":198.6,"end":200.86,"text":"وكيف هذا ينربط بالمورال"},{"start":200.86,"end":203.68,"text":"دعونا الآن نرى ما زيادة عن الموراليتي"},{"start":203.68,"end":205.5,"text":"قال لكم ما هي عندكم نوعين"},{"start":205.5,"end":206.88,"text":"rules of conduct في نوعين"},{"start":206.88,"end":208.78,"text":"عندكم directives و عندكم social"},{"start":208.78,"end":210.5,"text":"من كلمة directives"},{"start":210.5,"end":213.2,"text":"اعرفوا انه بس خصك انت"},{"start":213.2,"end":214.12,"text":"الاندفجول"},{"start":214.12,"end":216.12,"text":"فهذا هو زي ما ترقلنا"},{"start":216.12,"end":217.14,"text":"انا بس اشترك لسكيب"},{"start":217.14,"end":218.34,"text":"بس انه نفس اللي قبل فوق"},{"start":218.34,"end":219.52,"text":"اللي قلت لكم rules of conduct"},{"start":219.52,"end":220.42000000000002,"text":"a guide human behavior"},{"start":220.42000000000002,"end":222.14,"text":"يعني هو القوانين اللي تدعونا"},{"start":222.14,"end":224.72,"text":"فاذا قال لكم directives"},{"start":224.72,"end":227.12,"text":"هذا معتنا انت الحالك"},{"start":227.12,"end":229.24,"text":"ولاحظوا انه at a micro level"},{"start":229.24,"end":231.28,"text":"انتبهوا لهذه الكلمة"},{"start":231.28,"end":233.48,"text":"لان هنا ممكن يختبرونكم عليها"},{"start":233.48,"end":234.96,"text":"بحطر له هنا هايلايت"},{"start":234.96,"end":237.44,"text":"عشان صدق تركزون على هذه الكلمة"},{"start":237.44,"end":238.8,"text":"لانا بصراحة ما استبعد"},{"start":238.8,"end":240.5,"text":"ان يجيبونه كامسي كيو"},{"start":240.5,"end":241.48,"text":"وحرام تنقصون عليه"},{"start":241.48,"end":242.88,"text":"وبعدين عندكم طبعا الثاني"},{"start":242.88,"end":243.92,"text":"اللي هو ال"},{"start":243.92,"end":246.46,"text":"واضح من كلمة سوشل"},{"start":246.46,"end":248.08,"text":"انه للمجتمع"},{"start":248.08,"end":250.96,"text":"فهذا نوعين من القوانين"},{"start":250.96,"end":251.82,"text":"اللي لازم نتبعها"},{"start":251.82,"end":252.66,"text":"وبعدين عندكم"},{"start":252.66,"end":255.46,"text":"لازم تعرفون"},{"start":255.46,"end":256.58,"text":"انه تبع ايش"},{"start":256.58,"end":259.38,"text":"تابع الـ evaluating the rules"},{"start":259.38,"end":261.58,"text":"يعني إحنا مو بأي قانون"},{"start":261.58,"end":264.4,"text":"الشخص قال لنا طبقة من طبقة صح"},{"start":264.4,"end":266.02,"text":"لازم نسوي لـ evaluation"},{"start":266.02,"end":268.04,"text":"لازم نشوف إذا القانون منطقي"},{"start":268.04,"end":268.86,"text":"ولا لا"},{"start":268.86,"end":270.08,"text":"لذلك كتبت لكم"},{"start":270.08,"end":272.44,"text":"not all rules are okay or the best"},{"start":272.44,"end":274.62,"text":"يعني مو بكل قانون اللي ممكن شخصنا"},{"start":274.62,"end":276.48,"text":"يقول لك سوى مثلا مديرك"},{"start":276.48,"end":278.58,"text":"قال شف أنا أحتاجك"},{"start":278.58,"end":281.28,"text":"يعني تخرب الأوراق شوي"},{"start":281.28,"end":282.56,"text":"عشان ما يبين"},{"start":282.56,"end":284.12,"text":"إن حنا قاعد نسوي غسيل أموال"},{"start":284.12,"end":286.15999999999997,"text":"طبع هذا قانون الشركة"},{"start":286.15999999999997,"end":288.15999999999997,"text":"ولكن هذا القانون صح؟ لا"},{"start":288.15999999999997,"end":291.15999999999997,"text":"لذلك يجب أن يكون لديك \"Principles\" و يجب\nأن تقييم القوانين"},{"start":291.15999999999997,"end":294.15999999999997,"text":"أيضا قال لكم \"Standards are used to\njustify these rules\""},{"start":294.15999999999997,"end":297.15999999999997,"text":"مثلا هل هو \"Justice\"؟"},{"start":297.15999999999997,"end":300.16,"text":"هل هو يحكم عليك بطريقة صحيحة؟"},{"start":300.16,"end":303.16,"text":"هل هو عدل؟ هل هو يحترم الناس؟"},{"start":303.16,"end":308.16,"text":"هذا الأشياء التي يجب أن ننتبه لها و نتكلم\nعن \"Morality\""},{"start":308.16,"end":312.765,"text":"فهنا قال لكم \"Rules of Conduct\" و\n\"Principles of Evaluation\" قسموا هين"},{"start":312.765,"end":313.16,"text":"جزئتين"},{"start":313.16,"end":318.032,"text":"\"رules of conduct\" قال لكم \"action guiding\nrules in the form of either directives or"},{"start":318.032,"end":318.96,"text":"social policies\""},{"start":318.96,"end":326.3,"text":"يعني ايش يعني انكم او شي لاحظوا \"action\nguiding\" يعني يتعامل بالفعل عرفتو"},{"start":326.3,"end":332.28,"text":"يعني انا الحين بسوي هذا الشيء و ينقسم الى\nشيء شخصي انا الحالي ولا شيء بالمجتمع"},{"start":332.28,"end":337.587,"text":"اذا كان شخصي فيقول لكم هنا \"rules for\nguiding the action of individuals micro"},{"start":337.587,"end":338.0,"text":"level\""},{"start":338.0,"end":339.5,"text":"فعلي هنا مثال أعطيكم"},{"start":339.5,"end":340.5,"text":"including directives"},{"start":340.5,"end":341.5,"text":"do not steal"},{"start":341.5,"end":343.5,"text":"يعني هو ليس شيء مجتمعي"},{"start":343.5,"end":344.5,"text":"قال لك لا تسرق"},{"start":344.5,"end":346.5,"text":"لا هو يقول لك أنت شخصيا"},{"start":346.5,"end":348.0,"text":"هذا قوانين لك أنت شخصيا"},{"start":348.0,"end":349.5,"text":"do not harm others"},{"start":349.5,"end":350.5,"text":"يعني لا تدبح فلان"},{"start":350.5,"end":352.0,"text":"وعكسة social policies"},{"start":352.0,"end":354.5,"text":"قال لكم establishing social policies"},{"start":354.5,"end":355.5,"text":"ماكرو"},{"start":355.5,"end":356.5,"text":"for ethical rules"},{"start":356.5,"end":358.0,"text":"مثلا حماية software"},{"start":358.0,"end":358.5,"text":"صح؟"},{"start":358.5,"end":360.0,"text":"سوف نقول حبيب"},{"start":360.0,"end":361.0,"text":"برنامج حبيب"},{"start":361.0,"end":362.5,"text":"هو social policy"},{"start":362.5,"end":364.0,"text":"أن نحمي التطبيق"},{"start":364.0,"end":365.0,"text":"والprivacy"},{"start":365.0,"end":367.0,"text":"should be respected"},{"start":367.0,"end":370.0,"text":"لاحظوا انه هنا هذا بس قاعد ضر شخص واحد"},{"start":370.0,"end":371.0,"text":"هذا قاعد ضر شخص واحد"},{"start":371.0,"end":373.0,"text":"هنا قاعد ضر الجميع"},{"start":373.0,"end":375.0,"text":"علشان كده هذا social وهذا directives"},{"start":375.0,"end":377.0,"text":"وبنع عكسها اللي هو principles of\nevaluation"},{"start":377.0,"end":382.0,"text":"قالكم evaluate standards used to justify\nrules of conduct"},{"start":382.0,"end":385.0,"text":"يعني القوانين اللي توقيت لكم إياها"},{"start":385.0,"end":388.0,"text":"حرفي نفسها justice, fairness, respect for\nothers"},{"start":388.0,"end":391.0,"text":"و هنا ايه ما هذا غيروا شيء"},{"start":391.0,"end":396.0,"text":"فهذا بس يعني كأنه summary للسلايد اللي\nقبله"},{"start":396.0,"end":399.0,"text":"ونحن لدينا الـ principles , يحبون أن\nيتكلمون بكثيراً"},{"start":399.0,"end":402.0,"text":"قال لكم: \"نحن نتحدث عن principles أو\nالمعالي أو المعالي\""},{"start":402.0,"end":405.0,"text":"المعالي: العكس المعالي"},{"start":405.0,"end":408.0,"text":"يعني المعالي: فكروا شيء جيد، المعالي: شيء\nشين"},{"start":408.0,"end":411.0,"text":"ونحن نتحدث عن عدالة: عدالة:"},{"start":411.0,"end":415.0,"text":"ماذا معناتها ؟"},{"start":415.0,"end":421.0,"text":"انه انا ما احط قانون بس انا الوحيدة\nالاستفيد والبقية مايستفيدون"},{"start":421.0,"end":423.0,"text":"لا"},{"start":423.0,"end":427.0,"text":"لازم احنا نصير عندنا ولاء للمجتمع اللي\nحولنا وللناس"},{"start":427.0,"end":429.0,"text":"الاثوريتي"},{"start":429.0,"end":433.0,"text":"انه نفهم ان اوكي هذا تراف النهاية مديري"},{"start":433.0,"end":437.0,"text":"وانا بس مجرد موظف مثلا ان افهم الهيركي"},{"start":437.0,"end":442.0,"text":"الهيركي طبعا فكروه دائما بهذا الرسمة اللي\nجيكم كذا عرفتوا ناس"},{"start":442.0,"end":449.0,"text":"هذا في طرف كل الشركة طبعا عندها هيركي\nعندكم السي او والسي او الديركتر المدري ايش"},{"start":449.0,"end":452.0,"text":"فلازم تعرفون الاثوريتي"},{"start":452.0,"end":456.0,"text":"وبدين نروح الهين الى 4 features of a moral\nsystem"},{"start":456.0,"end":461.0,"text":"هذا ممكن يجيكم تعداد عندكم public عندكم\ninformal عندكم rational عندكم impartial"},{"start":461.0,"end":464.0,"text":"خلونا نشرح حبة حبة قال لكم اول شي public"},{"start":464.0,"end":468.6,"text":"من كلمة public أي قانون معروف للجميع"},{"start":468.6,"end":471.36,"text":"يعني لو أنت حين رحت تقلت على جارك"},{"start":471.36,"end":472.8,"text":"اللي ما قد تكلمت بحياتك"},{"start":472.8,"end":475.0,"text":"و قلت الله فلان تعرف عن هذا القانون"},{"start":475.0,"end":476.78,"text":"مفروض يجاوب و يقول يس"},{"start":476.78,"end":477.84000000000003,"text":"هذا public"},{"start":477.84000000000003,"end":479.78,"text":"known to all of the members"},{"start":479.78,"end":481.24,"text":"بري عندكم الinformal"},{"start":481.24,"end":483.38,"text":"هو عكسر الformal"},{"start":483.38,"end":484.96,"text":"formal فكروا قوانين"},{"start":484.96,"end":487.06,"text":"و يديكم تروحون المحكمة"},{"start":487.06,"end":487.98,"text":"و يعني خلاص"},{"start":487.98,"end":489.7,"text":"اللي مكتوبة بالجرائد"},{"start":489.7,"end":491.08,"text":"إن ترى إذا سويتوا كذا"},{"start":491.08,"end":492.72,"text":"هذا غرامة عشرة لاف"},{"start":492.72,"end":499.624,"text":"مثلا زي الحين لديكم رسائل حق الحج الناس\nاللي يعني يدخلون بدون تصريح تراغرامة عشرة"},{"start":499.624,"end":499.88,"text":"لاف"},{"start":499.88,"end":504.72,"text":"هذا الفورمال عكس الانفورمال القوانين اللي\nما تحتاج تنقال"},{"start":504.72,"end":510.44,"text":"بس يعني كل الناس عارفين انه مب يعني مب ما\nيمديك سوي"},{"start":510.44,"end":515.78,"text":"مثلا الذبح عرفتوا ما يحتاجون يحطون صديق\nقانون عشان يمنحون الذبح"},{"start":515.78,"end":518.3,"text":"يعني واضح ان هذا الشيء ممنوع من الاساس"},{"start":518.3,"end":519.66,"text":"فعندكم بعدين"},{"start":519.66,"end":520.3,"text":"راشنل"},{"start":520.3,"end":522.38,"text":"راشنل يقول لك عبارة عن قياس"},{"start":522.38,"end":523.14,"text":"قياس ايش"},{"start":523.14,"end":526.34,"text":"هل فيه لوجيك للموضوع"},{"start":526.34,"end":529.34,"text":"هل كل الناس يقدرون يسوونه"},{"start":529.34,"end":530.78,"text":"مثلا الحين"},{"start":530.78,"end":533.58,"text":"شخص والله بالغ كبير"},{"start":533.58,"end":535.2,"text":"بس انه ممكن عنده داون سندروم"},{"start":535.2,"end":537.32,"text":"او عنده مرض يأثر"},{"start":537.32,"end":539.12,"text":"بدماغه او عنده مشاكل"},{"start":539.12,"end":541.08,"text":"نفسية هل هو"},{"start":541.08,"end":542.98,"text":"بيقدر يعني ينفذ"},{"start":542.98,"end":544.54,"text":"نفس القانون ولا لا"},{"start":544.54,"end":545.56,"text":"و بعدين عندكم"},{"start":545.56,"end":547.7,"text":"يقول لكم"},{"start":547.7,"end":550.9,"text":"مثلا"},{"start":550.9,"end":551.94,"text":"ممكن الآن"},{"start":551.94,"end":554.76,"text":"قوانين معينة للسياح"},{"start":554.76,"end":556.22,"text":"وقوانين معينة"},{"start":556.22,"end":559.22,"text":"للجوة البلد"},{"start":559.22,"end":560.54,"text":"صح"},{"start":560.54,"end":561.32,"text":"فيقول لكم"},{"start":561.32,"end":563.08,"text":"لا هذا قوانين"},{"start":563.08,"end":564.3,"text":"اللي عادي"},{"start":564.3,"end":566.26,"text":"مهما كنتم"},{"start":566.26,"end":567.68,"text":"جايين من ديرة مختلفة"},{"start":567.68,"end":570.56,"text":"كلكم تتبعون نفس الشي"},{"start":570.56,"end":571.76,"text":"فالله نعيد"},{"start":571.76,"end":574.48,"text":"public, informal, rational, impartial"},{"start":574.48,"end":579.2,"text":"أرجوكم أحفظوها قدر الإمكان لأنه ممكن جداً\nيجيكم كتعداد"},{"start":579.2,"end":581.54,"text":"وبدأين طبعاً هنا قال لكم زيادة"},{"start":581.54,"end":582.32,"text":"الـ 4 features"},{"start":582.32,"end":586.5,"text":"Gertz describes a moral system as one that\nis public"},{"start":586.5,"end":591.99,"text":"the system is public he argues because\neveryone must know what the rules are that"},{"start":591.99,"end":592.6,"text":"define it"},{"start":592.6,"end":595.18,"text":"زي ما قلت لكم لازم كل الناس سنعرف من\nالقوانين"},{"start":595.18,"end":600.215,"text":"بد عندكم informal because moral system has\nno formal authoritative judges presiding"},{"start":600.215,"end":600.64,"text":"over it"},{"start":600.64,"end":601.52,"text":"يعني ما حد"},{"start":601.52,"end":604.16,"text":"ما في شيخ نقول"},{"start":604.16,"end":606.22,"text":"يأتي ويحكم عليك شيء"},{"start":606.22,"end":607.86,"text":"لأنه لا يوجد قانون رسمي"},{"start":607.86,"end":608.78,"text":"ويوجد لكم"},{"start":608.78,"end":624.36,"text":"مثلا"},{"start":624.36,"end":626.32,"text":"حتى ممكن حطين قانون"},{"start":626.32,"end":627.72,"text":"أحتاج أصير"},{"start":627.72,"end":630.02,"text":"مهندس وعندي دكتورات"},{"start":630.02,"end":631.44,"text":"أستوعب القانون صح"},{"start":631.44,"end":632.66,"text":"لا لا يصلح"},{"start":632.66,"end":639.782,"text":"لازم يصير راشن لازم يصير يعني اي احد طبيعي\nو يعني ممكن اقل مستوى علميا و كده يفهم"},{"start":639.782,"end":641.54,"text":"القانون يفهم السالفة"},{"start":641.54,"end":645.36,"text":"ما يصدح ان يصير لازم شخص يصير عنده معلومات\nما هتقدر تنجاب"},{"start":645.36,"end":651.613,"text":"ولا ترا حتى فكروا فيها اذا كان كده ان اذا\nكان فيه لازم involve special knowledge عز"},{"start":651.613,"end":653.12,"text":"الله ما حد كان اتبعه"},{"start":653.12,"end":654.04,"text":"ومن اخر شيء"},{"start":654.04,"end":658.864,"text":"\"A moral is impartial in the sense that\nall moral rules are ideally designed to"},{"start":658.864,"end":662.04,"text":"apply equalitably to all participants in\nthe system\""},{"start":662.04,"end":668.04,"text":"\"السيستم يعني كل الناس اللي بالشعب بمكانهم\nيتبعونه equally\""},{"start":668.04,"end":672.04,"text":"يعني ما يواجهون واحد اصلا يصير واجه صعوبة\nوثانية لا"},{"start":672.04,"end":676.618,"text":"خلنا نروح الآن عند \"deriving and justice\nthe rules and principles of a moral"},{"start":676.618,"end":677.04,"text":"system\""},{"start":677.04,"end":683.04,"text":"قال لكم هنا \"rules of conduct\" يعني ايش\nيعني قوانين اللي تعلمك وش تسوي وش ما تسوي"},{"start":683.04,"end":694.86,"text":"مرة مهمة كلمة core values"},{"start":694.86,"end":701.34,"text":"هم يعني الاعتقادات"},{"start":701.34,"end":704.82,"text":"اللي مهما احد قاعد فوق راسك يحاولي غيرها"},{"start":704.82,"end":705.82,"text":"مبقادر"},{"start":705.82,"end":707.74,"text":"ليش لانه هو fundamental"},{"start":707.74,"end":709.36,"text":"هو تخيل جوة your core"},{"start":709.36,"end":713.36,"text":"إذا كنتم ترسومكم"},{"start":713.36,"end":716.36,"text":"تحاولون حياتكم حلوة"},{"start":716.36,"end":718.36,"text":"كنت أحاولون أن تنعكم بشيء"},{"start":718.36,"end":720.36,"text":"لكن أنتم جوا أعضاءكم"},{"start":720.36,"end":722.36,"text":"تقولون: لا هذا الشيء لا أصدق"},{"start":722.36,"end":724.36,"text":"هذا تقاليد كذا"},{"start":724.36,"end":725.36,"text":"مهما يحاولون"},{"start":725.36,"end":727.36,"text":"لا يمكنون أن يغيرونه"},{"start":727.36,"end":730.36,"text":"ما يقول لكم عن الناس أو الناس"},{"start":730.36,"end":731.36,"text":"ليس فقط شخص"},{"start":731.36,"end":733.36,"text":"حيانا المكان"},{"start":733.36,"end":735.36,"text":"مثلا الناس أو جامعة السلطان"},{"start":737.36,"end":742.125,"text":"وبعدين يقولون \"they dictate behavior and\ncan help people understand the difference"},{"start":742.125,"end":743.52,"text":"between right and wrong\""},{"start":743.52,"end":748.9,"text":"وهو يساعد انك تتميز وتساعد الناس تفهمهم\nبين الصح والغلط"},{"start":748.9,"end":754.14,"text":"لان مثلا احنا عندنا fundamental belief\nاننا وشو الذبح حرام ما يجوز صح"},{"start":754.14,"end":759.82,"text":"احنا مستحيل احد يجيقنع ان الذبح حرام واننا\nمو بحرام واننا عاد يروح الذبح"},{"start":759.82,"end":762.18,"text":"لا لان عندنا fundamental belief"},{"start":762.18,"end":764.36,"text":"وبعدين نكمل قال لكم هنا"},{"start":764.36,"end":768.36,"text":"\"التصوصيبات لتحقق العقلات المقبلة في واحد\nمن ثلاثة الهاتف\""},{"start":794.36,"end":796.36,"text":"يقول لكم الآن هم كشكاتبين"},{"start":796.36,"end":798.36,"text":"طبعاً لا يوجد هذا"},{"start":798.36,"end":800.36,"text":"كذلك الPDF كان"},{"start":800.36,"end":802.36,"text":"فقال لكم هنا اللاء"},{"start":802.36,"end":804.36,"text":"اللي توجدنا"},{"start":804.36,"end":806.36,"text":"كلهم يدخلون"},{"start":806.36,"end":808.36,"text":"كلهم يدخلون"},{"start":808.36,"end":810.36,"text":"كل ذلك نستخدمهم"},{"start":810.36,"end":812.36,"text":"عشان نطلع"},{"start":812.36,"end":814.36,"text":"حتى هو بعض الهاتف"},{"start":814.36,"end":816.36,"text":"يدهد له علاقة"},{"start":816.36,"end":818.36,"text":"مع الهاتف"},{"start":818.36,"end":820.36,"text":"بس إنه ثلاثة"},{"start":820.36,"end":822.36,"text":"مع بعض"},{"start":822.36,"end":824.36,"text":"\"Ground for Justifying Moral Principles\""},{"start":824.36,"end":826.36,"text":"بعد ذلك \"Moral Principles and Rules\""},{"start":826.36,"end":828.36,"text":"وفي النهاية \"Source of Morals\""},{"start":828.36,"end":831.36,"text":"لاحظوا أن \"Core Values\" يعتبر \"Source\""},{"start":831.36,"end":833.36,"text":"يعني المكان الأساس"},{"start":833.36,"end":834.36,"text":"لأن أصلاً في النهاية"},{"start":834.36,"end":837.36,"text":"أنتم حين \"Core Values\" هي بتحدد دينكم"},{"start":837.36,"end":838.36,"text":"صح؟"},{"start":838.36,"end":840.36,"text":"وهي بتحدد الفلوسفية حقكم"},{"start":840.36,"end":843.36,"text":"والقوانين عادل قوانين"},{"start":843.36,"end":845.36,"text":"حسن المنطقة التي أنتم فيها"},{"start":845.36,"end":849.36,"text":"لكن يقولون أنتم ساكنين في هذه المنطقة بسبب\n\"Core Values\""},{"start":849.36,"end":859.36,"text":"لماذا نحن نجلس ونحاول نحلل ونفسفس"},{"start":859.36,"end":861.36,"text":"قال لكم \"to critically evaluate arguments\""},{"start":861.36,"end":863.36,"text":"مثلا انتم متهاوشين مع زميلكم"},{"start":863.36,"end":866.36,"text":"وما تبغون تسببون مشكلة أكبر"},{"start":866.36,"end":873.36,"text":"فشتسوا تروحون كل واحد بزاوية وكل واحد يقعد\nيفكر ويحلل عن كلام الثاني"},{"start":873.36,"end":877.36,"text":"عشان يشوف اذا كلام الثاني كان فيه منطق او\nلا"},{"start":877.36,"end":882.36,"text":"ثم نقول لكم: \"to support a position or\nclaim\""},{"start":882.36,"end":887.36,"text":"مثلا انتم تحاولون ان تقنعون اهلكم و تشترون\nقطوة"},{"start":887.36,"end":890.36,"text":"انتم اذا لم تفكرون و تحللون"},{"start":890.36,"end":893.36,"text":"كيف تطرعون اسباب انكم تقنعون الشخص الثاني"},{"start":893.36,"end":897.36,"text":"او تقوون كلامكم و تقنعونهم"},{"start":897.36,"end":900.36,"text":"فلازم تضعوا عندكم \"support\""},{"start":900.36,"end":903.36,"text":"للكليم الذي تريده"},{"start":903.36,"end":906.36,"text":"ثم: \"to convince someone to adopt or\nreject a certain position\""},{"start":906.36,"end":911.26,"text":"مثلا زي ما قلت لكم تحاولون تقنعون شخص انه\nيغير راي عن الموضوع"},{"start":911.26,"end":919.42,"text":"فلازم نحلل ونفكر بالأثيكس والفلوسفي عشان\nنحاول نقنع شخص"},{"start":919.42,"end":924.28,"text":"وبالي نقال لكم to provide consistent اللي\nهو logical reasons for our beliefs"},{"start":924.28,"end":927.7,"text":"احنا ما نبغى نقول والله هذا راي ليش"},{"start":927.7,"end":931.18,"text":"بس كذا انا احب انا احب هذا موب logic"},{"start":931.18,"end":933.5,"text":"هذا بس يعني انا نية ممكن خلقو شوي"},{"start":933.5,"end":935.74,"text":"اللوجك لا عندك اسباب"},{"start":935.74,"end":937.08,"text":"اسباب دينية"},{"start":937.08,"end":938.2,"text":"اسباب قانونية"},{"start":938.2,"end":939.82,"text":"اسباب فلسفلية"},{"start":939.82,"end":941.58,"text":"يعني في عندك اسباب"},{"start":941.58,"end":944.54,"text":"مو بس كده عشان انا براسي كده"},{"start":944.54,"end":945.38,"text":"من اخر شي"},{"start":945.38,"end":947.6,"text":"to engage in meaningful dialogue"},{"start":947.6,"end":950.54,"text":"طبعا احنا ما نريح نخسر وقتنا"},{"start":950.54,"end":952.22,"text":"نتكلم كلام فاضي"},{"start":952.22,"end":954.88,"text":"خلوا كلامنا يصير له معنى"},{"start":954.88,"end":955.86,"text":"ويصير له وزن"},{"start":955.86,"end":957.26,"text":"فانا هنا وش كتبت لكم"},{"start":957.26,"end":958.02,"text":"كتبت لكم نوت"},{"start":958.02,"end":963.547,"text":"it compares different moral theories to\nunderstand how people decide what is wrong"},{"start":963.547,"end":964.76,"text":"and why it's right"},{"start":964.76,"end":967.0,"text":"and why they make those decisions"},{"start":967.0,"end":972.6,"text":"يعني احنا اصلا بنتكلم بعدين انه في اس اقول\nزي ما قلت لكم فيه ست انواع theories"},{"start":972.6,"end":977.7,"text":"من ذول الثيريز احنا نقعد نستخدم الفلسفة\nوالأثيكس ونقعد نفكر ونفسفس"},{"start":977.7,"end":981.76,"text":"عشان نعرف اي واحدة منهم هي الصح لأي موقف"},{"start":981.76,"end":986.58,"text":"وبدين ان شاء الله بنكمل الاثيكو الثيريز\nبالمقطع الجاي"}]}