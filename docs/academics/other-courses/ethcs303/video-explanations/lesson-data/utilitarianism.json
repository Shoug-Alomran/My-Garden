  "chapters": [
    { "time": 0, "title": "Utility and happiness" },
    { "time": 158.8, "title": "The greatest happiness principle" },
    { "time": 289.3, "title": "Act and rule utilitarianism" },
    { "time": 494.56, "title": "Highway cost-benefit example" },
    { "time": 575.98, "title": "Limits of utility calculations" },
    { "time": 620.04, "title": "Difficulties with act utilitarianism" },
    { "time": 725.7, "title": "Applying rule utilitarianism" },
    { "time": 988.92, "title": "Rule utilitarianism versus Kantianism" }
  ],
  "transcript": [
    { "start": 0.0, "end": 0.78, "text": "السلام عليكم" },
    { "start": 0.78, "end": 1.84, "text": "اليوم نكمل عند" },
    { "start": 1.84, "end": 4.32, "text": "وتلاحظون انه هنا" },
    { "start": 4.32, "end": 6.46, "text": "يقول لكم وش التركيز حقه" },
    { "start": 6.46, "end": 8.14, "text": "السي او جي جي" },
    { "start": 8.14, "end": 9.74, "text": "هذا يعني اختصار تقدرون تساعدون" },
    { "start": 9.74, "end": 10.88, "text": "يعني يساعدكم تحفظون" },
    { "start": 10.88, "end": 16.32, "text": "طبعا احنا نبغي نعرف" },
    { "start": 16.32, "end": 17.5, "text": "وش هو بالضبط" },
    { "start": 17.5, "end": 20.14, "text": "قال لكم" },
    { "start": 20.14, "end": 25.92, "text": "يعني انا" },
    { "start": 25.92, "end": 27.92, "text": "ما قاعد اقيم النية" },
    { "start": 27.92, "end": 29.46, "text": "وراء التصرف لا" },
    { "start": 29.46, "end": 32.48, "text": "انا قاعد اقيم على بس شي واحد" },
    { "start": 32.48, "end": 34.46, "text": "اللي هو العقاب التصرف" },
    {
      "start": 34.46,
      "end": 41.46,
      "text": "يعني الحين قمة السعادة البشر ارتفعت"
    },
    { "start": 41.46, "end": 43.54, "text": "خلاص معانا ان هذا شوي كويس" },
    { "start": 43.54, "end": 45.46, "text": "بس وشو اذا سبب اذى" },
    { "start": 46.04, "end": 46.86, "text": "هذا لا" },
    { "start": 46.86, "end": 48.28, "text": "هذا مبكويس" },
    { "start": 48.28, "end": 49.02, "text": "هذا بالعكس" },
    { "start": 49.02, "end": 50.46, "text": "بس بكل بساطة" },
    { "start": 50.46, "end": 51.76, "text": "طبعا مين اللي مأسس هذا الشي" },
    { "start": 51.76, "end": 54.12, "text": "جيرمي بثمن و جون ستورت ميل" },
    { "start": 54.12, "end": 55.32, "text": "قال لكم هنا جيرمي" },
    { "start": 55.32, "end": 56.88, "text": "ان فاوندد يولتيلرزم" },
    {
      "start": 56.88,
      "end": 70.46000000000001,
      "text": "ودون ستورت قال لكم أنه راح حسن هذا الثيوري"
    },
    {
      "start": 70.46000000000001,
      "end": 79.26,
      "text": "يعني السعادة ممكن عادة أصير سعيدة شوي"
    },
    { "start": 79.26, "end": 81.64, "text": "وأقدر أصير سعيدة مرة" },
    {
      "start": 81.64,
      "end": 89.838,
      "text": "هو يقول ان قيمة نفسها عن السعادة اهم من\nمبس يعني العدد يعني خلنا نقول انا والله"
    },
    { "start": 89.838, "end": 92.64, "text": "كنت خمس مرات سعيدة بالاسبوع" },
    {
      "start": 92.64,
      "end": 98.828,
      "text": "بس يعني بقية اليومين ما كنت سعيدة هو ما\nيهمه كثر الايام السعيدة اللي انا فيه كثما"
    },
    {
      "start": 98.828,
      "end": 103.64,
      "text": "انا الحين خلال ذا الخمس ايام هل انا كنت\nسعيدة شوي ولا سعيدة مرة"
    },
    { "start": 103.64, "end": 105.64, "text": "وطبعاً الممري هوك" },
    { "start": 105.64, "end": 107.64, "text": "الآن سهل تحفظونا" },
    { "start": 107.64, "end": 109.64, "text": "تذكروا" },
    { "start": 109.64, "end": 111.64, "text": "\"A\" مثل \"A2²\"" },
    {
      "start": 111.64,
      "end": 113.64,
      "text": "لماذا؟ لأن \"Happiness\" يساوي"
    },
    {
      "start": 113.64,
      "end": 115.64,
      "text": "\"Advantage\" + \"Absence of pain\""
    },
    { "start": 115.64, "end": 117.64, "text": "شوفونا كيف \"A²\"" },
    { "start": 117.64, "end": 119.64, "text": "لأن هناك 2 \"A\"" },
    {
      "start": 119.64,
      "end": 122.72,
      "text": "\"absence of pain\" يعني ما فيه \"الم\" و\n\"advantage\""
    },
    {
      "start": 122.72,
      "end": 125.88,
      "text": "إني أنا قاعد أربح فيه شيء قاعد أكسبه"
    },
    {
      "start": 126.44,
      "end": 128.94,
      "text": "طبعاً \"all synonyms in one shot\" يعني وشه"
    },
    {
      "start": 129.34,
      "end": 133.54,
      "text": "هل الحين \"synonyms\" للكلمة \"السعادة\" و\n\"happiness\""
    },
    { "start": 134.04, "end": 134.94, "text": "طبعاً أو شيء \"happiness\"" },
    {
      "start": 135.04,
      "end": 138.84,
      "text": "\"advantage\" \"benefit\" \"good\" \"pleasure\"\n\"profit\""
    },
    {
      "start": 139.24,
      "end": 144.44,
      "text": "والعكسة \"unhappiness\" \"disadvantage\"\n\"cost\" \"evil\" \"pain\""
    },
    {
      "start": 144.74,
      "end": 147.84,
      "text": "أنا ليش حطيتكم إياهم كلهم كل أبوهم\nالسynonyms"
    },
    {
      "start": 148.04,
      "end": 153.12,
      "text": "عشان اذا جاكم بالاختبار ممكن ما يقولون\nhappiness ممكن يقولون advantage"
    },
    {
      "start": 153.12,
      "end": 158.04,
      "text": "انا بيكم على طول تربطون هذا الشيء انه اوه\nمو بس كلمة واحدة تعني هذا الشيء"
    },
    { "start": 158.8, "end": 161.04, "text": "الحين قلنا نتكلم عن principle" },
    {
      "start": 161.04,
      "end": 165.8,
      "text": "وشو also called the greatest happiness\nprinciple"
    },
    {
      "start": 165.8,
      "end": 171.82,
      "text": "يقول لكم ان ال right action يعني التصرف\nالصحيح هو الشو يساوي التصرف والفعل"
    },
    {
      "start": 171.82,
      "end": 176.94,
      "text": "اللي ينتج اكثر كمية سعادة لأكثر عدد الناس"
    },
    {
      "start": 176.94,
      "end": 183.96,
      "text": "قل لكم حين أول شيء يركز على الأوتكم"
    },
    { "start": 183.96, "end": 185.62, "text": "إحنا قلنا ليش الأوتكم" },
    { "start": 185.64, "end": 191.64, "text": "لكي نرى إذا كان عقاب أو العكس" },
    { "start": 191.64, "end": 192.64, "text": "شيء يفيد وحلو" },
    { "start": 192.64, "end": 193.64, "text": "قال لكم هنا" },
    {
      "start": 193.64,
      "end": 195.64,
      "text": "\"What matters is the results\""
    },
    { "start": 195.64, "end": 196.64, "text": "شاهدون كلمة هذه" },
    { "start": 196.64, "end": 198.64, "text": "وعش الخطوط تحتها" },
    { "start": 198.64, "end": 200.64, "text": "\"Result of the action\"" },
    {
      "start": 200.64,
      "end": 203.64,
      "text": "\"Not the intent or attitude behind it\""
    },
    { "start": 203.64, "end": 204.64, "text": "يعني أنا نيتي" },
    { "start": 204.64, "end": 206.64, "text": "وليش وسلوبي" },
    { "start": 206.64, "end": 207.64, "text": "مم مهم" },
    { "start": 207.64, "end": 208.64, "text": "بس مهم النتيجة" },
    { "start": 208.64, "end": 210.64, "text": "\"utility\" فكروا \"result\"" },
    { "start": 210.64, "end": 212.64, "text": "وعرفتم حتى شي ثاني" },
    {
      "start": 212.64,
      "end": 219.411,
      "text": "في حين لو رحتوا شقة مثلا ما تسأجرون أنتم\nتسألون عن الـ utility صح عن الأشياء اللي"
    },
    { "start": 219.411, "end": 220.07999999999998, "text": "بقدمونها" },
    {
      "start": 220.07999999999998,
      "end": 227.561,
      "text": "مثلا حين لو ما قدموا موعية حارة أو مكيف\nأنتم بيضركم صح ففكروا كده سووا ترابطوا أن"
    },
    {
      "start": 227.561,
      "end": 232.64,
      "text": "الـ utility يخدمك وأنت يهمك الخدمات على\nحسب الـ outcome"
    },
    {
      "start": 232.64,
      "end": 234.64,
      "text": "فهنا اقول لكم \"not about intentions\""
    },
    {
      "start": 234.64,
      "end": 236.64,
      "text": "يعني قلت \"نيتك\" ممكن يعني \"نيتك شينا\""
    },
    { "start": 236.64, "end": 238.64, "text": "بس إنه.." },
    {
      "start": 238.64,
      "end": 240.64,
      "text": "أو واحدة نيتك كويسة بس إنه يطلع"
    },
    { "start": 240.64, "end": 242.64, "text": "شي يعني كويس" },
    {
      "start": 242.64,
      "end": 244.64,
      "text": "كيف حين قلت لكم \"you could have good\nintentions\""
    },
    {
      "start": 244.64,
      "end": 246.64,
      "text": "\"but the outcomes causes harm\""
    },
    { "start": 246.64, "end": 248.64, "text": "\"it's wrong\" خلاص" },
    {
      "start": 248.64,
      "end": 250.64,
      "text": "هم شوفوني أنا ممكن زيد لو كنت طبيب"
    },
    { "start": 250.64, "end": 252.64, "text": "\"نيتي\" إني أعالج هذا المريض" },
    { "start": 252.64, "end": 254.64, "text": "هذا المريض لقدر الله توفى" },
    { "start": 254.64, "end": 256.64, "text": "أنا \"نيتي\" إني أنقذه" },
    { "start": 256.64, "end": 258.64, "text": "بس والله مات" },
    {
      "start": 258.64,
      "end": 260.64,
      "text": "فخلاص هذا \"morally wrong\" خلط عليه"
    },
    {
      "start": 260.64,
      "end": 265.54,
      "text": "الحين البنفتس شوفوا عندكم اربع خطوط\nوالهارمز خطين"
    },
    {
      "start": 265.54,
      "end": 269.24,
      "text": "عشان تعرفون الويت of the total benefits\nagainst the total هارمز"
    },
    {
      "start": 269.24,
      "end": 275.6,
      "text": "يعني كيف احنا لاحظوا لننبي اكثر عدد من\nالضرر"
    },
    {
      "start": 275.6,
      "end": 277.78,
      "text": "يعني اوكي هو قاعد يقول لك ان يوتيلتي"
    },
    {
      "start": 277.78,
      "end": 284.48,
      "text": "ما في مشكلة انك تب بضرر طالما ان النتيجة\nالاحسن اكثر"
    },
    {
      "start": 284.48,
      "end": 287.65999999999997,
      "text": "اوزناها اكثر من الضرر"
    },
    { "start": 287.65999999999997, "end": 289.3, "text": "الاكثر كمية الناس" },
    { "start": 289.3, "end": 292.86, "text": "الآن هناك نوعين" },
    { "start": 292.86, "end": 294.54, "text": "فيه Act وفيه Rule" },
    {
      "start": 294.54,
      "end": 297.64,
      "text": "زي كانت نظم كان فيه 2 فورميلاز"
    },
    { "start": 297.64, "end": 300.72, "text": "والترزم عندهم الآن" },
    { "start": 300.72, "end": 302.34, "text": "كان لتو فورميلاز بس نوعين" },
    { "start": 302.34, "end": 303.54, "text": "أول شيء Act" },
    { "start": 303.54, "end": 304.5, "text": "قال لكم هنا" },
    { "start": 304.5, "end": 306.8, "text": "Each evaluates" },
    { "start": 306.8, "end": 308.6, "text": "each individual action" },
    { "start": 308.6, "end": 309.84, "text": "on its own" },
    { "start": 309.84, "end": 310.5, "text": "Ask" },
    { "start": 310.5, "end": 312.7, "text": "will this specific act" },
    { "start": 312.7, "end": 314.4, "text": "produce the most good right now" },
    { "start": 314.4, "end": 316.24, "text": "أنا الآن بحكم على" },
    { "start": 316.24, "end": 318.36, "text": "الموقف الحالي" },
    { "start": 318.36, "end": 321.62, "text": "يعني ما قاعد افكر بالمستقبل" },
    { "start": 321.62, "end": 323.52, "text": "ما قاعد افكر بالماضي" },
    { "start": 323.52, "end": 325.44, "text": "ما قاعد افكر انه هل هذا قانون" },
    { "start": 325.44, "end": 327.28, "text": "قد اسأل هل هذا الموقف" },
    { "start": 327.28, "end": 328.62, "text": "بالذات هذا الموقف" },
    { "start": 328.62, "end": 331.18, "text": "يعني كويس نتيجته" },
    { "start": 331.18, "end": 332.7, "text": "ولا لا هذا احسن" },
    { "start": 332.7, "end": 335.3, "text": "ليش لان الحين كانت نزم" },
    { "start": 335.3, "end": 337.14, "text": "كما يعطي اولويات" },
    { "start": 337.14, "end": 339.36, "text": "للاشياء ولا كان يعطي مجال" },
    { "start": 339.36, "end": 340.84000000000003, "text": "انك صدق تقرر" },
    {
      "start": 340.84000000000003,
      "end": 343.2,
      "text": "او انك ما كان في بينهم"
    },
    { "start": 343.2, "end": 344.86, "text": "الرانكينج انه اوه" },
    { "start": 344.86, "end": 346.62, "text": "اول من هذا الشي بذا" },
    {
      "start": 346.62,
      "end": 348.6,
      "text": "بس هنا لا في الـ Act Utilism لا"
    },
    { "start": 348.6, "end": 351.82, "text": "أنه يعطيك المجال أنك أنت تشوف" },
    { "start": 351.82, "end": 354.98, "text": "وشو اللي تقدر تسوي" },
    { "start": 354.98, "end": 357.88, "text": "اللي بيخلي نتيجة كويسة حاليا" },
    { "start": 357.88, "end": 358.9, "text": "لهذا الموقف" },
    {
      "start": 358.9,
      "end": 361.32,
      "text": "يعني ما يسوي discrimination عن المواقف"
    },
    {
      "start": 361.32,
      "end": 363.72,
      "text": "ونقول لا خلاص أنت تستخدم القانون هذا"
    },
    { "start": 363.72, "end": 366.34, "text": "لكل شيء بغض النظر الموقف" },
    { "start": 366.34, "end": 366.9, "text": "عكس" },
    { "start": 366.9, "end": 367.98, "text": "طبعا وشو" },
    { "start": 367.98, "end": 370.02, "text": "Judge Act by Act" },
    { "start": 370.02, "end": 371.18, "text": "Case by Case" },
    { "start": 371.18, "end": 373.62, "text": "يعني مو بكل حالة نفس الحالة" },
    { "start": 374.26, "end": 375.12, "text": "وعكسها عندكم" },
    { "start": 375.12, "end": 377.7, "text": "هذي يقول لك" },
    { "start": 377.7, "end": 382.36, "text": "قوانين ايش" },
    {
      "start": 382.36,
      "end": 384.38,
      "text": "اللي لو ان شاء الله رحت لفلبين"
    },
    { "start": 384.38, "end": 385.02, "text": "ولا الهند" },
    { "start": 385.02, "end": 387.34, "text": "بيطبقون نفس القانون" },
    {
      "start": 387.34,
      "end": 389.94,
      "text": "produces the greatest happiness overall"
    },
    { "start": 389.94, "end": 391.4, "text": "judge rules" },
    {
      "start": 391.4,
      "end": 393.15999999999997,
      "text": "not individual acts"
    },
    { "start": 393.15999999999997, "end": 394.56, "text": "ان حين حنا" },
    { "start": 394.56, "end": 396.06, "text": "هذا متى وين نستخدم" },
    { "start": 396.06, "end": 398.24, "text": "فكروا الحين احد" },
    { "start": 398.24, "end": 399.48, "text": "سوى جريمة" },
    { "start": 399.48, "end": 401.86, "text": "راح للمحكمة بيحكمونه" },
    { "start": 401.86, "end": 404.28, "text": "هو بيحكمون على حالته" },
    { "start": 404.28, "end": 405.6, "text": "هو بيستخدمون" },
    { "start": 405.6, "end": 408.22, "text": "هم بيفكرون ان" },
    { "start": 408.22, "end": 410.22, "text": "وشو الأفضل نتيجة" },
    { "start": 410.22, "end": 411.86, "text": "أقدر أحكم عن هذا الشخص" },
    { "start": 411.86, "end": 413.98, "text": "من حيث ان أكثر عدد الناس" },
    { "start": 413.98, "end": 415.92, "text": "يكونون كويسين فرحانين" },
    { "start": 415.92, "end": 417.74, "text": "الرول" },
    { "start": 417.74, "end": 420.44, "text": "لا ما يستخدم" },
    { "start": 420.44, "end": 422.04, "text": "لانك انت الحين ما قاعد تقيس" },
    { "start": 422.04, "end": 423.74, "text": "على specific situation" },
    { "start": 423.74, "end": 425.74, "text": "انت قاعد تطبق قانون" },
    { "start": 425.74, "end": 427.72, "text": "عالميا مثلا" },
    { "start": 427.72, "end": 430.14, "text": "الحين عالميا إذا أحد ذبح شخص" },
    { "start": 430.14, "end": 431.72, "text": "لازم يروح" },
    { "start": 431.72, "end": 433.98, "text": "للسجن ويحكمون" },
    { "start": 433.98, "end": 435.98, "text": "هذا قانون" },
    { "start": 435.98, "end": 437.98, "text": "لماذا هو قانون؟" },
    { "start": 437.98, "end": 439.98, "text": "لأنه كل العالم يسويه" },
    { "start": 439.98, "end": 441.98, "text": "نحن ننزل إلى ديب دايف" },
    { "start": 441.98, "end": 443.98, "text": "الذي يجب أن نعرفه" },
    { "start": 453.98, "end": 455.98, "text": "نلاحظوا بعد كلمة افكتد" },
    { "start": 455.98, "end": 457.98, "text": "لا تجيب لي شخص من الفلبين" },
    {
      "start": 457.98,
      "end": 459.98,
      "text": "على مشكلة قاعدة تصف في السعودية"
    },
    {
      "start": 459.98,
      "end": 464.74,
      "text": "لا، هو مش دخل، هو ما هما، هو ما قاعد يتأثر\nشخصياً عليه"
    },
    {
      "start": 464.74,
      "end": 468.3,
      "text": "فأنتم لازم تحطون عليه بعد 10 خطوط افكتد"
    },
    {
      "start": 468.3,
      "end": 473.42,
      "text": "لأنه تبغون تحسبون حساب الناس اللي قاعدين\nيتأثرون"
    },
    { "start": 473.42, "end": 474.54, "text": "قال لكم طبعاً هنا" },
    {
      "start": 474.54,
      "end": 480.66,
      "text": "قال لكم إنه بيصروحون يسوون شارع جديد"
    },
    {
      "start": 480.66,
      "end": 485.14,
      "text": "بس إنه بيأخذون من بيوت الناس عشان يسوون ذا\nالشارع"
    },
    {
      "start": 485.14,
      "end": 491.66,
      "text": "فهذا يعود المياه و خمسين هوم اونر هذا\nبيكلفهم عشرين مليون"
    },
    {
      "start": 491.66,
      "end": 494.56,
      "text": "حلو بدأ عندكم الكونسروكشن كاست"
    },
    {
      "start": 494.56,
      "end": 499.08,
      "text": "هذا الحين الضريبة قاعد يستخدمونها عشان\nيبنون هذا الشارع الجديد"
    },
    { "start": 499.08, "end": 501.02, "text": "هذا بيكلف عشر مليون" },
    { "start": 501.02, "end": 503.74, "text": "وبعدين امبارمينتل امباكت" },
    {
      "start": 503.74,
      "end": 506.16,
      "text": "لان في حيوانات قاعدين يأخذون بيوتهم"
    },
    {
      "start": 506.16,
      "end": 509.08,
      "text": "فلازم يروحون يأخذون الحيوانات ويسوون لهم\nبيت جديد صح"
    },
    { "start": 509.08, "end": 511.9, "text": "فهذا خلو نقول انه مليون واحد" },
    { "start": 511.9, "end": 513.2, "text": "بس وشه" },
    {
      "start": 513.2,
      "end": 516.4,
      "text": "saving to drivers over the 25 years"
    },
    { "start": 516.4, "end": 517.64, "text": "يعني الحين قاعد يقول لك ان" },
    { "start": 517.64, "end": 519.5, "text": "خلال الخمسة وعشرين سنة" },
    { "start": 519.5, "end": 520.52, "text": "اللي عقوا ما تنتهي" },
    { "start": 520.52, "end": 523.18, "text": "يعني خلاص يجهز الشارع" },
    { "start": 523.18, "end": 524.38, "text": "والناس الصريق يستخدمونه" },
    { "start": 524.38, "end": 526.8, "text": "انه بيربحون منه" },
    { "start": 526.8, "end": 529.82, "text": "تسعة وثلاثين مليون دولار" },
    { "start": 529.82, "end": 531.54, "text": "فتشوفون انه عديته" },
    { "start": 531.54, "end": 533.42, "text": "هذا الحين عشرين زائد عشر" },
    { "start": 533.42, "end": 535.58, "text": "ثلاثين زائد واحد واحد ثلاثين" },
    { "start": 535.58, "end": 537.0, "text": "فالارباح" },
    { "start": 537.0, "end": 540.18, "text": "بيكون اكثر من الخسارة" },
    { "start": 540.18, "end": 540.86, "text": "تشوفون" },
    {
      "start": 540.86,
      "end": 544.3,
      "text": "فيقول لك نت رزولت ان استفادوا ثمانية مليون"
    },
    { "start": 544.3, "end": 545.64, "text": "هذا بنيفت وينز" },
    { "start": 545.64, "end": 546.8, "text": "فإيه" },
    { "start": 546.8, "end": 547.78, "text": "بيلد هايوي" },
    { "start": 547.78, "end": 551.72, "text": "ان الربح اكثر من الضرر" },
    { "start": 551.72, "end": 552.74, "text": "قال لكم هنا بعد" },
    { "start": 552.74, "end": 553.64, "text": "فور اكت" },
    { "start": 553.64, "end": 555.5, "text": "فوكيز اون" },
    { "start": 555.5, "end": 560.02, "text": "مو بشي خيالي او يقدر حسبات" },
    { "start": 560.02, "end": 561.16, "text": "وبدين قال لكم انتويتف" },
    {
      "start": 561.16,
      "end": 566.06,
      "text": "طبع البشر ان يفكر بهذا الطريقة"
    },
    { "start": 566.06, "end": 566.68, "text": "خلقه" },
    { "start": 566.68, "end": 567.78, "text": "وبدين قال لكم" },
    { "start": 567.78, "end": 570.74, "text": "يعني يفكر بالجماعة" },
    { "start": 570.74, "end": 572.04, "text": "ما يفكر بشخص واحد" },
    { "start": 572.04, "end": 574.1, "text": "طبعا عنده اشياء ضده" },
    { "start": 574.1, "end": 575.98, "text": "اللي هو ما يعني" },
    {
      "start": 575.98,
      "end": 578.56,
      "text": "unclear who to include in calculations"
    },
    { "start": 578.56, "end": 580.14, "text": "يعني مين هل صدق" },
    { "start": 580.14, "end": 582.08, "text": "affected ومين مبأفكتد" },
    {
      "start": 582.08,
      "end": 584.28,
      "text": "مين اللي صدق بيتضرر ولا مو متضرر"
    },
    { "start": 584.28, "end": 584.66, "text": "عرفته" },
    { "start": 584.66, "end": 585.74, "text": "برين قال لكم" },
    { "start": 585.74, "end": 589.46, "text": "يعني طالما ان" },
    { "start": 589.46, "end": 591.38, "text": "ما يأذي" },
    {
      "start": 591.38,
      "end": 593.76,
      "text": "يعني يجيب نتيجة كويسة اكثر من الضرر"
    },
    { "start": 593.76, "end": 595.6, "text": "فعادي تقدر تكسر وعدك" },
    { "start": 595.6, "end": 596.86, "text": "ما في مشكلة" },
    { "start": 596.86, "end": 598.1, "text": "وقال لكم هنا" },
    {
      "start": 598.1,
      "end": 606.36,
      "text": "يعني ما يحطه في بال أنه عندنا واجبات\nوعندنا ملتزمات في حياتنا"
    },
    { "start": 606.36, "end": 610.42, "text": "هذا هو المشكل عكس مع الأكت" },
    { "start": 610.42, "end": 612.46, "text": "لاحظوا أنه أكت ما قاله الرول" },
    { "start": 612.46, "end": 614.32, "text": "بنهيني قال لكم" },
    { "start": 614.32, "end": 618.62, "text": "بنهيني قال لكم" },
    { "start": 618.62, "end": 620.04, "text": "The promise problem" },
    { "start": 620.04, "end": 622.76, "text": "Y act utility gets tricky" },
    {
      "start": 622.76,
      "end": 625.2,
      "text": "قال لك حين X promised Y something"
    },
    { "start": 625.2, "end": 627.14, "text": "يعني شخص وعد شخص ثاني شي" },
    {
      "start": 627.14,
      "end": 633.02,
      "text": "قال لكم الحين ان اذا مسكت الوعد تاخذ 1000\nunit of good"
    },
    {
      "start": 633.02,
      "end": 639.42,
      "text": "بس وشو اذا كسرت الوعد نقصت زيادة تشوفون ان\nما في عدالة"
    },
    { "start": 639.42, "end": 640.28, "text": "فيقول لكم" },
    { "start": 640.28, "end": 646.06, "text": "يعني انت الحين قاعد تكسب اكثر" },
    { "start": 646.06, "end": 648.4, "text": "بس وشو انت قاعد تكسب" },
    {
      "start": 648.4,
      "end": 653.1,
      "text": "عكس لو انت يعني keep promise انت بتاخذ\n1000 شي"
    },
    {
      "start": 653.1,
      "end": 657.34,
      "text": "وإذا أكسرتها ألف وواحد فأنت قاعد تربح\nزيادة واحد"
    },
    {
      "start": 657.34,
      "end": 662.1,
      "text": "يعني أنت قاعد يقول لك الأكت أن أي رح أكسر\nهذا الشي عشان أنت تستفيد"
    },
    { "start": 662.1, "end": 664.36, "text": "يعني تأخذ أكثر فائدة" },
    {
      "start": 664.36,
      "end": 666.78,
      "text": "بس أن هذا يعني فيه تحس أنه غلط"
    },
    {
      "start": 666.78,
      "end": 670.0,
      "text": "تحس أن ليش دقيقة أروح أكثب عشان أخذ زيادة"
    },
    {
      "start": 670.0,
      "end": 672.92,
      "text": "عموما وننتقل لسكشن 5 اللي يقول لك"
    },
    { "start": 672.92, "end": 675.92, "text": "لحظوك رول أوك" },
    {
      "start": 675.92,
      "end": 679.62,
      "text": "انتبهوا تسلق فضون بين أكت و رول"
    },
    {
      "start": 679.62,
      "end": 685.82,
      "text": "رول يقول لكم أن الأكشن صح إذا كان كل الناس\nيتبعونه يونيفرسل"
    },
    { "start": 685.82, "end": 696.52, "text": "حطوا عشر قطوط تحت هذا الجملة" },
    { "start": 696.52, "end": 699.58, "text": "معنى إيش؟" },
    {
      "start": 699.58,
      "end": 706.7,
      "text": "إذا أنا طبقت عالميا هل بيتبعونا وهل بيجيب\nنتيجة كويسة؟"
    },
    { "start": 706.7, "end": 707.7, "text": "نعم أو لا" },
    {
      "start": 707.7,
      "end": 716.213,
      "text": "مثلا حين انا لو قمت بعمل مدين عن اني اخلي\nكل المدن و الديار يتكلمون عن الدين و خلاص"
    },
    {
      "start": 716.213,
      "end": 719.7,
      "text": "الاسلامي و التابعون الدين الاسلامي"
    },
    { "start": 719.7, "end": 722.7, "text": "هذا بيصير النتيجة جيد" },
    { "start": 722.7, "end": 723.7, "text": "نقول لكم هنا" },
    {
      "start": 723.7,
      "end": 725.7,
      "text": "\"is it okay for everyone to do this\""
    },
    {
      "start": 725.7,
      "end": 730.7,
      "text": "هذا السؤال اللي لازم تسألون نفسكم و انتم\nتفكرون بـ Rule Utilism"
    },
    { "start": 730.7, "end": 733.7, "text": "مو بس هل هذا الشيء مناسب لي" },
    { "start": 733.7, "end": 743.7, "text": "لا يحتاج لك أن تفكروا بعقلكم" },
    { "start": 743.7, "end": 746.7, "text": "لا يحتاج لكي أن تفكروا بعقلكم" },
    {
      "start": 746.7,
      "end": 750.7,
      "text": "لا يحتاج لكي أن أقوم بإمكانك الموقف"
    },
    { "start": 750.7, "end": 753.7, "text": "هذا لا يهم من أنك موقفك" },
    {
      "start": 753.7,
      "end": 758.7,
      "text": "الحكم الذي أحكمه يكون نفس الشيء مهما كانت\nالحالة"
    },
    { "start": 758.7, "end": 759.7, "text": "أريد أن أقول لكم" },
    {
      "start": 759.7,
      "end": 764.28,
      "text": "يعني احيانا الواحد يبغى اللي يفيده"
    },
    {
      "start": 764.28,
      "end": 768.66,
      "text": "ما يبغى يعني ما يهمه ولا اللي يفيده\nالمجتمع بشكل عام"
    },
    {
      "start": 768.66,
      "end": 771.56,
      "text": "بس يفيده اللي اوه انا بربح من هذا الشي يلا\nطبق"
    },
    {
      "start": 771.56,
      "end": 774.02,
      "text": "بس هنا يساعد ان يفيد البايس هذا"
    },
    { "start": 774.02, "end": 774.7, "text": "بلين قال لكم" },
    { "start": 774.7, "end": 781.4, "text": "يعني ما فيه يعني شعب ممكن يقول" },
    {
      "start": 781.4,
      "end": 785.28,
      "text": "بلين شعب ثان لا يصير فيه قابلية للجميع"
    },
    { "start": 785.28, "end": 786.24, "text": "و بلين يقول" },
    {
      "start": 786.24,
      "end": 794.24,
      "text": "اللي هو: يقولنا ان انت واعد شخص و انه\nمتأخر و هكذا يعني اذا بده"
    },
    {
      "start": 794.24,
      "end": 799.24,
      "text": "هذا النقطة تشوفوها من المقبع السابق حتى\nعشان تشوفون الاكزامبل"
    },
    {
      "start": 799.24,
      "end": 805.407,
      "text": "و عندكم المتاشن قال لكم: rules may\nsometimes produce less good in specific"
    },
    { "start": 805.407, "end": 806.24, "text": "edge cases" },
    {
      "start": 806.24,
      "end": 814.378,
      "text": "يعني احنا البشر كل يوم قاعدين نسوي شي جديد\nفما نقدر يعني نخطط لكل تغيير لكل exception"
    },
    { "start": 814.378, "end": 815.24, "text": "ما يعرفته" },
    {
      "start": 815.24,
      "end": 822.016,
      "text": "فهو أصلاً قد يقول لكم إنه ما فيه إكسبشن\nفتخيل أنت كنت في موقف صعب و أنت سويت هذا"
    },
    {
      "start": 822.016,
      "end": 824.98,
      "text": "الشيء لعدة أسباب وكان أسبابك منطقية"
    },
    {
      "start": 824.98,
      "end": 832.45,
      "text": "بس الرول تتبع القانون مهما كان الكيس فهذا\nهو يقول لكم إنه بروس لس جود ان سبيسيك أجد"
    },
    {
      "start": 832.45,
      "end": 835.78,
      "text": "كيس لأنه ما فيه روم يعني إنه ديسكريشن"
    },
    {
      "start": 835.78,
      "end": 839.04,
      "text": "بلن يقول لكم requires agreement on which\nrules to follow"
    },
    { "start": 839.04, "end": 841.86, "text": "يعني لازم احنا نتفق كجماعة" },
    {
      "start": 841.86,
      "end": 843.66,
      "text": "اوكي بنتبع هذا القانون وهذا القانون"
    },
    {
      "start": 843.66,
      "end": 845.66,
      "text": "بس رموما ما تتبعين هذا القانون وهذا\nالقانون"
    },
    { "start": 845.66, "end": 847.02, "text": "طبعا نحن خلنا نقارن" },
    { "start": 847.02, "end": 849.0, "text": "خلنا نقارن بين الاكت versus رو" },
    {
      "start": 849.0,
      "end": 850.72,
      "text": "هذا مرة مهم انكم تقدرون تفرقون بينهم"
    },
    { "start": 850.72, "end": 851.52, "text": "اول شيء" },
    { "start": 851.52, "end": 855.46, "text": "يعني كيف انا اقيس الموقف" },
    { "start": 855.46, "end": 858.56, "text": "الاكت يقول لك كل موقف الحالة" },
    { "start": 858.56, "end": 860.22, "text": "بس الرول يقول لك" },
    { "start": 860.22, "end": 862.42, "text": "الرول اللي behind the act" },
    { "start": 862.42, "end": 865.12, "text": "يعني القانون اللي ورا الفعل" },
    { "start": 865.12, "end": 868.8, "text": "المؤكد يقول لك" },
    { "start": 868.8, "end": 870.46, "text": "هل هذا الشيء" },
    { "start": 870.46, "end": 872.36, "text": "لاحظوا كلمة" },
    { "start": 872.36, "end": 874.5, "text": "هل هذا الشيء" },
    { "start": 874.5, "end": 875.68, "text": "الموقف الفعل" },
    { "start": 875.68, "end": 878.44, "text": "ينتج أفأكثر شيء كويس" },
    { "start": 878.44, "end": 879.24, "text": "the most good" },
    { "start": 879.24, "end": 881.16, "text": "عكسة" },
    { "start": 881.16, "end": 882.04, "text": "الرول" },
    { "start": 882.04, "end": 885.48, "text": "لاحظوا كلمة الرول" },
    { "start": 885.48, "end": 886.16, "text": "bold" },
    { "start": 886.16, "end": 888.8, "text": "produce the most good" },
    { "start": 888.8, "end": 890.38, "text": "هل القانون هذا يعني ينتج" },
    { "start": 890.38, "end": 891.26, "text": "مثلا حين" },
    { "start": 891.26, "end": 893.12, "text": "إذا ضبحت شخص" },
    { "start": 893.12, "end": 894.5, "text": "الحكم قصاص" },
    { "start": 894.5, "end": 897.08, "text": "هل هذا القانون زين ولا لا" },
    { "start": 897.08, "end": 899.24, "text": "الأغلب يقول أكيد زين" },
    {
      "start": 899.24,
      "end": 901.7,
      "text": "لأن ذا القاتل دائما قتل مرة وحدة"
    },
    {
      "start": 901.7,
      "end": 905.08,
      "text": "ما عنده مانع يروح يقتل مرة ثالثة ورابعة\nوخامسة"
    },
    {
      "start": 905.08,
      "end": 908.08,
      "text": "خانك كل يعني إذا كان زي جيفري دامور مثلا\nعرفتو"
    },
    { "start": 908.08, "end": 908.96, "text": "برين قال لكم هنا" },
    { "start": 908.96, "end": 909.98, "text": "promise scenario" },
    {
      "start": 909.98,
      "end": 912.84,
      "text": "break it if it gives one more unit of good"
    },
    { "start": 912.84, "end": 913.82, "text": "اللي هو الأكت" },
    {
      "start": 913.82,
      "end": 917.64,
      "text": "دائما هو أنت قاعد تكسب زيادة في good في\nالموضوع"
    },
    { "start": 917.64, "end": 919.08, "text": "عادي يكسر الوعد" },
    { "start": 919.08, "end": 921.58, "text": "بس إذا كان والله الرول" },
    { "start": 921.58, "end": 923.88, "text": "لا يقول لك احتفظ بالpromise" },
    {
      "start": 923.88,
      "end": 930.36,
      "text": "لا تقعد لا تكسر الوعد عشان والله يعني أنت\nبتكسب هذا الشيء حاليا"
    },
    {
      "start": 930.36,
      "end": 938.2,
      "text": "الناس أصلا بيصرون إذا كسرت الوعد ما يصدقون\nفيه"
    },
    { "start": 938.2, "end": 940.16, "text": "ما يؤمنون أنك أنت صادق" },
    { "start": 940.16, "end": 942.28, "text": "فعشان كيطة long term بيضر" },
    {
      "start": 942.28,
      "end": 944.02,
      "text": "يعني المدى البعيد مرة بيكون ضرر"
    },
    {
      "start": 944.02,
      "end": 946.96,
      "text": "فما يمديك أصلا تطوله universalization"
    },
    { "start": 946.96, "end": 949.06, "text": "بنعندكم حين أخر شي يعني" },
    { "start": 949.06, "end": 950.54, "text": "البايس ريسك والإيزفيوس" },
    { "start": 950.54, "end": 951.6, "text": "البايس ريسك والشو" },
    { "start": 951.6, "end": 953.28, "text": "يقولك هاير للأكت" },
    { "start": 953.28, "end": 954.62, "text": "لأن على حسب" },
    { "start": 954.62, "end": 957.52, "text": "أنا اللي أحكم" },
    { "start": 957.52, "end": 958.98, "text": "وأقرر في النهاية" },
    {
      "start": 958.98,
      "end": 961.84,
      "text": "فأنا ممكن أحط مشاعري وراي بالموضوع"
    },
    { "start": 961.84, "end": 965.34, "text": "وبرين طبعا القانون" },
    { "start": 965.34, "end": 967.94, "text": "لأنه يسأل هل هذا الشيء" },
    { "start": 967.94, "end": 969.28, "text": "أوكي للجميع" },
    { "start": 969.28, "end": 970.36, "text": "للجميع" },
    { "start": 970.36, "end": 971.36, "text": "مو بس أنا" },
    { "start": 971.36, "end": 972.52, "text": "لا للجميع" },
    { "start": 972.52, "end": 975.5, "text": "طبعا الأكت أصعب" },
    {
      "start": 975.5,
      "end": 978.36,
      "text": "لأنك كل مرة لازم تقعد تسوي حساباتك"
    },
    { "start": 978.36, "end": 979.5, "text": "وتشوف وتقيس" },
    { "start": 979.5, "end": 982.14, "text": "مو بيعني كذا بسهلات" },
    {
      "start": 982.14,
      "end": 988.92,
      "text": "عكس الرول. الرول أسهل. ليش؟ لأنه خاص هذا\nالقانون ثابت أنت بس وظيفتك أنك تتبعه"
    },
    {
      "start": 988.92,
      "end": 993.72,
      "text": "والحين طبعا نقول لكم الـ common confusion\nبين الروليوتزم vs. الكانتنزم"
    },
    { "start": 993.72, "end": 995.86, "text": "لأنه بينهم متشابه مرة" },
    {
      "start": 995.86,
      "end": 1000.38,
      "text": "بس ليش؟ ليش كلهم متابعون يعني القوانين"
    },
    {
      "start": 1000.38,
      "end": 1005.63,
      "text": "قال لكم روليوتيريزم and كانتنزم both use\nrules but they arrive at them very"
    },
    { "start": 1005.63, "end": 1006.4, "text": "differently" },
    { "start": 1006.4, "end": 1014.94, "text": "يعني لاحظة كلمة adoption" },
    { "start": 1014.94, "end": 1017.88, "text": "يعني إذا أنا طبقت هذا الشي" },
    { "start": 1017.88, "end": 1020.84, "text": "خلاص مو بأنه أردي مأسس مطبق" },
    {
      "start": 1020.84,
      "end": 1023.26,
      "text": "لا إذا أنا طبقته على الجميع عالميا"
    },
    { "start": 1023.26, "end": 1026.34, "text": "بيكون ينتج نتيجة كويسة" },
    { "start": 1026.34, "end": 1028.06, "text": "لأكثر عدد الناس صح" },
    {
      "start": 1028.06,
      "end": 1031.08,
      "text": "زي مثلا لو وحين صارت كل الدول"
    },
    {
      "start": 1031.08,
      "end": 1034.28,
      "text": "مثلا صاروا يعني يتبعون دين الإسلامي"
    },
    {
      "start": 1034.28,
      "end": 1040.72,
      "text": "هذا بيكون اكثر شيء انه ينتج السعادة صح\nوالفوكس عبارة عن العقابات"
    },
    {
      "start": 1040.72,
      "end": 1044.1,
      "text": "كانتنزم واللكانتن يقول لكم انه"
    },
    {
      "start": 1044.1,
      "end": 1048.7,
      "text": "follows a rule because it aligns with the\ncategorical imperative"
    },
    {
      "start": 1048.7,
      "end": 1054.0,
      "text": "اللي هو لا تستخدمون الناس يعني عشان يجبون\nالنتيجة"
    },
    {
      "start": 1054.0,
      "end": 1060.66,
      "text": "استخدمون الناس يعني بطريقة ما تستغلونهم\nوترفعونهم معاكم"
    },
    { "start": 1060.66, "end": 1067.66, "text": "ويقول لكم التركيز" },
    {
      "start": 1067.66,
      "end": 1072.66,
      "text": "هنا كانت هنا يقول لك أنا يهمني نية"
    },
    {
      "start": 1072.66,
      "end": 1075.66,
      "text": "أنا يهمني السبب إن شخص قاعد يسوي"
    },
    {
      "start": 1075.66,
      "end": 1078.66,
      "text": "اليوتوريون يقول لك أنا بس يهمني الإعقاب"
    },
    {
      "start": 1078.66,
      "end": 1083.66,
      "text": "رغم إن كلهم قاعد يفكرون عن القوانين"
    },
    {
      "start": 1083.66,
      "end": 1088.66,
      "text": "بس آخر شي بكرر وبعيد عشان صدق مرة تستوعبون\nمعي"
    },
    { "start": 1088.66, "end": 1090.66, "text": "كاتيكورغل إمبراتفز" },
    {
      "start": 1090.66,
      "end": 1092.66,
      "text": "هذا فيه زي ما قلنا ترى قانونين"
    },
    {
      "start": 1092.66,
      "end": 1094.66,
      "text": "أول واحد إنه هل هذا القانون يقدر يكون"
    },
    { "start": 1094.66, "end": 1096.66, "text": "Universalized" },
    {
      "start": 1096.66,
      "end": 1098.66,
      "text": "والقانون الثاني إنه لا تستخدمون"
    },
    { "start": 1098.66, "end": 1100.66, "text": "تستخدمون الناس" },
    {
      "start": 1100.66,
      "end": 1102.66,
      "text": "هذا ما فيه لقانون واحد في الـ Rule"
    },
    { "start": 1102.66, "end": 1104.66, "text": "اللي هو هل إذا كان" },
    { "start": 1104.66, "end": 1106.66, "text": "سويته adaptation لكل العالم" },
    { "start": 1106.66, "end": 1108.66, "text": "بيسبب نتيجة كويسة؟" },
    { "start": 1108.66, "end": 1110.66, "text": "أوكي ويركز على إيش" },
    { "start": 1110.66, "end": 1112.66, "text": "العقابات هذا ترى أكثر شيء" },
    {
      "start": 1112.66,
      "end": 1114.66,
      "text": "إذا بس ركستوا على هذول الثنتين"
    },
    {
      "start": 1114.66,
      "end": 1116.66,
      "text": "خلاص أنتم عرفتوا إنه وش الفرق بينهم"
    },
    { "start": 1116.66, "end": 1118.66, "text": "طبعا كيف تذكرون هذا الشيء؟" },
    { "start": 1118.66, "end": 1119.66, "text": "قال لكم هنا" },
    { "start": 1125.94, "end": 1127.3, "text": "لماذا لا يعانيت هذا" },
    { "start": 1127.3, "end": 1131.14, "text": "أنا الآن في اليوثلترين" },
    { "start": 1131.14, "end": 1132.22, "text": "أنا يهمني العقاب" },
    {
      "start": 1132.22,
      "end": 1135.34,
      "text": "فأنا يهمني وين بيكون عقب الموقف"
    },
    { "start": 1135.34, "end": 1137.14, "text": "بس الكانت يسأل" },
    { "start": 1137.14, "end": 1138.7, "text": "ليش هذا الفلان سوى" },
    { "start": 1138.7, "end": 1141.02, "text": "ليش لأنه يفكر بالنية" },
    { "start": 1141.02, "end": 1142.14, "text": "الانتنشن" },
    {
      "start": 1142.14,
      "end": 1144.94,
      "text": "فهو يبغى يعرف ليش قاعدا تتوين هذا الشي"
    },
    { "start": 1144.94, "end": 1147.26, "text": "طبعاً الآن عندكم هذا الشي" },
    { "start": 1147.26, "end": 1149.96, "text": "أبيكم صدق تتحاولون مع نفسكم" },
    { "start": 1149.96, "end": 1150.46, "text": "أضغطوه" },
    { "start": 1150.46, "end": 1152.16, "text": "وبتشوفون الجواب" },
    {
      "start": 1152.16,
      "end": 1154.66,
      "text": "أبيكم تعرفون أن تختبرون نفسكم"
    },
    { "start": 1154.66, "end": 1155.4, "text": "بشكل عام" },
    { "start": 1155.4, "end": 1156.32, "text": "أنه أوكي" },
    { "start": 1156.32, "end": 1157.64, "text": "وشوفوا مين سوى هذا الشي" },
    { "start": 1157.64, "end": 1158.38, "text": "أقول تنك" },
    { "start": 1158.38, "end": 1159.02, "text": "أطلع لي" },
    { "start": 1159.02, "end": 1160.12, "text": "وأتأكد أنه عن جوابي" },
    { "start": 1160.12, "end": 1161.28, "text": "والبك بكتور" },
    { "start": 1161.28, "end": 1161.78, "text": "والشو" },
    { "start": 1161.78, "end": 1162.68, "text": "الحين قال لكم" },
    { "start": 1162.68, "end": 1163.64, "text": "identify the action" },
    { "start": 1163.64, "end": 1165.2, "text": "إنه وشو الأشي" },
    { "start": 1165.2, "end": 1166.88, "text": "اللي حين إحنا نقدره" },
    { "start": 1166.88, "end": 1167.74, "text": "considering" },
    { "start": 1167.74, "end": 1169.18, "text": "إنه بنسوي" },
    { "start": 1169.18, "end": 1170.14, "text": "برنسب 2" },
    { "start": 1170.14, "end": 1171.48, "text": "مين اللي بتأثر" },
    { "start": 1171.48, "end": 1173.66, "text": "أعطني list stakeholders" },
    { "start": 1173.66, "end": 1174.56, "text": "مين اللي بتأثر" },
    { "start": 1174.56, "end": 1175.6, "text": "وبعدين" },
    { "start": 1175.6, "end": 1181.16, "text": "أنا أرى الضرر مع الفائدة" },
    {
      "start": 1181.16,
      "end": 1184.8,
      "text": "وأرى هل الفائدة أكثر من الضرر لأكثر عدد\nالناس"
    },
    { "start": 1184.8, "end": 1187.78, "text": "هو يسمح للضرر لعدد شوي" },
    {
      "start": 1187.78,
      "end": 1191.66,
      "text": "إذا كان عدد السعادة والنتيجة الكويسة أعلى\nبكثير"
    },
    { "start": 1191.66, "end": 1193.64, "text": "والأكثر ناس ممكن" },
    {
      "start": 1193.64,
      "end": 1203.06,
      "text": "قرروا أنتم هل تحسون أن هنا الحالة كويس أني\nأطبق عليه قانون"
    },
    {
      "start": 1203.06,
      "end": 1206.32,
      "text": "او اني ايجاج على الفعل الحالة"
    },
    { "start": 1206.32, "end": 1208.06, "text": "و بعدنا اخر شيء" },
    { "start": 1208.06, "end": 1209.18, "text": "المورال فردكت" },
    { "start": 1209.18, "end": 1211.98, "text": "هل هو مورالي right" },
    { "start": 1211.98, "end": 1213.8, "text": "و هل هو مورالي wrong" },
    { "start": 1213.8, "end": 1216.6, "text": "هل الخسارة اكثر" },
    { "start": 1216.6, "end": 1217.94, "text": "او الربح اكثر" },
    { "start": 1217.94, "end": 1218.48, "text": "عرفتو" },
    { "start": 1218.48, "end": 1220.34, "text": "اماما هذا الحين عندكم سكشن" },
    { "start": 1220.34, "end": 1221.38, "text": "ال past practice exam" },
    { "start": 1221.38, "end": 1222.66, "text": "ابيكم انتم تحلونا" },
    {
      "start": 1222.66,
      "end": 1225.12,
      "text": "لان الصدق فعلا جاي من اختبار سابق"
    },
    { "start": 1225.12, "end": 1226.46, "text": "فتدربوا عليه" },
    { "start": 1226.46, "end": 1227.74, "text": "ومكتوب بعد من جاء" },
    { "start": 1227.74, "end": 1229.36, "text": "هو هذا major exam MCQ" },
    { "start": 1229.36, "end": 1231.32, "text": "هذا additional MCQ" },
    { "start": 1231.32, "end": 1232.16, "text": "عرفتو" },
    {
      "start": 1232.16,
      "end": 1236.8,
      "text": "وهنا الـ practice questions اللي أنا\nأعطيتكم وواكم برضو تحلونها"
    },
    {
      "start": 1236.8,
      "end": 1240.1,
      "text": "هذا جبتها من عندي بس إنها مرة مرة مفيدة"
    },
    {
      "start": 1240.1,
      "end": 1244.54,
      "text": "شكراً لإستماعكم وإذا عندكم أي استفسار\nتواصلوا معي على الواتس"
    }
  ]
}
