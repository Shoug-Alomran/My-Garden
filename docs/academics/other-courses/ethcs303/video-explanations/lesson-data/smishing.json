    { "time": 0, "title": "What is smishing?" },
    { "time": 58.6, "title": "Fear and greed" },
    { "time": 93.56, "title": "How numbers are obtained" },
    { "time": 140.84, "title": "Messages, calls and links" },
    { "time": 184.12, "title": "Prize scam example" },
    { "time": 240.84, "title": "Mobile banking and convincing messages" },
    { "time": 295.48, "title": "Simulated attacks and training" }
  ],
  "transcript": [
    {
      "start": 0.0,
      "end": 2.28,
      "text": "السلام عليكم. اليوم نكمل عن سميشنج."
    },
    { "start": 2.28, "end": 3.28, "text": "ما هو سميشنج؟" },
    {
      "start": 3.28,
      "end": 6.6,
      "text": "هو عبارة عن الفون تكس اللي هو الاسمس."
    },
    { "start": 6.6, "end": 9.44, "text": "يعني تخيلوا الحين البنك حقكم." },
    {
      "start": 9.44,
      "end": 13.44,
      "text": "صح هو يجيكم اسمس كلما رحت ودفعته وسوتوا\nشي."
    },
    {
      "start": 13.44,
      "end": 17.08,
      "text": "تخيلوا يجيكم رسالة بس شخص مسوي نفس انه هو\nبنككم."
    },
    {
      "start": 17.08,
      "end": 22.84,
      "text": "ويرسل انه اوه ترى يقفر حسابكم خلال الاسمس\nوتروحوا نصدقون و تتوين اللي هو يبيه."
    },
    {
      "start": 22.84,
      "end": 25.44,
      "text": "هو اذا بدنا يلعب عليكم خلال الاسمس."
    },
    { "start": 25.44, "end": 27.12, "text": "هو وش قال لكم؟" },
    {
      "start": 27.12,
      "end": 31.404,
      "text": "\"to lure victims into immediate actions\nsuch as downloading mobile wire, visiting"
    },
    {
      "start": 31.404,
      "end": 35.16,
      "text": "a malicious website, or claiming or\ncalling a fraudulent phone number.\""
    },
    {
      "start": 35.16,
      "end": 39.383,
      "text": "قال لكم هنا \"smeishing messages are\nusually crafted to elicit an immediate"
    },
    { "start": 39.383, "end": 39.84, "text": "action.\"" },
    { "start": 39.84, "end": 41.68, "text": "هذا ترى مرة مرة مهم." },
    {
      "start": 41.68,
      "end": 46.36,
      "text": "خلونا نسوي لكم هايلايت \"immediate action\"\nيعني هو الدزاين حقها"
    },
    {
      "start": 46.36,
      "end": 49.6,
      "text": "انه يخليكم تروحون على طول تحتون ردة فعل."
    },
    {
      "start": 49.6,
      "end": 53.56,
      "text": "ما يعطيكم مجال انكم توقفون و تفكرون عن\nالقرار اللي كانت تخذونه."
    },
    {
      "start": 53.56,
      "end": 57.582,
      "text": "\"from the target requiring them to hand\nover personally identifying information"
    },
    { "start": 57.582, "end": 58.6, "text": "and account details." },
    {
      "start": 58.6,
      "end": 63.198,
      "text": "they will often do this by using fear or\ngreed based on terminologies that"
    },
    { "start": 63.198, "end": 65.0, "text": "impending account suspension," },
    {
      "start": 65.0,
      "end": 70.24,
      "text": "fraudulent account activity detected, or\noffering some type of award or discount.\""
    },
    {
      "start": 70.24,
      "end": 75.64,
      "text": "يعني تخيلوا انتم لو جاكم الحين صدق رسالة\nمن البنك انه ترى في احد"
    },
    {
      "start": 75.64,
      "end": 78.88,
      "text": "عملية احتيال قاعدة تصير و مدري ايش."
    },
    {
      "start": 78.88,
      "end": 84.03999999999999,
      "text": "بتخافون صح ما انتم يعني مجالسين تفكرون عن\nاتخاذ القرار صح."
    },
    {
      "start": 84.03999999999999,
      "end": 86.28,
      "text": "على وطول بتعتون ردة فعل."
    },
    {
      "start": 86.28,
      "end": 90.32,
      "text": "بس هذا ترى تصرف غلط مفروض تكلمون البنك و\nيعني."
    },
    { "start": 90.32, "end": 93.56, "text": "بس يستثقون بالاسمس الرسالة." },
    {
      "start": 93.56,
      "end": 97.8,
      "text": "و قال لكم هنا \"Cyber criminals will either\nobtain a phone number from the dark web\"."
    },
    {
      "start": 97.8,
      "end": 101.96000000000001,
      "text": "يعني انتم احيانا اذا سجلتوا في موقع يصير\nشيء اسمه."
    },
    { "start": 101.96000000000001, "end": 104.28, "text": "اه ماليش لنكتبه." },
    { "start": 104.28, "end": 106.52000000000001, "text": "\"Data leak\"." },
    {
      "start": 106.52000000000001,
      "end": 113.75999999999999,
      "text": "هذا اللي يصير والله الشركة ما امنت يعني\nمرة كويس و طلعت الفضائح حقتهم."
    },
    {
      "start": 113.75999999999999,
      "end": 120.56,
      "text": "او ان راحوهم باعوا معلوماتك على ال dark\nweb على السوق الاسود."
    },
    {
      "start": 120.56,
      "end": 124.0,
      "text": "من حيث ان الناس يقدرون يشترونه و يلعبون\nعليكم."
    },
    {
      "start": 124.0,
      "end": 129.0,
      "text": "او احيانا حتى من الفون بوك ترى يعني كده\nحضونا احيانا رقام عشوائية."
    },
    { "start": 129.0, "end": 130.2, "text": "هذا ترى option ثاني." },
    {
      "start": 130.2,
      "end": 133.8,
      "text": "بس هنا قالوا لكم \"number from dark web\"\nولا يعني كده."
    },
    {
      "start": 133.8,
      "end": 137.827,
      "text": "\"Following the data breach through the web\ncrawlers, checking social media posts or"
    },
    { "start": 137.827, "end": 139.04, "text": "even through random\" هنا." },
    {
      "start": 139.04,
      "end": 140.84,
      "text": "هذا هو \"random number generators\"."
    },
    {
      "start": 140.84,
      "end": 145.52,
      "text": "\"They'll send out the text message asking\nusers to call a number or click on a link\""
    },
    {
      "start": 145.52,
      "end": 148.6,
      "text": "\"The message scammers send often involve\nbank accounts\""
    },
    {
      "start": 148.6,
      "end": 152.974,
      "text": "\"and in some cases may even contain most\nor all of our potential victims' credit"
    },
    {
      "start": 152.974,
      "end": 154.56,
      "text": "card or bank account numbers\""
    },
    {
      "start": 154.56,
      "end": 160.68,
      "text": "يعني اذا بدأ ان في معنوات حين تسربت او\nبالحظ طاحت عليك"
    },
    {
      "start": 160.68,
      "end": 167.511,
      "text": "يدقونا يعني يرسلونك SMS من حيث انه يعني\nيقولك او تعال تواصل معانا على الرقم الجوار"
    },
    { "start": 167.511, "end": 168.76, "text": "هذا واللينك هذا" },
    {
      "start": 168.76,
      "end": 171.72,
      "text": "لانه اكثر شيء يساعد ان الواحد يصدق."
    },
    {
      "start": 171.72,
      "end": 176.44,
      "text": "ونكمل هنا قال لكم \"smishing tactics by\noffering some type of price\""
    },
    { "start": 176.44, "end": 178.76, "text": "هنا سواء على شكل واتتاب" },
    {
      "start": 178.76,
      "end": 182.12,
      "text": "ليس بس يعني الاسم اس اللي على الجوالنا"
    },
    { "start": 182.12, "end": 184.12, "text": "شوفوا او شيء رقم غريب" },
    {
      "start": 184.12,
      "end": 189.56,
      "text": "ثاني شيء قال لكم انه فزتوا 200 الف من ريال\nمن لولو هايبر ماركت"
    },
    {
      "start": 189.56,
      "end": 193.92,
      "text": "يعني اصلا فكروا ليش هنا بيعطوني ان لولو\nهايبر ماركت هم في سعودية"
    },
    { "start": 193.92, "end": 195.52, "text": "فليش رقم مبسعودي" },
    { "start": 195.52, "end": 196.8, "text": "صاح هذا اول شيء" },
    {
      "start": 196.8,
      "end": 199.2,
      "text": "ثاني شيء ليش بيعطوني انا 200 الف ريال"
    },
    {
      "start": 199.2,
      "end": 203.2,
      "text": "بس انا اوه حماس صاح فلا يلا فزت يلا خلني\nااخده"
    },
    {
      "start": 203.2,
      "end": 205.28,
      "text": "وبنين قال لكم هنا تواصل مع هذا الرقم"
    },
    { "start": 205.28, "end": 207.68, "text": "فشفتوا كيف هنا الخلل" },
    { "start": 207.68, "end": 208.48, "text": "طبعا يقول لكم هنا" },
    {
      "start": 208.48,
      "end": 215.88,
      "text": "لاحظوا بعد ان اختاروا لولو هايبر ماركت"
    },
    {
      "start": 215.88,
      "end": 220.72,
      "text": "يعني كلنا نعرف عن لولو ونستخدمها وقدر\nاحناها يعني at some point"
    },
    {
      "start": 220.72,
      "end": 223.54,
      "text": "ما يقالوا شركة ما نعرفها لا عارفين"
    },
    {
      "start": 223.54,
      "end": 226.34,
      "text": "وبعدين عندكم الحين اكزامبل ثاني"
    },
    {
      "start": 226.34,
      "end": 229.7,
      "text": "لاحظوا الايميل يعني اسبالين حق غريب"
    },
    { "start": 229.7, "end": 231.72, "text": "قال لكم هنا وصفارجو ابديت" },
    { "start": 231.72, "end": 233.68, "text": "واللينك هذا يعني غريب" },
    { "start": 233.68, "end": 234.94, "text": "لشي بيك سوين لوج ان" },
    { "start": 234.94, "end": 236.96, "text": "ولاش يقول لك اكاونت سسبند" },
    { "start": 236.96, "end": 238.18, "text": "هذا هو يقول لكم" },
    {
      "start": 238.18,
      "end": 240.84,
      "text": "جوزي the factors that many more and more\nusers"
    },
    {
      "start": 240.84,
      "end": 243.64,
      "text": "are conducting banking transactions\nthrough smart phones"
    },
    { "start": 243.64, "end": 244.52, "text": "يعني زي الحين صارق في" },
    { "start": 244.52, "end": 246.16, "text": "apple pay صاح" },
    { "start": 246.16, "end": 247.56, "text": "فصارق على الجوال" },
    { "start": 247.56, "end": 248.64, "text": "فيقول لكم هنا" },
    {
      "start": 248.64,
      "end": 250.4,
      "text": "banking transactions through the smart\nphones"
    },
    {
      "start": 250.4,
      "end": 253.4,
      "text": "many smishing messages claimed to be from\nthe financial institution"
    },
    { "start": 253.4, "end": 256.32, "text": "صارحنا يعني جينا رسالة البنكية" },
    {
      "start": 256.32,
      "end": 258.28,
      "text": "اني قول ترى انت شرت كذا شرت كذا"
    },
    { "start": 258.28, "end": 258.84, "text": "هذا الحساب" },
    { "start": 258.84, "end": 260.3, "text": "هذا التاريخ هذا الوقت" },
    { "start": 260.3, "end": 262.2, "text": "فهذا هو يقول لكم هنا" },
    {
      "start": 262.2,
      "end": 264.58,
      "text": "many users won't think twice before acting"
    },
    {
      "start": 264.58,
      "end": 266.32,
      "text": "when they receive messages from their bank"
    },
    { "start": 266.32, "end": 268.32, "text": "بس طبعا هم مو بصدق من بينكم" },
    { "start": 268.32, "end": 269.88, "text": "بس اني يحسبون انه من بينكم" },
    {
      "start": 269.88,
      "end": 273.0,
      "text": "فطبيعي ان الشخص على الطول بيتفاعل مع\nالرسالة"
    },
    { "start": 273.0, "end": 273.68, "text": "قال لكم هنا" },
    {
      "start": 273.68,
      "end": 276.2,
      "text": "attackers will use legitimate sounding\nverbiage"
    },
    {
      "start": 276.2,
      "end": 278.2,
      "text": "and even some branding to assist their\npretext"
    },
    { "start": 278.2, "end": 279.76, "text": "يعني احيانا ممكن يحطون" },
    { "start": 279.76, "end": 281.88, "text": "logo البنك" },
    { "start": 281.88, "end": 283.08, "text": "او يستخدموا نفس الطريقة" },
    { "start": 283.08, "end": 284.36, "text": "اسلوبهم كلامهم" },
    { "start": 284.36, "end": 285.72, "text": "هذا مرة يساعد" },
    { "start": 285.72, "end": 287.68, "text": "انه ينلعب عليك" },
    { "start": 287.68, "end": 289.52, "text": "وطبعا كيف نحنا نحمي نفسنا من" },
    { "start": 289.52, "end": 290.15999999999997, "text": "smishing" },
    {
      "start": 290.15999999999997,
      "end": 291.68,
      "text": "اول شي قال لكم هنا"
    },
    { "start": 291.68, "end": 293.92, "text": "the best way to educate users" },
    { "start": 293.92, "end": 295.48, "text": "يعني انك تتعلم الناس" },
    {
      "start": 295.48,
      "end": 297.48,
      "text": "سوى conducting simulated attacks"
    },
    { "start": 297.48, "end": 299.32, "text": "يعني تروح كشركة" },
    {
      "start": 299.32,
      "end": 302.12,
      "text": "تسوي يعني اختبارات من باب التعوية"
    },
    {
      "start": 302.12,
      "end": 304.2,
      "text": "as part of your security awareness"
    },
    { "start": 304.2, "end": 305.12, "text": "يعني انك تور الناس" },
    { "start": 305.12, "end": 305.64, "text": "انه شوفوا" },
    { "start": 305.64, "end": 307.48, "text": "ترى يمكن يجيكم كذا كذا كذا" },
    { "start": 307.48, "end": 309.16, "text": "و training programs" },
    { "start": 309.16, "end": 309.96, "text": "هذا option ثاني" },
    { "start": 309.96, "end": 311.24, "text": "انه يصير يعني يروحون" },
    { "start": 311.24, "end": 311.92, "text": "ضيط وايك" },
    { "start": 311.92, "end": 315.88, "text": "ويعلمهم عن كل الاشياء" },
    { "start": 315.88, "end": 317.6, "text": "اللي ممكن تصير لهم كذا كذا كذا" },
    {
      "start": 317.6,
      "end": 325.0,
      "text": "يعني كيف يعني مفرود يتعاملوا مع هذا الشيء"
    },
    { "start": 325.0, "end": 326.0, "text": "وش مفرود ردون" },
    {
      "start": 326.0,
      "end": 328.14,
      "text": "وكيف يعني يتعاملوا معه بشكل عام"
    },
    { "start": 328.14, "end": 329.1, "text": "برضو قال لكم" },
    {
      "start": 329.1,
      "end": 331.84,
      "text": "stimulated attacks can lead to educational\npages"
    },
    {
      "start": 331.84,
      "end": 334.65999999999997,
      "text": "that allow the moment an employee behaves\nbadly"
    },
    {
      "start": 334.65999999999997,
      "end": 335.62,
      "text": "to be teachable moment"
    },
    {
      "start": 335.62,
      "end": 337.84000000000003,
      "text": "مثلا الحين اقول لكم عن المثال"
    },
    { "start": 337.84000000000003, "end": 340.28, "text": "اعرف شخص الحين" },
    { "start": 340.28, "end": 341.58, "text": "قال لهم الشركة" },
    { "start": 341.58, "end": 342.62, "text": "stc solutions" },
    { "start": 342.62, "end": 343.52, "text": "قالوا شوفوا" },
    { "start": 343.52, "end": 345.32, "text": "سووا هذا التدريب" },
    { "start": 345.32, "end": 347.1, "text": "السايبر مثلا" },
    { "start": 347.1, "end": 348.86, "text": "واللي ما يسوي" },
    { "start": 348.86, "end": 350.72, "text": "ترى الجهازة بيصير suspended" },
    { "start": 350.72, "end": 351.92, "text": "لمدة الله اعلم" },
    { "start": 351.92, "end": 353.34000000000003, "text": "وبرضو قالوا" },
    { "start": 353.34000000000003, "end": 354.56, "text": "سووا يعني سابقا" },
    {
      "start": 354.56,
      "end": 356.65999999999997,
      "text": "ان حطوا دعايات واشياء"
    },
    { "start": 356.65999999999997, "end": 358.06, "text": "وشافوا كل الناس" },
    { "start": 358.06, "end": 360.5, "text": "اللي والله ضغطوا على اللينك" },
    { "start": 360.5, "end": 361.62, "text": "واللي ما تعاملوا بطريقة" },
    { "start": 361.62, "end": 362.82, "text": "اللي مفرود تعاملوا فيها" },
    { "start": 362.82, "end": 366.4, "text": "مباشرة يجيهم يعني المدير رسالة" },
    {
      "start": 366.4,
      "end": 368.8,
      "text": "ويروحون يسوون training مرة ثانية"
    },
    { "start": 368.8, "end": 370.04, "text": "عشان يعني يتعلمون" },
    { "start": 370.04, "end": 371.92, "text": "وان يعني يصير teaching moment" },
    {
      "start": 371.92,
      "end": 374.12,
      "text": "وان شاء الله بنكمل عند impersonation"
    },
    { "start": 374.12, "end": 375.04, "text": "بالمقطع الجاي" }
  ]
}
