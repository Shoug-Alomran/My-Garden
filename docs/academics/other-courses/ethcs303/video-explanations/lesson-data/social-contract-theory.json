{"id":"social-contract-theory","title":"Social Contract Theory","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/social-contract-mp4.mp4","page":"/academics/other-courses/ethcs303/video-explanations/social-contract-theory/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/social-contract-theory.vtt","chapters":[{"time":0,"title":"Hobbes and social contracts"},{"time":60.6,"title":"Life without a social contract"},{"time":140.4,"title":"How the social contract arises"},{"time":182.04,"title":"Traffic-light example"},{"time":275,"title":"Implicit agreement"},{"time":439.64,"title":"Negative and positive rights"},{"time":575.46,"title":"Rawls and principles of justice"},{"time":921.94,"title":"Confidentiality and rights"},{"time":1030.2,"title":"Conflicting rights"},{"time":1287.02,"title":"The hypothetical contract"}],"transcript":[{"start":0.0,"end":0.86,"text":"السلام عليكم"},{"start":0.86,"end":1.78,"text":"اليوم نبدأ"},{"start":1.78,"end":3.16,"text":"social contract theory"},{"start":3.16,"end":5.36,"text":"وشو طبعا الماستمينامكس"},{"start":5.36,"end":8.24,"text":"اللي هو HRRC"},{"start":8.24,"end":11.42,"text":"Hobbes, Wright, Rawls, Community Rules"},{"start":11.42,"end":14.06,"text":"هو عبارة عن المجتمع"},{"start":14.06,"end":15.32,"text":"و عن القوانين المجتمع"},{"start":15.32,"end":17.74,"text":"من أصلا كلمة social contract theory"},{"start":17.74,"end":19.26,"text":"خلونا نبدأ"},{"start":19.26,"end":19.86,"text":"سكشن 1"},{"start":19.86,"end":21.02,"text":"قال لكم the problem"},{"start":21.02,"end":22.32,"text":"Life without rules"},{"start":22.32,"end":25.1,"text":"هذا Thomas Hobbes"},{"start":25.1,"end":26.4,"text":"هو المأسس هذا الشيء"},{"start":26.4,"end":27.56,"text":"هو اللي قادي يتكلم عنه"},{"start":27.56,"end":29.74,"text":"قال لكم without rules and enforcement"},{"start":29.74,"end":42.16,"text":"عيش معناتها؟ معناتها الحين أنتوا فكروا\nفيها بشكل منطق"},{"start":42.16,"end":49.42,"text":"هل بتهتمون للناس إذا ما كان في قوانين تحمي\nالناس وتحمي نفسك؟"},{"start":49.42,"end":53.92,"text":"لا بتصير أنت مرة خايف على أغراضك وعلى\nعيشتك"},{"start":53.92,"end":58.56,"text":"وبتصير تفكر أن كيف تأخذ اللي أنت بي وكيف\nتحمي اللي معاك"},{"start":58.56,"end":60.6,"text":"قال لكم هنا"},{"start":60.6,"end":62.76,"text":"Hobbes identified the fundamental problem"},{"start":62.76,"end":64.72,"text":"Without a social contract"},{"start":64.72,"end":66.64,"text":"There is no initiative to cooperate"},{"start":66.64,"end":68.26,"text":"Create or trust anyone"},{"start":68.26,"end":70.58,"text":"This is called the state of nature"},{"start":70.58,"end":72.03999999999999,"text":"احفظوا هذا الشي"},{"start":72.03999999999999,"end":72.88,"text":"وشو state of nature"},{"start":72.88,"end":75.53999999999999,"text":"انه يصير بدون قانون"},{"start":75.53999999999999,"end":77.46000000000001,"text":"أو عقد للمجتمع"},{"start":77.46000000000001,"end":79.28,"text":"انه ما في سبب"},{"start":79.28,"end":81.24,"text":"وما في شيء يغري الناس"},{"start":81.24,"end":82.46000000000001,"text":"يسمعون الكلام"},{"start":82.46000000000001,"end":84.5,"text":"أو يثقون الناس الاخرين"},{"start":84.5,"end":85.66,"text":"قال لكم طبعا هنا"},{"start":85.66,"end":86.42,"text":"state of nature"},{"start":86.42,"end":87.82,"text":"no rule exists"},{"start":87.82,"end":100.78,"text":"يعني لاحظوا قالوا الناس المنطقيين"},{"start":100.78,"end":106.78,"text":"مو بالناس اللي يعني من زمن سابق وما يبغون\nوما عندهم منطق"},{"start":106.78,"end":107.25999999999999,"text":"لا"},{"start":107.25999999999999,"end":107.97999999999999,"text":"قالكم هنا"},{"start":107.97999999999999,"end":115.08,"text":"أنا الحين بعطيكم شوي من حريتي"},{"start":115.08,"end":121.14,"text":"لأنه شيء إذا كان فيه قوانين معاناة أني أنا\nقد أخسر شيء"},{"start":121.14,"end":126.84,"text":"أنا فيه شيء ممكن قد يمنعوني من أن أتخذ\nالقرار أني أسويه"},{"start":126.84,"end":129.34,"text":"فهذا الآن قد أخسر من حريتي"},{"start":129.34,"end":137.14,"text":"بس عادي دائما أنا قد يجيني يعني protection\nوorder خاص فيه نظام وفيه يعني أمان"},{"start":137.14,"end":139.0,"text":"خلاص عادي ما عندي مشكلة أخسر شوي"},{"start":139.0,"end":140.4,"text":"فلن قال لكم هنا"},{"start":140.4,"end":142.22,"text":"The social contract is born"},{"start":142.22,"end":143.06,"text":"هنا أولت"},{"start":143.06,"end":143.72,"text":"قال لكم"},{"start":143.72,"end":147.38,"text":"Moral rules and government enforcement\nbecome possible"},{"start":147.38,"end":148.38,"text":"يصير يعني"},{"start":148.38,"end":151.48,"text":"المoral rules اللي حنا حطناها لنفسنا"},{"start":151.48,"end":153.57999999999998,"text":"أو حطاها المجتمع"},{"start":153.57999999999998,"end":156.0,"text":"يقدر حتى ويصير فيه بعد"},{"start":156.0,"end":157.14,"text":"حكومة معاها"},{"start":157.14,"end":159.76,"text":"إن تخليهم يسمعون هذا الشي"},{"start":159.76,"end":161.06,"text":"يغسمن عليهم"},{"start":161.06,"end":162.06,"text":"يطبقونا"},{"start":162.06,"end":162.88,"text":"Enforcement"},{"start":162.88,"end":164.64,"text":"بناء آخر شي"},{"start":164.64,"end":166.54,"text":"No one is above the rules"},{"start":166.54,"end":167.32,"text":"يعني"},{"start":167.32,"end":168.54,"text":"مهما أنس"},{"start":168.54,"end":170.48,"text":"لو الليدر"},{"start":170.48,"end":172.32,"text":"ولا السيتسن ولا اللي هو"},{"start":172.32,"end":174.64,"text":"كلكم القوانين تطبق"},{"start":174.64,"end":176.48,"text":"على الجميع"},{"start":176.48,"end":177.56,"text":"قال لكم ماري هوك"},{"start":177.56,"end":179.06,"text":"traffic light analogy"},{"start":179.06,"end":182.04,"text":"no traffic lights means chaos"},{"start":182.04,"end":184.82,"text":"تخيل أنتوا بالحين في تقاطع ذاك أبو أربعة"},{"start":184.82,"end":186.58,"text":"وكل واحد"},{"start":186.58,"end":188.46,"text":"يبغى يلف تخيل ما فيه إشارة"},{"start":188.46,"end":190.56,"text":"على أي أساس مين بيعرف"},{"start":190.56,"end":192.2,"text":"مين أول مين عقوب"},{"start":192.2,"end":193.34,"text":"مين يعني عرفته"},{"start":193.34,"end":195.88,"text":"traffic lights are the social contract"},{"start":195.88,"end":208.6,"text":"أنت تقوم بإمكانكم بإمكانكم بإمكانكم تطعون\nالإشارة"},{"start":208.6,"end":210.38,"text":"لأنها كأنك موقع عقد"},{"start":210.38,"end":215.04,"text":"وهذا أحسن عشان صحة وأمالة الجميع"},{"start":215.04,"end":220.24,"text":"لأن أفرض أن تقطعت الإشارة الحمرة وصدمت\nسيارة وصار حادث كبير"},{"start":220.24,"end":222.7,"text":"هذا بيضر أكثر عدد الناس صح"},{"start":222.7,"end":228.06,"text":"يقول لكم هنا"},{"start":228.06,"end":237.34,"text":"يعني الزبدة"},{"start":237.34,"end":240.48,"text":"انت اذا تبغت تعيش بهذا الديرة بهذا البلد"},{"start":240.48,"end":243.44,"text":"انت اجباري انك تتبه قوانينهم"},{"start":243.44,"end":245.16,"text":"يعني انا نحين لو رحت السعودية"},{"start":245.16,"end":247.16,"text":"لو انا امريكية و جيت السعودية"},{"start":247.16,"end":248.98,"text":"لازم اتبع قوانين السعودية"},{"start":248.98,"end":250.6,"text":"عشان امشي معاهم"},{"start":250.6,"end":253.3,"text":"لو ما اسمعت كلامي بروح بطلع بيطلعوني"},{"start":253.3,"end":256.84,"text":"او عالعكس اذا رحت مثلا انا المانيا لازم\nاتبع قوانينهم"},{"start":256.84,"end":260.54,"text":"مهما كان القوانين يعني تحسون انها غير\nمنطقية"},{"start":260.54,"end":262.4,"text":"زي مثلا الفرنسا"},{"start":262.4,"end":266.18,"text":"في بعض الكوفيات اذا كنتي منقبة يطلعوني"},{"start":266.18,"end":269.1,"text":"يقولونك لا احنا قانوننا انك ما تصير منقبة"},{"start":269.1,"end":272.32,"text":"هذا عد قانونهم وبرضو لازم نسير يعني نحتنمه"},{"start":272.32,"end":274.2,"text":"رغم انه غبي بس شكوا"},{"start":274.2,"end":275.0,"text":"قال لكم هنا بعد"},{"start":275.0,"end":279.577,"text":"the contract is implicit by living in\nsocial society and benefiting from its"},{"start":279.577,"end":280.42,"text":"protection you"},{"start":280.42,"end":287.32,"text":"agree to follow its rules implicit يعني ما\nحد قال لك لا تقطع الإشارة بس أنت عارف"},{"start":287.32,"end":292.48,"text":"implicitly عارف دون ما حد يقول لك ان لا\nهذا الشيء ممنوع عملا مبني على"},{"start":292.48,"end":296.96,"text":"mutual agreement يعني الجميع موافق على هذا\nالشيء everyone follows rule in"},{"start":296.96,"end":301.52,"text":"exchange for organized safe society عندكم\nالنقطة ثانية community"},{"start":301.52,"end":305.52,"text":"تقريباً: \"الجميع يقوم بحقاته و يجب أن يجب\nأن يقوم بهم\""},{"start":331.52,"end":334.34000000000003,"text":"ملكك وخصوصيتك"},{"start":334.34000000000003,"end":336.06,"text":"وحريتك"},{"start":336.06,"end":337.02,"text":"بلين عندكم"},{"start":337.02,"end":340.02,"text":"طبعا فيه فوائد"},{"start":340.02,"end":341.72,"text":"وفيه أشياء تاخذ منك"},{"start":341.72,"end":344.24,"text":"نحن الناس اللي يسوون القوانين"},{"start":344.24,"end":345.54,"text":"ويخلونه نطبقها مثلا"},{"start":345.54,"end":347.74,"text":"اللي جاب طاري الإشارات"},{"start":347.74,"end":349.52,"text":"وإنه خاص إذا قطعت الإشارة"},{"start":349.52,"end":351.76,"text":"مناخذ منك أربع علاق ريال صح"},{"start":351.76,"end":353.56,"text":"ومن اللي لازم"},{"start":353.56,"end":355.44,"text":"نحن ندفع لذولي رواتب"},{"start":355.44,"end":356.92,"text":"ولازم يعني نظم"},{"start":356.92,"end":358.9,"text":"الحكومة"},{"start":358.9,"end":360.5,"text":"لازم ندعمها وعرفته"},{"start":360.5,"end":365.0,"text":"فقال لكم هنا security and order comes with\ntaxes, laws and duties"},{"start":365.0,"end":371.26,"text":"taxes اللي هو الضرائب لازم يعني عشان إذا\nأنتم تبغون ناس يساعدكم ويديركم"},{"start":371.26,"end":378.28,"text":"يأسسون لكم أشياء لازم ضرائب ولازم قوانين\nولازم أن يكون أنا عندي واجبات"},{"start":378.28,"end":381.24,"text":"قال لكم هنا key difference من الكانتنزم"},{"start":381.24,"end":387.06,"text":"كانتنزم يقول لكم أن القانون يكون صح إذا\nكان universal"},{"start":387.06,"end":389.4,"text":"إذا كان يعني مدينة نسوي universal"},{"start":389.4,"end":390.34,"text":"بس يقولكم هنا"},{"start":390.34,"end":392.54,"text":"society contract theory"},{"start":392.54,"end":398.67,"text":"ان الright rules are what rational people\nwould collectively accept for community"},{"start":398.67,"end":399.2,"text":"benefit"},{"start":399.2,"end":401.3,"text":"مثلا انتم حين بنك"},{"start":401.3,"end":403.02,"text":"عندكم المجلس التنفيذي"},{"start":403.02,"end":405.04,"text":"دول يقعدون يجلسون"},{"start":405.04,"end":407.24,"text":"ويخططون ويفكرون عن وشوا"},{"start":407.24,"end":409.1,"text":"الاشياء اللي بتفيد"},{"start":409.1,"end":410.98,"text":"اغلب المجتمع"},{"start":410.98,"end":413.14,"text":"يستخدمون بنكهم صح"},{"start":413.14,"end":415.34000000000003,"text":"فهو نفس الشي بس بشكل كبير"},{"start":415.34000000000003,"end":416.68,"text":"يعني بشكل ديرة كاملة"},{"start":416.68,"end":418.62,"text":"ولاحظوا قالوا rational people"},{"start":418.62,"end":426.002,"text":"ما يجبون الناس عندهم يعني افكار قديمة او\nتقاليد قديمة او يعني ان شي ممكن يضر"},{"start":426.002,"end":433.869,"text":"المجتمع لانهم irrational لا هم rational\nيعني يقدرون يقولون لكم انا تفكيري ليش كذا"},{"start":433.869,"end":436.88,"text":"كذا كذا كذا او سير تفكيره منطقي"},{"start":436.88,"end":438.92,"text":"سكشن 3"},{"start":438.92,"end":439.64,"text":"اللي هو قال لكم"},{"start":439.64,"end":440.44,"text":"kinds of rights"},{"start":440.44,"end":442.34,"text":"ينقشوا الأنواع الحقوق"},{"start":442.34,"end":443.56,"text":"اللي أنتملكها"},{"start":443.56,"end":448.68,"text":"اول شيء negative right"},{"start":448.68,"end":449.34,"text":"اللي هو"},{"start":449.34,"end":451.48,"text":"بعد عني"},{"start":451.48,"end":453.64,"text":"لا تجد ذا تقرب"},{"start":453.64,"end":454.65999999999997,"text":"خلاص هذا negative"},{"start":454.65999999999997,"end":456.84000000000003,"text":"لأيش لني أريك تباعد"},{"start":456.84000000000003,"end":460.08,"text":"a right others guarantee by not\ninterfering with you"},{"start":460.08,"end":461.18,"text":"مثلا الان"},{"start":461.18,"end":463.24,"text":"free speech, religion, and privacy"},{"start":463.24,"end":465.26,"text":"أنا ما أدخل"},{"start":465.26,"end":466.46,"text":"بخصوصيتك"},{"start":466.46,"end":467.92,"text":"ما أتدخل بدينك"},{"start":467.92,"end":470.64,"text":"ما أتدخل بالكلام اللي أنت تقوله"},{"start":470.64,"end":471.26,"text":"من الحين"},{"start":471.26,"end":472.34000000000003,"text":"الـ Positive Right"},{"start":472.34000000000003,"end":474.88,"text":"الأشياء اللي أنت قاعد تسوي لنا"},{"start":474.88,"end":477.12,"text":"مثلا الحين الحكومة وش قاعد تسوي لنا"},{"start":477.12,"end":480.22,"text":"قاعد طبعا تعطينا دراسة مجانية"},{"start":480.22,"end":481.82,"text":"الصحة"},{"start":481.82,"end":482.56,"text":"الـ Health Care"},{"start":482.56,"end":484.18,"text":"يعني حين لو رحتوا أي مستشفى"},{"start":484.18,"end":486.74,"text":"حتجتوا يعني علاج شيء"},{"start":486.74,"end":487.86,"text":"حتى لو ما عندكم"},{"start":487.86,"end":491.56,"text":"الحكومة بتتكفر عليكم"},{"start":491.56,"end":492.6,"text":"بتدفع علاجكم"},{"start":492.6,"end":494.64,"text":"و Legal Representation"},{"start":494.64,"end":498.94,"text":"إذا ما كان عندكم فلوس كافي أنكم تجيبون\nمحامي"},{"start":498.94,"end":500.96,"text":"يصير الحكومة تجيب لكم محامي"},{"start":500.96,"end":506.52,"text":"A right that requires others or society to\nactively provide something"},{"start":506.52,"end":508.48,"text":"يعني أنا المجتمع positive"},{"start":508.48,"end":509.76,"text":"قاعد تعطيني شيء"},{"start":509.76,"end":510.58,"text":"فpositive"},{"start":510.58,"end":513.16,"text":"وأنكم ما تعطوني شيء negative"},{"start":513.16,"end":514.4,"text":"من أن قالكم هنا"},{"start":514.4,"end":516.2,"text":"N. Nothing needed"},{"start":516.2,"end":517.88,"text":"P. Provide something"},{"start":517.88,"end":519.24,"text":"هذا طريقة أنكم تحفظونا"},{"start":519.24,"end":523.44,"text":"Negative right يساوي أن society does\nnothing except not block you"},{"start":523.44,"end":525.62,"text":"أنا موب موقفتك"},{"start":525.62,"end":527.24,"text":"أبد سوي اللي ودك"},{"start":527.24,"end":529.52,"text":"positive لا أن هذا شيء لازم"},{"start":529.52,"end":530.94,"text":"society يقدمه لي"},{"start":530.94,"end":532.4,"text":"طبعا قال لكم the features"},{"start":532.4,"end":535.18,"text":"action required طبعا negative لا ما يحتاج"},{"start":535.18,"end":537.04,"text":"لأننا قلنا أنه أنت ما قاعد تعطيني شيء"},{"start":537.04,"end":539.4,"text":"أنت بس قاعد تحترم أني أبغى سوي هذا الشيء"},{"start":539.4,"end":540.08,"text":"وقاعد أسويه"},{"start":540.08,"end":542.22,"text":"positive لا لازم active support"},{"start":542.22,"end":545.54,"text":"والburden أنه يعني هل هذا الشيء"},{"start":545.54,"end":547.38,"text":"بيعيقني"},{"start":547.38,"end":548.94,"text":"يقولك passive restraint"},{"start":548.94,"end":551.28,"text":"يعني passive يعني تراها"},{"start":551.28,"end":552.4,"text":"أنتبه لحدودك"},{"start":552.4,"end":555.12,"text":"بس إننا حنا قاعدين نعطيك المجال"},{"start":555.12,"end":570.22,"text":"هذا هو السكتشن الثالث"},{"start":570.22,"end":573.5,"text":"اللي أنواع الحقوق اللي أنت لك حق عليها"},{"start":573.5,"end":575.46,"text":"بعدين عندكم سكتشن فور"},{"start":575.46,"end":578.48,"text":"اللي هو جون رولز and the principle of\njustice"},{"start":578.48,"end":580.76,"text":"قالكم رولز هذا الجون"},{"start":580.76,"end":583.22,"text":"سأل وش القانون"},{"start":583.22,"end":584.64,"text":"اللي راشنال بيبل"},{"start":584.64,"end":586.62,"text":"لاحظوا كلمة راشنال بيبل قاعد تتكرر"},{"start":586.62,"end":587.96,"text":"بيختارونها"},{"start":587.96,"end":588.74,"text":"لو"},{"start":588.74,"end":592.38,"text":"يعني أنا الحين"},{"start":592.38,"end":594.06,"text":"ممكن وزيرة صح"},{"start":594.06,"end":596.36,"text":"أنا لو ما كنت أدري أني وزيرة"},{"start":596.36,"end":598.96,"text":"هل بختار أني أنفذ هذا القانون"},{"start":598.96,"end":600.48,"text":"ولا أني قد نفذه"},{"start":600.48,"end":602.74,"text":"بس عشاني أنا وزيرة وبيفيدني أنا"},{"start":602.74,"end":604.68,"text":"عرفتوا لازم هم كده"},{"start":604.68,"end":606.44,"text":"يقيسون أن راشنال بيبل"},{"start":606.44,"end":609.02,"text":"هل رغم أنا وش منصبي"},{"start":609.02,"end":611.52,"text":"بختار نفس القانون ولا لا"},{"start":611.52,"end":612.42,"text":"قال لكم"},{"start":612.42,"end":615.58,"text