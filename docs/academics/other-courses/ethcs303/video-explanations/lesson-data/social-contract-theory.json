6.24,"end":957.06,"text":"بنعندكم حين"},{"start":957.06,"end":958.44,"text":"الكلكتوف اكشن"},{"start":958.44,"end":962.28,"text":"قال لك الحين اذا كان كل الناس"},{"start":962.28,"end":964.8,"text":"يعني في يستخدمون"},{"start":964.8,"end":966.36,"text":"الباصات والمترو"},{"start":966.36,"end":967.98,"text":"بس يومين بالاسبوع"},{"start":967.98,"end":970.7,"text":"الفترة اللي كان والله"},{"start":970.7,"end":972.18,"text":"البترول مرة نازل"},{"start":972.18,"end":974.98,"text":"و يعني باقي شفية وخلص كان ما صار"},{"start":974.98,"end":976.26,"text":"ليش لانه الحين"},{"start":976.26,"end":981.58,"text":"كلنا كمجتمع اتفقنا اننا يومين من الاسبوع\nبنستخدم المترو أو الباص"},{"start":981.58,"end":983.52,"text":"فاننا يصير بساعد"},{"start":983.52,"end":985.76,"text":"فقالكم مينا اول شيء الواحد"},{"start":985.76,"end":993.68,"text":"يعني احيانا صعب ترى جدا انكم تقنعون شخص\nانه يتخلى من سيارته"},{"start":993.68,"end":996.42,"text":"او طريقة اللي هو ينتقل فيه"},{"start":996.42,"end":999.76,"text":"عشان يعني يسمع الكلام ويساعد المجتمع"},{"start":999.76,"end":1000.78,"text":"بس وشوا"},{"start":1000.78,"end":1007.74,"text":"يعني لو أنتم المشكلة اللي كلكم مشتركينها"},{"start":1007.74,"end":1012.42,"text":"إذا كلكم سويتوا نفس الحل"},{"start":1012.42,"end":1016.86,"text":"اللي هو أنكم تروحون تركبون المرتين بالسبوع"},{"start":1016.86,"end":1020.54,"text":"خلاص كلكم حليتوا المشكلة اللي كلكم عندكم"},{"start":1020.54,"end":1021.52,"text":"شفتوا أن"},{"start":1021.52,"end":1030.2,"text":"ليش أن القوانين المجتمع اللي كلنا لازم\nنطبقها تفيد المجتمع"},{"start":1030.2,"end":1035.2,"text":"هنا عندكم حين \"conflicting rights\" الأشياء\nاللي يقعز الضارة مع بعض"},{"start":1035.2,"end":1040.2,"text":"حين متى يصير صعب يقول لكم \"when two\ngenuine rights collide\""},{"start":1040.2,"end":1043.2,"text":"\"one side claims bodily autonomy and\nprivacy\""},{"start":1043.2,"end":1046.2,"text":"\"another slide claims right to life\""},{"start":1046.2,"end":1051.159,"text":"هنا يقول لكم \"social contract theory has\nno automatic mechanism for resolving all"},{"start":1051.159,"end":1052.2,"text":"rights conflicts\""},{"start":1052.2,"end":1055.2,"text":"يعني وش معلت هذا الحين مثال"},{"start":1055.2,"end":1067.06,"text":"انا مثلا احتاج قلب او احتاج كبد او كله انا\nلازم احسن من الناس ما يبغون يتبرعون"},{"start":1067.06,"end":1074.48,"text":"يعني لهم حق ليش لانهم اطانم حقهم والخصوصية\nحقتهم صح بس اني انا ليه حق اني اعيش"},{"start":1074.48,"end":1080.85,"text":"ولان عشان اعيش احتاج كله مثلا ف يعني ما\nيمديكتوا يعني ما في حل علاقة للسوشيال"},{"start":1080.85,"end":1081.76,"text":"كونشاك تيري"},{"start":1081.76,"end":1088.56,"text":"انه يقول ما ما اقدر صراحة اغصب اجبر شخص\nيعطيك كليته ولا اقدر اني اخليك انت تموت"},{"start":1088.56,"end":1090.96,"text":"فهذا هو الكمفلكتينج"},{"start":1090.96,"end":1099.524,"text":"ولاحظوا انه اغلبهم ترى عندهم مشاكل انه\nيعني ما يقدرون يحطون اولوية لشيء او يحلون"},{"start":1099.524,"end":1100.38,"text":"الكمفلكت"},{"start":1100.38,"end":1104.16,"text":"طبعا حين خلنقارن السوشيال كونتراك تيري مع\nالكانتنزم"},{"start":1104.16,"end":1111.36,"text":"الفونديشن الكانتنزم يقول لك انه فيه ريزن\nيعني فيه سبب وفيه دوتي اللي هو الواجب"},{"start":1111.36,"end":1118.44,"text":"social contract لا يقول لك أنا والمجتمع\nكلنا اللي حولي مقتنعين بالقوانين هذه"},{"start":1118.44,"end":1123.84,"text":"وندري أننا كلنا بنسويه فدامنا كلنا بنسويه\nعادي أنا بسويه"},{"start":1123.84,"end":1127.38,"text":"برعندكم rights rule can be universalized\nlogically"},{"start":1127.38,"end":1132.86,"text":"يعني أنا الحين بالاستخدام اللوجيك يمديني\nأخلي كل العالم يطبقون هذا القانون"},{"start":1132.86,"end":1138.0,"text":"هذا كانت النظم بس وشو قال لكم للsocial أن\nwould be collectively accepted"},{"start":1138.0,"end":1142.74,"text":"يعني إذا كان المجسمع اللي حولك يقبرون هذا\nالقانون"},{"start":1142.74,"end":1146.56,"text":"فأوكي مثلاً الحين المسدسات في أمريكا"},{"start":1146.56,"end":1150.54,"text":"لأن المجسمع مرمت مسكين بسلاحاتهم"},{"start":1150.54,"end":1155.16,"text":"ويحسون أن لا إحنا نبي نحمي نفسنا ونلازم\nيسر معانا السلاح"},{"start":1155.16,"end":1157.58,"text":"فهذا صار socially accepted"},{"start":1157.58,"end":1160.76,"text":"وأن القانون صار mutual فصار عادي"},{"start":1160.76,"end":1165.08,"text":"طبعاً الحين هنا في السعودية لا ما يمديك\nتروح السوق والمطاعم"},{"start":1165.08,"end":1166.62,"text":"ومعاك السلاح بجيبك"},{"start":1166.62,"end":1170.62,"text":"فلازم نرى ما الذي هو \"collectively\naccepted\""},{"start":1170.62,"end":1172.62,"text":"ثم نقوم بفكرة"},{"start":1172.62,"end":1174.62,"text":"عن \"Individual duties\""},{"start":1174.62,"end":1176.62,"text":"\"أنا شوك واشواجبي\""},{"start":1176.62,"end":1178.62,"text":"\"الدكتورة فلانية واشواجبها\""},{"start":1178.62,"end":1182.62,"text":"\"الرئيس الجامع واشواجبه\""},{"start":1182.62,"end":1184.62,"text":"\"collective rights\" لل \"social\""},{"start":1184.62,"end":1187.62,"text":"طبعا ليش؟ لأننا نفكر بالمجتمع مجتمع مجتمع"},{"start":1187.62,"end":1189.62,"text":"فطبيعي إنه \"collective rights\""},{"start":1189.62,"end":1197.851,"text":"ولكن اللغة اللي هو الدوتي الامبراتف اللي\nكانت نزم الواجبات والانيداء والسوشال"},{"start":1197.851,"end":1202.34,"text":"كونتراكت انها لا الحقوق العدالة العقد هكذا"},{"start":1202.34,"end":1209.925,"text":"طبعا كيف تقدرون تقارنونه بسطر واحد يقول\nلكم هنا كانت يسأل وش هو السبب وهل هذا الشي"},{"start":1209.925,"end":1213.44,"text":"يقدر يصير له يونيفرزاليزايزايشن ولا لا"},{"start":1213.44,"end":1221.962,"text":"والسوشال كونتراك تيري يسأل هل الناس\nالراشنل بيوافقون هذا الشي عشان كل الناس"},{"start":1221.962,"end":1226.28,"text":"يعني لكل الناس يعني هم يستفيدون ولا لا"},{"start":1226.28,"end":1232.64,"text":"لاحظة قائنا احنا نجيب نطاري ان بغض النظر\nهو المنصب والواح وحال اللي هو فيه"},{"start":1232.64,"end":1240.145,"text":"وبعدين طبعا حين يقول لكم الليش احنا مفروض\nنستخدم السوشال كونتراكت قال لكم رايتس"},{"start":1240.145,"end":1242.9,"text":"لانجوج لان مرة يركز على حقوقك"},{"start":1242.9,"end":1249.9,"text":"\"إني مرة سهل أنكم تستخدمونه بهذا الشيء\nيعني القوانين والباليسي\""},{"start":1249.9,"end":1252.9,"text":"و \"الجواريسي\""},{"start":1252.9,"end":1254.9,"text":"يعني مرة خلاص"},{"start":1254.9,"end":1258.9,"text":"إنه واضح إن الشعب لازم يسمعون كذا كذا كذا"},{"start":1258.9,"end":1261.9,"text":"بس الحكومة لازم بعد يقدمون كذا كذا كذا"},{"start":1261.9,"end":1263.9,"text":"يعني كل واحد يعرف واجبة"},{"start":1263.9,"end":1264.9,"text":"يعرف الابلغيشن حقتها"},{"start":1264.9,"end":1266.9,"text":"بني عندكم \"workable\""},{"start":1266.9,"end":1268.9,"text":"إيه هو فعلا \"workable\""},{"start":1268.9,"end":1270.9,"text":"لأن \"practical for real social decisions\""},{"start":1270.9,"end":1273.7,"text":"اني صدق يمديك تستخدمه بأغلب حالات"},{"start":1273.7,"end":1275.98,"text":"بس وش اللي عنده مشاكل ضده"},{"start":1275.98,"end":1280.12,"text":"طبعا انا قلت لكم انه احنا وقعنا العقد\nبصغير مباشرا"},{"start":1280.12,"end":1282.02,"text":"فصدق حنا نوم ونسايندت"},{"start":1282.02,"end":1285.58,"text":"ما احد قال انه اوقع هذا العقد"},{"start":1285.58,"end":1287.02,"text":"لا فأنت ما وقعت شيك"},{"start":1287.02,"end":1289.72,"text":"بس وش يقول لك ان الـ contract is\nhypothetical"},{"start":1289.72,"end":1294.9,"text":"يعني كل واحد ماشي على المجتمع"},{"start":1294.9,"end":1297.7,"text":"يعني عرفت اللي وسوسون لك انه لا تقطع اشارة"},{"start":1297.7,"end":1299.9,"text":"لا تسرع"},{"start":1299.9,"end":1302.48,"text":"لكن كل اللقوان هاي بتتسكيل عرفته"},{"start":1302.48,"end":1307.6,"text":"زي ما قلنا الحين هنا"},{"start":1307.6,"end":1310.42,"text":"أنت تبغى تعيش بس برضو ما تبغى"},{"start":1310.42,"end":1312.9,"text":"ما أحد يبغى يتبرع عليك أعضاء"},{"start":1312.9,"end":1314.44,"text":"هذا هو يقول لكم هنا"},{"start":1314.44,"end":1319.2,"text":"صعب فيه يصير فيه مشاكب شيئين"},{"start":1319.2,"end":1319.94,"text":"بلنقلكم هنا"},{"start":1319.94,"end":1328.28,"text":"يعني الحين ناس مثلا"},{"start":1328.28,"end":1332.08,"text":"عندهم مشاكل بالتعلم"},{"start":1332.08,"end":1336.16,"text":"ممكن واحد عمره جسديا عمره عشرين"},{"start":1336.16,"end":1338.56,"text":"بس عقله عمره ممكن خمس سنوات"},{"start":1338.56,"end":1341.74,"text":"هو ما يقدر يطبق القوانين هذه"},{"start":1341.74,"end":1344.94,"text":"ما يقدر ما عنده القدرة"},{"start":1344.94,"end":1346.7,"text":"فهو ما يقعد يعني"},{"start":1346.7,"end":1349.08,"text":"أنه ما يقعد يوضح"},{"start":1349.08,"end":1352.3,"text":"أنه وش الحل مع هذول الفئة من الناس"},{"start":1352.3,"end":1354.38,"text":"وزي ما قلت في المقاطعة السابقة"},{"start":1354.38,"end":1355.98,"text":"عندكم هنا الفلاش كارد"},{"start":1355.98,"end":1357.5,"text":"أبيكم أنتم تضغطونا"},{"start":1357.5,"end":1358.68,"text":"وتشوفون الجواب"},{"start":1358.68,"end":1360.08,"text":"وصدق تختبرون نفسكم"},{"start":1360.08,"end":1361.76,"text":"خذوا وقتكم وانتم تحلون"},{"start":1361.76,"end":1363.5,"text":"لان مرموها منكم ترون مستوعبين"},{"start":1363.5,"end":1365.58,"text":"نفس حكاية مع الكويك كويز"},{"start":1365.58,"end":1367.44,"text":"والباست اكزام براكتس"},{"start":1367.44,"end":1369.12,"text":"اذا عندكم اي سفسار"},{"start":1369.12,"end":1370.9,"text":"تواصلوا معاي على الواتس"}]}