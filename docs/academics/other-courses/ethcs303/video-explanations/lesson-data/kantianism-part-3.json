{"id":"kantianism-part-3","title":"Kantianism — Part 3","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/Moral%20Systems%2C%20Ethical%20Concepts%2C%20and%20Theories/Kantianism%20p3.mp4","page":"/academics/other-courses/ethcs303/video-explanations/kantianism-part-3/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/kantianism-part-3.vtt","chapters":[{"time":0,"title":"Arguments for Kantianism"},{"time":57.78,"title":"Is Kantianism workable?"},{"time":105.18,"title":"Moral obligations"},{"time":184.3,"title":"Conflicts between duties"},{"time":222.3,"title":"No exceptions to perfect duties"}],"transcript":[{"start":0.0,"end":0.76,"text":"السلام عليكم"},{"start":0.76,"end":1.76,"text":"اليوم نكمل عند"},{"start":1.76,"end":3.3,"text":"cases for cantonism"},{"start":3.3,"end":4.9,"text":"لاحظوا ان قال لكم"},{"start":4.9,"end":6.8,"text":"هذا theory rational"},{"start":6.8,"end":7.66,"text":"ايش"},{"start":7.66,"end":9.18,"text":"يعني في منطق"},{"start":9.18,"end":10.58,"text":"وليس مشاعر"},{"start":10.58,"end":12.32,"text":"كل عبارة عن المنطق"},{"start":12.32,"end":13.58,"text":"produces universal"},{"start":13.58,"end":15.08,"text":"moral guidelines"},{"start":15.08,"end":15.86,"text":"applied to people"},{"start":15.86,"end":17.32,"text":"for all of history"},{"start":17.32,"end":18.12,"text":"يعني"},{"start":18.12,"end":20.04,"text":"من اي زمن الزمن"},{"start":20.04,"end":22.18,"text":"ولا من اي مكان المكان"},{"start":22.18,"end":23.36,"text":"القوانين"},{"start":23.36,"end":24.08,"text":"نفسها"},{"start":24.08,"end":24.68,"text":"ما تتغيى"},{"start":24.68,"end":25.7,"text":"بنعندكم هذة النقطة"},{"start":25.7,"end":26.12,"text":"يقول لكم"},{"start":26.12,"end":27.26,"text":"treat all persons"},{"start":27.26,"end":28.74,"text":"as moral equals"},{"start":28.74,"end":29.86,"text":"يعني ما في"},{"start":29.86,"end":31.08,"text":"أحد فوق الثاني"},{"start":31.08,"end":33.82,"text":"مثلا خنقول دونالد ترامب"},{"start":33.82,"end":35.94,"text":"دامه هو رئيس صلاح تتوقع"},{"start":35.94,"end":38.08,"text":"أنه ممكن عنده أولويات"},{"start":38.08,"end":39.72,"text":"يصير أولى للدولة"},{"start":39.72,"end":42.12,"text":"أولى أهم من بقية الناس"},{"start":42.12,"end":43.7,"text":"بس بالكانتنزم يقول لا"},{"start":43.7,"end":46.08,"text":"دونالد ترامب زي بقية الشعب"},{"start":46.08,"end":47.24,"text":"ما في أي اختلاف"},{"start":47.24,"end":48.88,"text":"وبعدين يقول لكم هذا"},{"start":48.88,"end":51.16,"text":"ترى workable هذا حين ثاني"},{"start":51.16,"end":52.98,"text":"اللي يعتبر workable"},{"start":52.98,"end":55.82,"text":"عندكم أو شيء دينتالجي اللي خص رب العالمين"},{"start":55.82,"end":57.78,"text":"وبعدين حين الكانتنزم"},{"start":57.78,"end":59.0,"text":"اللي هو workable theory"},{"start":59.0,"end":60.14,"text":"دعونا نكمل"},{"start":60.14,"end":63.74,"text":"قال لكم طبعاً كانتنزم في عندكم الأكت"},{"start":63.74,"end":68.124,"text":"\"so that they can treat both yourself and\nother people as ends in themselves and"},{"start":68.124,"end":69.22,"text":"never only as means\""},{"start":69.22,"end":72.5,"text":"وبنا نقول لكم نوركبال theory because it's\nbased on logic"},{"start":72.5,"end":72.58,"text":"وبنا نقول لكم نوركبال theory because it's\nbased on logic"},{"start":72.58,"end":73.88,"text":"وبنا نقول لكم \"universal guidelines\""},{"start":73.88,"end":78.56,"text":"هذا بس summary للي كل اللي شرحناه فمن\nمتعمقة مرة"},{"start":78.56,"end":82.4,"text":"وبنا عندنا طبعاً الأشياء اللي ضد الكانتنزم"},{"start":82.4,"end":84.0,"text":"أول شي وشو قال لكم"},{"start":84.0,"end":87.0,"text":"\"no single rule adequately characterizes\nan action\""},{"start":87.0,"end":91.06,"text":"يعني ممكن أنت الحين واعد في هذا اللي حين\nبك أشرح لكم هذا الاكزامبل"},{"start":91.06,"end":94.56,"text":"أنتم ممكن واعدين صديقهم بالكوفي أوكي"},{"start":94.56,"end":98.97999999999999,"text":"وأنتم قدتوا مثلا بتوصلون الساعة ثمانية"},{"start":98.97999999999999,"end":101.72,"text":"فأنتم وعدتوهم من الساعة ثمانية"},{"start":101.72,"end":105.18,"text":"بس في الطريق اكتشفتوا أن فيه شخص يحتاج\nمساعدة"},{"start":105.18,"end":109.08,"text":"فيلا هل تبلش أنك عندك moral obligation"},{"start":109.08,"end":111.14,"text":"أنك تساعد هذا الشخص"},{"start":111.14,"end":115.03999999999999,"text":"في نفس الوقت أنت عندك obligation أنك ما\nتكذب على زميلك"},{"start":115.03999999999999,"end":117.08,"text":"فوشو اللي بتسوي"},{"start":117.08,"end":119.0,"text":"هذا هو كانت نظم ما يقدر"},{"start":119.0,"end":120.7,"text":"يعلمك مين اولى"},{"start":120.7,"end":122.62,"text":"ولا مين اللي يستحق"},{"start":122.62,"end":125.04,"text":"يعني تمسك القانون عليها اكثر"},{"start":125.04,"end":125.78,"text":"وبالي عندنا"},{"start":125.78,"end":131.16,"text":"يعني احيانا ان كل الحالات"},{"start":131.16,"end":133.04,"text":"شينة فما يمديك"},{"start":133.04,"end":133.84,"text":"يعني"},{"start":133.84,"end":136.14,"text":"تفرق بينهم مثلا"},{"start":136.14,"end":138.86,"text":"ان وحدة سألتك الفستان حلو علي"},{"start":138.86,"end":140.46,"text":"وهي خلاص شاريتها"},{"start":140.46,"end":141.8,"text":"ما تقدر ترجع"},{"start":141.8,"end":144.14,"text":"الفستان كان مرة غالي"},{"start":144.14,"end":145.5,"text":"يعني خلق نقول كذا عرفتوا"},{"start":145.5,"end":146.96,"text":"ها الفستان حلو"},{"start":146.96,"end":150.18,"text":"لو الكذب طبعا غلط"},{"start":150.18,"end":152.4,"text":"صح؟ فمفروض ما أكذب"},{"start":152.4,"end":154.52,"text":"بس برضو أدلني لو قلت الصدق"},{"start":154.52,"end":156.0,"text":"مرة بتزعل"},{"start":156.0,"end":158.1,"text":"وبيضيق صدرها"},{"start":158.1,"end":159.88,"text":"وبيخرب يومها"},{"start":159.88,"end":161.38,"text":"وبتزعل يعني مرة مرة"},{"start":161.38,"end":163.1,"text":"فيسبب أذى كثير صح؟"},{"start":163.1,"end":164.94,"text":"في الله حين قد أقول لكم أن الكمفلكس"},{"start":164.94,"end":167.24,"text":"ما يمديك تحل بين المشاكل"},{"start":167.24,"end":169.76,"text":"أنك تحترم الشخص وما تكسر مشاعره"},{"start":169.76,"end":171.14,"text":"وأنك تقول الصدق"},{"start":171.14,"end":172.3,"text":"ما في حل وسط"},{"start":172.3,"end":174.3,"text":"وبدأ عندنا الحين طبعا زيادة"},{"start":174.3,"end":176.3,"text":"sometimes there's no way to resolve\nconflicts"},{"start":176.3,"end":178.3,"text":"يعني هذة النزمة قلت لكم ليش"},{"start":178.3,"end":180.3,"text":"بس راحطوا في بالكم هذة النقطة"},{"start":180.3,"end":182.3,"text":"في يعني ها ها كأنه"},{"start":182.3,"end":184.3,"text":"في طريقة قال لكم انه"},{"start":184.3,"end":186.3,"text":"conflict between perfect duty"},{"start":186.3,"end":188.3,"text":"وال imperfect duty"},{"start":188.3,"end":190.3,"text":"ترى ال perfect duty دائما يفوز"},{"start":190.3,"end":192.3,"text":"بس خنقول اذا حطيتوا perfect"},{"start":192.3,"end":194.3,"text":"مع perfect"},{"start":194.3,"end":196.3,"text":"ما في solution"},{"start":196.3,"end":198.3,"text":"فagain remember"},{"start":198.3,"end":200.3,"text":"هنا بحط لكم يا highlight"},{"start":200.3,"end":202.3,"text":"النقطة لازم اميزها لكم"},{"start":202.3,"end":204.3,"text":"اذا قال لكم هنا perfect duty"},{"start":204.3,"end":206.3,"text":"و اذا قال لكم imperfect duty"},{"start":206.3,"end":208.3,"text":"ال perfect طبعا دائما فوز"},{"start":208.3,"end":210.3,"text":"بس اذا كان too perfect"},{"start":210.3,"end":212.3,"text":"ما في حل"},{"start":212.3,"end":214.3,"text":"هذا لازم تعرفونا بشكل"},{"start":214.3,"end":216.3,"text":"يعني تصمونا"},{"start":216.3,"end":218.3,"text":"و بننطبع زيادة اخر"},{"start":218.3,"end":220.3,"text":"او اي اخر نقطة"},{"start":220.3,"end":222.3,"text":"بنعندكم حين اخر نقطة يقول لكم"},{"start":222.3,"end":224.3,"text":"cantonism allows no exception to perfect\nduties"},{"start":224.3,"end":226.3,"text":"هذا المثال مرة حلو"},{"start":226.3,"end":228.3,"text":"فخلونا اشرح لكم اياه"},{"start":228.3,"end":230.66,"text":"انا قاعدة تخبى من قاتل"},{"start":230.66,"end":232.22,"text":"اوكي ولا يعني انا"},{"start":232.22,"end":233.98,"text":"دخلت احد في بيتي"},{"start":233.98,"end":236.5,"text":"قالوا بليز انقذوني ان في احد"},{"start":236.5,"end":238.24,"text":"يحاول يذبحني فانا جيت"},{"start":238.24,"end":239.66,"text":"خبيتها جوابيتي صح"},{"start":239.66,"end":241.92,"text":"جاهل القاتل طق على البابي"},{"start":241.92,"end":244.8,"text":"قال لي هل شفتي فلان"},{"start":244.8,"end":246.44,"text":"انا الحين"},{"start":246.44,"end":248.58,"text":"كانت النظام يقول لي ممنوع تكذبين"},{"start":248.58,"end":249.84,"text":"بس برضو"},{"start":249.84,"end":252.46,"text":"حط لي قانون يقول لي انه ممنوع"},{"start":252.46,"end":254.44,"text":"اسوي شيء يأدي الى وفاة"},{"start":254.44,"end":256.54,"text":"انسان فيالله اسوي"},{"start":256.54,"end":262.38,"text":"هذا الشيء والأسوي هذا الشيء كلهم perfect\nduties ووش أسوي ما في حل"},{"start":262.38,"end":268.24,"text":"وبدأ لدينا حين آخر سلايد يقول لك أنه\ndespite يعني كل العيوب اللي كانت نزم"},{"start":268.24,"end":274.861,"text":"هو ما زال يعتبر a workable theory وبس\nوالله هذا المقطع الأخير لل ethical"},{"start":274.861,"end":276.24,"text":"theories part 1"},{"start":276.24,"end":281.851,"text":"إن شاء الله بنكمل عند ethical theories\npart 2 في أنه هو الدرس الثاني في مقطع"},{"start":281.851,"end":282.22,"text":"الجاي"},{"start":282.22,"end":287.4,"text":"إذا عندكم أي استفسار أو مشكلة بالشابتر\nتواصلوا معاي على الواتس"}]}