  ],
  "transcript": [
    { "start": 0.0, "end": 1.46, "text": "اليوم بنتكلم عن" },
    { "start": 1.46, "end": 3.28, "text": "privacy in cyberspace" },
    { "start": 3.28, "end": 5.52, "text": "اول شي ابيكم تتذكرونه" },
    { "start": 5.52, "end": 6.44, "text": "والشو اللي هو" },
    { "start": 6.44, "end": 6.98, "text": "4 ways" },
    { "start": 6.98, "end": 8.08, "text": "الcyber technology" },
    { "start": 8.08, "end": 8.78, "text": "غير" },
    { "start": 8.78, "end": 10.06, "text": "ال privacy" },
    { "start": 10.06, "end": 10.64, "text": "الخصوصية" },
    { "start": 10.64, "end": 12.56, "text": "طبعا احنا هذا السؤال" },
    { "start": 12.56, "end": 14.4, "text": "اكثر شي ممكن يعني ينسأله عليه" },
    { "start": 14.4, "end": 16.12, "text": "فلازم مارا نحفظه" },
    { "start": 16.12, "end": 17.74, "text": "ASDK" },
    { "start": 17.74, "end": 18.44, "text": "وش معناتها" },
    { "start": 18.44, "end": 19.9, "text": "معنات الاماونت" },
    { "start": 19.9, "end": 21.5, "text": "كمية المعلومات" },
    { "start": 21.5, "end": 22.24, "text": "اللي الحين" },
    { "start": 22.24, "end": 23.28, "text": "سارت تقدر يعني" },
    { "start": 23.28, "end": 24.5, "text": "توصل لها" },
    { "start": 24.5, "end": 26.36, "text": "اكثر بكثير" },
    { "start": 26.36, "end": 27.04, "text": "من سابقا" },
    { "start": 27.04, "end": 28.2, "text": "سابقا كان وشو" },
    { "start": 28.2, "end": 28.88, "text": "كل معلوماتك" },
    { "start": 28.88, "end": 30.2, "text": "على جهازك الخاص" },
    { "start": 30.2, "end": 31.94, "text": "أو كأوراق" },
    { "start": 31.94, "end": 34.68, "text": "وصعب أن أحد يروح يصرق معلوماتك" },
    {
      "start": 34.68,
      "end": 37.8,
      "text": "لأنه شو لازم يصير يتخلون جهازك نفسه"
    },
    { "start": 37.8, "end": 40.22, "text": "ولا يتخلون بيتك" },
    { "start": 40.22, "end": 41.02, "text": "يشوفون مكتبك" },
    { "start": 41.02, "end": 41.98, "text": "يشوفون أوراقك صح" },
    { "start": 41.98, "end": 42.74, "text": "الحين لا" },
    { "start": 42.74, "end": 44.82, "text": "الحين صار معلوماتك مخزن أصلا" },
    { "start": 44.82, "end": 47.18, "text": "في مكان وكميات" },
    { "start": 47.18, "end": 49.34, "text": "amount of personal information" },
    { "start": 49.34, "end": 51.44, "text": "مخزن في مكان ما تعرف وين" },
    { "start": 51.44, "end": 52.82, "text": "فهذا هو قال لكم" },
    {
      "start": 52.82,
      "end": 55.24,
      "text": "amount more personal data can be collected"
    },
    {
      "start": 55.24,
      "end": 58.2,
      "text": "than ever before digested tiny storage"
    },
    {
      "start": 58.2,
      "end": 62.1,
      "text": "لأن الآن أصلاً مساحتنا في الأجهزة صارت\nقليلة"
    },
    {
      "start": 62.1,
      "end": 65.82,
      "text": "فصرنا مرار نعتمد على السيبر سبيس اللي هو\nالكلاود"
    },
    {
      "start": 65.82,
      "end": 68.84,
      "text": "بالنهاء بنتكلم أصلاً عنه بدرس كامل حالة"
    },
    { "start": 68.84, "end": 70.22, "text": "وعندكم النقطة الثانية" },
    {
      "start": 70.22,
      "end": 74.30799999999999,
      "text": "speed records transferred between\ndatabases in milliseconds via wireless or"
    },
    { "start": 74.30799999999999, "end": 74.58, "text": "cable" },
    {
      "start": 74.58,
      "end": 78.66,
      "text": "يعني إحنا الآن لو كنا مثلاً نبغى نرسل file"
    },
    {
      "start": 78.66,
      "end": 83.52,
      "text": "كان لازم نرسله بإيميل أو يعني نرسله فعلياً\nبالميل"
    },
    { "start": 83.52, "end": 87.06, "text": "ونقعد نطول وياخذ ساعات صح؟" },
    { "start": 87.06, "end": 89.38, "text": "مثلا الحين شخص يبغي يرسل مقطع" },
    { "start": 89.38, "end": 90.44, "text": "50 جيجا بايت" },
    { "start": 90.44, "end": 93.62, "text": "قبل كان صاحب جدا" },
    { "start": 93.62, "end": 95.12, "text": "كان يقض ساعات" },
    { "start": 95.12, "end": 97.22, "text": "مثلا النت بطيء" },
    { "start": 97.22, "end": 98.88, "text": "والملف ثقيل" },
    { "start": 98.88, "end": 101.68, "text": "بس الحين سبحان الله صار بثواني" },
    {
      "start": 101.68,
      "end": 103.75999999999999,
      "text": "ليش؟ لأن كل شي على الكلاود"
    },
    { "start": 103.75999999999999, "end": 105.4, "text": "بدنا عندكم دوريشن" },
    { "start": 105.4, "end": 107.0, "text": "سابقا يعني الحين" },
    { "start": 107.0, "end": 109.0, "text": "كان والله إذا ما تلبتوبك" },
    {
      "start": 109.0,
      "end": 109.97999999999999,
      "text": "ما تلبتوبك معلوماتك"
    },
    { "start": 109.97999999999999, "end": 112.36, "text": "يعني يصير التخزين" },
    { "start": 112.36, "end": 114.42, "text": "ما يسمح أنك تخزن كميات" },
    { "start": 114.42, "end": 115.44, "text": "فتكت تحذفة" },
    { "start": 115.44, "end": 117.28, "text": "ما يعيش للأبد الزبدة" },
    { "start": 117.28, "end": 118.88, "text": "حتى الأوراق الحبر" },
    { "start": 118.88, "end": 121.38, "text": "مع الوقت يقل ويروح" },
    { "start": 121.38, "end": 122.44, "text": "هذا هو" },
    { "start": 122.44, "end": 122.94, "text": "دوريشن" },
    { "start": 122.94, "end": 129.74, "text": "يعني ما في تاريخ انتهاء" },
    { "start": 129.74, "end": 131.04, "text": "هذا واحد من الأشياء" },
    { "start": 131.04, "end": 133.46, "text": "اللي تغيرت بالسايبر سبيس" },
    { "start": 133.46, "end": 134.78, "text": "وبنعندكم النوع" },
    { "start": 134.78, "end": 143.72, "text": "يعني كل فضايحك صدق طالعا" },
    {
      "start": 143.72,
      "end": 149.52,
      "text": "يعني الناس يمكنون يعرفون وين رايحت وش\nعاداتك وش طبعك مرة"
    },
    {
      "start": 149.52,
      "end": 154.1,
      "text": "وبعدنا طبعا قال لكم وش هو الخصوصية هذا اهم\nشيء يعني لازم نغطيه"
    },
    { "start": 154.1, "end": 156.3, "text": "الخصوصية بالشكل العامية يعني" },
    {
      "start": 156.3,
      "end": 159.76,
      "text": "The right to be let alone or freedom from\ninterference or intrusion"
    },
    {
      "start": 159.76,
      "end": 166.3,
      "text": "يعني الحق أو الحقوق حقتك اللي تخلي الناس\nيتركونك بالحالك"
    },
    { "start": 166.3, "end": 169.22, "text": "أو ما يمنعونهم من يدخلون فيك" },
    { "start": 169.22, "end": 170.54, "text": "طبعا قال لكم هنا بعد" },
    { "start": 170.54, "end": 171.66, "text": "Information privacy" },
    {
      "start": 171.66,
      "end": 173.7,
      "text": "هذا اللي احنا نبغى نصدق نتحمق فيه"
    },
    {
      "start": 173.7,
      "end": 177.12,
      "text": "إنه وشو الخصوصية من ناحية المعلومات"
    },
    {
      "start": 177.12,
      "end": 180.18,
      "text": "فهو control over the flow of one's\npersonal information"
    },
    {
      "start": 180.18,
      "end": 182.08,
      "text": "including its transfer and exchange"
    },
    { "start": 182.08, "end": 183.18, "text": "يعني أنتم" },
    {
      "start": 183.18,
      "end": 184.72,
      "text": "إذا حد قال لكم information privacy"
    },
    {
      "start": 184.72,
      "end": 188.22,
      "text": "معناته إن القدرة أنكم أنتم تتحكمون"
    },
    {
      "start": 188.22,
      "end": 192.04,
      "text": "كيف معلوماتك تروح وين تروح ومين تروح له"
    },
    { "start": 192.04, "end": 193.46, "text": "طبعا قال لكم برضو" },
    { "start": 193.46, "end": 194.92, "text": "privacy as social value" },
    {
      "start": 194.92,
      "end": 197.22,
      "text": "يعني إحنا كمجتمع لا شي يهمنا هذا الشي"
    },
    {
      "start": 197.22,
      "end": 199.82,
      "text": "قال لكم privacy is not just a personal\nright"
    },
    {
      "start": 199.82,
      "end": 201.46,
      "text": "يعني مو بشيك شي خاص فيك أنت لا"
    },
    {
      "start": 201.46,
      "end": 204.78,
      "text": "It's a necessary condition for other\nrights such as freedom"
    },
    {
      "start": 204.78,
      "end": 209.16,
      "text": "يعني بدون خصوصية بهذا الشكل معنات أنه ما\nفي حرية"
    },
    { "start": 209.16, "end": 210.76, "text": "And personal autonomy" },
    {
      "start": 210.76,
      "end": 214.12,
      "text": "Without privacy those cannot exist period"
    },
    { "start": 214.12, "end": 216.46, "text": "فهذا هو السبب أن يكون مرة مهم" },
    {
      "start": 216.46,
      "end": 220.07999999999998,
      "text": "من عندنا الحين categories of private\ninformation"
    },
    { "start": 220.07999999999998, "end": 220.84, "text": "اللي هو CHIP" },
    { "start": 220.84, "end": 223.12, "text": "أول شيء communication" },
    {
      "start": 223.12,
      "end": 225.42000000000002,
      "text": "Private communication"
    },
    {
      "start": 225.42000000000002,
      "end": 227.82,
      "text": "اللي لكم حق أن أي شيء بينكم"
    },
    {
      "start": 227.82,
      "end": 230.38,
      "text": "يعني مثلا أنا أرسلت لكم رسالة على سناب شات"
    },
    { "start": 230.38, "end": 230.96, "text": "واتساب" },
    { "start": 230.96, "end": 232.22, "text": "استجرام" },
    { "start": 232.22, "end": 232.74, "text": "اللي هو" },
    { "start": 232.74, "end": 234.48, "text": "يصير بيننا خاص" },
    { "start": 234.48, "end": 235.36, "text": "ما يطلع" },
    {
      "start": 235.36,
      "end": 237.32,
      "text": "all forms of personal communication"
    },
    {
      "start": 237.32,
      "end": 239.72,
      "text": "which a person wishes to keep private"
    },
    { "start": 239.72, "end": 241.36, "text": "messages, calls, letters, etc" },
    { "start": 241.36, "end": 242.72, "text": "وبعدين" },
    { "start": 242.72, "end": 243.22, "text": "health" },
    { "start": 243.22, "end": 244.38, "text": "medical information" },
    { "start": 244.38, "end": 245.8, "text": "هذا أكثر واحد" },
    { "start": 245.8, "end": 246.58, "text": "اللي واضح" },
    { "start": 246.58, "end": 247.66, "text": "أن يعني" },
    { "start": 247.66, "end": 248.82, "text": "ما هم حق" },
    { "start": 248.82, "end": 249.48, "text": "أي أحد" },
    { "start": 249.48, "end": 250.94, "text": "يعرفون مثلا" },
    { "start": 250.94, "end": 253.08, "text": "الأشياء اللي أنا عاني فيها" },
    { "start": 253.08, "end": 255.12, "text": "من ناحية الأمراض النفسية" },
    { "start": 255.12, "end": 255.68, "text": "أو مثلا" },
    { "start": 255.68, "end": 256.86, "text": "أمراض الجسدية" },
    { "start": 256.86, "end": 257.62, "text": "أو اللي هو" },
    { "start": 257.62, "end": 258.5, "text": "ما هم حق" },
    { "start": 258.5, "end": 259.84, "text": "هذا خصوصيتي" },
    { "start": 259.84, "end": 261.32, "text": "كيف تعرفون أنا وش عندي" },
    { "start": 261.32, "end": 262.42, "text": "فقال لكم هنا" },
    { "start": 262.42, "end": 263.62, "text": "Health or medical information" },
    {
      "start": 263.62,
      "end": 265.08,
      "text": "A person has a right to privacy"
    },
    {
      "start": 265.08,
      "end": 266.42,
      "text": "About the nature of their illness"
    },
    {
      "start": 266.42,
      "end": 268.82,
      "text": "They cannot be forced to disclose it to\nothers"
    },
    { "start": 268.82, "end": 270.28, "text": "من عندنا طبعا" },
    { "start": 270.28, "end": 272.06, "text": "Personal information واضحة" },
    { "start": 272.06, "end": 273.0, "text": "هذه برضو حسن من الأشياء" },
    { "start": 273.0, "end": 273.86, "text": "اللي سهلة تحفظون" },
    { "start": 273.86, "end": 275.94, "text": "معلومات خاصة عنكم صح" },
    {
      "start": 275.94,
      "end": 278.74,
      "text": "Information referring only to that\nspecific person"
    },
    { "start": 278.74, "end": 279.15999999999997, "text": "مثلا" },
    { "start": 279.15999999999997, "end": 281.42, "text": "كم راتبك" },
    { "start": 281.42, "end": 284.15999999999997, "text": "محتبط بفلوس" },
    { "start": 284.15999999999997, "end": 286.44, "text": "وش اللي قاعد تسوي" },
    { "start": 286.44, "end": 287.86, "text": "يعني وش وظيفتك" },
    { "start": 287.86, "end": 289.6, "text": "أنت أي مستوى" },
    { "start": 289.6, "end": 291.58, "text": "مين وش قاعد تصير في الدوام" },
    { "start": 291.58, "end": 293.22, "text": "أشياء تخصك في أنت" },
    { "start": 293.22, "end": 295.04, "text": "حتى أشياء توضح أن أنت" },
    { "start": 295.04, "end": 297.04, "text": "وبدأين عندكم آخر شيء" },
    {
      "start": 297.04,
      "end": 298.65999999999997,
      "text": "اللي هو information about possessions"
    },
    {
      "start": 298.65999999999997,
      "end": 301.04,
      "text": "يعني الأشياء اللي أنا أملكها"
    },
    {
      "start": 301.04,
      "end": 303.88,
      "text": "ليش لازم تعرف أنت كم سيارة أملكها"
    },
    { "start": 303.88, "end": 304.58, "text": "كم بيت" },
    { "start": 304.58, "end": 305.36, "text": "الأرض" },
    { "start": 305.36, "end": 307.9, "text": "أي شيء يعني أنا" },
    { "start": 307.9, "end": 310.0, "text": "اللي حق عليه" },
    { "start": 310.0, "end": 311.42, "text": "مكتوب باسمي" },
    {
      "start": 311.42,
      "end": 315.805,
      "text": "\"Closely related to property rights, a\nperson has control over information"
    },
    {
      "start": 315.805,
      "end": 319.42,
      "text": "relating to their personal possessions in\ncertain instances.\""
    },
    {
      "start": 319.42,
      "end": 327.42,
      "text": "يعني ما لك حق اني تعرف كذا كل التفاصيل\nمثلا انت خلق قول وضيفتك انك تبيع بيوت"
    },
    {
      "start": 327.42,
      "end": 332.42,
      "text": "و تتجي والله تحاو تستغلني لنكداري اني عندي\nكذا أرض"
    },
    { "start": 332.42, "end": 335.42, "text": "هذا هو السبب" },
    {
      "start": 335.42,
      "end": 345.42,
      "text": "ثلاثة سيبر برايفيسي السؤال: ما هي الأسئلة\nالتي يسألون من ناحية السيبر برايفيسي؟"
    },
    {
      "start": 345.42,
      "end": 349.42,
      "text": "أول شيء: ما هي المعلومات التي تجمع؟"
    },
    { "start": 349.42, "end": 351.42, "text": "ما هي المعلومات التي تجمع؟" },
    { "start": 351.42, "end": 352.42, "text": "ما هي المعلومات التي تجمع؟" },
    {
      "start": 352.42,
      "end": 353.42,
      "text": "لا يجب أن تجمع المعلومات التي تجمعها؟"
    },
    {
      "start": 353.42,
      "end": 356.42,
      "text": "لا يجب أن تجمع المعلومات التي تجمعها؟"
    },
    { "start": 356.42, "end": 358.78, "text": "يعني مثلا أنا الحيم" },
    { "start": 358.78, "end": 360.18, "text": "بمستشفى" },
    { "start": 360.18, "end": 362.6, "text": "بسأل أشياء وبجمع داتي عن إيش" },
    { "start": 362.6, "end": 364.54, "text": "عن فصيل الدمك عن طولك" },
    { "start": 364.54, "end": 366.18, "text": "عن وزنك عن يعني الأمراض" },
    { "start": 366.18, "end": 368.0, "text": "الليك سابقة صح" },
    { "start": 368.0, "end": 370.74, "text": "ليش مفق يعني ممكن أسألك" },
    { "start": 370.74, "end": 372.28, "text": "كم سيارة تملك" },
    { "start": 372.28, "end": 374.34, "text": "هل هذا لهم خصيفي" },
    { "start": 374.34, "end": 376.78, "text": "هل لهم دخل لا أنا مستشفى" },
    { "start": 376.78, "end": 378.54, "text": "ما لي علاقة ما لي الإصلاحين" },
    { "start": 378.54, "end": 381.18, "text": "يطلب منك أنك جاءوا هذا السؤال" },
    { "start": 381.18, "end": 382.68, "text": "فهذا هو يقولك أنه ممكن" },
    { "start": 382.68, "end": 384.5, "text": "للمعلومات لترلكم حق" },
    { "start": 384.5, "end": 386.06, "text": "تجمعونها. فلازم تسألون" },
    {
      "start": 386.06,
      "end": 388.34,
      "text": "وش المعلومات اللي مفروض نجمعها"
    },
    { "start": 388.34, "end": 390.2, "text": "بعدين طبعا السؤال الثاني" },
    { "start": 390.2, "end": 392.14, "text": "وش المعلومات" },
    { "start": 392.14, "end": 394.04, "text": "اللي يعني تشارك مع مين" },
    { "start": 394.04, "end": 396.65999999999997, "text": "يعني مم شاركها" },
    { "start": 396.65999999999997, "end": 397.92, "text": "معلوماتي الصحية" },
    {
      "start": 397.92,
      "end": 400.64,
      "text": "مع والله مدير الجامعة وش دخلها"
    },
    {
      "start": 400.64,
      "end": 402.34000000000003,
      "text": "انا بروح اشاركي مع المستشفى صاح"
    },
    {
      "start": 402.34000000000003,
      "end": 404.28,
      "text": "مع الدكتور حقي. فلازم"
    },
    { "start": 404.28, "end": 406.52, "text": "عارف وش المعلومات اللي نقدر" },
    { "start": 406.52, "end": 408.7, "text": "نعطيها المين بالضبط" },
    {
      "start": 408.7,
      "end": 410.52,
      "text": "who is the authorized recipient"
    },
    { "start": 410.52, "end": 412.54, "text": "under what conditions can the" },
    { "start": 412.54, "end": 414.76, "text": "مثلا انا الحين" },
    { "start": 414.76, "end": 417.24, "text": "ما اعطي معلوماتي للدكتور" },
    { "start": 417.24, "end": 419.28, "text": "على اي اساس الدكتور" },
    { "start": 419.28, "end": 420.72, "text": "له الحق مثلا" },
    {
      "start": 420.72,
      "end": 423.32,
      "text": "ان يروح ينقل معلوماتي للدكتور ثاني"
    },
    { "start": 423.32, "end": 424.48, "text": "يصير ممكن" },
    { "start": 424.48, "end": 426.58, "text": "والله هذا الدكتور" },
    { "start": 426.58, "end": 428.48, "text": "برضو صار دخل مع حالتي" },
    { "start": 428.48, "end": 430.86, "text": "هكذا بس انا ما لحق ان فجأة" },
    { "start": 430.86, "end": 432.88, "text": "كذا من رأسها يعطي معلوماتي" },
    { "start": 432.88, "end": 434.54, "text": "الصحية لأي دكتور ثاني" },
    { "start": 434.54, "end": 436.84, "text": "بدون ما يعني يصير الدكتور هذا" },
    { "start": 436.84, "end": 437.74, "text": "اللي هدخل فيني" },
    { "start": 437.74, "end": 439.06, "text": "وبعدا عندكم" },
    {
      "start": 439.06,
      "end": 441.84,
      "text": "To what extent can individuals control it"
    },
    { "start": 441.84, "end": 443.56, "text": "يعني زي ما قلت لكم سابقا" },
    {
      "start": 443.56,
      "end": 445.76,
      "text": "الحين المعلومات صار تكشي بالكلاود"
    },
    { "start": 445.76, "end": 447.98, "text": "وصار يعني ما يمديكم" },
    { "start": 447.98, "end": 449.64, "text": "تتحكمون وين ببببتل تتخزن" },
    { "start": 449.64, "end": 451.56, "text": "معلوماتكم في أي ديرة" },
    { "start": 451.56, "end": 452.82, "text": "في أي منطقة" },
    { "start": 452.82, "end": 455.9, "text": "وكيف هم مني لحق يشوفها" },
    { "start": 455.9, "end": 457.48, "text": "فإلى أي حد" },
    { "start": 457.48, "end": 459.18, "text": "يعني حنا واقعين نقدر" },
    { "start": 459.18, "end": 460.82, "text": "نتحكم فيه" },
    { "start": 460.82, "end": 462.76, "text": "خصوصا خصوصياتنا على الانترنت" },
    { "start": 462.76, "end": 465.0, "text": "How is it gathered, stored," },
    { "start": 465.28, "end": 467.26, "text": "mind, combined, recombined" },
    {
      "start": 467.26,
      "end": 472.8,
      "text": "هذا كله قد يعني نسأل نفسنا سؤال"
    },
    {
      "start": 472.8,
      "end": 475.46,
      "text": "إنه قد إيش نقدر نتحكم بهذا الشي"
    },
    {
      "start": 475.46,
      "end": 479.82,
      "text": "لأنه ما قدت أي شي خلاص بالإنترنت لأبد\nبالإنترنت"
    },
    {
      "start": 479.82,
      "end": 484.64,
      "text": "فهذا هو علاقة السايبر سبيس و سايبر سبيس و\nبرايباسي"
    },
    { "start": 484.64, "end": 487.78, "text": "طبعا أيضا أس وش السؤال الثاني" },
    {
      "start": 487.78,
      "end": 492.26,
      "text": "إن لمدة كم هذا الشي اللي عني مخزن"
    },
    {
      "start": 492.26,
      "end": 495.64,
      "text": "هل مثلا خلاص بيخزنون معلوماتي لمدة خمس\nسنوات"
    },
    { "start": 495.64, "end": 496.88, "text": "بعدين عقبة يحذفونا" },
    { "start": 496.88, "end": 498.44, "text": "أو خلاص للأبد" },
    { "start": 498.44, "end": 499.34, "text": "هذو" },
    { "start": 499.34, "end": 504.84, "text": "إلى أي حد" },
    { "start": 504.84, "end": 507.14, "text": "مسموح لك تخزن الأشياء" },
    { "start": 507.14, "end": 511.2, "text": "وبعدين عندنا الحين" },
    {
      "start": 511.2,
      "end": 513.16,
      "text": "How personal information is used"
    },
    { "start": 513.16, "end": 516.34, "text": "قلنا إننا والله جمعتوها" },
    { "start": 516.34, "end": 518.46, "text": "ومين ملحق يشوفها" },
    { "start": 518.46, "end": 519.3, "text": "وكذا" },
    { "start": 519.3, "end": 520.58, "text": "بس إحنا الحين نبغى نعرف" },
    { "start": 520.58, "end": 522.14, "text": "كل هذا وشفايته" },
    { "start": 522.14, "end": 524.12, "text": "كيف تقدرون تستخدمونا" },
    { "start": 524.12, "end": 526.1, "text": "خصوصاً تستخدمون ضدي" },
    { "start": 526.1, "end": 527.36, "text": "قال لكم او شيء" },
    { "start": 527.36, "end": 530.76, "text": "هذا اول مصيبة" },
    { "start": 530.76, "end": 532.36, "text": "انكم جمعوا معلومات عني" },
    { "start": 532.36, "end": 533.44, "text": "وانا ما انا ادري" },
    { "start": 533.44, "end": 536.5, "text": "هذا مو باوكي طبعا" },
    { "start": 536.5, "end": 537.0, "text": "قال لكم ان" },
    { "start": 537.0, "end": 537.72, "text": "سايبر تكنولوجي" },
    { "start": 537.72, "end": 539.54, "text": "ميكس اتباع دارة" },
    { "start": 539.54, "end": 540.52, "text": "باو انفيدو فيجولز" },
    { "start": 540.52, "end": 544.14, "text": "وبتشوفون بعدين ليش" },
    { "start": 544.14, "end": 544.88, "text": "وكيف" },
    { "start": 544.88, "end": 546.78, "text": "بس هذا ترى مصيبة" },
    { "start": 546.78, "end": 548.02, "text": "بشكل جذري" },
    { "start": 548.02, "end": 549.6, "text": "لان انت" },
    { "start": 549.6, "end": 550.66, "text": "يعني حين ما تدري" },
    { "start": 550.66, "end": 551.72, "text": "في مثال بعضكم" },
    { "start": 551.72, "end": 552.44, "text": "زي" },
    { "start": 552.44, "end": 556.14, "text": "هذا الشيء يصير بالأجهزة" },
    { "start": 556.14, "end": 558.8, "text": "أنه يطلع جهازك وش" },
    { "start": 558.8, "end": 561.2, "text": "وصفتور الذي يمشي عليه" },
    { "start": 561.2, "end": 564.2, "text": "ويجمع تفاصيل عنك أنت" },
    {
      "start": 564.2,
      "end": 567.1,
      "text": "وفي مرحلات أنك مستحيل تدني أنك يصير"
    },
    { "start": 567.1, "end": 568.74, "text": "أي شيء" },
    { "start": 568.74, "end": 570.92, "text": "إذا يصير من وراء ظهرك" },
    { "start": 570.92, "end": 572.88, "text": "اعرف أنه في مصيبة" },
    { "start": 572.88, "end": 574.38, "text": "هم ما سووا هذا الشيء" },
    { "start": 574.38, "end": 575.74, "text": "اللي هم يريدون يستغلونك" },
    { "start": 575.74, "end": 577.26, "text": "وبدأ عندكم مرج" },
    {
      "start": 577.26,
      "end": 580.82,
      "text": "اللي هو creating electronic profiles"
    },
    {
      "start": 580.82,
      "end": 584.56,
      "text": "راحوا وجابوا معلومات من سيرفرات مختلفة"
    },
    { "start": 584.56, "end": 586.4, "text": "من داتاباس مختلف" },
    { "start": 586.4, "end": 589.02, "text": "ويجمعونا إلى شيء واحد" },
    { "start": 589.02, "end": 595.4, "text": "تلاحظوا كلمة merge" },
    { "start": 595.4, "end": 596.46, "text": "تتكرر" },
    { "start": 596.46, "end": 602.74, "text": "هذا لاحظوا أبيكم تركتون" },
    {
      "start": 602.74,
      "end": 604.64,
      "text": "ما أنكم ما تتلخبطون مع matched"
    },
    { "start": 604.64, "end": 606.2, "text": "matched عكسة" },
    { "start": 606.2, "end": 607.18, "text": "هذا قال لكم merge" },
    { "start": 607.18, "end": 608.52, "text": "أنه يروح يأخذ معلومات" },
    { "start": 608.52, "end": 609.74, "text": "ويحطها مع بعض" },
    { "start": 609.74, "end": 611.0, "text": "ماتش لا" },
    { "start": 611.0, "end": 611.98, "text": "اللي يروح" },
    { "start": 611.98, "end": 612.94, "text": "يقول اوكي" },
    { "start": 612.94, "end": 614.7, "text": "هذا المعلومة من هذا الديتباس" },
    { "start": 614.7, "end": 616.7, "text": "وهذا المعلومة من هذا الديتباس" },
    { "start": 616.7, "end": 618.5, "text": "جاي من نفس الشخص" },
    { "start": 618.5, "end": 619.5, "text": "يعني بس كذا" },
    { "start": 619.5, "end": 621.22, "text": "it identifies" },
    { "start": 621.22, "end": 622.06, "text": "ان اوه" },
    { "start": 622.06, "end": 624.06, "text": "هذا الشيء من نفس الانسان" },
    { "start": 624.06, "end": 625.06, "text": "فقط مجرد" },
    { "start": 625.06, "end": 626.6, "text": "information in one database" },
    { "start": 626.6, "end": 627.88, "text": "is matched against records" },
    { "start": 627.88, "end": 628.68, "text": "in another database" },
    {
      "start": 628.68,
      "end": 630.38,
      "text": "that contains information about us"
    },
    { "start": 630.38, "end": 631.34, "text": "بس يسوون" },
    { "start": 631.34, "end": 632.34, "text": "ماتشي ماتشي" },
    { "start": 632.34, "end": 633.22, "text": "من كلمة ماتش" },
    { "start": 633.22, "end": 635.04, "text": "لذكروا ماتشي ماتشي" },
    { "start": 635.04, "end": 637.06, "text": "مرج معنة ان يخلطون" },
    { "start": 637.06, "end": 638.3, "text": "ماتشت" },
    { "start": 638.3, "end": 639.4, "text": "معنة يسوون ماتش" },
    { "start": 639.4, "end": 641.28, "text": "وبنعندكم mind" },
    { "start": 641.28, "end": 643.08, "text": "revealing hidden patterns" },
    { "start": 643.08, "end": 644.76, "text": "يعني هي أنتم سويتوا merging" },
    { "start": 644.76, "end": 646.18, "text": "وسويتوا matching وكل شي" },
    { "start": 646.18, "end": 648.9, "text": "بس إذا ما قعدتوا تحللون" },
    { "start": 648.9, "end": 649.92, "text": "اللي هو mind" },
    { "start": 649.92, "end": 651.64, "text": "ما لا فايدة صح" },
    { "start": 651.64, "end": 653.26, "text": "فهذا هو يقول لكم" },
    { "start": 653.26, "end": 654.38, "text": "revealing hidden patterns" },
    {
      "start": 654.38,
      "end": 656.98,
      "text": "personal data is mind from the database"
    },
    {
      "start": 656.98,
      "end": 659.12,
      "text": "and web activity to reveal patterns"
    },
    {
      "start": 659.12,
      "end": 661.52,
      "text": "and behavior that would have been very\ndifficult"
    },
    {
      "start": 661.52,
      "end": 663.56,
      "text": "to discern in the pre-computer era"
    },
    { "start": 663.56, "end": 664.84, "text": "يعني سابقا" },
    { "start": 664.84, "end": 666.82, "text": "صاحب جدا ترى" },
    { "start": 666.82, "end": 668.98, "text": "أن الواحد يقد يحلل شخصيتك" },
    {
      "start": 668.98,
      "end": 673.42,
      "text": "يعني لان ما بقادر صدق يوصل كل المعلومات\nعنك وصح"
    },
    { "start": 673.42, "end": 675.62, "text": "الحين لا صار مرة سهل" },
    { "start": 675.62, "end": 677.48, "text": "فيقدرون الحين سواء مائنك" },
    {
      "start": 677.48,
      "end": 680.72,
      "text": "يقولون اوكي الساعة كده فلانية والساعة كده"
    },
    {
      "start": 680.72,
      "end": 683.52,
      "text": "يروح هو يفتح موقع السفر ويشوفوا طيارات"
    },
    { "start": 683.52, "end": 684.64, "text": "شكله هو ودي يسافره" },
    {
      "start": 684.64,
      "end": 688.36,
      "text": "فخلونا ممكن نرسله دعاية عن تذاكر"
    },
    { "start": 688.36, "end": 690.78, "text": "يشوفون كيف يقدرون يستغلونك" },
    { "start": 690.78, "end": 693.28, "text": "وبدين طبعا قال لكم هنا" },
    { "start": 693.28, "end": 698.72, "text": "هذا اهم شيء" },
    {
      "start": 698.72,
      "end": 703.24,
      "text": "لذلك أبيكم تحفظون لماذا نحن وكيف المعلومات\nالتي تتخزن"
    },
    { "start": 703.24, "end": 703.96, "text": "هذه الأسباب" },
    {
      "start": 703.96,
      "end": 707.52,
      "text": "بنحن لديكم هنا الأسئلة الماضية"
    },
    {
      "start": 707.52,
      "end": 710.08,
      "text": "هذا أبيكم أنتم تختبرونها مع نفسكم"
    },
    { "start": 710.08, "end": 711.64, "text": "وترون كيف تجيبون" },
    {
      "start": 711.64,
      "end": 718.6,
      "text": "إذا عندكم أي استفسار تواصلوا معي على\nالواتس"
    }
  ]
}
