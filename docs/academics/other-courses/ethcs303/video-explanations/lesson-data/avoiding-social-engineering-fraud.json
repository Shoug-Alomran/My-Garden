    { "start": 133.0, "end": 135.0, "text": "بس هم يستغلون الروعة" },
    { "start": 135.0, "end": 138.0, "text": "أو ال \"urgency\" اللي أنت تحسه" },
    {
      "start": 138.0,
      "end": 140.0,
      "text": "فعشان كذي يقول لكم \"slow down\""
