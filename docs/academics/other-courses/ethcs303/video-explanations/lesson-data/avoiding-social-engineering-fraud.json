    { "start": 279.0, "end": 280.0, "text": "احذفوا الرسالة" },
    { "start": 280.0, "end": 281.0, "text": "ولا روحوا للناس" },
    { "start": 281.0, "end": 283.0, "text": "اللي أنتم فوقكم" },
