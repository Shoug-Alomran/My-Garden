    { "start": 129.0, "end": 131.0, "text": "لأن دائماً إذا فكرت أصلاً" },
    {
      "start": 131.0,
      "end": 133.0,
      "text": "بتقول اوه دقيقة أنا ليش سويت كذا؟"
