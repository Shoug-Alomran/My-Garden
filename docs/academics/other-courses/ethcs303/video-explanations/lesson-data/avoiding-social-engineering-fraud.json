  "transcript": [
    {
      "start": 0.0,
      "end": 4.0,
      "text": "السلام عليكم. اليوم نكمل عن \"How to avoid\nsocial engineering frauds\""
    },
    {
      "start": 4.0,
      "end": 7.0,
      "text": "أول شيء، أول شيء وهذا من أهم الأشياء"
    },
    {
      "start": 7.0,
      "end": 11.0,
      "text": "والذكر حتى الدكتور كانت تقول أن الـ IT\nصاحهم عندهم القدرة"
    },
    { "start": 11.0, "end": 13.0, "text": "أن يدخلون جهازك ويعدلون عليه" },
    {
      "start": 13.0,
      "end": 18.0,
      "text": "تقول كانوا يمنعونها أو يعني ما يعدلون\nالشيء اللي هي تبيه"
    },
    {
      "start": 18.0,
      "end": 23.0,
      "text": "إليما هي كانت عند المكتب وكانت واقفة عند\nاللابتوب"
    },
    {
      "start": 23.0,
      "end": 27.0,
      "text": "ليش؟ لأنه إذا كان جهازك \"not secure\""
    },
    {
      "start": 27.0,
      "end": 30.0,
      "text": "يعرفته أنه مثلا أنتم راحين كوفي تالكينا\nوالله مفتوح"
    },
    {
      "start": 30.0,
      "end": 34.0,
      "text": "ولا رمزكم مرة سهل يقدر أي أحد يجي ويلعب\nفيه"
    },
    {
      "start": 34.0,
      "end": 36.0,
      "text": "صح ولا لا؟ فعشان كده يقول لكم أو شيء"
    },
    { "start": 36.0, "end": 38.0, "text": "\"Secure your computing devices\"" },
    { "start": 38.0, "end": 39.0, "text": "هذا أول وأهم نقطة" },
    {
      "start": 39.0,
      "end": 42.0,
      "text": "وبنى عندكم \"Set your spam filters to high\""
    },
    {
      "start": 42.0,
      "end": 48.0,
      "text": "بعض الإيميلات وهذا قد اشتغلت فيه في\nالموضوع مرة مرة مرة"
    },
    {
      "start": 48.0,
      "end": 52.0,
      "text": "لأن بعض الأباقات بتشوفونها ما فيه\n\"filters\" يعني"
    },
    { "start": 52.0, "end": 54.0, "text": "ولا الفلتر يصير \"standard\"" },
    {
      "start": 54.0,
      "end": 57.0,
      "text": "بس بعض الإشتراكات كلما يعني دفعتوا فلوس\nزيادة"
    },
    { "start": 57.0, "end": 59.0, "text": "يصير عندكم ميزات زيادة بالإيميل" },
    {
      "start": 59.0,
      "end": 61.0,
      "text": "فأنتم الحين لو شفتوا هذا ما قد شفتوه"
    },
    {
      "start": 61.0,
      "end": 63.0,
      "text": "ما قد شفتوه في \"spam filters\" وكذا"
    },
    { "start": 63.0, "end": 65.0, "text": "لأنه بالنسبة لنا حنا \"standard\"" },
    {
      "start": 65.0,
      "end": 69.0,
      "text": "بس من ناحية الشركات عندهم يعني فيه باقات"
    },
    {
      "start": 69.0,
      "end": 73.0,
      "text": "وبواحد من الباقات يصير الواحد يقدر يحط\n\"spam filter\" العالي"
    },
    {
      "start": 73.0,
      "end": 75.0,
      "text": "فيه طبعا \"low\", \"medium\" و \"high\""
    },
    { "start": 75.0, "end": 76.0, "text": "وش معناته؟" },
    { "start": 76.0, "end": 78.0, "text": "يصير مدد ذكاء صناعي" },
    { "start": 78.0, "end": 79.0, "text": "و السيستم" },
    { "start": 79.0, "end": 81.0, "text": "عندهم هم الغريثم معين" },
    { "start": 81.0, "end": 82.0, "text": "من حيث أن يقرأ الإيميل" },
    { "start": 82.0, "end": 85.0, "text": "ويقيس نسبة هذا الإيميل" },
    { "start": 85.0, "end": 87.0, "text": "إنه يكون \"spam\" و \"real\"" },
    { "start": 87.0, "end": 89.0, "text": "ويصير يحطه في \"spam folder\"" },
    { "start": 89.0, "end": 91.0, "text": "إذا كان يحسني \"spam\"" },
    { "start": 91.0, "end": 93.0, "text": "يقول لكم \"نحطوه\" على \"عالي\"" },
    {
      "start": 93.0,
      "end": 95.0,
      "text": "وبنها عندكم \"beware of any download\""
    },
    { "start": 95.0, "end": 96.0, "text": "لا تحملوا أي شيء" },
    {
      "start": 96.0,
      "end": 100.0,
      "text": "روحوا و سووا \"check\" و روحوا و أسألوا \"IT\"\nو كلموا"
