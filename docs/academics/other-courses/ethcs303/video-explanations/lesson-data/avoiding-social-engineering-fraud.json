    { "start": 120.0, "end": 122.0, "text": "ليش؟ لأن بعض الناس" },
    { "start": 122.0, "end": 124.0, "text": "ما يبغونك تفكر" },
    { "start": 124.0, "end": 126.0, "text": "يبغونك تخاف و على طول" },
    {
      "start": 126.0,
      "end": 129.0,
      "text": "تتوي اللي هم يبغونه بدون ما تفكر"
