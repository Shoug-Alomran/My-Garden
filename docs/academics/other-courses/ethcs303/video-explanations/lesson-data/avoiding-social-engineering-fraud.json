    { "start": 100.0, "end": 101.0, "text": "لا تحملوا أي شيء" },
    { "start": 101.0, "end": 102.0, "text": "انتبهوا" },
    {
      "start": 102.0,
      "end": 105.0,
      "text": "\"delete any requests for financial\ninformation or passwords\""
