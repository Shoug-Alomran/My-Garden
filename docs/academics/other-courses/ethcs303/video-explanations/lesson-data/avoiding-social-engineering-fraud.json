    { "start": 248.0, "end": 250.0, "text": "أهم شيء أنكم تفهمون" },
    { "start": 250.0, "end": 253.0, "text": "لا تصدقون" },
    { "start": 253.0, "end": 256.0, "text": "لا تصدقون" },
    { "start": 256.0, "end": 258.0, "text": "اعتبروها \"سcam\"" },
    {
      "start": 258.0,
      "end": 260.0,
      "text": "لأن هنا يقول لكم \"refinance a home\""
