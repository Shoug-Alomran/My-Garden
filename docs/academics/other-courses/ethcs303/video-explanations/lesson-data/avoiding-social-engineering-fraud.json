    { "start": 360.0, "end": 361.0, "text": "\"infected\"" },
    { "start": 361.0, "end": 362.0, "text": "ما يجيكم أنتم الضرر" },
    { "start": 362.0, "end": 363.0, "text": "لأنه \"virtual machine\"" },
