    { "start": 145.0, "end": 146.0, "text": "\"be skeptical\"" },
    {
      "start": 146.0,
      "end": 149.0,
      "text": "\"never let their urgency influence your\ncareful review\""
    },
    { "start": 149.0, "end": 152.0, "text": "دائماً خذوا نفس عادي" },
