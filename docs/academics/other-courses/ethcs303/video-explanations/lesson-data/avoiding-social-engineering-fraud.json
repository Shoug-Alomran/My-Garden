    { "start": 313.0, "end": 315.0, "text": "لا تصرون عندكم" },
    { "start": 315.0, "end": 316.0, "text": "متعانون من فراغ الدرجة" },
    { "start": 316.0, "end": 317.0, "text": "أنكم تضغطون أي شيء" },
