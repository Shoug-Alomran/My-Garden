  "transcript": [
    { "start": 0.0, "end": 0.64, "text": "السلام عليكم" },
    {
      "start": 0.64,
      "end": 3.84,
      "text": "اليوم بنكمل اخر درس في الethical theories"
    },
    {
      "start": 3.84,
      "end": 5.58,
      "text": "هو رقم 6 بالintroduction to ethics"
    },
    { "start": 5.58, "end": 7.3, "text": "وهو virtue ethics" },
    { "start": 7.3, "end": 8.12, "text": "خلونا نبدأ" },
    { "start": 8.12, "end": 9.94, "text": "اول شيء وش هو virtue ethics" },
    { "start": 9.94, "end": 12.44, "text": "وش قاعد يقول يعني وش المطلوب منه" },
    { "start": 12.44, "end": 14.38, "text": "هو اول شيء ترى يقول" },
    { "start": 14.38, "end": 15.98, "text": "اني راعي ارستاتو" },
    { "start": 15.98, "end": 17.7, "text": "الهو اللي مسوي ال virtue ethics" },
    { "start": 17.7, "end": 19.58, "text": "قاعد يقول شوف حبايبي" },
    {
      "start": 19.58,
      "end": 22.72,
      "text": "الكانتنزم واليوتيرتزم والسوشل كونتراك تيري"
    },
    { "start": 22.72, "end": 24.28, "text": "ما عندهم سالفة" },
    {
      "start": 24.28,
      "end": 26.5,
      "text": "ليش لانهم ما يفكرون ببنية الانسان"
    },
    { "start": 26.5, "end": 28.24, "text": "طبيعة الانسان عقلية الانسان" },
    { "start": 28.24, "end": 29.52, "text": "وكل هذا الاشياء صح" },
    {
      "start": 29.52,
      "end": 35.3,
      "text": "هو فقط يفكر عن العقبات وواجبات وكيف\nالمشتبع يستفيد"
    },
    {
      "start": 35.3,
      "end": 40.06,
      "text": "ولكن لا أحد منهم يفكر كيف البشر طبيعته\nيأثر"
    },
    { "start": 40.06, "end": 42.34, "text": "إلا يفكر فيه" },
    { "start": 42.34, "end": 43.64, "text": "قال لكم أن" },
    { "start": 43.64, "end": 51.36, "text": "العلم مثلا في واحد" },
    { "start": 51.36, "end": 53.2, "text": "والله ما عنده علم صفر علم" },
    {
      "start": 53.2,
      "end": 55.22,
      "text": "وواحد عنده مليون علم رايح الجامعة"
    },
    { "start": 55.22, "end": 57.1, "text": "متخرج من دكتورات" },
    { "start": 57.1, "end": 64.1, "text": "علاقتك مع عائلتك ومجتمع" },
    { "start": 64.1, "end": 66.44, "text": "وحتى أهم شيء مشاعرك" },
    { "start": 66.44, "end": 67.78, "text": "مشاعرك تلعب دور" },
    { "start": 67.78, "end": 70.1, "text": "طيب يعني البشر ترى خنقول" },
    { "start": 70.1, "end": 73.76, "text": "ان في كثير ناس يسوون جرائم" },
    { "start": 73.76, "end": 75.4, "text": "ليش بسبت مشاعرهم" },
    { "start": 75.4, "end": 76.76, "text": "ما يفكرون عن واجباتهم" },
    { "start": 76.76, "end": 77.84, "text": "ما يفكرون عن العقبات" },
    { "start": 77.84, "end": 80.56, "text": "ما يفكرون عن العقد المجتمع" },
    { "start": 80.56, "end": 82.22, "text": "يفكرون بمشاعرهم" },
    { "start": 82.22, "end": 83.78, "text": "وعشان كذا هو أفضل شيء" },
    {
      "start": 83.78,
      "end": 86.72,
      "text": "لأنه يفكر زي ما قلت ببنية الإنسان"
    },
    { "start": 86.72, "end": 87.96000000000001, "text": "دعونا نكمل" },
    {
      "start": 87.96000000000001,
      "end": 90.42,
      "text": "هناك شيء يسمى \"Virtue\" و هناك شيء يسمى\n\"Vice\""
    },
    {
      "start": 90.42,
      "end": 92.36,
      "text": "نحن في هذا السلايد نتكلم عن \"Virtue\""
    },
    { "start": 92.36, "end": 94.36, "text": "\"Virtue\" هي الصفات الكويسة" },
    { "start": 94.36, "end": 97.7, "text": "والأشياء التي نطمح لها نصل لها" },
    {
      "start": 97.7,
      "end": 100.46000000000001,
      "text": "يقول لكم \"Your first reaching one's\nhighest potential\""
    },
    {
      "start": 100.46000000000001,
      "end": 102.53999999999999,
      "text": "يعني أنا أريد أن أصبح \"Top Top Top\""
    },
    {
      "start": 102.53999999999999,
      "end": 107.34,
      "text": "أريد أن يصبح عندي \"Honesty\", \"Courage\",\n\"Kindness\", \"Fairness\", \"Respect\""
    },
    { "start": 107.34, "end": 108.94, "text": "أريد أن يصبح كل صفاتي" },
    {
      "start": 108.94,
      "end": 112.74000000000001,
      "text": "يعني إذا جاءوا يقولون \"شوق والله إنها\nحنونة كريمة\""
    },
    {
      "start": 112.74000000000001,
      "end": 117.74000000000001,
      "text": "صفات كويسة عرفتوا انا بغسير دائما صفاتي\nكويسة"
    },
    {
      "start": 117.74000000000001,
      "end": 118.74000000000001,
      "text": "هذا الفيرتو"
    },
    {
      "start": 118.74000000000001,
      "end": 121.74,
      "text": "العكس ايش اللي هو الفايس اللي بندرس عنا\nبسلايه ثاني"
    },
    {
      "start": 121.74,
      "end": 123.74,
      "text": "قال لكم طبعا ايرستاطل اكسبرسي الابينيون"
    },
    {
      "start": 123.74,
      "end": 127.74,
      "text": "that the path to true happiness and\ngenuine flourishing of human being lies"
    },
    {
      "start": 127.74,
      "end": 130.74,
      "text": "in the living of virtue life يعني"
    },
    { "start": 130.74, "end": 132.74, "text": "وش قصده هو يعني وش السالفه" },
    {
      "start": 132.74,
      "end": 137.74,
      "text": "قال انه طالما ان الانسان يعني مبعايش\nبالفيرتو"
    },
    { "start": 137.74, "end": 138.74, "text": "ما حيث ان حيث بكنت عيزة" },
    {
      "start": 138.74,
      "end": 142.74,
      "text": "بس اذا عاش بالفيرتو صار يعني يحاول قدر\nالامكان"
    },
    { "start": 142.74, "end": 145.74, "text": "إنه يكون عنده صفات كذا كويسة" },
    { "start": 145.74, "end": 148.24, "text": "هو بيكون عايش حياة" },
    {
      "start": 148.24,
      "end": 151.74,
      "text": "وأصلا البشر بشكل عام بسرحاته منعشة أكثر"
    },
    { "start": 151.74, "end": 153.74, "text": "خلونا نتكلم زيادة" },
    { "start": 153.74, "end": 154.74, "text": "قال لكم طبعاً" },
    { "start": 161.74, "end": 163.74, "text": "أنا عندي مثال مرة جميلة" },
    { "start": 163.74, "end": 164.74, "text": "الرسول صلى الله عليه وسلم" },
    { "start": 164.74, "end": 165.74, "text": "ماذا كان يسويه؟" },
    { "start": 165.74, "end": 167.74, "text": "هو كان طبعاً عنده" },
    { "start": 167.74, "end": 169.74, "text": "كان كريم وحنون" },
    { "start": 169.74, "end": 170.74, "text": "ويقدر ويفعل" },
    {
      "start": 170.74,
      "end": 173.74,
      "text": "يعني كل الصفات اللي a virtuous person\nwould have"
    },
    {
      "start": 173.74,
      "end": 178.26,
      "text": "يعني إحنا لو تخيلنا شخص يعني مثالي عنده كل\nالصفات الكويسة"
    },
    {
      "start": 178.26,
      "end": 180.22,
      "text": "طبعاً بنفكر برسوله صلى الله عليه وسلم"
    },
    {
      "start": 180.22,
      "end": 183.02,
      "text": "فأفكروا فيه إذا جدتوا تفكرون في ال virtue\nethics"
    },
    {
      "start": 183.02,
      "end": 188.22,
      "text": "إن أي شيء إحنا نشوف الرسول يسويه إحنا\nنسويه زيه صح؟"
    },
    {
      "start": 188.22,
      "end": 193.5,
      "text": "يعني إشان كذا أي أفعل الشخص virtuous سواه"
    },
    {
      "start": 193.5,
      "end": 197.38,
      "text": "يعتبر فتحت طبعاً نفس الحالة نفس the\ncircumstances"
    },
    {
      "start": 197.38,
      "end": 200.98,
      "text": "مثلاً صار موقف كذا صار نفس الموقف بالضبط"
    },
    {
      "start": 200.98,
      "end": 204.16,
      "text": "سو طبقنا نفس الشيء بصير صح علينا التصرف"
    },
    {
      "start": 204.16,
      "end": 207.84,
      "text": "A virtuous person is a person who\npossesses and lives out the virtues"
    },
    { "start": 207.84, "end": 208.78, "text": "يعني ايش" },
    {
      "start": 208.78,
      "end": 212.82,
      "text": "يعني ما اقول انه والله انا يعني كريمة"
    },
    {
      "start": 212.82,
      "end": 216.57999999999998,
      "text": "وفي النهاية ما اوري النس كرمي لا هذا غلط"
    },
    {
      "start": 216.57999999999998,
      "end": 219.04,
      "text": "و A virtuous are those character traits"
    },
    { "start": 219.04, "end": 220.38, "text": "لاحظوا traits يعني ايش" },
    {
      "start": 220.38,
      "end": 224.76,
      "text": "الصفات الشخصية اللي يحتاجها الشخص عشان\nصدقي"
    },
    { "start": 224.76, "end": 226.88, "text": "يعني يصير الانسان بشكل عام" },
    { "start": 226.88, "end": 228.86, "text": "البشر يصير منعش" },
    { "start": 228.86, "end": 231.04, "text": "ويصير صدق سعيد بحياته" },
    { "start": 231.04, "end": 231.98, "text": "مبنين طبعا" },
    { "start": 231.98, "end": 232.92000000000002, "text": "وش قال إيرستوسل" },
    { "start": 232.92000000000002, "end": 233.36, "text": "قال لكم" },
    {
      "start": 233.36,
      "end": 237.24,
      "text": "A person should try to cultivate\nexcellence in everything he or she does"
    },
    {
      "start": 237.24,
      "end": 240.92,
      "text": "This theory emphasizes on building and\nassessing an individual's character"
    },
    { "start": 240.92, "end": 242.3, "text": "and not rules or actions" },
    { "start": 242.3, "end": 243.26, "text": "طبعا" },
    {
      "start": 243.26,
      "end": 246.34,
      "text": "حنا بشر في النهاية ولا نقدر نصير"
    },
    { "start": 246.34, "end": 248.3, "text": "يعني مية مية عرفته" },
    { "start": 248.3, "end": 250.82, "text": "صعب جدا ان نوصل هذا الدرجة" },
    {
      "start": 250.82,
      "end": 253.32,
      "text": "بس نحاول قدر الامكان خلال حياتنا"
    },
    {
      "start": 253.32,
      "end": 258.44,
      "text": "إننا نتطور ونبدأ كده نجمع نجمع نجمع صفات\nكويسة"
    },
    { "start": 258.44, "end": 260.48, "text": "عشان يصير عندنا كده" },
    {
      "start": 260.48,
      "end": 265.1,
      "text": "فول كاركتر وكامل ويصير هو من النوع الكويس"
    },
    {
      "start": 265.1,
      "end": 267.36,
      "text": "ولاحظوا إنه قد يقول لكم وكرر لكم"
    },
    { "start": 267.36, "end": 269.72, "text": "إنه هو مبعد على عقابات وفعال" },
    {
      "start": 269.72,
      "end": 274.34000000000003,
      "text": "وكده ما هو على شخصية الإنسان وكيف هو يتصرف"
    },
    {
      "start": 274.34000000000003,
      "end": 276.9,
      "text": "بني عندكم حين الفيرتو أثيكس في هذا السلايد"
    },
    {
      "start": 276.9,
      "end": 279.9,
      "text": "ترى يتكلم عن شيء مرة لازم أبيكم تنتبهون له"
    },
    {
      "start": 279.9,
      "end": 284.64,
      "text": "شوفوا كيف أن يتكلم عن agent وaction وبين\nconsequences"
    },
    {
      "start": 284.64,
      "end": 288.02,
      "text": "agent قاعد يفكي يتكلم من ناحية الـ Virtue\nصح؟"
    },
    {
      "start": 288.02,
      "end": 293.28,
      "text": "يعني هذا إحنا قلنا الـ agent هو الشخص\nالبشر اللي قاعد يسوي وينفذ هذا الفعل"
    },
    {
      "start": 293.28,
      "end": 298.42,
      "text": "بس الـ Action قاعد يجيب من وين من\nCantonism ومن Social Contract Theory"
    },
    {
      "start": 298.42,
      "end": 302.68,
      "text": "شوفوا كيف قاعد يروح يجمع لكم كل الـ\nTheories اللي احنا درسنا عنها سابقا"
    },
    {
      "start": 302.68,
      "end": 305.68,
      "text": "وعشان كذا أصلا هم حطينا Ethics Part 4"
    },
    {
      "start": 305.68,
      "end": 308.26,
      "text": "الـ Virtues عشان هو قاعد يجمعهم كلهم"
    },
    {
      "start": 308.26,
      "end": 311.1,
      "text": "ولاحظوا أن الـ consequences من الـ\nUtilurism"
    },
    {
      "start": 311.1,
      "end": 314.04,
      "text": "يعني الـ Virtue Ethics ترى قاعد يجمع كل\ntheory"
    },
    { "start": 314.04, "end": 316.62, "text": "بس قاعد يتضيف عليه الـ Agent" },
    { "start": 316.62, "end": 318.22, "text": "again وشه الـ Agent" },
    {
      "start": 318.22,
      "end": 321.88,
      "text": "فكروا بالناس اللي قاعدين يفعلون الفعل"
    },
    { "start": 321.88, "end": 323.74, "text": "وبعدين إذا قالوا لك وشه الفعل" },
    { "start": 323.74, "end": 324.98, "text": "والله الفعل" },
    { "start": 324.98, "end": 327.02, "text": "الشي اللي قاعد فعلا يصير" },
    { "start": 327.02, "end": 329.08, "text": "وترى يعتبر تحت Cantonism" },
    { "start": 329.08, "end": 330.32, "text": "والـ Social Contract Theory" },
    { "start": 330.32, "end": 331.58, "text": "والعقاب" },
    { "start": 331.58, "end": 333.7, "text": "هذا وشه من الفعل" },
    { "start": 333.7, "end": 336.24, "text": "هذا تستخدمون الـ Utilurism" },
    { "start": 336.24, "end": 337.06, "text": "طبعا" },
    {
      "start": 337.06,
      "end": 343.68,
      "text": "\"A good person does the right thing at the\nright time for the right reason\""
    },
    { "start": 343.68, "end": 345.18, "text": "ترون كيف؟" },
    {
      "start": 345.18,
      "end": 349.64300000000003,
      "text": "وبعد نكمل قال لكم \"according to the theory\nof virtue ethics, moral decision making"
    },
    {
      "start": 349.64300000000003,
      "end": 354.15999999999997,
      "text": "rules cannot or be reduced to the routine\napplication of a set of rules that is not"
    },
    {
      "start": 354.15999999999997,
      "end": 356.5,
      "text": "to say there is no place for rule of\nthumb\""
    },
    {
      "start": 356.5,
      "end": 362.0,
      "text": "يعني ترحين داحت قال لك \"rule of thumb\"\nيعني قانون بالعادل سووي يعني"
    },
    {
      "start": 362.0,
      "end": 366.0,
      "text": "rule of thumb إن الشخص إذا سرع عمر 18 يدخل\nالجامعة"
    },
    {
      "start": 366.0,
      "end": 370.0,
      "text": "لكن ليس بقانون إنه يجب أن يسرع عمر 18 يدخل\nالجامعة"
    },
    { "start": 370.0, "end": 371.0, "text": "لا، ليس شرط" },
    { "start": 371.0, "end": 373.0, "text": "لكن rule of thumb الغالبية" },
    { "start": 373.0, "end": 375.0, "text": "هذا يقول لكم" },
    { "start": 375.0, "end": 377.0, "text": "لكن من ناحية virtual ethics" },
    { "start": 377.0, "end": 380.0, "text": "لا يمديكم قللون أو تشيلون" },
    { "start": 380.0, "end": 383.0, "text": "يعني إن هذا قانون ثابت" },
    { "start": 383.0, "end": 385.0, "text": "لا، يجب أن يتغير عرفته" },
    {
      "start": 385.0,
      "end": 390.0,
      "text": "ليش؟ لأنه معتمد على الموقف والvirtual\ncharacteristics"
    },
    { "start": 390.0, "end": 391.06, "text": "بلين قال لكم" },
    { "start": 391.06, "end": 394.2, "text": "يعني مثلا" },
    { "start": 394.2, "end": 396.26, "text": "ان شخص يصير يثق فيك" },
    { "start": 396.26, "end": 397.94, "text": "هذا صفة كويسة" },
    {
      "start": 397.94,
      "end": 400.02,
      "text": "لازم وشوف اللي هنا حط لكم يا مثال"
    },
    {
      "start": 400.02,
      "end": 402.32,
      "text": "it is a good idea to follow the rule of\nthumb"
    },
    { "start": 402.32, "end": 403.52, "text": "اللي هو keep confidences" },
    {
      "start": 403.52,
      "end": 406.12,
      "text": "however under certain circumstances"
    },
    {
      "start": 406.12,
      "end": 408.46,
      "text": "keeping a confidence may not be the right\ncourse of action"
    },
    { "start": 408.46, "end": 409.92, "text": "مثلا خنقول" },
    { "start": 409.92, "end": 412.02, "text": "الحين زميلكم" },
    { "start": 412.02, "end": 414.08, "text": "والله جاب العيد" },
    { "start": 414.08, "end": 415.92, "text": "في مشروع ولو ما" },
    { "start": 415.92, "end": 418.32, "text": "تكلم بيكبر المشكلة" },
    { "start": 418.32, "end": 420.5, "text": "وممكن يذلقوا المشكلة بيفصلونا" },
    {
      "start": 420.5,
      "end": 426.48,
      "text": "بس إنه لو لو تكلم بيعطونا فرصة إنه\nويساعدونا يحلون المشكلة"
    },
    { "start": 426.48, "end": 428.42, "text": "بس إنه هو مستحي وخايف صح" },
    {
      "start": 428.42,
      "end": 433.22,
      "text": "فإحنا الـ rule of thumb إنه يعني عشان ما\nنخسر ثقة صديقنا"
    },
    {
      "start": 433.22,
      "end": 438.06,
      "text": "إنه نسكت ما نتكلم ما نفضحها ما نروح نسوي\nإعلان عن أغلطة"
    },
    {
      "start": 438.06,
      "end": 441.44,
      "text": "بس في نفس الوقت عشان كذا يسمونه rule of\nthumb"
    },
    {
      "start": 441.44,
      "end": 446.0,
      "text": "لأن الحين في هذا الموقف لا والله بروح\nأتكلم عشان ما صلحته"
    },
    {
      "start": 446.0,
      "end": 450.54,
      "text": "لأنه مستحي وخايف وما قاعد يفكر عن مصلحتها\nالمدى البعيد صح"
    },
    {
      "start": 450.54,
      "end": 454.02,
      "text": "فعشان كذا أنه rule of thumb مبقانون ثابت"
    },
    { "start": 454.02, "end": 455.74, "text": "عشان كذا يرجعون يكررون لكم" },
    {
      "start": 455.74,
      "end": 457.78,
      "text": "لأنه ما يصلح يصير a set of rules"
    },
    {
      "start": 457.78,
      "end": 461.74,
      "text": "خلاص أنه زي مثلاً el literalism اللي هو\nهذا النقطة هذه"
    },
    {
      "start": 461.74,
      "end": 464.14,
      "text": "ما يصلح لازم يصير كذا flexible"
    },
    { "start": 464.14, "end": 465.18, "text": "فعشان كذا يقال لكم" },
    {
      "start": 465.18,
      "end": 469.14,
      "text": "moral wisdom or disagreement takes\npredicence over any rule"
    },
    { "start": 469.14, "end": 470.04, "text": "يعني والشو" },
    { "start": 470.04, "end": 471.6, "text": "مثلاً أنا صحيح أنيقول لكم" },
    {
      "start": 471.6,
      "end": 474.62,
      "text": "اللي أكبر منكم بيوم عنده علم أكثر منكم\nبسنة"
    },
    { "start": 474.62, "end": 477.04, "text": "نفس الفكرة ان انا استخدم علمي" },
    { "start": 477.04, "end": 478.44, "text": "والدسكريشن حقي" },
    { "start": 478.44, "end": 479.36, "text": "عشان" },
    { "start": 479.36, "end": 482.64, "text": "اني اقيس الموقف" },
    { "start": 482.64, "end": 483.52, "text": "وانفذ" },
    { "start": 483.52, "end": 486.0, "text": "مو بخلاص قانون وانفذ للابد" },
    { "start": 486.0, "end": 488.22, "text": "فوش هذا الكلمة وش معناتها" },
    {
      "start": 488.22,
      "end": 490.6,
      "text": "معناتها the ability to judge things wisely"
    },
    { "start": 490.6, "end": 491.32, "text": "and accurately" },
    { "start": 491.32, "end": 494.88, "text": "يعني انا سوي تحاليل منطقية" },
    { "start": 494.88, "end": 496.44, "text": "واقعد اشوف" },
    { "start": 496.44, "end": 498.44, "text": "هل هذا الحالة تستدعي" },
    { "start": 498.44, "end": 499.52, "text": "ولا ما تستدعي" },
    { "start": 499.52, "end": 500.7, "text": "عرفته اقيس" },
    { "start": 500.7, "end": 503.38, "text": "لازم يصير عندي انا قياس" },
    { "start": 503.38, "end": 505.38, "text": "يعني موزون مو فاجأة" },
    {
      "start": 505.38,
      "end": 507.38,
      "text": "عرفتوا اللي يروحون يوزونون قهوة"
    },
    { "start": 507.38, "end": 509.38, "text": "ميزانهم والله ما يوزن زين" },
    { "start": 509.38, "end": 511.38, "text": "يعطيهم رقم مو بصاح" },
    { "start": 511.38, "end": 513.38, "text": "لا احنا نبي رقم الصاح" },
    { "start": 513.38, "end": 515.38, "text": "نبقى رقم دقيق نفس الفكرة" },
    {
      "start": 515.38,
      "end": 517.38,
      "text": "بالتصرفاتنا وقراراتنا اللي نتخذها"
    },
    { "start": 517.38, "end": 519.38, "text": "مبنية على تحاليننا" },
    { "start": 519.38, "end": 521.38, "text": "وبدين طبعا نكمل" },
    { "start": 521.38, "end": 523.38, "text": "إذا قال لكم هنا" },
    {
      "start": 523.38,
      "end": 525.38,
      "text": "there are two kinds of ritual ethics"
    },
    { "start": 525.38, "end": 527.38, "text": "أول شيء intellectual virtues" },
    { "start": 527.38, "end": 529.38, "text": "والمoral virtues" },
    { "start": 529.38, "end": 531.38, "text": "فكرة intellectual ان الهد" },
    { "start": 531.38, "end": 535.4, "text": "بالصدق و بالتحقيق و بالتحليل" },
    { "start": 535.4, "end": 536.5, "text": "reasoning and truth" },
    {
      "start": 536.5,
      "end": 540.0,
      "text": "يعني تخيلوا أحد يقول لكم الصدق و قاعدين\nتحللون"
    },
    { "start": 540.0, "end": 541.68, "text": "كذا سوون analyzation" },
    { "start": 541.68, "end": 543.02, "text": "عرفتوا قاعدين تفكرون بعمق" },
    { "start": 543.02, "end": 544.56, "text": "هنا عندكم moral virtues" },
    { "start": 544.56, "end": 545.76, "text": "هو لا ما يقول لك أنه" },
    { "start": 545.76, "end": 547.7, "text": "بس عن الصدق و بس كذا لا" },
    { "start": 547.7, "end": 548.88, "text": "قاعد يقول لكم أنه" },
    { "start": 548.88, "end": 550.84, "text": "اللي قاعدين اليوم يقولونه" },
    { "start": 550.84, "end": 552.8, "text": "أنه على طبع الإنسان" },
    { "start": 552.8, "end": 554.64, "text": "وش هو بالعادي ينفذ و يسوي" },
    { "start": 554.64, "end": 555.6, "text": "dispositions" },
    { "start": 555.6, "end": 556.72, "text": "يعني" },
    { "start": 556.72, "end": 557.52, "text": "قال لكم برضو" },
    {
      "start": 557.52,
      "end": 560.76,
      "text": "In a form through the repetition of\nrelevant virtuous actions"
    },
    { "start": 560.76, "end": 561.54, "text": "مثلا" },
    { "start": 561.54, "end": 563.12, "text": "الآن في هذا الزمن" },
    { "start": 563.12, "end": 566.14, "text": "ما نسميك كريم عقب مرة واحدة" },
    { "start": 566.14, "end": 567.3, "text": "من أنك تصير كريم" },
    { "start": 567.3, "end": 567.58, "text": "لا" },
    { "start": 567.58, "end": 569.26, "text": "والله فنان صار كريم مرة" },
    { "start": 569.26, "end": 569.88, "text": "عقب مرة" },
    { "start": 569.88, "end": 570.46, "text": "عقب مرة" },
    { "start": 570.46, "end": 571.06, "text": "عقب مرة" },
    { "start": 571.06, "end": 571.86, "text": "فخلاص" },
    { "start": 571.86, "end": 573.64, "text": "صار الآن وشتو دائرة" },
    { "start": 573.64, "end": 574.66, "text": "صارنا نشوف أنه" },
    { "start": 574.66, "end": 575.58, "text": "والله صرت كريم هنا" },
    { "start": 575.58, "end": 576.3, "text": "وصرت كريم هنا" },
    { "start": 576.3, "end": 577.02, "text": "وصرت كريم هنا" },
    { "start": 577.02, "end": 577.64, "text": "وصرت كريم هنا" },
    { "start": 577.64, "end": 579.6, "text": "فمعانا أن هذا عندك طبع" },
    { "start": 579.6, "end": 580.48, "text": "فيقول لكم" },
    { "start": 580.48, "end": 581.3, "text": "moral virtues" },
    { "start": 581.3, "end": 582.82, "text": "أن الطبع البشر" },
    { "start": 582.82, "end": 584.78, "text": "وكم مرة يكرر" },
    { "start": 584.78, "end": 585.68, "text": "هذا الشيء" },
    { "start": 585.68, "end": 586.94, "text": "اللي هو الصفة الكويسة" },
    {
      "start": 586.94,
      "end": 591.683,
      "text": "فعشان كاذا اجابه لكم طاري انه you can\ndevelop moral virtues of honesty مثلا كثير"
    },
    { "start": 591.683, "end": 591.92, "text": "صادق" },
    {
      "start": 591.92,
      "end": 597.2,
      "text": "by habitually يعني انتم كل مرة حطيتوا في\nموقف لازم تكونوا صادقين"
    },
    {
      "start": 597.2,
      "end": 604.324,
      "text": "تقولون الصدق هنا صرتوا يعني you developed\nthe moral virtue of honesty لانكم دايما"
    },
    { "start": 604.324, "end": 604.94, "text": "تقولونه" },
    {
      "start": 604.94,
      "end": 607.52,
      "text": "or again performing other honest actions"
    },
    {
      "start": 607.52,
      "end": 611.851,
      "text": "بعد يشوفوا عندكم الحين مثال ثاني اللي قال\nلكم consider someone who possesses the"
    },
    {
      "start": 611.851,
      "end": 613.8,
      "text": "virtue of honesty اللي هو يعني الصدق"
    },
    { "start": 613.8, "end": 632.98, "text": "وشو هالا الكلام معناته" },
    { "start": 632.98, "end": 633.74, "text": "شوفوا" },
    { "start": 633.74, "end": 636.22, "text": "أنا الحين لو كنت شخصيتي" },
    {
      "start": 636.22,
      "end": 638.62,
      "text": "ولا أعرف أني أنا صادق وما أكذب"
    },
    { "start": 638.62, "end": 641.48, "text": "بضايق إذا أنا كذبت" },
    { "start": 641.48, "end": 642.56, "text": "بضايق" },
    { "start": 642.56, "end": 645.46, "text": "لو أحد طلب مني أشارك معابل كذ" },
    { "start": 645.46, "end": 647.8, "text": "أنا أرفض تماما" },
    { "start": 647.8, "end": 649.76, "text": "لأنه طبعي" },
    { "start": 649.76, "end": 651.28, "text": "أنا أني ما أكذب" },
    { "start": 651.28, "end": 653.16, "text": "فأنا نصار عندي هذا التريت" },
    { "start": 653.16, "end": 654.26, "text": "هذا الصفة عني" },
    { "start": 654.26, "end": 655.14, "text": "يصير وشه" },
    { "start": 655.14, "end": 659.7, "text": "ما يحتاج أني أفكر" },
    { "start": 659.7, "end": 661.3, "text": "أو أقعد ألخكم" },
    { "start": 661.3, "end": 663.14, "text": "وقول هاي لازم" },
    { "start": 663.14, "end": 665.1, "text": "لا خلاص هذا شيء" },
    { "start": 665.1, "end": 666.98, "text": "أسوي بدون أفكر كذا" },
    { "start": 666.98, "end": 668.84, "text": "على طول مباشرة" },
    { "start": 668.84, "end": 669.86, "text": "وبدين قال لكم" },
    {
      "start": 669.86,
      "end": 672.4,
      "text": "A moral virtue is not simply a disposition"
    },
    {
      "start": 672.4,
      "end": 677.16,
      "text": "يعني مب والله في موقف معين خلاص أسوي هذا\nالشي بني خلاص أترك لا"
    },
    {
      "start": 677.16,
      "end": 680.4,
      "text": "It is also a disposition to feel in a\nparticular way"
    },
    {
      "start": 680.4,
      "end": 684.44,
      "text": "يعني مثلا أحد جاء قال شوفي بالله أكذبيلي"
    },
    { "start": 684.44, "end": 686.82, "text": "أنا قول لا والله ما أكذب لك" },
    { "start": 686.82, "end": 688.5, "text": "أنا مب طبعي كلا" },
    { "start": 688.5, "end": 690.82, "text": "مب بس يكفيني أنا ما أكذب لا لا" },
    {
      "start": 690.82,
      "end": 694.34,
      "text": "حتى أنت أني أشارك معك بكذبتك ما أكدر"
    },
    { "start": 694.34, "end": 695.76, "text": "According to Aristotle" },
    {
      "start": 695.76,
      "end": 699.4,
      "text": "You can tell a lot about someone's\ncharacter by observing what pleases them"
    },
    { "start": 699.4, "end": 702.32, "text": "كيف تعرفون الشخص" },
    { "start": 702.32, "end": 704.3, "text": "قدامكم إذا كان شخص كويس" },
    { "start": 704.3, "end": 705.4, "text": "ولي مبكويس" },
    { "start": 705.4, "end": 708.64, "text": "على حسب اللي يغريهم ويرضيهم" },
    { "start": 708.64, "end": 710.0, "text": "ولي ما يرضيهم" },
    { "start": 710.0, "end": 712.28, "text": "ترى مرة يلعب دور ويؤثر" },
    { "start": 712.28, "end": 713.78, "text": "والله واحد مثلا" },
    { "start": 713.78, "end": 716.52, "text": "عادي عنده أن صديقة" },
    { "start": 716.52, "end": 717.42, "text": "يكذب" },
    { "start": 717.42, "end": 720.5, "text": "ويروحي يسوي أشياء تصرفات" },
    { "start": 720.5, "end": 722.18, "text": "غلط معنات أن هذا شخص" },
    { "start": 722.18, "end": 723.44, "text": "مبكويس مبعادي" },
    {
      "start": 723.44,
      "end": 726.22,
      "text": "فشفتوا كيف أن تقدرون تميزون الشخص"
    },
    { "start": 726.22, "end": 728.54, "text": "على حسب وش هو يرضي وش ما يرضي" },
    {
      "start": 728.54,
      "end": 732.64,
      "text": "فمرة انتبهوا بغض النظر الكورس يعني صدق\nسخموا بحيات الواقعية"
    },
    { "start": 732.64, "end": 735.32, "text": "وبنين عندنا زيادة قال لكم هين" },
    {
      "start": 735.32,
      "end": 743.46,
      "text": "بعض الأشياء مرتبطة في مشاعرنا أكثر"
    },
    { "start": 743.46, "end": 745.04, "text": "في النهاية حين ترى بشر" },
    {
      "start": 745.04,
      "end": 748.822,
      "text": "فقال لكم كورج is a good example of a\nvirtue that has a close connection with"
    },
    { "start": 748.822, "end": 749.22, "text": "emotions" },
    {
      "start": 749.22,
      "end": 752.56,
      "text": "in order to be courageous you must be\nmoderate your fear"
    },
    {
      "start": 752.56,
      "end": 756.2,
      "text": "يعني ايش عشان أصير شجاع لازم يعني في نفس\nالوقت"
    },
    { "start": 756.2, "end": 758.72, "text": "خوف اللي يعني في طبيعة البشرة" },
    { "start": 758.72, "end": 760.02, "text": "اللي كنت أصير خايف شوي" },
    { "start": 760.02, "end": 761.58, "text": "لازم أتجاوزها" },
    { "start": 761.58, "end": 763.34, "text": "لازم يعني أصير" },
    { "start": 763.34, "end": 766.28, "text": "ما أخلي اللي خوف يتحكم فيني" },
    { "start": 766.28, "end": 767.26, "text": "عشان أصير شجاعة" },
    { "start": 767.26, "end": 768.16, "text": "فقال لكم هنا" },
    { "start": 768.16, "end": 769.12, "text": "امورال فرشو" },
    { "start": 769.12, "end": 770.12, "text": "is a deep-seated" },
    { "start": 770.12, "end": 771.32, "text": "يعني شيء داخل" },
    { "start": 771.32, "end": 773.06, "text": "كأنه بذرة جوة التراب" },
    { "start": 773.06, "end": 773.52, "text": "عرفتوا كيف" },
    { "start": 773.52, "end": 775.36, "text": "هنا ملائقين قولوا" },
    { "start": 775.36, "end": 775.9, "text": "هنا التراب" },
    { "start": 775.9, "end": 776.76, "text": "وهنا البذرة" },
    { "start": 776.76, "end": 778.34, "text": "كيف كيف مدفونا تحت تحت تحت" },
    { "start": 778.34, "end": 779.84, "text": "يعني شيء عميق جدا" },
    { "start": 779.84, "end": 781.86, "text": "وقال لكم صفة فيكم" },
    {
      "start": 781.86,
      "end": 784.94,
      "text": "and character traits take time to become\ndeep-seated"
    },
    {
      "start": 784.94,
      "end": 788.78,
      "text": "يعني ما أقولكم يوم يومين سنة سنتين ثلاث\nأربع"
    },
    {
      "start": 788.78,
      "end": 791.06,
      "text": "مبكي خمس سنوات عشان تصير عندكم هذا الصفة"
    },
    {
      "start": 791.06,
      "end": 795.88,
      "text": "يعني لازم فترة طويلة عشان يصير هذا الشيء\nمرة ثابت"
    },
    { "start": 795.88, "end": 796.98, "text": "بلنقلكم" },
    { "start": 796.98, "end": 802.62, "text": "يعني إيش" },
    { "start": 802.62, "end": 805.36, "text": "مثلا إذا كان والله شخص كريم" },
    { "start": 805.36, "end": 806.44, "text": "صفتها أنتم دائمين" },
    {
      "start": 806.44,
      "end": 808.84,
      "text": "إذا رحت المجلس تقول أوه هذا الشخص كريم"
    },
    {
      "start": 808.84,
      "end": 812.28,
      "text": "فجأة صار موقف هو ما صار كريم فيه"
    },
    { "start": 812.28, "end": 815.72, "text": "تعرفون ان هذا الشخص له سبب" },
    { "start": 815.72, "end": 818.76, "text": "في احد الغرف ولا في موقف صاير" },
    { "start": 818.76, "end": 821.2, "text": "مسبب لانه ما يكون كريم" },
    { "start": 821.2, "end": 822.88, "text": "وما يكون صادق" },
    { "start": 822.88, "end": 823.68, "text": "فيه سبب" },
    {
      "start": 823.68,
      "end": 825.94,
      "text": "هو شخص اذا كان عنده هذا الفيرتو"
    },
    { "start": 825.94, "end": 827.06, "text": "وفجأة ما سوا" },
    { "start": 827.06, "end": 828.54, "text": "عرفوا انه فيه سبب" },
    { "start": 828.54, "end": 829.82, "text": "وبدأ نكمل" },
    { "start": 829.82, "end": 831.36, "text": "الحين دخلنا بالفايس" },
    { "start": 831.36, "end": 832.46, "text": "الفايس زي ما قلت لكم" },
    { "start": 832.46, "end": 834.1, "text": "هو عكس الفيرتو" },
    { "start": 834.1, "end": 835.58, "text": "الفايس الاشياء" },
    { "start": 835.58, "end": 838.14, "text": "الصفات الشينا عن الانسان" },
    { "start": 838.14, "end": 840.14, "text": "اللي ما تخلي الانسان ينجح" },
    { "start": 840.14, "end": 841.98, "text": "ويصير يعني منعش" },
    { "start": 841.98, "end": 844.26, "text": "ولا يخليه حتى سيعيد" },
    { "start": 844.26, "end": 845.0, "text": "فهذه" },
    { "start": 845.0, "end": 857.62, "text": "يعني تخيلوا أنتم عندكم الحين" },
    { "start": 857.62, "end": 858.76, "text": "شيء كويس" },
    { "start": 858.76, "end": 861.9, "text": "بس عنده مرتبط بشيين" },
    { "start": 861.9, "end": 863.18, "text": "مو كويسة" },
    { "start": 863.18, "end": 865.24, "text": "شيء زايد" },
    { "start": 865.24, "end": 866.6, "text": "وشيء ناقص" },
    { "start": 866.6, "end": 867.74, "text": "وأنتم في النصف" },
    { "start": 867.74, "end": 869.9, "text": "هذا اللي قال لكم" },
    {
      "start": 869.9,
      "end": 875.58,
      "text": "هذا جاني كمسي كيو فمرة مهم هذا خصوصا اللي\nسويت لكم هايلايت بالأحمر والفوشي"
    },
    {
      "start": 875.58,
      "end": 880.8,
      "text": "قال لكم مثال الحين الكوريج انك تصير سجاع\nلازم يسرع انت بالوسط بين ايش"
    },
    {
      "start": 880.8,
      "end": 886.987,
      "text": "بين اول شي انك تصير مرة كاوردس مرة خواف\nيعني خنقوا جبان عرفت اللي مرة خواف خواف"
    },
    { "start": 886.987, "end": 887.3, "text": "خواف" },
    {
      "start": 887.3,
      "end": 894.762,
      "text": "ما يسوي شيء بعدين عندكم الراشنس المثلا\nالحين المراهق اللي ما يخاف اللي يعني ما"
    },
    { "start": 894.762, "end": 895.24, "text": "ينتبه" },
    {
      "start": 895.24,
      "end": 902.604,
      "text": "ما يحسب حساب لأنه فيه ممكن وفاة في الموضوع\nعرفتوه لازم توزنون بين هذا الشيين عشان"
    },
    { "start": 902.604, "end": 904.24, "text": "تصيرون يعني سجاعين" },
    {
      "start": 904.24,
      "end": 909.721,
      "text": "وبعد عندكم \"Friendliness\" انكم تصيرون\nكويسين مع الناس لازم اقان هذا الكلمة"
    },
    {
      "start": 909.721,
      "end": 914.24,
      "text": "\"Quoralsomeness\" لازم تصيرونه و\n\"Obscrueness\" هذا لازم تصيرين"
    },
    {
      "start": 914.24,
      "end": 918.995,
      "text": "هنا عندنا طبعا الاشياء لـ \"Virtue Ethics\"\nوالشو قال لكم \"In many situations it makes"
    },
    {
      "start": 918.995,
      "end": 923.24,
      "text": "more sense to focus on virtues than on\nobligations, rights or consequences\""
    },
    {
      "start": 923.24,
      "end": 928.64,
      "text": "يعني أحيانا إحنا ما نحتاج نفكر عن واجباتنا\nعن حقوقنا وعن العقابات"
    },
    { "start": 928.64, "end": 929.82, "text": "عشان نتخذ قرار" },
    {
      "start": 929.82,
      "end": 935.56,
      "text": "أحيانا إحنا مثلا طبيعتنا إحنا من جوة\nقلوبنا إحنا كذا"
    },
    {
      "start": 935.56,
      "end": 938.78,
      "text": "فما يحتاج ما نداعي نسوي كل هذه الثلاثة\nنقاط هذه"
    },
    {
      "start": 938.78,
      "end": 941.84,
      "text": "اللي إحنا نتكلم ندرسنا عنها في المورال\nالثانية"
    },
    {
      "start": 941.84,
      "end": 943.76,
      "text": "بل عندكم نقطة ثانية قال لكم أن"
    },
    {
      "start": 943.76,
      "end": 951.14,
      "text": "يعني مو شيء تمورد فيه يوم وليلة خلاص لا"
    },
    {
      "start": 951.14,
      "end": 956.46,
      "text": "هذا شيء خلال الوقت تتعلم دروس الحياة\nتتعلمك إياها زين وتبنيها"
    },
    {
      "start": 956.46,
      "end": 960.46,
      "text": "من النقطة الثالثة قال لكم أنه ما في نوع\nirreversible moral dilemmas"
    },
    {
      "start": 960.46,
      "end": 965.88,
      "text": "يعني مثلا زي الحين الكانتنزم إذا قال لكم\nperfect duty مع perfect duty"
    },
    { "start": 965.88, "end": 968.56, "text": "والله يلا ما في حل ونبلش" },
    {
      "start": 968.56,
      "end": 971.96,
      "text": "الحين جالسين كده الناظر المصائب وما في حل"
    },
    {
      "start": 971.96,
      "end": 975.76,
      "text": "هنا بالفيرتو أثيكس يقول لا ما في مشكلة ما\nتنحل"
    },
    { "start": 975.76, "end": 977.4, "text": "كل شيء يقدر ينحل" },
    {
      "start": 977.4,
      "end": 983.4,
      "text": "وفي آخر نقطة قال لكم أن \"Virtual Ethics\nrecognize the importance of emotions\""
    },
    {
      "start": 983.4,
      "end": 989.9,
      "text": "طبعاً أفضل شيء عن \"Virtual Ethics\" هو أن\nيتذكر أننا بشر"
    },
    {
      "start": 989.9,
      "end": 995.4,
      "text": "بشر والبشر يسوي أغلاطه عنده مشاعر"
    },
    { "start": 995.4, "end": 999.4, "text": "يعني إحنا ليس نفكر بالمنطق" },
    { "start": 999.4, "end": 1002.4, "text": "وبعكل عقلنا نفكر بمشاعرنا" },
    {
      "start": 1002.4,
      "end": 1005.4,
      "text": "فلازم يعني إحنا حسب هذا الحساب"
    },
    {
      "start": 1005.4,
      "end": 1008.8,
      "text": "وهذا فائدة ان Virtue Ethics يحسب حساب\nمشاعرنا"
    },
    { "start": 1008.8, "end": 1011.76, "text": "وبين طبعا فيه اشياء من عيوبة" },
    {
      "start": 1011.76,
      "end": 1015.36,
      "text": "وترى هذا النقطة الثانية جاني امسكيو فمرة\nمرة مرة مرة مهم انكم تحرفونا"
    },
    {
      "start": 1015.36,
      "end": 1018.4,
      "text": "ولكن دعونا نبدأ بأول نقطة قال لكم ان اول\nشيء"
    },
    {
      "start": 1018.4,
      "end": 1022.4,
      "text": "\"الدفرين بيبول مي هاف كوائد دفرين\nكونسيبشن\""
    },
    {
      "start": 1022.4,
      "end": 1027.8,
      "text": "يعني انا ما اشوف مثلا ان واحد يتخرج من\nالجامعة"
    },
    {
      "start": 1027.8,
      "end": 1032.9,
      "text": "هو يعني شيء يسبب ان الواحد يسر حياته كويسة\nوانه ناجح"
    },
    { "start": 1032.9, "end": 1033.9, "text": "انا ما اشوف هذا شيء" },
    {
      "start": 1033.9,
      "end": 1039.514,
      "text": "وفلان ثاني يقول لا والله أنا أحس إنه لازم\nالناس يروحون للجامعة من حيث إنه يصيرون"
    },
    {
      "start": 1039.514,
      "end": 1041.76,
      "text": "يعني ناجحين بالحياة وفاهمين وكذا"
    },
    {
      "start": 1041.76,
      "end": 1048.737,
      "text": "بالنقطة الثانية يقول لك إنه فيرشو أثيكس ما\nيقدرون يستخدمونها الحكومة عشان ينفذون"
    },
    { "start": 1048.737, "end": 1049.26, "text": "قوانين" },
    {
      "start": 1049.26,
      "end": 1053.24,
      "text": "يعني وشو بيقول لكم كانت أو كانت نوت لا"
    },
    {
      "start": 1053.24,
      "end": 1059.689,
      "text": "لازم ترى النقطة هذه مرة مرة مرة مرة مرة\nمرة مرة مرة مرة مرة مرة لكم تعرفون إنه إيش"
    },
    { "start": 1059.689, "end": 1061.34, "text": "الحكومة ما تقدر تطبقه" },
    {
      "start": 1061.34,
      "end": 1063.44,
      "text": "والنقطة الثالثة والأخيرة اللي هي"
    },
    {
      "start": 1063.44,
      "end": 1071.46,
      "text": "يعني إيش؟ يعني إذا واحد كان تصرفاته وصخة"
    },
    {
      "start": 1071.46,
      "end": 1073.62,
      "text": "ولا قليلة أدب ولا ما لها أي سنة"
    },
    {
      "start": 1073.62,
      "end": 1079.4,
      "text": "ما يحط يعني عقبات أو يقول إن هيا فلان ترك\nخلطان"
    },
    { "start": 1079.4, "end": 1081.86, "text": "أو إن تصرفك غلط إن إمورال" },
    { "start": 1081.86, "end": 1084.5, "text": "مشكلة هذا بحد ذاته" },
    {
      "start": 1084.5,
      "end": 1088.56,
      "text": "وبس والله هذا آخر تشابتر في الأثيكال تيريز"
    },
    {
      "start": 1088.56,
      "end": 1091.14,
      "text": "إذا عندكم أي استفسار أو أي مشكلة"
    },
    { "start": 1091.14, "end": 1092.76, "text": "تواصلوا معي على الواتس" }
  ]
}
