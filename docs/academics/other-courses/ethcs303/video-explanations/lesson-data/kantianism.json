start":1385.72,"end":1387.08,"text":"احنا في نهاية انسان"},{"start":1387.08,"end":1388.44,"text":"بدنا نقال لكم"},{"start":1388.44,"end":1391.1,"text":"يعني احيانا"},{"start":1391.1,"end":1395.08,"text":"الفعل الواحد يمكن أن تضع عليه ألف مليون\nقانون"},{"start":1395.08,"end":1398.6,"text":"كانتينيزم's framework may not know which\nrule to apply"},{"start":1398.6,"end":1402.42,"text":"يعني حين هذا الموقف كأي قانون بالضبط طبقة"},{"start":1402.42,"end":1404.2,"text":"طبعاً وآخر شيء"},{"start":1404.2,"end":1406.14,"text":"إذا قال لك two perfect duties conflict"},{"start":1406.14,"end":1412.98,"text":"طبعاً قلنا أن ال perfect مع ال perfect ما\nيملكهم يعني تتجاوزونه"},{"start":1412.98,"end":1414.44,"text":"كلهم نفس اللفل"},{"start":1414.44,"end":1416.8,"text":"عموماً على قوة هنا البتم لاين"},{"start":1416.8,"end":1427.76,"text":"هذا احفظه زي اسمكم لانه ممكن جدا يجيكم\nسؤال يقولكم هل هذا الثيري ورقبل ولا لا"},{"start":1427.76,"end":1430.0,"text":"ليش هو ورقبل لانه راشنال"},{"start":1430.0,"end":1430.94,"text":"كونسسطنت"},{"start":1430.94,"end":1431.9,"text":"ورسبكتفول"},{"start":1431.9,"end":1435.0,"text":"يحترم البشر"},{"start":1435.0,"end":1441.68,"text":"و الى الان يعني القوانين ما زال تستخدم بعض\nالبرفشنال اثيكس"},{"start":1441.68,"end":1444.18,"text":"طبعا الحين بتشوفوه in section 8"},{"start":1444.18,"end":1447.94,"text":"ابيكم تتعودون انكم تسوونها بالحالكم"},{"start":1447.94,"end":1449.54,"text":"وتحاولون تختبرون نفسكم"},{"start":1449.54,"end":1451.08,"text":"اذا عرفتوا الديفنيشن ولا لا"},{"start":1451.08,"end":1453.62,"text":"برضو سكشن ناين هو عبارة عن"},{"start":1453.62,"end":1454.38,"text":"كويك كويز"},{"start":1454.38,"end":1456.54,"text":"ابيكم تختبرون نفسكم وتشوفون"},{"start":1456.54,"end":1458.1,"text":"كيف يعني"},{"start":1458.1,"end":1460.5,"text":"اجاباتكم هل قاعدين جاوبون صح او لا"},{"start":1460.5,"end":1461.86,"text":"اذا ما قاعدوا جاوبون صح"},{"start":1461.86,"end":1464.48,"text":"يعيدوا المقطع او اقروا بدقة"},{"start":1464.48,"end":1466.1,"text":"وانتبهوا يعني احرصوا"},{"start":1466.1,"end":1468.52,"text":"وزائد هنا هذا ال past exam"},{"start":1468.52,"end":1469.86,"text":"لاحظوا انه مكتوب past exam"},{"start":1469.86,"end":1470.86,"text":"ومكتوب من وين جاء"},{"start":1470.86,"end":1473.68,"text":"فصديق هذا ركزوا عليه"},{"start":1473.68,"end":1475.92,"text":"لأن هذا اللي قد جاهز صديق بالاختبارة\nالماضية"},{"start":1475.92,"end":1478.58,"text":"شكراً لاستماعكم إذا عندكم أي استفسار"},{"start":1478.58,"end":1480.14,"text":"تواصلوا معاي خلال الواتس"}]}