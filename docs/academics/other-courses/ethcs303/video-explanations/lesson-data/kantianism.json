{"id":"kantianism","title":"Kantianism","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/kantianism-mp4.mp4","page":"/academics/other-courses/ethcs303/video-explanations/kantianism/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/kantianism.vtt","chapters":[{"time":0,"title":"Introduction"},{"time":194.66,"title":"Reason and good will"},{"time":358.96,"title":"Universalizability"},{"time":504.02,"title":"Categorical imperatives"},{"time":650.02,"title":"Treating people as ends"},{"time":731.2,"title":"Perfect and imperfect duties"},{"time":908.08,"title":"Conflicting duties"},{"time":1001.82,"title":"Worked cases"},{"time":1199.6,"title":"The murderer-at-the-door example"}],"transcript":[{"start":0.0,"end":2.2,"text":"طبعاً وش هو عبارة عن"},{"start":2.2,"end":3.76,"text":"قال لكم هنا الماستر مناوميكس"},{"start":3.76,"end":5.54,"text":"احنا زي ما قلت لكم المقلع سابق"},{"start":5.54,"end":8.34,"text":"أنا مناوميكس الطريقة اللي تاعدكم كيف\nتحفظونها"},{"start":8.34,"end":11.1,"text":"عندكم الحين دي يو جي سي"},{"start":11.1,"end":13.0,"text":"احفظوا كده"},{"start":13.0,"end":14.04,"text":"دي يو جي سي"},{"start":14.04,"end":21.22,"text":"وش معناتها طبعاً دوتي واضحة"},{"start":21.22,"end":24.12,"text":"وش واجبك عليك وش متلزماتك في الحياة هكذا"},{"start":24.12,"end":31.92,"text":"\"universality\" هذا أن هل الحين لو رحت\nللهند بيسوون نفسي اللي أنا قلت أسويه ولي"},{"start":31.92,"end":32.12,"text":"لا"},{"start":32.12,"end":38.303,"text":"\"goodwill\" طبعا أنا ممكن أسوي الشيء ما\nعشان أربح من وراك أو أخذ شيء، لا بس عشان"},{"start":38.303,"end":41.12,"text":"أنا شخص كويس وأن هذا يعني \"goodwill\""},{"start":41.12,"end":47.12,"text":"وبنمناخذ الكاتيجوركال \"imperative\" مرة و\nمرة بناخذ بشكل عميق بس مو بالحين انتظرو"},{"start":47.12,"end":51.64,"text":"من كانت مختصر الى كانت نظم"},{"start":51.64,"end":54.24,"text":"قال لكم انه بورن في المانيا"},{"start":54.24,"end":56.24,"text":"وهذا كلها مهمة"},{"start":56.24,"end":58.24,"text":"نحن نبغى أصلا نسوي الاسكب"},{"start":58.24,"end":59.32,"text":"لأن الابد مهم"},{"start":59.32,"end":61.76,"text":"بس اممكن اعرفوا السنة واسمه"},{"start":61.76,"end":63.84,"text":"بس الباقي يعني هو بدرس"},{"start":63.84,"end":65.6,"text":"هستري بالموضوع في النهاية"},{"start":65.6,"end":68.03999999999999,"text":"عموما خل روح صدق لل"},{"start":68.03999999999999,"end":69.03999999999999,"text":"core framework"},{"start":69.03999999999999,"end":70.6,"text":"وشو يقول لكم هنا"},{"start":70.6,"end":72.72,"text":"اللي هو أصلا شخصيا قاله"},{"start":72.72,"end":75.2,"text":"what makes an action right or wrong"},{"start":75.2,"end":77.1,"text":"is the principle inherent in the action"},{"start":77.1,"end":78.52,"text":"not its consequences"},{"start":78.52,"end":80.7,"text":"يعني بغض النظر"},{"start":80.7,"end":82.7,"text":"العقاب انا بغعرف"},{"start":82.7,"end":84.76,"text":"ليش سويت هذا الشي"},{"start":84.76,"end":86.92,"text":"انا بغعرف ان السبب انك"},{"start":86.92,"end":89.2,"text":"سويت هذا الشي هو اللي بيبين"},{"start":89.2,"end":90.66,"text":"او صح او غلط"},{"start":90.66,"end":92.32,"text":"وليس العقاب"},{"start":92.32,"end":94.24000000000001,"text":"حطو عليه عشر خطوط"},{"start":94.24000000000001,"end":96.7,"text":"طبعا قال لكم اول شي"},{"start":96.7,"end":97.56,"text":"duty based"},{"start":97.56,"end":99.34,"text":"morality comes from obligations"},{"start":99.34,"end":101.08,"text":"humans have to each other"},{"start":101.08,"end":103.36,"text":"not from what produces"},{"start":103.36,"end":104.24000000000001,"text":"the best outcome"},{"start":104.24000000000001,"end":110.82,"text":"مثلا بر الوالدين هذا واجب عليكم بغض النظر\nهم اعطوكم مكافآت او اي شي"},{"start":110.82,"end":116.82,"text":"هذا يعني الواجب اللي عليك من انت الى اهلك"},{"start":116.82,"end":120.16,"text":"عشان كذي قال لكم obligations human have to\neach other"},{"start":120.16,"end":125.46,"text":"بل عندكم ال universal طبعا قلت لكم انه\nلازم يكون يطبق في كل زمن في كل مكان"},{"start":125.46,"end":127.44,"text":"يعني بغض النظر الموقف"},{"start":127.44,"end":132.62,"text":"مثلا الحين احنا سوينا universalization لل\nloyalty"},{"start":132.62,"end":135.7,"text":"او مثلاً الـ honesty يعني انك تصير صادق"},{"start":135.7,"end":139.56,"text":"يعني الحين اذا رحت المانيا رحت سويسرا رحت\nالفلبين"},{"start":139.56,"end":143.8,"text":"اي منطق في الدين بيقولون لك انه لازم تكون\nصادق"},{"start":143.8,"end":146.1,"text":"هذا شيء سوينا لـ universalize"},{"start":146.1,"end":147.48,"text":"بنعندكم الحين equality"},{"start":147.48,"end":152.1,"text":"اللي هو عبارة عن انكم تحكمون وتعاملون\nبعدالة واحترام"},{"start":152.1,"end":154.68,"text":"اوكي يقولكم ان الناس"},{"start":154.68,"end":156.98,"text":"اذا كان خصوصاً في مواقف مشابهة"},{"start":156.98,"end":159.18,"text":"انه لازم تحكمون عليهم نفس الحكم"},{"start":159.18,"end":161.64,"text":"مثلاً خلنقول انا الحين دكتورة بالجامعة"},{"start":161.64,"end":163.88,"text":"سربت يعني الاختبار"},{"start":163.88,"end":166.54,"text":"وبرينفيدي وطالب برضو سرب الاختبار"},{"start":166.54,"end":169.56,"text":"احنا لازم ينحكم علينا نفس الحكم"},{"start":169.56,"end":172.42000000000002,"text":"يصير يعني كلنا ننفصل مثلا"},{"start":172.42000000000002,"end":175.22,"text":"انا كدكتورة وهو كطالب"},{"start":175.22,"end":177.52,"text":"كلنا خلاصين يعني نتخلى من الجامعة"},{"start":177.52,"end":179.94,"text":"بسبة الجريمة اللي سويناها"},{"start":179.94,"end":182.62,"text":"بنا عندكم نحين اخر شيء اللي هو اللوجكل"},{"start":182.62,"end":183.36,"text":"قال لكم"},{"start":183.36,"end":188.92,"text":"يعني في سبب مشاعر"},{"start":188.92,"end":194.66,"text":"يعني مشاعري ممكن أصلاً عكس السبب بس إنه\nلازم يكون فيه سبب"},{"start":194.66,"end":199.3,"text":"قال لكم أكانتن can always explain why an\naction is right or wrong"},{"start":199.3,"end":203.14,"text":"يعني أنا مو أشرح لك والله أنا أحس إن هذا\nالشي غلط"},{"start":203.14,"end":206.62,"text":"لا أنا أقدر أشرح لك ليش هذا الشي غلط وليش\nهذا الشي صح"},{"start":206.62,"end":209.0,"text":"عند نحن تو سابقاً جبنا تاري goodwill"},{"start":209.0,"end":212.72,"text":"إنه يعني مو شي أسوي عشان أربع أخذ شي منكم"},{"start":212.72,"end":215.92000000000002,"text":"أو عشان أنا أرفع نفسي أو نحن بعد نفسفس فيه"},{"start":215.92000000000002,"end":220.74,"text":"قالكم can't argue that intelligence,\nwealth and talent are not always good"},{"start":220.74,"end":223.94,"text":"يعني الحين احنا بلعاد نقول والله انا اذا\nصرت غنية"},{"start":223.94,"end":227.86,"text":"يعني شي خرافي اذا انا كان عندي الصحة والفن"},{"start":227.86,"end":229.04,"text":"يعني شي خرافي"},{"start":229.04,"end":232.52,"text":"بس شوفوا الناس اذا كان عندهم هذا اشياء"},{"start":232.52,"end":235.1,"text":"وهم خلقه كانوا ناس موب كويسين"},{"start":235.1,"end":238.14,"text":"هذا الشي طبعا يقدر استخدم ضد كل خلق الله"},{"start":238.14,"end":239.76,"text":"فموب شي كويس"},{"start":239.76,"end":242.62,"text":"يعني شو اند العلم اللي حنا قاعدين نحاول\nجيبة"},{"start":242.62,"end":244.52,"text":"افرضوا والله انت هاكر"},{"start":244.52,"end":245.6,"text":"دعا تهاكر الناس"},{"start":245.6,"end":247.34,"text":"يعني اوكي قاعد تستخدم العلم"},{"start":247.34,"end":249.74,"text":"بس هل هو قاعد تستخدم بطريقة صحيحة"},{"start":249.74,"end":250.58,"text":"لا طبعا"},{"start":250.58,"end":252.52,"text":"فعشان كده قال لكم ان هذا الاشياء"},{"start":252.52,"end":255.36,"text":"مبدايما تستخدم الاسباب كويسة"},{"start":255.36,"end":257.14,"text":"They can always be used for evil"},{"start":257.14,"end":260.64,"text":"The only thing that is unconditionally\ngood is a good will"},{"start":260.64,"end":262.28,"text":"النية الزينة"},{"start":262.28,"end":263.48,"text":"النية الطيبة"},{"start":263.48,"end":267.86,"text":"The motivation to do the right thing\nsimply because it is right"},{"start":267.86,"end":271.24,"text":"يعني مثلا انا الحين شفت والله صار حادث"},{"start":271.24,"end":274.54,"text":"بوقف انا حتى لو انا كنت عندي مثلا اختبار"},{"start":274.54,"end":275.76,"text":"أو متأخرة على موعد"},{"start":275.76,"end":278.3,"text":"بوقف وبساعد لأن أنا أدري"},{"start":278.3,"end":279.54,"text":"أن هذا الشيء الصح"},{"start":279.54,"end":280.52,"text":"قال لكم طبعاً هنا"},{"start":280.52,"end":282.76,"text":"عندي تب يعني أنكم كيف تحفظونه"},{"start":282.76,"end":284.94,"text":"أن العقبات"},{"start":284.94,"end":286.82,"text":"ما تحتسب مع كانتانيزم"},{"start":286.82,"end":289.38,"text":"العقبات ما تحتسب"},{"start":289.38,"end":290.74,"text":"هذا لازم أعيد مرتين"},{"start":290.74,"end":292.32,"text":"عشان صدق تستوعبون لأن في"},{"start":292.32,"end":294.76,"text":"بعدين ندرس عن اليوتيلاتيزم"},{"start":294.76,"end":295.7,"text":"وهذا العكس"},{"start":295.7,"end":297.08,"text":"قال لكم هنا"},{"start":297.08,"end":299.94,"text":"كانت is the opposite of the ends justify\nthe means"},{"start":299.94,"end":301.78,"text":"a surgeon who accidentally"},{"start":301.78,"end":311.78,"text":"وهذا مثالين"},{"start":311.78,"end":314.78,"text":"وهذا مثالين"},{"start":314.78,"end":318.78,"text":"أنا جراح قتلت شخص بالغلط"},{"start":318.78,"end":320.78,"text":"طبعاً لو كنا من الوليوتاريزم"},{"start":320.78,"end":323.78,"text":"نقول أن هذا الشخص غلطان"},{"start":323.78,"end":326.78,"text":"كان مرة عظيم"},{"start":326.78,"end":328.78,"text":"مرة كبير"},{"start":328.78,"end":329.78,"text":"بس نحن بالكانتنزم"},{"start":329.78,"end":331.08,"text":"نحن نشوف النية"},{"start":331.08,"end":333.7,"text":"نيتا انه كان ينقذ هذا الشخص"},{"start":333.7,"end":335.68,"text":"عدل قدر الله توفق"},{"start":335.68,"end":338.38,"text":"معنات انه دامنا نيتا كويسة"},{"start":338.38,"end":339.02,"text":"فهو"},{"start":339.02,"end":341.96,"text":"والحرامي"},{"start":341.96,"end":343.12,"text":"اللي يسرق"},{"start":343.12,"end":345.24,"text":"وانقذ شخص بالصدفة"},{"start":345.24,"end":346.58,"text":"ما زال حرامي"},{"start":346.58,"end":348.06,"text":"فهو نيتا"},{"start":348.06,"end":349.56,"text":"انه يسرق"},{"start":349.56,"end":352.08,"text":"فهو شخص"},{"start":352.08,"end":353.15999999999997,"text":"شين شخص"},{"start":353.15999999999997,"end":354.46,"text":"تصرفاته"},{"start":354.46,"end":358.2,"text":"رغم انه انقذ شخص بالغلط"},{"start":358.2,"end":358.96,"text":"بالصدفة"},{"start":358.96,"end":362.12,"text":"من الآن عندنا النقطة الثاثة اللي هو\nuniversability"},{"start":362.12,"end":366.68,"text":"هذا الشيء إحنا نعرف إذا كان كانتنزم ولا لا"},{"start":366.68,"end":369.14,"text":"إذا إحنا نقدر نتويله universability"},{"start":369.14,"end":370.94,"text":"قال لكم"},{"start":370.94,"end":373.3,"text":"The key tests in Canton ethics"},{"start":373.3,"end":376.58,"text":"Could this rule work if everyone followed\nit"},{"start":376.58,"end":379.94,"text":"If the rule self-destructs when\nuniversalized it's more long"},{"start":379.94,"end":384.18,"text":"وش قصته من الآن إذا كان القانون\nself-destructs when universalized"},{"start":384.18,"end":387.32,"text":"مثلا أنا الآن وعدت شخص"},{"start":387.32,"end":389.12,"text":"انا كنت في موقف مرة صعب"},{"start":389.12,"end":389.9,"text":"مرة صعب"},{"start":389.9,"end":391.96,"text":"وقلت له يا فلان اذا ساعدتني"},{"start":391.96,"end":394.08,"text":"بسوي اللي تبي باوعدك وعد"},{"start":394.08,"end":396.32,"text":"وانا داريا وانا اوعد ذا الوعد"},{"start":396.32,"end":397.42,"text":"اني نصابة"},{"start":397.42,"end":398.84000000000003,"text":"اني مو بسويت لك شي"},{"start":398.84000000000003,"end":400.68,"text":"بس ان انا ابغاك تساعدني بهذا اللحظة"},{"start":400.68,"end":403.58,"text":"افرضوا طبقت هذا الشي عالميا"},{"start":403.58,"end":406.82,"text":"هل تتوقعون ان الناس بيثقون بالوعد"},{"start":406.82,"end":407.6,"text":"لا"},{"start":407.6,"end":408.65999999999997,"text":"فخلاص"},{"start":408.65999999999997,"end":413.06,"text":"الوعد ما صار له قيمة"},{"start":413.06,"end":415.22,"text":"فهذا القانون ما يقدر يكون"},{"start":415.22,"end":417.58,"text":"وعشان كده يقول لكم"},{"start":417.58,"end":418.8,"text":"ان it's self-destruct"},{"start":418.8,"end":421.76,"text":"فأنتم فكروا إذا قروا لكم هل هذا القانون"},{"start":421.76,"end":423.66,"text":"يعني كويز من ناحية"},{"start":423.66,"end":424.58,"text":"اللي كانت النزم ولا لا"},{"start":424.58,"end":426.98,"text":"إذا يمديكم تخلون تسمحون"},{"start":426.98,"end":429.44,"text":"لكل الناس بالعالم يساوونه"},{"start":429.44,"end":431.44,"text":"إذا ما زالوا يطبقونه"},{"start":431.44,"end":433.44,"text":"فإيس إذا ما طبقوا لا"},{"start":433.44,"end":434.98,"text":"طبعا عندكم step 1"},{"start":434.98,"end":437.54,"text":"اللي هو identify the rule behind your\naction"},{"start":437.54,"end":439.42,"text":"يعني زي ما هنا"},{"start":439.42,"end":441.08,"text":"يعطيكم مثال أنا بكذب"},{"start":441.08,"end":442.42,"text":"لأنه بيساعدني"},{"start":442.42,"end":448.3,"text":"إلقوا إلقوا القانون وأنا الفعل دوروا\nالقانون"},{"start":448.3,"end":449.1,"text":"اللي كان أطبقه"},{"start":449.1,"end":450.64,"text":"بعدين رقم اثنين"},{"start":450.64,"end":451.68,"text":"إنكم تسوونا"},{"start":451.68,"end":454.54,"text":"إذا كان كل الناس"},{"start":454.54,"end":458.4,"text":"وبعدين هنا"},{"start":458.4,"end":466.32,"text":"لأن الناس خلاص بزماجة ممصدقين الوعد"},{"start":466.32,"end":469.12,"text":"فلا صار الحين ما لقيمة"},{"start":469.12,"end":472.14,"text":"البردكة: \"itself-destructs\"\n\"morally-wrong\""},{"start":472.14,"end":475.64,"text":"اذا تبقى، طبعا، لاحظوا حتى\n\"potentially-right\""},{"start":475.64,"end":478.86,"text":"يعني، مو بشرط مية بالمية انه كويس"},{"start":478.86,"end":483.0,"text":"هنا قال لكم \"can be universalized\" قال لك\n\"telling the truth\""},{"start":483.0,"end":486.5,"text":"\"if everyone told the truth\"\n\"communication works perfectly\" يعني"},{"start":486.5,"end":490.68,"text":"كويس لان الناس كلهم بيثقون بكل الناس"},{"start":490.68,"end":492.32,"text":"بس وش اللي ما يقدر مثلا"},{"start":492.32,"end":494.4,"text":"الجرائم اللي قتل، الذبح"},{"start":494.4,"end":498.08,"text":"انه الان لو قعدنا نذبح كل خلق اللي اللي ما\nنحبهم"},{"start":498.08,"end":500.38,"text":"ما في بشر بيبقى بالدنيا"},{"start":500.38,"end":502.0,"text":"طبعا عشان كده"},{"start":502.0,"end":504.02,"text":"ما يقدر يكون universalized"},{"start":504.02,"end":506.14,"text":"والآن عندكم السكشن الرابع"},{"start":506.14,"end":507.88,"text":"The Categorial Imperatives"},{"start":507.88,"end":510.46,"text":"عندكم ترى قانونين"},{"start":510.46,"end":512.24,"text":"ولاحظوا هنا ان مكتوب"},{"start":512.24,"end":514.0,"text":"Unconditional Moral Law"},{"start":514.0,"end":515.76,"text":"عرفتوا يعني معناتها"},{"start":515.76,"end":517.52,"text":"ان مهما كان"},{"start":517.52,"end":519.58,"text":"رغبتك مهما كان"},{"start":519.58,"end":522.02,"text":"حالتك مهما كان هدفك"},{"start":522.02,"end":523.52,"text":"يعني انا ما يهمني"},{"start":523.52,"end":526.06,"text":"وش يعني نفسيتك"},{"start":526.06,"end":527.78,"text":"مشاعرك"},{"start":527.78,"end":530.7,"text":"أي شيء أي شيء مرة مرة هو ما لا علاقة فيك"},{"start":530.7,"end":533.46,"text":"هو يطبق بغض النظر أنت سمين"},{"start":533.46,"end":534.3,"text":"عرفته"},{"start":534.3,"end":535.66,"text":"وفيه two formulas"},{"start":535.66,"end":537.96,"text":"الأول يقول لك تسأل نفسك"},{"start":537.96,"end":540.36,"text":"هل هذا القانون يمديني أسوينا universal"},{"start":540.36,"end":541.46,"text":"ولا لا"},{"start":541.46,"end":543.78,"text":"هل يعني كل الخلق الله اللي بالعالم"},{"start":543.78,"end":545.7,"text":"ده الكوكب يقدرون يطبقونه"},{"start":545.7,"end":547.5,"text":"وبيستمرون يطبقونه"},{"start":547.5,"end":550.3,"text":"حطوا عشر خطوط كلمة يستمرون"},{"start":550.3,"end":552.56,"text":"لو إيه فكويس"},{"start":552.56,"end":554.26,"text":"وعندكم القانون الثاني"},{"start":554.26,"end":554.92,"text":"اللي يقول لك"},{"start":554.92,"end":558.12,"text":"\"Treat people as an end, never merely as\nends\""},{"start":558.12,"end":559.12,"text":"يعني وشو"},{"start":559.12,"end":563.12,"text":"أنتم ما تترحون تستخدمون و تستغلون خلق الله"},{"start":563.12,"end":565.52,"text":"عشان بس أنتم تستفيدون"},{"start":565.52,"end":568.52,"text":"والبقية يعني صيرون متأزمين"},{"start":568.52,"end":571.02,"text":"أو ما يربحون معاك"},{"start":571.02,"end":572.92,"text":"لا يصيرون بس كذا \"tools\""},{"start":572.92,"end":577.42,"text":"البشر مبتوز يعني هم مفروض تستخدمهم as ends"},{"start":577.42,"end":578.72,"text":"بس مبتأزمين"},{"start":578.72,"end":580.42,"text":"يعني ما تستغل لهم"},{"start":580.42,"end":582.92,"text":"طبعا خلونا نفصفص زيادة بالفورمولة الأولى"},{"start":582.92,"end":584.92,"text":"اللي عبارة عن الـ \"Universability\""},{"start":584.92,"end":588.92,"text":"قال لكم ان تصرف و \"Act\""},{"start":588.92,"end":592.92,"text":"بالقوانين اللي تقدر تصير \"Universal\""},{"start":592.92,"end":598.253,"text":"قال لكم هنا \"Act only on a maximum that\nyou could will to become a universal law"},{"start":598.253,"end":598.92,"text":"of nature\""},{"start":598.92,"end":604.501,"text":"يعني انت اذا حست هذا القانون يقدر يطبق في\nمصر في الهند في الالبين في السعودية في"},{"start":604.501,"end":604.92,"text":"امريكا"},{"start":604.92,"end":606.92,"text":"فايه استمر بهذا الشيء"},{"start":606.92,"end":608.92,"text":"مثلا حين اعطوكم مثال"},{"start":608.92,"end":611.0,"text":"مثال انك تكسر وعد"},{"start":611.0,"end":612.86,"text":"هذا نفس هذا اللي سويت"},{"start":612.86,"end":614.98,"text":"شرحت لكم اياه مرة حلو"},{"start":614.98,"end":616.48,"text":"هذا المثال لانه يعني"},{"start":616.48,"end":619.06,"text":"صدقي يوريكم قيمة"},{"start":619.06,"end":620.86,"text":"انكم تمسكون الوعد"},{"start":620.86,"end":622.5,"text":"انكم ما تكسرونه"},{"start":622.5,"end":624.74,"text":"لان اذا اكسرتوه خلاص الناس"},{"start":624.74,"end":626.5,"text":"مو بصيرين واثقين في الوعد"},{"start":626.5,"end":628.6,"text":"وانه ما يطبقون الوعد"},{"start":628.6,"end":630.74,"text":"فانتم شفتوا كيف انتم اخسرتو هذا الشي"},{"start":630.74,"end":631.72,"text":"عموان"},{"start":631.72,"end":634.84,"text":"عندكم الثانية اللي هو اهم"},{"start":634.84,"end":636.58,"text":"شي وحسنا حتى"},{"start":636.58,"end":638.1,"text":"كيف فهم"},{"start":638.1,"end":643.06,"text":"يعني بيكون لازم تستوعبونا مية مية عشان\nتقدرون تحللون"},{"start":643.06,"end":649.42,"text":"دائما تستخدمون الناس as ends in themselves\nnever merely as ends"},{"start":649.42,"end":650.02,"text":"وش قصده"},{"start":650.02,"end":654.14,"text":"act so that you treat both yourself and\nother people as ends"},{"start":654.14,"end":658.1,"text":"اقوى يعني هول احدا شوف لاحظوا ان كيف كل\nشوي يكرر يكرر يكرر"},{"start":658.1,"end":660.54,"text":"حتى بصلايز بتشوفون ان يكرر يكرر يكرر يكرر"},{"start":660.54,"end":661.82,"text":"وش الزبدة"},{"start":661.82,"end":667.4,"text":"انا الحين مفروض زي ما قلت ما استغل و\nاستخدم و ألعب و أغش عن الناس"},{"start":667.4,"end":668.86,"text":"عشان انا استفيد"},{"start":668.86,"end":669.7,"text":"مثلا"},{"start":669.7,"end":680.58,"text":"يعني انه"},{"start":680.58,"end":682.64,"text":"هذا الاكزامبل وش معناته"},{"start":682.64,"end":684.5,"text":"انا الحين شركة احتاج"},{"start":684.5,"end":687.18,"text":"اجيب اوظف شخص لمدة ثلاث شهور"},{"start":687.18,"end":689.06,"text":"بس عشان يخلص لي هذا الشغلة"},{"start":689.06,"end":690.92,"text":"بلان خلاص ما احتاجه ما ابيه"},{"start":690.92,"end":692.36,"text":"فانا الحين"},{"start":692.36,"end":694.86,"text":"قلت لي فلان تعال اشتغل عندي"},{"start":694.86,"end":696.38,"text":"انه بقدم لك كذا كذا كذا"},{"start":696.38,"end":699.28,"text":"وما قلت لي ترى أنا بس أبغاك لمدة ثلاثة\nشهور"},{"start":699.28,"end":701.82,"text":"أنا الآن غشيته ولعبت عليه"},{"start":701.82,"end":704.38,"text":"وما احترمت الـ rational autonomy"},{"start":704.38,"end":705.46,"text":"شوفون كيف"},{"start":705.46,"end":708.86,"text":"فهذا الآن أنا ما استخدمته عشان أنا استفيد"},{"start":708.86,"end":711.44,"text":"ما استخدمته يعني as an end"},{"start":711.44,"end":713.9,"text":"لا أنا استخدمته as a means to an end"},{"start":713.9,"end":714.4,"text":"عرفتو"},{"start":714.4,"end":719.24,"text":"means إن أنا أبغى شيء أخلص أسويه يعني\nأنتجه"},{"start":719.24,"end":720.16,"text":"عموا"},{"start":720.16,"end":722.96,"text":"طبعا كانت قلق يقول إنna discuss the truth"},{"start":722.96,"end":725.28,"text":"لا أنت إجباري إنك تقول لا"},{"start":725.28,"end":727.8,"text":"مدة دوامك بيكون ثلاثة شهور"},{"start":727.8,"end":728.82,"text":"عموما"},{"start":728.82,"end":731.2,"text":"ننتقل الى سكشن 5"},{"start":731.2,"end":734.74,"text":"اللي قولك perfect versus imperfect duties"},{"start":734.74,"end":736.08,"text":"وش يقول لكم"},{"start":736.08,"end":737.5,"text":"طبعا فكروا ان ال-P"},{"start":737.5,"end":739.44,"text":"اللي هو من الكلمة perfect"},{"start":739.44,"end":740.28,"text":"negative"},{"start":740.28,"end":743.54,"text":"وال-I من ال-imperfect"},{"start":743.54,"end":744.42,"text":"perfect"},{"start":744.42,"end":746.54,"text":"ليش ولا يعني positive"},{"start":746.54,"end":749.66,"text":"لانا الحين نشرح لكم"},{"start":749.66,"end":751.16,"text":"perfect يساوي"},{"start":751.16,"end":752.32,"text":"no exception"},{"start":752.32,"end":754.58,"text":"يعني انت بتطبق"},{"start":754.58,"end":756.58,"text":"الذي أقوله بالسنتي"},{"start":756.58,"end":759.58,"text":"لا زيادة ولا نقص"},{"start":759.58,"end":761.58,"text":"والإمبرفكت العكس"},{"start":761.58,"end":764.58,"text":"إنه يسمح لك أن تضع رأيك بالموضوع"},{"start":764.58,"end":766.58,"text":"نرى الآن لماذا"},{"start":766.58,"end":768.58,"text":"كما قلت لكم هنا"},{"start":768.58,"end":770.58,"text":"\"perfect duties are rigid and negative\""},{"start":770.58,"end":774.58,"text":"و \"don't do\""},{"start":774.58,"end":776.58,"text":"\"يا فلان لا تسوي كذا\""},{"start":776.58,"end":778.58,"text":"\"يا فلان لا تسوي كذا\""},{"start":778.58,"end":780.58,"text":"أنت أصلا تطفش"},{"start":780.58,"end":782.58,"text":"من كثير ما أنت في أشياء ممنوع تسويها"},{"start":782.58,"end":786.82,"text":"عكس الـ imperfect duties"},{"start":786.82,"end":789.34,"text":"لأنهم فلاكسبل هم بوزيتيف"},{"start":789.34,"end":795.0,"text":"أنتم تقدر تسوي هذا الشي بس أنت تقدر تقرر\nمتها وليش"},{"start":795.0,"end":797.0,"text":"طبعا عندكم الحين الـ perfect duty"},{"start":797.0,"end":799.82,"text":"absolute obligations strict"},{"start":799.82,"end":803.66,"text":"ما في أي إكسبشن أبدا نهائيا"},{"start":803.66,"end":807.88,"text":"عندك طبعا ليش سلبي لأنه عبارة عن الأشياء\nاللي ما تسويه"},{"start":807.88,"end":815.12,"text":"لأن أنت يعني زي هنا المثال لا تكذب لا تذبح\nلا تسرق"},{"start":815.12,"end":821.74,"text":"هذول كلهم القوانين اللي الإجبار يطبقها بغض\nالنظر مين أنت"},{"start":821.74,"end":825.74,"text":"ما في أي قانون يعاكس هذا الشيء"},{"start":825.74,"end":828.76,"text":"عكس الـ imperfect duties يقول لكم منه\nflexible obligation"},{"start":828.76,"end":835.12,"text":"إنه عادي إنه فيه discretion يعني يمديك أن\nتحط رأيك بالموضوع بطريقة اللي تنجز فيه"},{"start":835.12,"end":838.88,"text":"والـ positive لأنه يعلمك الأشياء اللي تقدر\nتسويه"},{"start":838.88,"end":840.62,"text":"مسموح لك تسويه"},{"start":840.62,"end":842.82,"text":"طبعاً يقول لك هناك context dependent"},{"start":842.82,"end":845.1,"text":"in how and when you act"},{"start":845.1,"end":846.3,"text":"يعني بكيفك"},{"start":846.3,"end":848.52,"text":"زي مثلاً أنا مقلت لكم أن صار حادث"},{"start":848.52,"end":853.28,"text":"أنا أقدر أقرر لو أبغى أوقف وأساعد هذا\nالشخص"},{"start":853.28,"end":854.78,"text":"مو معناته أن أنا"},{"start":854.78,"end":857.58,"text":"immoral لو أني ما طبقت هذا الشي"},{"start":857.58,"end":858.86,"text":"هذا الشيء زيادة مني"},{"start":858.86,"end":859.64,"text":"عرفته"},{"start":859.64,"end":860.36,"text":"example"},{"start":860.36,"end":862.54,"text":"help others develop your talents"},{"start":862.54,"end":864.58,"text":"يعني لازم"},{"start":864.58,"end":866.32,"text":"تساعد الناس بس أنت"},{"start":866.32,"end":868.08,"text":"تختار متى تساعدهم"},{"start":868.08,"end":870.98,"text":"وين تساعدهم وكيف تساعدهم"},{"start":870.98,"end":872.7,"text":"يعني مب لازم"},{"start":872.7,"end":874.62,"text":"كل مرة أنت شخصيا"},{"start":874.62,"end":876.02,"text":"تساعدهم عشان كده"},{"start":876.02,"end":878.18,"text":"وعشان كده برضو"},{"start":878.18,"end":880.8,"text":"طبعا يقول لكم الحين"},{"start":880.8,"end":881.76,"text":"أن"},{"start":881.76,"end":884.52,"text":"طبعا مثلا"},{"start":884.52,"end":885.94,"t