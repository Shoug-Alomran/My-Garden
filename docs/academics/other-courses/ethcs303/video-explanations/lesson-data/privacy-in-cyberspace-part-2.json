{"id":"privacy-in-cyberspace-part-2","title":"Privacy in Cyberspace — Part 2","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/cyberspace-part-2-mov.mp4","page":"/academics/other-courses/ethcs303/video-explanations/slide-breakdowns/privacy-in-cyberspace-part-2/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/privacy-in-cyberspace-part-2.vtt","chapters":[{"time":0,"title":"Data collection"},{"time":204.52,"title":"Surveillance drones"},{"time":333.14,"title":"Internet cookies"},{"time":390.34,"title":"First-party cookies"},{"time":431.64,"title":"Third-party and tracking cookies"},{"time":479.74,"title":"Flash cookies"},{"time":612.4,"title":"Privacy concerns with cookies"},{"time":858.42,"title":"Fingerprinting"},{"time":1120.74,"title":"RFID technology"},{"time":1378.32,"title":"Tracking technology"}],"transcript":[{"start":0.0,"end":2.76,"text":"نحن نكمل نروح عند ال data collection"},{"start":2.76,"end":5.0,"text":"قال لكم هنا gathering personal data"},{"start":5.0,"end":7.3,"text":"monitoring recording and tracking"},{"start":7.3,"end":10.12,"text":"احنا لازم ننتبه عن هذا الشي برضو"},{"start":10.12,"end":12.1,"text":"data valence وش معناته"},{"start":12.1,"end":13.66,"text":"لاحظوا ان data"},{"start":13.66,"end":15.2,"text":"بدان كلمة valence"},{"start":15.2,"end":17.74,"text":"يعني ان ال data حقتكم تحت المراقبة"},{"start":17.74,"end":20.96,"text":"the term data valence is made possible by\ncomputer technology"},{"start":20.96,"end":23.46,"text":"it refers to the use of digital tools"},{"start":23.46,"end":25.28,"text":"to monitor individuals continuously"},{"start":25.28,"end":26.78,"text":"الامثلة زي ايش"},{"start":26.78,"end":27.84,"text":"الكاميرات"},{"start":27.84,"end":30.08,"text":"video cameras monitoring consumer\nmovements"},{"start":30.08,"end":30.84,"text":"in retail stores"},{"start":30.84,"end":33.82,"text":"الان اذا رحتوا اي محل بتشوفون كاميرات"},{"start":33.82,"end":35.86,"text":"هذا الكاميرات ترى سابقا كانت"},{"start":35.86,"end":37.86,"text":"اوكي عشان واحد سرق"},{"start":37.86,"end":39.56,"text":"يطلعونا الحين لا"},{"start":39.56,"end":41.4,"text":"الحين صار في يعني"},{"start":41.4,"end":43.18,"text":"زي الذكاء الصناعي"},{"start":43.18,"end":46.02,"text":"صار يركزون ويشوفون طبعك وش قاعد تسوي"},{"start":46.02,"end":47.6,"text":"وحركاتك"},{"start":47.6,"end":49.84,"text":"فريد انقال لكم scanning devices used by"},{"start":49.84,"end":51.9,"text":"intelligent highway vehicle systems"},{"start":51.9,"end":53.36,"text":"هذا نقطة ثانية"},{"start":53.36,"end":55.54,"text":"الان مثلا اللي يعطونكم"},{"start":55.54,"end":57.7,"text":"مخالفات تداوز"},{"start":57.7,"end":58.58,"text":"المسار"},{"start":58.58,"end":60.66,"text":"أو أنكم تمسكن جوال"},{"start":60.66,"end":62.12,"text":"أو حزام"},{"start":62.12,"end":64.62,"text":"هذا الأشياء أحيانا ترى الكاميرات تلقطها"},{"start":64.62,"end":65.26,"text":"هذا هو"},{"start":65.26,"end":70.02,"text":"بني أقول لكم"},{"start":70.02,"end":74.24,"text":"هذا برضو واحد من الأشياء"},{"start":74.24,"end":76.02,"text":"اللي تخليكم"},{"start":76.02,"end":77.62,"text":"يعني تحت"},{"start":77.62,"end":78.74,"text":"data balance"},{"start":78.74,"end":80.38,"text":"أن في زي"},{"start":80.38,"end":83.46000000000001,"text":"من كلمة"},{"start":83.46000000000001,"end":84.32,"text":"شفاف"},{"start":84.32,"end":85.1,"text":"ما يبديكم تشوفونا"},{"start":85.1,"end":85.8,"text":"ما تدرون عنه"},{"start":85.8,"end":87.28,"text":"هو يتابع مين"},{"start":87.28,"end":89.4,"text":"يتابع الموظفين وفعالياتهم"},{"start":89.4,"end":90.74,"text":"طول الوقت"},{"start":90.74,"end":92.6,"text":"24 ساعة"},{"start":92.6,"end":95.66,"text":"ما يفشل ترى أن يسجل شيء"},{"start":95.66,"end":97.6,"text":"يعني ممكن في الدقيقة"},{"start":97.6,"end":99.52000000000001,"text":"لا 24 ساعة مسجل"},{"start":99.52000000000001,"end":106.3,"text":"طبيعي"},{"start":106.3,"end":107.44,"text":"طبيعي"},{"start":107.44,"end":110.06,"text":"فعلا كل شيء قاد يراقبني"},{"start":110.06,"end":111.1,"text":"أكيد أخاف"},{"start":111.1,"end":112.22,"text":"هذا شيء طبيعي جدا"},{"start":112.22,"end":113.74000000000001,"text":"بذلقال لكم الحين"},{"start":113.74000000000001,"end":117.14,"text":"الآن الحكومة"},{"start":117.14,"end":117.97999999999999,"text":"دماغة الآن"},{"start":117.97999999999999,"end":122.66,"text":"هذا من يستخدم"},{"start":122.66,"end":123.96,"text":"الحكومة صح"},{"start":123.96,"end":124.82,"text":"فقد أقول لكم هنا"},{"start":124.82,"end":138.2,"text":"هنا"},{"start":138.2,"end":141.3,"text":"هناك الناس خائفين"},{"start":141.3,"end":148.3,"text":"بس في نفس الوقت لازم الحكومة تكون داخل\nالصورة عن وش الشعب قاعدين يسوون"},{"start":148.3,"end":150.68,"text":"والذي كان صار فيه فساد"},{"start":150.68,"end":151.44,"text":"عندكم طبعا"},{"start":151.44,"end":156.815,"text":"some tools are installed using the same\ntype of malicious malware and spyware used"},{"start":156.815,"end":158.06,"text":"by online criminals"},{"start":158.06,"end":164.64,"text":"يعني عشان الناس يراقبون ويشوفون ويدخلون\nبالموضوع"},{"start":164.64,"end":169.64,"text":"يستخدمون نفس الطرق نفس التكنيكس اللي\nالهاكرز يسوونها"},{"start":169.64,"end":181.48,"text":"يمكن أن تخلق الكاميرات الجهاز ومايك حق\nالهاتف"},{"start":181.48,"end":186.84,"text":"هذا صراحة أتوقع صار يعني في طرق أنكم\nتدفادونه"},{"start":186.84,"end":189.52,"text":"وأنني علاقة لأبين"},{"start":189.52,"end":191.02,"text":"اللي هو زي هذه النقطة اللي هنا"},{"start":191.02,"end":194.68,"text":"شوفون كيف في نقطة شسمة برتقالية"},{"start":194.68,"end":197.12,"text":"هذه النقطة البرتقالية هي تقول"},{"start":197.12,"end":200.2,"text":"انه ترى حين شاشة كاعدة تتجل"},{"start":200.2,"end":202.92000000000002,"text":"على اقلل ابل اللي نتعبونا"},{"start":202.92000000000002,"end":204.52,"text":"ونعندكم طبعا الحين"},{"start":204.52,"end":205.74,"text":"Surveillance drones"},{"start":205.74,"end":208.68,"text":"Unmanned aerial systems"},{"start":208.68,"end":209.96,"text":"هذا هو ال UAS"},{"start":209.96,"end":211.96,"text":"لاحظوا انه unmanned"},{"start":211.96,"end":213.16,"text":"يعني ما في احد راكبة"},{"start":213.16,"end":215.04,"text":"مو بزي طيارة او هليكوبتر"},{"start":215.04,"end":216.32,"text":"ما في حد راكبة"},{"start":216.32,"end":217.44,"text":"Aerial system"},{"start":217.44,"end":218.62,"text":"انه هو قا يطير بالهواء"},{"start":218.62,"end":221.54,"text":"Raises significant issues for privacy and\ncivil liberties"},{"start":221.54,"end":223.72,"text":"Drones and use of law enforcement"},{"start":223.72,"end":226.48,"text":"Can carry live video feed cameras"},{"start":226.48,"end":233.48,"text":"هاته الاشياء اللي ممكن يجي بعد عداد انه وش\nاللي جوات هذا الشي"},{"start":233.48,"end":241.22,"text":"لاحظوا بعد ترى ان في السعودية خصوصا ممنوع\nالشخص الطبيعي يملك درون"},{"start":241.22,"end":245.16,"text":"يعني اللي خصوصا فيها كاميرات هذي ممنوعة\nرسميا"},{"start":245.16,"end":247.98,"text":"طبعا الحكومة لا من اكيد كل شي مسموح"},{"start":247.98,"end":251.9,"text":"واستخدمونا يعني اكيد عشان يشوفون يعني\nوضعهم"},{"start":251.9,"end":258.36,"text":"وهذه الأشياء الضرونة لهم غير الدرونة التي\nلا تستطيع اشتريها"},{"start":258.36,"end":267.16,"text":"لماذا؟ غير الكاميرات هنا تشوفون أنه فيها\nأو شيء تطير لمدة أيام أو ساعات"},{"start":267.16,"end":272.24,"text":"وزائد أن كاميرتهم فيها يعني هايتك مبنئة"},{"start":272.24,"end":277.3,"text":"أصور جو بيث لا أصور سيتي كامل"},{"start":277.3,"end":279.3,"text":"تخيلوا تصورون رياض كاملة مثلا"},{"start":279.3,"end":281.65999999999997,"text":"They can also carry Wi-Fi crackers"},{"start":281.65999999999997,"end":283.1,"text":"يعني يخربون عليكم النت"},{"start":283.1,"end":286.52,"text":"Fake cell phone towers that can determine\nyour location"},{"start":286.52,"end":288.32,"text":"or intercept your text and phone calls"},{"start":288.32,"end":289.74,"text":"يعني الحين جوالنا"},{"start":289.74,"end":292.6,"text":"يحاول يلقط أول"},{"start":292.6,"end":294.9,"text":"يعني ذاك العمود الطويل عرفتوه"},{"start":294.9,"end":296.4,"text":"يحاول يمسكه"},{"start":296.4,"end":297.52,"text":"اللي هو cell tower"},{"start":297.52,"end":300.8,"text":"بس يجي هذا الدرون ويمثل"},{"start":300.8,"end":301.72,"text":"إنه هو cell tower"},{"start":301.72,"end":304.24,"text":"طبعا جوال هدفه إنه يلقط أقرب واحد"},{"start":304.24,"end":306.82,"text":"فتخيلوا لو جاد الدرون وهو صار أقرب واحد"},{"start":306.82,"end":307.36,"text":"صار الحين"},{"start":307.36,"end":315.123,"text":"اول شي يقدرون ان يطعون منكم النت ويعرفوا\nموقعكم ويقدرون حتى يعني بدان ما يجيك انت"},{"start":315.123,"end":317.04,"text":"المكالمة يصير يجيمهم"},{"start":317.04,"end":319.5,"text":"بنا عشان كذي قال لكم fake cell phone\ntowers"},{"start":319.5,"end":323.88,"text":"بنا قال لكم برضو drone manufacturers even\nadmit they may carry"},{"start":323.88,"end":327.62,"text":"يعني انهم صنعوا انهم صنعوا انهم صنعوا انهم\nصنعوا انهم صنعوا وشو less lethal weapons"},{"start":327.62,"end":331.56,"text":"زي اللي كهربكم التازرز ولا rubber bullets"},{"start":331.56,"end":333.14,"text":"يعني طلقات بس مصنوع من rubber"},{"start":333.14,"end":337.48,"text":"لدينا الآن الانترنت cookies"},{"start":337.48,"end":339.14,"text":"قال لكم وشهد انترنت cookies"},{"start":339.14,"end":339.84000000000003,"text":"definition"},{"start":339.84000000000003,"end":345.359,"text":"cookies are files that websites send to\nand retrieve from computer systems of web"},{"start":345.359,"end":345.7,"text":"users"},{"start":345.7,"end":349.802,"text":"enabling website owners to collect\ninformation about individuals browsing"},{"start":349.802,"end":350.42,"text":"preferences"},{"start":350.42,"end":352.12,"text":"whenever they visit a website"},{"start":352.12,"end":357.618,"text":"data recorded about the user is stored on\na file that is placed on the hard drive of"},{"start":357.618,"end":359.32,"text":"the user's computer system"},{"start":359.32,"end":364.393,"text":"This can be retrieved and resubmitted to\nwebsite the next time the user access the"},{"start":364.393,"end":364.64,"text":"site"},{"start":364.64,"end":365.98,"text":"هذا كله وش بعناتها"},{"start":365.98,"end":367.42,"text":"بكل بساطة"},{"start":367.42,"end":369.56,"text":"أنا الحين موقع مثلا"},{"start":369.56,"end":371.46,"text":"لا تستبعدوني موقعي هنا"},{"start":371.46,"end":372.56,"text":"الحين قاعدين نبتح"},{"start":372.56,"end":373.86,"text":"وش هو"},{"start":373.86,"end":375.18,"text":"في cookies"},{"start":375.18,"end":378.06,"text":"يصير أحيانا أنت والله مسوي sign in"},{"start":378.06,"end":380.42,"text":"أو حط مثلا dark mode"},{"start":380.42,"end":381.84,"text":"أو مختار اللغة العربية"},{"start":381.84,"end":382.96,"text":"بدال الإنجليزية"},{"start":382.96,"end":385.96,"text":"يصير خلاص كل ما تدخل موقعي"},{"start":385.96,"end":387.14,"text":"ثابت على هذا الشي"},{"start":387.14,"end":389.22,"text":"هذا عشان يحسن الجودة"},{"start":389.22,"end":390.34,"text":"بس ترى هذا"},{"start":390.34,"end":391.66,"text":"first cookie"},{"start":391.66,"end":392.86,"text":"first party cookie"},{"start":392.86,"end":394.04,"text":"اللي هذا قاعد أشرح لكم"},{"start":394.04,"end":396.04,"text":"في عندكم third party"},{"start":396.04,"end":397.52,"text":"وعندكم flash cookies"},{"start":397.52,"end":399.84000000000003,"text":"خلونا نغطيهم حبة حبة"},{"start":399.84000000000003,"end":400.76,"text":"قال لكم"},{"start":400.76,"end":401.3,"text":"legitimate"},{"start":401.3,"end":403.22,"text":"قال لكم هنا"},{"start":403.22,"end":405.0,"text":"legitimate first party"},{"start":405.0,"end":405.54,"text":"اللي هو"},{"start":405.54,"end":406.84000000000003,"text":"use by the legitimate"},{"start":406.84000000000003,"end":409.02,"text":"website to make special offers"},{"start":409.02,"end":410.24,"text":"to returning customers"},{"start":410.24,"end":412.08,"text":"and to track the results"},{"start":412.08,"end":413.04,"text":"of their advertising"},{"start":413.04,"end":414.94,"text":"generally considered acceptable"},{"start":414.94,"end":416.04,"text":"مو بس إن عان"},{"start":416.04,"end":417.42,"text":"عشان يحسن جودة تكترى"},{"start