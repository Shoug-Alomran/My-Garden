62.3,"text":"الحلو أنت مثلا ذبحت شخص"},{"start":962.3,"end":964.3,"text":"وكنت تماسك سكينة وبدون غلوف"},{"start":964.3,"end":966.3,"text":"بيطلع بصمتك يعني بيبين"},{"start":966.3,"end":967.76,"text":"يعني بيعرفون أن أنت"},{"start":967.76,"end":969.98,"text":"بس بالكمبيوتر ما يبين"},{"start":969.98,"end":971.5,"text":"leaves no evidence"},{"start":971.5,"end":974.7,"text":"و therefore impossible for you to know"},{"start":974.7,"end":976.16,"text":"when you are being tracked"},{"start":976.16,"end":977.4,"text":"by fingerprinting"},{"start":977.4,"end":982.696,"text":"يعني مستحيل تعرفون أني أنا كنت سوي لكم\nتراكين بالفينجر بلنا مستحيل بينا عال"},{"start":982.696,"end":983.12,"text":"جهازكم"},{"start":984.3,"end":986.62,"text":"طبعا هذا مثال يعني بالعالم الحقيقي"},{"start":986.98,"end":990.14,"text":"أن شخصين يستخدمون نفس البراؤزر نفس الأو أس"},{"start":990.46,"end":992.86,"text":"والهاردوير يعني مشتشابه جدا"},{"start":993.3,"end":997.16,"text":"وعندما يستخدمون بشكل مختلفة بشكل مختلفة من\nرسالة مختلفة"},{"start":997.56,"end":1003.68,"text":"إستخدام النظام وطارئة وطارئة وطارئة وطارئة\nوطارئة وطارئة بإستخدام"},{"start":1003.68,"end":1008.54,"text":"إستخدام الإستخدام للغاية أفضل لكثير من\nأجهزة وطارئة من أجهزة من أجهزة"},{"start":1008.54,"end":1011.12,"text":"حتى مع الكوكيات فليا ديسابل"},{"start":1012.98,"end":1014.28,"text":"ونحن لديكم الآن"},{"start":1014.28,"end":1016.78,"text":"كراس ديفيس تراكين"},{"start":1016.78,"end":1018.78,"text":"هذا بكل بساطة"},{"start":1018.78,"end":1021.78,"text":"الآن أنا وعندي معك"},{"start":1021.78,"end":1025.84,"text":"وعندي لابتوب وعندي ايفون وعندي ايباد"},{"start":1025.84,"end":1027.16,"text":"ليش؟ لأن عندي"},{"start":1027.16,"end":1028.28,"text":"إيكو سيستم صح"},{"start":1028.28,"end":1029.44,"text":"أبل إيكو سيستم"},{"start":1029.44,"end":1031.0,"text":"إن كل واحد مرتبة الثاني"},{"start":1031.0,"end":1037.78,"text":"هو إنه يروح يربط الأنواع الأجهزة مع راعي\nواحد"},{"start":1037.78,"end":1053.26,"text":"يعني أنا الحين مثلا"},{"start":1053.26,"end":1056.12,"text":"يشوفون فوقات معينة أستخدم لبتبوي"},{"start":1056.12,"end":1058.12,"text":"سوف يستخدم الشغل"},{"start":1058.12,"end":1060.12,"text":"ثم يقوم بالوقت المعين"},{"start":1060.12,"end":1062.12,"text":"سوف يستخدم جوالي"},{"start":1062.12,"end":1064.12,"text":"خاص خلصت الشغل"},{"start":1064.12,"end":1066.12,"text":"يرسلون دعاية في هذا الوقت"},{"start":1066.12,"end":1068.12,"text":"هذا هو وظيفة"},{"start":1068.12,"end":1070.12,"text":"أنه يعرفون"},{"start":1070.12,"end":1072.12,"text":"يعرفون أنا بيئتي ونفسيتي"},{"start":1072.12,"end":1074.12,"text":"وكل شيء يخصني"},{"start":1074.12,"end":1076.12,"text":"عشان يعرفون كيف يستهدفوني"},{"start":1076.12,"end":1078.12,"text":"هذا هو السبب"},{"start":1078.12,"end":1080.12,"text":"اللي أشرحتها"},{"start":1080.12,"end":1082.12,"text":"Who knows what you're doing"},{"start":1082.12,"end":1084.12,"text":"when you browse the web"},{"start":1084.12,"end":1086.12,"text":"لا أعرف ما أفعله أو لم أفعله"},{"start":1086.12,"end":1087.12,"text":"صح؟"},{"start":1087.12,"end":1088.12,"text":"فقال أقول لكم هنا"},{"start":1094.12,"end":1096.12,"text":"لاحظوا أن بدون ما أنا أعرف"},{"start":1096.12,"end":1099.12,"text":"يعني مبنى كذين يعلموني من وراء ظهري"},{"start":1107.12,"end":1110.12,"text":"أصدقني أنا ودي أشوف اللي هم شايفين عني"},{"start":1110.12,"end":1112.12,"text":"وشوف ده هون عندهم سالفة ولا لا"},{"start":1112.12,"end":1113.12,"text":"صراحة محسن الموضوع مرة انترسيك"},{"start":1113.12,"end":1116.18,"text":"ولكن تبدأ أنهم هدفهم الوحيد"},{"start":1116.18,"end":1117.7,"text":"أن يعرفون طبعك"},{"start":1117.7,"end":1118.98,"text":"يعرفون بيئتك"},{"start":1118.98,"end":1120.74,"text":"يعرفون كل شي عنك"},{"start":1120.74,"end":1123.3,"text":"ونعندكم حين RFID Technology"},{"start":1123.3,"end":1125.14,"text":"اللي هو Radio Frequency Identification"},{"start":1125.14,"end":1127.36,"text":"هذا الأشياء اللي فيه Microchip"},{"start":1127.36,"end":1129.34,"text":"اللي هو consists of a tag اللي هو\nMicrochip"},{"start":1129.34,"end":1130.14,"text":"and a reader"},{"start":1130.14,"end":1134.1,"text":"Microchip هو اللي يعطي المعلومات"},{"start":1134.1,"end":1136.18,"text":"يخزن والريدر هو اللي يقرأ طبعا"},{"start":1136.18,"end":1137.82,"text":"The tag اللي هو Microchip"},{"start":1137.82,"end":1141.0,"text":"has an electronic circuit which stores\ndata"},{"start":1141.0,"end":1146.358,"text":"and an antenna that broadcast data by\nradio waves in response to a signal from a"},{"start":1146.358,"end":1146.76,"text":"reader"},{"start":1146.76,"end":1151.656,"text":"the reader contains an antenna that\nreceives a radio signal and the"},{"start":1151.656,"end":1152.46,"text":"demodulator"},{"start":1152.46,"end":1154.1,"text":"هذا يبدو ترجمي يعني"},{"start":1154.1,"end":1156.82,"text":"that transforms the analog radio\ninformation into digital"},{"start":1156.82,"end":1160.32,"text":"هذا كل ذا قمبقة وشوش يبون منك"},{"start":1160.32,"end":1162.96,"text":"يبون مسيش يقولون لك انتر تاق اللي هو\nالمايكروشيب"},{"start":1162.96,"end":1165.16,"text":"في وشوه إلكترونيك سيركت أو شي"},{"start":1165.16,"end":1166.4,"text":"وفي عنده أنتنة"},{"start":1166.4,"end":1169.02,"text":"أنتنة يسوي برادكاست للمعلومات خلال ايش"},{"start":1169.02,"end":1169.84,"text":"ريديو ويف"},{"start":1169.84,"end":1172.62,"text":"وهو قاعد يعطي ردة فعل من"},{"start":1172.62,"end":1175.02,"text":"من response to signal من الريدر"},{"start":1175.02,"end":1176.94,"text":"الريدر والله جاء signal"},{"start":1176.94,"end":1178.58,"text":"فهو قاعد يعني يتعامل معاه"},{"start":1178.58,"end":1180.74,"text":"والريدر وشو يسوي عنده برضو"},{"start":1180.74,"end":1182.28,"text":"أنتناه طبعا هو كيف يعني"},{"start":1182.28,"end":1185.22,"text":"يوصل معلومات ويرد إذا ماك عنده أنتناه"},{"start":1185.22,"end":1186.56,"text":"وعنده ديكم دول"},{"start":1186.56,"end":1187.94,"text":"ذا الكلمة العجيبة"},{"start":1187.94,"end":1190.5,"text":"هذا حرفيا موظيفة أنه يترجم"},{"start":1190.5,"end":1192.54,"text":"الانالوج ريديو اللي هما قلنا"},{"start":1192.54,"end":1194.68,"text":"الريديو ويفس إلى معلومة"},{"start":1194.68,"end":1195.94,"text":"يعني الكمبيوتر قدر يستوعبه"},{"start":1195.94,"end":1196.74,"text":"اللي هو ديكم دول داتا"},{"start":1196.74,"end":1200.38,"text":"نحن لديكم طبعاً سمارت و دم"},{"start":1200.38,"end":1201.58,"text":"ما هو سمارت؟"},{"start":1201.58,"end":1201.96,"text":"قال لكم"},{"start":1201.96,"end":1204.54,"text":"إمبادت في تسجيل البيئة الوطنية"},{"start":1204.54,"end":1208.16,"text":"يمكن أن يقوم بسرعة من مدينة"},{"start":1208.16,"end":1212.06,"text":"يمكن أن يكون في طاقة بنك مثلاً"},{"start":1212.06,"end":1214.0,"text":"أو طاقة المترو"},{"start":1214.0,"end":1216.78,"text":"هل يمكنكم تستخدمونها خلال 10 متر؟"},{"start":1216.78,"end":1217.14,"text":"لا"},{"start":1217.14,"end":1219.74,"text":"لازم تستخدمونها خلال مترين صح"},{"start":1219.74,"end":1220.34,"text":"أو شيء زي كذلك"},{"start":1220.34,"end":1223.94,"text":"لازم يكون المساحة أقرب شيء ممكن صح"},{"start":1223.94,"end":1225.02,"text":"في المدينة"},{"start":1225.02,"end":1227.02,"text":"لكن الدم لا يقول لكم"},{"start":1227.02,"end":1229.02,"text":"بسيئة"},{"start":1229.02,"end":1231.02,"text":"بسيئة فقط تقوم بخصوص"},{"start":1231.02,"end":1233.02,"text":"بسيئة في الكثير من الأشياء"},{"start":1233.02,"end":1235.02,"text":"كم تسيئة باركوة"},{"start":1235.02,"end":1237.02,"text":"فكرون الدم يبدل البركوة"},{"start":1237.02,"end":1239.02,"text":"سيئة تقوم باستخدام"},{"start":1239.02,"end":1241.02,"text":"بسيئة تقوم بسيئة"},{"start":1241.02,"end":1243.02,"text":"ثم يتعلم أنهم يمتلك"},{"start":1243.02,"end":1245.02,"text":"بسيئة تقوم بخصوص"},{"start":1245.02,"end":1247.02,"text":"أجرب مثال أجيب لكم"},{"start":1247.02,"end":1249.02,"text":"السيارات الجديدة"},{"start":1249.02,"end":1251.02,"text":"أحيانا بعضهم يستخدمون"},{"start":1251.02,"end":1253.02,"text":"إذا أنا بعتلك هذا السيارة"},{"start":1253.02,"end":1260.02,"text":"صح ففي بار كود يصير في راديو ويصير يعني\nمدينة طلع وانت وين روحت وش صويت وين فعلت"},{"start":1260.02,"end":1268.02,"text":"بس يعني طلع معلومات لو انك ما تعرف ان انا\nشاري هذا السيارة فهذا البر كود"},{"start":1268.02,"end":1273.02,"text":"هذا الشيب حقي بيكون ملا قيمة بس دامك انت\nتعرف انها اوه"},{"start":1273.02,"end":1278.02,"text":"هذي اشترت هذا السيارة وهذا هو الشيب حقي\nفبسير له طبعا قيمة"},{"start":1278.02,"end":1284.24,"text":"والسمارت هو أن يكون ذكي و لا ينربط بك\nشخصياً"},{"start":1284.24,"end":1286.24,"text":"يصير بس في الجواز مثلاً"},{"start":1286.24,"end":1289.18,"text":"و يستخدم بقرب"},{"start":1289.18,"end":1290.48,"text":"و ليس بعيد"},{"start":1294.82,"end":1296.58,"text":"أبنى طبعاً قال لكم \"Inhumans\""},{"start":1296.58,"end":1299.4,"text":"تدرون انصاروا و يستخدمونها بالإنسان"},{"start":1299.4,"end":1302.936,"text":"قال لكم هنا \"Although commercially\nintended for identifying real world"},{"start":1302.936,"end":1303.34,"text":"objects\""},{"start":1303.34,"end":1305.4,"text":"يعني مثلاً أغراض بالسبرماركت"},{"start":1305.4,"end":1309.4,"text":"المترجمات يمكن أن يستخدمون أيضاً لإستخدام\nهذه الأشياء بعد تصويرهم"},{"start":1309.4,"end":1312.4,"text":"هذا ما قلت لكم. مثلاً أنا أبيع لكم سيارة"},{"start":1312.4,"end":1315.4,"text":"ويصير هذا الشيء في المترجمات"},{"start":1315.4,"end":1319.4,"text":"بعض المترجمات يقدمون بعض الأشياء للمشاهدة"},{"start":1319.4,"end":1321.4,"text":"حتى يوجد المترجمات الآن"},{"start":1321.4,"end":1325.4,"text":"يجب أن ترنون من أم مساحة معينة"},{"start":1325.4,"end":1327.4,"text":"لأنه لديهم هذا السوارة"},{"start":1327.4,"end":1332.4,"text":"المترجمات يمكن أن تخيلوا شريحة"},{"start":1332.4,"end":1334.4,"text":"تحت جلدكم شوي"},{"start":1334.4,"end":1339.8,"text":"فخصوطهم بالاطفال عشان اذا انصاروا مفقودين\nيقدرون يعني يلقونهم"},{"start":1339.8,"end":1341.16,"text":"طبعا قال لكم"},{"start":1341.16,"end":1346.722,"text":"\"Because RFID is now embedded in humans\nenabling them to be tracked it has raised"},{"start":1346.722,"end":1349.4,"text":"serious concerns for privacy advocates\""},{"start":1349.4,"end":1357.2,"text":"يعني الحين يفكرون ان دقيقة هذا الطفل\nبالنهاية بيكبر و بيصير يعني كبير"},{"start":1357.2,"end":1361.1,"text":"وتخيلوا انكم ما زلتوا تقدرون تتبعونه\nوتعرفون وين راح"},{"start":1361.1,"end":1365.48,"text":"تخيل هذا الشخص منحش من شخص يحاول يذبحه"},{"start":1365.48,"end":1369.58,"text":"و هو بكل سهولة يقدر يطلع موقعه من ذا\nالشريحة"},{"start":1369.58,"end":1372.38,"text":"يعني صار فيه privacy concerns بالموضوع"},{"start":1372.38,"end":1375.12,"text":"بنا طبعا عندكم هنا الاختبار الماضي"},{"start":1375.12,"end":1378.32,"text":"أبيكم تختبرون تشوفون اذا عرفت الجاوبة ولا\nلا"},{"start":1378.32,"end":1381.94,"text":"و خلونا نروح ننتقل على tracking tech"}]}