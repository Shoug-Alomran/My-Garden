  "chapters": [
    { "time": 0, "title": "Kantianism" },
    { "time": 91.38, "title": "Universal moral laws" },
    { "time": 290.24, "title": "Good will" },
    { "time": 456.42, "title": "Acting from duty" },
    { "time": 525.68, "title": "Testing universalizability" },
    { "time": 620.1, "title": "Categorical imperatives" }
  ],
  "transcript": [
    { "start": 0.0, "end": 0.84, "text": "السلام عليكم" },
    { "start": 0.84, "end": 2.94, "text": "اليوم نتكلم او نكمل" },
    { "start": 2.94, "end": 3.84, "text": "المورال سيستم" },
    { "start": 3.84, "end": 4.8, "text": "اثيكال كونسبت" },
    { "start": 4.8, "end": 7.54, "text": "طبعا بتلاحظون ان هذا" },
    { "start": 7.54, "end": 9.74, "text": "يعني نفس التايتل اللي قبل تركان" },
    { "start": 9.74, "end": 10.44, "text": "انتردكشن" },
    { "start": 10.44, "end": 11.66, "text": "الان بدينه part 1" },
    { "start": 11.66, "end": 13.22, "text": "فيه part 1 part 2" },
    { "start": 13.22, "end": 14.24, "text": "وبعدين part 3" },
    { "start": 14.24, "end": 17.04, "text": "طبعا هذا الشابتر part 1" },
    { "start": 17.04, "end": 18.36, "text": "بيتكلم عن شيء اسمه" },
    { "start": 18.36, "end": 19.0, "text": "كانتونيزم" },
    { "start": 19.0, "end": 20.82, "text": "اللي هو واحد من الاشياء" },
    { "start": 20.82, "end": 21.94, "text": "اللي تكلمنا عنا" },
    { "start": 21.94, "end": 23.06, "text": "قلناه انهو" },
    { "start": 23.06, "end": 23.76, "text": "دوتي بيس" },
    { "start": 23.76, "end": 24.62, "text": "دينتولوجي" },
    { "start": 24.62, "end": 26.12, "text": "في هذا الشابتر" },
    { "start": 26.12, "end": 27.06, "text": "كنحنا تكلمنا عن" },
    { "start": 27.06, "end": 28.28, "text": "الاثيكال رولتزم" },
    { "start": 28.28, "end": 29.42, "text": "والدفاين كماند" },
    { "start": 29.42, "end": 32.54, "text": "باقي هذولي الثلاث أربعة" },
    { "start": 32.54, "end": 33.98, "text": "اللي لازم نغطيهم" },
    { "start": 33.98, "end": 36.34, "text": "فخلونا نبدأ بالكانتنزم" },
    { "start": 36.34, "end": 37.78, "text": "الحين ومين كانت؟" },
    {
      "start": 37.78,
      "end": 39.92,
      "text": "هذة ترى كلها معنوات الدكتورة كانت تقول"
    },
    { "start": 39.92, "end": 42.02, "text": "انه مب مهمة" },
    { "start": 42.02, "end": 42.98, "text": "ما يهمني يعني" },
    { "start": 42.98, "end": 45.44, "text": "بس خلنقول ممكن دكتورك يهتم" },
    { "start": 45.44, "end": 47.92, "text": "في السنوات وكان يقول" },
    { "start": 47.92, "end": 49.6, "text": "انه ما كان يسافر" },
    { "start": 49.6, "end": 51.64, "text": "يعني ما كان يطلع بره كورته" },
    { "start": 51.64, "end": 53.94, "text": "اكثر من عشرة مايلز" },
    { "start": 53.94, "end": 55.64, "text": "حتى يعني ما حطوا بالكيلو" },
    { "start": 55.64, "end": 57.46, "text": "وانه كان عنده روتين" },
    { "start": 57.46, "end": 59.96, "text": "ثابت ويشوف" },
    { "start": 59.96, "end": 62.26, "text": "اوقاتها ويطلع" },
    { "start": 62.26, "end": 64.2, "text": "يمشي وانه كان" },
    { "start": 64.2, "end": 66.16, "text": "يعني اكثر شخص" },
    { "start": 66.16, "end": 68.56, "text": "احنا الان يهمنا كلامه" },
    { "start": 68.56, "end": 70.68, "text": "رغم ان كلامه قبل 300 سنة" },
    { "start": 70.68, "end": 72.32, "text": "الحين خلونا ندخل على الكلام" },
    { "start": 72.32, "end": 74.24, "text": "اللي احنا بيهمنا واصلا" },
    { "start": 74.24, "end": 75.88, "text": "بيجينا اسئلة عليه كثيرة" },
    { "start": 75.88, "end": 76.92, "text": "قال لكم او شيء" },
    { "start": 76.92, "end": 80.0, "text": "معناته دوتي" },
    { "start": 80.0, "end": 81.48, "text": "جاي من كلمة الگريك" },
    {
      "start": 81.48,
      "end": 83.82,
      "text": "فاهم شي كيف اذا بيجيكم او امسكيو"
    },
    { "start": 83.82, "end": 85.8, "text": "دي دي عرفتو" },
    { "start": 85.8, "end": 89.86, "text": "شاهدون كيف حفظتها" },
    { "start": 89.86, "end": 91.38, "text": "وقال لكم" },
    {
      "start": 91.38,
      "end": 95.92,
      "text": "People's actions are guided by the\nuniversal moral laws"
    },
    { "start": 95.92, "end": 96.9, "text": "يعني إيش" },
    { "start": 96.9, "end": 98.06, "text": "لاحظنا universal" },
    { "start": 98.06, "end": 99.94, "text": "إن شاء الله لو رحت أمريكا" },
    { "start": 99.94, "end": 100.58, "text": "سويسرا" },
    { "start": 100.58, "end": 101.08, "text": "أوروبا" },
    { "start": 101.08, "end": 101.62, "text": "سعودية" },
    { "start": 101.62, "end": 103.46000000000001, "text": "كلنا مجموعية" },
    { "start": 103.46000000000001, "end": 104.78, "text": "في نفس القانون" },
    { "start": 104.78, "end": 105.32, "text": "ليش" },
    { "start": 105.32, "end": 106.64, "text": "لأنني قال لك القوانين هذه" },
    { "start": 106.64, "end": 108.44, "text": "عبارة عن logic" },
    { "start": 108.44, "end": 109.6, "text": "في أسباب" },
    { "start": 109.6, "end": 110.84, "text": "مو بأنا قد أسوي الشيء" },
    { "start": 110.84, "end": 112.12, "text": "عشان ورلا أنا أرغب" },
    { "start": 112.12, "end": 113.25999999999999, "text": "أسوي هذا الشيء" },
    {
      "start": 113.25999999999999,
      "end": 125.08,
      "text": "يعني بيقولك الذبح ليش ما يصلاح والله يأذي\nالعائلة الميت يأذي الشخص اللي مات"
    },
    {
      "start": 125.08,
      "end": 133.18,
      "text": "يأذي مثلا لو كان فتح شركة يأذي الشركة يأذي\nالمجتمع هكذا عرفتوا فيه أسباب مقنعة"
    },
    {
      "start": 133.18,
      "end": 138.57,
      "text": "فعشان كذلك كتبت لكم logic not feelings\nيعني مشاعركم حطوها على جنب لنهمالها أي"
    },
    { "start": 138.57, "end": 138.92000000000002, "text": "علاقة" },
    {
      "start": 138.92000000000002,
      "end": 148.003,
      "text": "وترى بالفاينل جاني سؤال عن الكنتنزم قال\nانه والله سيارة قاعدة تمشي وصار حين عندها"
    },
    { "start": 148.003, "end": 148.9, "text": "اختيارين" },
    {
      "start": 148.9,
      "end": 158.356,
      "text": "يا انها تكمل سيده وتقتل خمس اشخاص او انه\nتلف وتخبط بجدار وتقتل اللي قاية سوق اللي"
    },
    { "start": 158.356, "end": 159.64, "text": "هو شخص واحد" },
    {
      "start": 159.64,
      "end": 167.121,
      "text": "فخلال الكنتنزم واي واحد تختارون طبعا\nاغلبنا يعني يقول لكلنا بنختار نذبح شخص"
    },
    { "start": 167.121, "end": 167.52, "text": "واحد" },
    {
      "start": 167.52,
      "end": 174.72,
      "text": "ليش؟ لأنه يقل أقل من الضرر صح ففيه لوجيك\nفيه ريزن موب عشان مشاعرنا"
    },
    {
      "start": 174.72,
      "end": 179.659,
      "text": "وبدأنا خلونا نكمل قال لكم برضو كانت نزم is\nbased on a universal principle which"
    },
    {
      "start": 179.659,
      "end": 182.16,
      "text": "treats everyone equally and respectfully"
    },
    {
      "start": 182.16,
      "end": 190.786,
      "text": "يعني ما في أحد فوق الثاني ما نقل الاحترام\nمن الناس معينة وناس لا لا كل شي قاعد يمشي"
    },
    { "start": 190.786, "end": 193.8, "text": "بالعدالة كانت زي فكروا النايت" },
    {
      "start": 193.8,
      "end": 201.92000000000002,
      "text": "إذا كنت في بريطانيا جلسين في حصان قدام\nالقصر الملكة"
    },
    {
      "start": 201.92000000000002,
      "end": 204.07999999999998,
      "text": "يحرصون صح حراس يعني تقليبا"
    },
    {
      "start": 204.07999999999998,
      "end": 206.36,
      "text": "فهم الحراس عندهم واجبات صح"
    },
    {
      "start": 206.36,
      "end": 209.32,
      "text": "فشان كذا أنا حفظت أنه كانت زي النايت"
    },
    {
      "start": 209.32,
      "end": 212.42000000000002,
      "text": "زي اللي عنده واجبات"
    },
    { "start": 212.42000000000002, "end": 213.68, "text": "وبنقال لكم هنا" },
    { "start": 213.68, "end": 220.74, "text": "يعني ايش" },
    { "start": 220.74, "end": 221.5, "text": "لاحظوا بعد" },
    {
      "start": 221.5,
      "end": 226.14,
      "text": "يعني كانتينيزم بيكون ترى حكس يوتيليرتيريزم"
    },
    {
      "start": 226.14,
      "end": 230.32,
      "text": "يوتيليرتيريزم هو يروح يقيس العقابات والضرر\nومدري إيش"
    },
    { "start": 230.32, "end": 233.16, "text": "الكانتينيزم ما يقيس هذا الشي" },
    {
      "start": 233.16,
      "end": 239.42000000000002,
      "text": "يقيس وشو واجباتكم والأشياء اللي إجبارية\nتسوونا"
    },
    {
      "start": 239.42000000000002,
      "end": 244.88,
      "text": "وترى على سالفة اللي قتلكم القصة اللي قاتت\nعندكم الحين"
    },
    { "start": 244.88, "end": 245.7, "text": "two options" },
    {
      "start": 245.7,
      "end": 248.66,
      "text": "يا تذبحون شخص واحد يا تذبحون خمس أشخاص"
    },
    {
      "start": 248.66,
      "end": 255.5,
      "text": "قالت ليش انه باستخدام الكانت النزم ليش ما\nيصلح"
    },
    {
      "start": 255.5,
      "end": 259.94,
      "text": "انه نقول خاصة على طول نذبح شخص واحد انه\nنسوي للسيارة"
    },
    {
      "start": 259.94,
      "end": 266.0,
      "text": "من حيث انه اذا دائما صار فيه هذا الابشن\nانه نذبح هذا الشخص الواحد"
    },
    {
      "start": 266.0,
      "end": 271.2,
      "text": "الجواب ليش ممنوع يصير هذا الشي لانه لا هو\nالايكول ولا هو رسبيكتفل"
    },
    { "start": 271.2, "end": 272.64, "text": "وزائد انه" },
    {
      "start": 272.64,
      "end": 274.96,
      "text": "it's our duty to protect human lives"
    },
    {
      "start": 274.96,
      "end": 279.56,
      "text": "عندنا واجب ان ما نقتل اي انسان"
    },
    {
      "start": 279.56,
      "end": 285.02,
      "text": "فذا احنا رح نبرمجنا السيارة اننا على طول\nتفحط على هذا الشخص"
    },
    { "start": 285.02, "end": 287.4, "text": "بيصير يعني خربنا الدوتي" },
    {
      "start": 287.4,
      "end": 290.24,
      "text": "فعشان كذا it goes against الكانتنism"
    },
    { "start": 290.24, "end": 292.64, "text": "ونكمل في شيء اسمه goodwill" },
    { "start": 292.64, "end": 294.58, "text": "goodwill هو مرتبط بالكانت" },
    {
      "start": 294.58,
      "end": 298.52,
      "text": "ليش قال لكم can't argue that most things\nwe think as good are not always good"
    },
    {
      "start": 298.52,
      "end": 308.282,
      "text": "مثلا احنا نقول والله العلم شي واو الفلوس\nشي واو بس اذا حطيت العلم وحطيت الفلوس في"
    },
    {
      "start": 308.282,
      "end": 317.2,
      "text": "يد شخص شرير بيقدر ينتج اشياء مو بكويسة مو\nبكويسة لا للشخص نفسه ولا للمجتمع"
    },
    { "start": 317.2, "end": 318.54, "text": "فعشان كده قال لكم" },
    { "start": 318.54, "end": 320.2, "text": "كده always be used for evil" },
    { "start": 320.2, "end": 322.36, "text": "يعني خلقوا الدكتور" },
    { "start": 322.36, "end": 324.62, "text": "راح والله خد دكتورات" },
    { "start": 324.62, "end": 326.56, "text": "وفاهم ويعرف سوية عمليات" },
    { "start": 326.56, "end": 327.96, "text": "وكي صح شيء واو" },
    { "start": 327.96, "end": 329.98, "text": "شيء احنا نقول مرة مفيد" },
    { "start": 329.98, "end": 332.4, "text": "بس والله هذا الدكتور طلع انسان" },
    { "start": 332.4, "end": 334.74, "text": "مو كويس واذا سوى العمليات" },
    { "start": 334.74, "end": 336.7, "text": "ياخذ اعضاء المريض والبيحة" },
    {
      "start": 336.7,
      "end": 338.74,
      "text": "شوفون كيف انه صار used for evil"
    },
    {
      "start": 338.74,
      "end": 341.32,
      "text": "قال لكم for can't the only thing that is\nalways good"
    },
    { "start": 341.32, "end": 342.78, "text": "in itself is a good will" },
    { "start": 342.78, "end": 344.15999999999997, "text": "يعني ايش" },
    { "start": 344.15999999999997, "end": 345.56, "text": "نياتكم" },
    { "start": 345.56, "end": 348.24, "text": "نياتكم نياتكم نياتكم" },
    { "start": 348.24, "end": 350.24, "text": "إذا كان نياتكم كويسة" },
    { "start": 350.24, "end": 350.74, "text": "خلاص" },
    { "start": 350.74, "end": 351.9, "text": "الأكشن صار good" },
    { "start": 351.9, "end": 354.46, "text": "بس والله نياتكم مو كويسة" },
    { "start": 354.46, "end": 355.24, "text": "على طول" },
    { "start": 355.24, "end": 355.7, "text": "X" },
    { "start": 355.7, "end": 357.0, "text": "فعشان كذي يقولكم" },
    {
      "start": 357.0,
      "end": 358.9,
      "text": "This is the motivation to do the right\nthing"
    },
    { "start": 358.9, "end": 360.68, "text": "whatever it is" },
    {
      "start": 360.68,
      "end": 363.28,
      "text": "You can always use good thing for bad"
    },
    { "start": 363.28, "end": 364.08, "text": "and makes it good" },
    { "start": 364.08, "end": 365.22, "text": "على حسب" },
    { "start": 365.22, "end": 366.42, "text": "again intentions" },
    { "start": 366.42, "end": 368.86, "text": "نفس الكلام هنا اختصرت لكم هذا" },
    { "start": 368.86, "end": 370.16, "text": "كله هنا" },
    { "start": 370.16, "end": 372.04, "text": "ونكمل" },
    { "start": 372.04, "end": 374.26, "text": "طبعا ليش مهم" },
    { "start": 374.26, "end": 375.48, "text": "إننا نسوي لها" },
    { "start": 375.48, "end": 376.5, "text": "universal laws" },
    { "start": 376.5, "end": 377.28, "text": "ليش" },
    { "start": 377.28, "end": 378.04, "text": "لحظة أصلا هنا" },
    { "start": 378.04, "end": 378.82, "text": "بعد كبنا" },
    { "start": 378.82, "end": 380.2, "text": "إننا" },
    { "start": 380.2, "end": 380.76, "text": "ما ليش" },
    { "start": 380.76, "end": 380.96, "text": "هنا" },
    { "start": 380.96, "end": 383.3, "text": "universal moral laws" },
    { "start": 383.3, "end": 383.86, "text": "ليش" },
    { "start": 383.86, "end": 385.58, "text": "وش الهدف من هذا الموضوع" },
    { "start": 385.58, "end": 386.92, "text": "ليش يسم كل الناس" },
    { "start": 386.92, "end": 387.5, "text": "يطبقونا" },
    { "start": 387.5, "end": 388.62, "text": "قال لكم" },
    { "start": 388.62, "end": 389.02, "text": "هنا" },
    { "start": 389.02, "end": 390.2, "text": "this means for Kant" },
    { "start": 390.2, "end": 391.26, "text": "إن المoral laws" },
    { "start": 391.26, "end": 392.62, "text": "must be universal" },
    { "start": 392.62, "end": 394.6, "text": "they must be kind of laws" },
    { "start": 394.6, "end": 395.78, "text": "that everyone could discover" },
    { "start": 395.78, "end": 396.28, "text": "and follow" },
    { "start": 396.28, "end": 397.18, "text": "also" },
    { "start": 397.18, "end": 398.8, "text": "because he based them" },
    { "start": 398.8, "end": 399.5, "text": "on logic" },
    { "start": 399.5, "end": 400.96, "text": "and not motions" },
    { "start": 400.96, "end": 401.8, "text": "or laws governed" },
    { "start": 401.8, "end": 402.94, "text": "by a specific place" },
    { "start": 402.94, "end": 405.0, "text": "تشوفون الحين مثلا زي" },
    { "start": 405.0, "end": 406.8, "text": "الريلتزم" },
    { "start": 406.8, "end": 409.08, "text": "والسوشيال كونتراك" },
    { "start": 409.08, "end": 410.64, "text": "اللي بعدين من نتكلم عنا" },
    { "start": 410.64, "end": 412.56, "text": "ولا حتى عن" },
    { "start": 412.56, "end": 414.36, "text": "الديفاين" },
    { "start": 414.36, "end": 416.64, "text": "مورال ثيري لان الديفاين" },
    {
      "start": 416.64,
      "end": 419.12,
      "text": "حين ممكن يقول لك والله احنا نتبع"
    },
    { "start": 419.12, "end": 420.36, "text": "الكاثلك" },
    { "start": 420.36, "end": 423.14, "text": "بوكس واحنا نتبع القرآن" },
    { "start": 423.14, "end": 425.12, "text": "هنا ها قولوا انه" },
    { "start": 425.12, "end": 427.18, "text": "فيه يعني اختلاف" },
    { "start": 427.18, "end": 428.74, "text": "صح؟ فيه شوي حكة" },
    {
      "start": 428.74,
      "end": 430.94,
      "text": "بس هنا في الكانت نازم يقولك لا"
    },
    {
      "start": 430.94,
      "end": 434.54,
      "text": "لأنه قاعد يبني كل أفكار عن اللوجك"
    },
    {
      "start": 434.54,
      "end": 439.18,
      "text": "وليس المشاعر ولا القوانين اللي كلنا نتبعه"
    },
    {
      "start": 439.18,
      "end": 441.92,
      "text": "يعني طبعا القوانين أمريكا وقوانين سعودية\nمختلفة صح"
    },
    {
      "start": 441.92,
      "end": 447.24,
      "text": "هنا في المورال لا يواجه هذه المشكلة"
    },
    {
      "start": 447.24,
      "end": 450.28,
      "text": "وقال لكم برضو أن هذا كلمة ثانية"
    },
    {
      "start": 450.28,
      "end": 454.7,
      "text": "يعني لو شفتوا كلمة دينتالوجي ترى نفس\nالكلمة كانت نزم له اسمين"
    },
    { "start": 454.7, "end": 456.42, "text": "فوش تقول لكم" },
    {
      "start": 456.42,
      "end": 460.391,
      "text": "This theory states that what makes an\naction right or wrong is the principle"
    },
    { "start": 460.391, "end": 461.54, "text": "inherent in the action" },
    {
      "start": 461.54,
      "end": 464.56,
      "text": "يعني النية اللي حطيت وراء الفعل"
    },
    {
      "start": 464.56,
      "end": 467.04,
      "text": "If an action is done from a sense of duty"
    },
    { "start": 467.04, "end": 469.4, "text": "يعني كواجب حسسنة واجبك تساعد" },
    {
      "start": 469.4,
      "end": 472.28,
      "text": "And if the principle of an action can be\nuniversalized"
    },
    {
      "start": 472.28,
      "end": 478.28,
      "text": "يعني لو رحت سويس رأمريكا الصين سعودية كلنا\nبنقدر نسوي هذا الشيء"
    },
    { "start": 478.28, "end": 480.94, "text": "فمعناته هذا التصرف صح" },
    {
      "start": 480.94,
      "end": 484.64,
      "text": "هذا الطريقة اللي هم يقيمون ان الشيء صح ولا\nلا"
    },
    {
      "start": 484.64,
      "end": 490.2,
      "text": "زي ما قلتلكم كان عبارة عن شخص واحد ولا\nيعني البيئة اللي حوله"
    },
    {
      "start": 490.2,
      "end": 494.7,
      "text": "وبعدين عندكم دينالوجي هذا يا جماعة كان رب\nالعالمين"
    },
    {
      "start": 494.7,
      "end": 500.94,
      "text": "والحين يقول لكم كانت النزم عبارة عن اذا كل\nالناس بالعالم اقدر اذا قدروا هم يطبقونه"
    },
    { "start": 500.94, "end": 502.42, "text": "فمعاتنا اوكي" },
    {
      "start": 502.42,
      "end": 505.66,
      "text": "وبعدين خلونا نكمل زيادة عندكم حين الامثلة\nقال لكم"
    },
    { "start": 505.66, "end": 508.94, "text": "طبعا ليش فيه لوجك" },
    {
      "start": 508.94,
      "end": 516.72,
      "text": "انه اذا كل الناس كانوا والله يقولون الصدق\nمعناتها ان الناس بيثقون"
    },
    {
      "start": 516.72,
      "end": 521.44,
      "text": "فكل معناه it's not self-deprecating انه\nعادي بيكمل بيكمل بيكمل"
    },
    {
      "start": 521.44,
      "end": 525.68,
      "text": "ما احد فجأة بيوقف انه يقول الصدق دامه انه\nشيء كويس"
    },
    {
      "start": 525.68,
      "end": 528.68,
      "text": "وبرضو يقول لكم هنا murder cannot be\nuniversalized"
    },
    {
      "start": 528.68,
      "end": 532.26,
      "text": "تخيلوا لو كل شخص راح ذبح اي شخص ما احبه"
    },
    { "start": 532.26, "end": 535.32, "text": "كان ما صار فيه بشر في الدنيا" },
    { "start": 535.32, "end": 536.56, "text": "فعشان كذا يقول لكم هنا" },
    {
      "start": 536.56,
      "end": 541.2,
      "text": "يعني نياتكم شينا وما عندكم logic"
    },
    {
      "start": 541.2,
      "end": 546.16,
      "text": "وبرضو يقول لكم هنا ان الكذب ما يمديكم تونة\nuniversalize"
    },
    {
      "start": 546.16,
      "end": 549.16,
      "text": "ليش لان اذا كل الناس قاعدوا يكذبون"
    },
    { "start": 549.16, "end": 551.42, "text": "كان ما صدقنا اي احد صح" },
    {
      "start": 551.42,
      "end": 554.62,
      "text": "فعشان كذا يقول لكم not everything can be\nuniversalize"
    },
    { "start": 554.62, "end": 556.0, "text": "ونكمل تحت" },
    { "start": 556.0, "end": 558.64, "text": "وشو الكاتيكوريال امبراتيف" },
    {
      "start": 558.64,
      "end": 561.26,
      "text": "قال لكم ترى ما هذا ممكن يجيكم كذا ككلمة"
    },
    {
      "start": 561.26,
      "end": 563.22,
      "text": "وشو الكاتيكوريال امبراتيف في الامسكيو"
    },
    {
      "start": 563.22,
      "end": 566.32,
      "text": "قال لكم since moral laws must be\nuniversalized"
    },
    { "start": 566.32, "end": 568.3, "text": "يعني الموضوع لازم" },
    { "start": 568.3, "end": 570.08, "text": "اجباري يصير يونيفورسلايز" },
    { "start": 570.08, "end": 571.52, "text": "يعني يطبق في كل مكان" },
    { "start": 571.52, "end": 576.9, "text": "يعني مثلا" },
    { "start": 576.9, "end": 577.92, "text": "زي ما قلت لكم" },
    {
      "start": 577.92,
      "end": 579.6,
      "text": "انا حبيت هذا المثال حق السيارات"
    },
    { "start": 579.6, "end": 581.08, "text": "لازم سوي له يونيفورسلايز" },
    {
      "start": 581.08,
      "end": 584.06,
      "text": "معتنا والله حين لو هذا الشخص الواحد"
    },
    { "start": 584.06, "end": 585.36, "text": "ممكن رئيس دولة صح" },
    {
      "start": 585.36,
      "end": 588.26,
      "text": "وبالي هذا الشخص الثاني في خمس اطفال"
    },
    { "start": 588.26, "end": 590.32, "text": "ما يمديك تقيس" },
    { "start": 590.32, "end": 592.54, "text": "ما يمديك والله خلاص" },
    { "start": 592.54, "end": 593.44, "text": "يعني" },
    { "start": 593.44, "end": 596.0, "text": "تقول والله لان هذا الرئيس" },
    { "start": 596.0, "end": 597.48, "text": "بذبح أطفال" },
    {
      "start": 597.48,
      "end": 599.24,
      "text": "ولا عشان هؤلاء الأطفال بذبح الرئيس"
    },
    {
      "start": 599.24,
      "end": 604.14,
      "text": "ما يمديكم تفكرون عن الموقف هذا بالضبط"
    },
    { "start": 604.14, "end": 605.1, "text": "وطبقونه" },
    { "start": 605.1, "end": 606.56, "text": "لا هو يشمل كل شيء" },
    { "start": 606.56, "end": 607.64, "text": "خلاص هو select all" },
    { "start": 607.64, "end": 609.26, "text": "هو ما يدخل بالعميق" },
    { "start": 609.26, "end": 610.96, "text": "هو خلاص يصير" },
    { "start": 610.96, "end": 612.36, "text": "يسوي بروغرام" },
    { "start": 612.36, "end": 613.74, "text": "انه اوكي شخص واحد" },
    { "start": 613.74, "end": 614.5, "text": "ولا خمسة شخاص" },
    { "start": 614.5, "end": 616.26, "text": "بغض النظر من الشخص" },
    { "start": 616.26, "end": 617.4, "text": "بذبح الأقل" },
    { "start": 617.4, "end": 618.5, "text": "مثلا هذا مثال" },
    { "start": 618.5, "end": 620.1, "text": "وقال لكم هنا" },
    {
      "start": 620.1,
      "end": 622.84,
      "text": "can't call this laws categorical\nimperatives"
    },
    {
      "start": 622.84,
      "end": 626.22,
      "text": "They identify principles that we should\nalways follow"
    },
    {
      "start": 626.22,
      "end": 631.82,
      "text": "يعني بغض النظر موقفك أو رغبتك أو موقف اللي\nأنت فيه"
    },
    {
      "start": 631.82,
      "end": 635.28,
      "text": "وإن شاء الله بنكمل عن الفورميلاز بالمقطع\nالجاي"
    }
  ]
}
