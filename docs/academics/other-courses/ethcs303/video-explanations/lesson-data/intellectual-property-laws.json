{"id":"intellectual-property-laws","title":"Intellectual Property Laws","url":"https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/intellectual-property/intellectual-property-intro-mp4.mp4","page":"/academics/other-courses/ethcs303/video-explanations/intellectual-property-laws/","caption":"/academics/other-courses/ethcs303/video-explanations/captions/intellectual-property-laws.vtt","chapters":[{"time":0,"title":"Types of intellectual property"},{"time":129.06,"title":"Protecting intellectual works"},{"time":207.6,"title":"Copyright and creative works"},{"time":333.22,"title":"Automatic copyright protection"},{"time":423.52,"title":"Copyright owner rights"},{"time":577.02,"title":"Saudi copyright law"},{"time":642.04,"title":"Copyright infringement"},{"time":741.36,"title":"Fair use"},{"time":934.98,"title":"Software protection"},{"time":1148.2,"title":"Digital rights management"},{"time":1300.9,"title":"Plagiarism and infringement"},{"time":1447.42,"title":"Tetris example"},{"time":1588.46,"title":"Sharing versus selling"}],"transcript":[{"start":0.0,"end":5.407,"text":"السلام عليكم. اليوم بنغطي إليه\nintellectual property. عندنا حين أول سلايد"},{"start":5.407,"end":10.0,"text":"يتكلم عن وش هو أصلاً القوانين اللي بخصوص\nأشياء اللي ممتلكاتنا."},{"start":10.0,"end":17.455,"text":"intellectual property. لاحظوا إنه مو شي\nممكن زي سيارة أو بيت. لا ممكن أحياناً فكرة"},{"start":17.455,"end":19.0,"text":"أو كتاب أو أغنية."},{"start":19.0,"end":20.78,"text":"ونتكلم زيادة عن هذا الفشياء"},{"start":20.78,"end":22.52,"text":"أول شي عندنا الحين الكوبيرايت لا"},{"start":22.52,"end":24.48,"text":"وشهو يقولك أنه يحمي"},{"start":24.48,"end":26.62,"text":"الشخص اللي صنع مثلا"},{"start":26.62,"end":28.92,"text":"الفنية راح سوى لوحة"},{"start":28.92,"end":29.84,"text":"كتاب"},{"start":29.84,"end":31.68,"text":"فيلم أو موسيقى"},{"start":31.68,"end":33.56,"text":"يعني تخيلوا أنا الحين مثلا"},{"start":33.56,"end":35.52,"text":"أروح أسوي أصمم"},{"start":35.52,"end":37.6,"text":"أو أسوي مثلا فيلم"},{"start":37.6,"end":40.24,"text":"ويجي أحد ثاني يقلد فيلمي"},{"start":40.24,"end":42.24,"text":"بس ممكن حتى ممثلين مختلفين"},{"start":42.24,"end":44.48,"text":"بس نفس القصة مية بالمية"},{"start":44.48,"end":46.34,"text":"هل هذا شيء"},{"start":46.34,"end":47.76,"text":"ممؤثرني؟ لا بيأثرني"},{"start":47.76,"end":49.18,"text":"بيأثر في مبيعاتي"},{"start":49.18,"end":51.06,"text":"بيأثر من حقوقي"},{"start":51.06,"end":52.46,"text":"أني أنا اللي مسوي الفيلم"},{"start":52.46,"end":54.72,"text":"على أي أساس أن تجي وتسرقه"},{"start":54.72,"end":56.48,"text":"فهذا هو Copyright Law"},{"start":56.48,"end":58.14,"text":"بل عندكم Patent Law"},{"start":58.14,"end":61.34,"text":"Patent Law هو بخصوص أشياء"},{"start":61.34,"end":63.26,"text":"اللي أصنعها مثلا اختراعات"},{"start":63.26,"end":64.6,"text":"يعني زي الكفر"},{"start":64.6,"end":66.68,"text":"أو الملعقة والسكينة"},{"start":66.68,"end":68.84,"text":"يعني طبعا الحين نشوفها أشياء طبيعية"},{"start":68.84,"end":70.46000000000001,"text":"أنه أي أحد يقدر سوي ملعقة والسكينة"},{"start":70.46000000000001,"end":72.26,"text":"بس قبل أيام الجاهلية"},{"start":72.26,"end":73.66,"text":"اللي ما كان فيها الأشياء"},{"start":73.66,"end":75.08,"text":"كان لا والله اختراع"},{"start":75.08,"end":77.58,"text":"بل عندكم آخر شيء اللي هو Trade Secret Law"},{"start":77.58,"end":87.44,"text":"يعني إيش أنا الحين عندي وصفة وعندي مكونات\nسرية ما بغى أي أحد يعرف عنها"},{"start":87.44,"end":93.92,"text":"ليش لأنه لو عرفوا عنها الوصفتي بتصير أي\nأحد يقدر يسويها ينسخها ويبيحها صح؟"},{"start":93.92,"end":99.42,"text":"فهذا هو trade secret law وكل هذولي النقاط\nبنتكلم عنهم في مقاطع لحالهم"},{"start":99.42,"end":105.24000000000001,"text":"لأنهم عندهم أشياء وسب categories وذلك\nالأشياء فبنفسفس فيهم المقاطع الجاية"},{"start":105.24000000000001,"end":108.24000000000001,"text":"اليوم المقطع بيكون مركز على الـ Copyright\nLaw"},{"start":108.24000000000001,"end":109.47999999999999,"text":"طبعا قال لكم برضو"},{"start":109.47999999999999,"end":122.84,"text":"ايش يعني الحين يعطيك القدرة انك تروح\nوتقاضي اي احد اللي يسرق شغلك"},{"start":122.84,"end":125.74,"text":"وطبعا عشان تقاضي وان اوه سرق شغلي"},{"start":125.74,"end":129.06,"text":"لازم نعرف وش يعتبر سرقها لأي حد"},{"start":129.06,"end":133.5,"text":"ويلا خلنمشي الحين عند الـ Protection of\nIntellectual Objects"},{"start":133.5,"end":135.22,"text":"يعني كيف احنا نقدر نحميهم"},{"start":135.22,"end":136.28,"text":"أول شيء قال لكم"},{"start":136.28,"end":140.76,"text":"اللي هو أي شيء كرياتيب يعني أي شيء فني"},{"start":140.76,"end":143.06,"text":"لازم يصير تانجبل ميديم"},{"start":143.06,"end":148.2,"text":"يعني مثلا أنت لحين رحت قد الشخص فكرتك\nباللسانك"},{"start":148.2,"end":151.22,"text":"هذا ما يعني أن أنت محمي بتحت الكابيرايت"},{"start":151.22,"end":153.54,"text":"لا لازم يصير تانجبل ميديم"},{"start":153.54,"end":155.24,"text":"لا يصير كتاب"},{"start":155.24,"end":156.94,"text":"يا يصير مكتوب على ورقة"},{"start":156.94,"end":158.66,"text":"يا يصير كنتينيك ميزيك"},{"start":158.66,"end":159.48,"text":"مثلا لو كان أغنية"},{"start":159.48,"end":162.0,"text":"يعني يصير فيه ذيك الورقة"},{"start":162.0,"end":163.72,"text":"اللي يخطوط وبدين يقول لك كذا"},{"start":163.72,"end":165.74,"text":"النوتس حرفتوها"},{"start":165.74,"end":168.1,"text":"بس الزبدة أنه يكون"},{"start":168.1,"end":169.7,"text":"شيء مكتوب"},{"start":169.7,"end":171.76,"text":"شيء أنا أقدر أمسكه بيدي"},{"start":171.76,"end":174.28,"text":"مو بشيء كلام والله أنا أسامعته بإذني"},{"start":174.28,"end":175.3,"text":"لا ممنوع"},{"start":175.3,"end":177.62,"text":"برضو قال لكم إذا كان الفكرة فنكشنل"},{"start":177.62,"end":179.26,"text":"يعني مثلا زي الكفر"},{"start":179.26,"end":181.7,"text":"هو يخدمك هو طبعا الشيء اللي يخلي"},{"start":181.7,"end":182.94,"text":"السيارة تمشي صح"},{"start":182.94,"end":185.04,"text":"فهذا ماشين أو براسس"},{"start":185.04,"end":187.52,"text":"ولاحظوا أنه لازم يصير متبع"},{"start":187.52,"end":188.54,"text":"هو شيء زي كان"},{"start":188.54,"end":191.34,"text":"وهذا الانفنشن بندخل"},{"start":191.34,"end":192.64,"text":"تحت الباتنت لاز"},{"start":192.64,"end":194.88,"text":"بس لحظة نحن بعدين بنشوفه"},{"start":194.88,"end":197.76,"text":"ولاحظوا ان ذي المشين وشه فكروا ذي\nالهاردوير"},{"start":197.76,"end":199.34,"text":"ولا البراسس"},{"start":199.34,"end":201.48,"text":"بعدين نحن عندنا الكابيرايت"},{"start":201.48,"end":203.2,"text":"وشه هو أول شيء زي ما قلنا"},{"start":203.2,"end":205.07999999999998,"text":"It only covers tangible work"},{"start":205.07999999999998,"end":205.9,"text":"اللي هو existing"},{"start":205.9,"end":207.6,"text":"قال لكم"},{"start":207.6,"end":210.66,"text":"The main aim of the copyright laws is to\nprotect creative works"},{"start":210.66,"end":212.02,"text":"such as art, music and writing"},{"start":212.02,"end":214.28,"text":"همين هذا التكرار من الكلام السابق"},{"start":214.28,"end":216.98,"text":"هنا الزبدة هذا الدرس عبارة عن هذا شيء هنا"},{"start":216.98,"end":217.88,"text":"The things you made"},{"start":217.88,"end":232.16,"text":"هذا حرفين تقدرون تفكرون مئة ألف شيء"},{"start":232.16,"end":233.94,"text":"مو بس اللي هنا كاتبين باللستة"},{"start":233.94,"end":236.02,"text":"أي شيء أنتم تسوونا"},{"start":236.02,"end":238.16,"text":"زي مثلا كتاب على أي أساس"},{"start":238.16,"end":242.04,"text":"لأحد الحق أن يروح يأخذ كتابك وينسخ ويبيعه\nصح"},{"start":242.04,"end":243.04,"text":"ففكروا كذا"},{"start":243.04,"end":245.24,"text":"أي شيء أنتم شخصيا مسوينا"},{"start":245.24,"end":246.68,"text":"كابيرايت"},{"start":246.68,"end":247.94,"text":"وأهم شيء تانجبل"},{"start":247.94,"end":250.46,"text":"فهذا الاختصار كلها عبارة عن"},{"start":250.46,"end":251.56,"text":"The things you made"},{"start":251.56,"end":254.14,"text":"أي شيء أنت مسويه هو يصير تحت الكابيرايت"},{"start":254.14,"end":256.84,"text":"طبعا قال لكم هنا وش هو اللي كابيرايت ما\nيغطي"},{"start":256.84,"end":258.44,"text":"يقول الكابيرايت ما يغطي"},{"start":258.44,"end":259.44,"text":"أفكار"},{"start":259.44,"end":262.2,"text":"يعني والله أنا فكرت بهذا الشيء فخلاص"},{"start":262.2,"end":263.12,"text":"زي ما كتبت هنا"},{"start":263.12,"end":264.84,"text":"You don't own what's in your thoughts"},{"start":264.84,"end":267.46,"text":"يعني أنت ما تملك الأشياء اللي في أفكارك"},{"start":267.46,"end":269.48,"text":"يعني ممكن أنا أجي عقبك وأفكر نفس الفكرة"},{"start":269.48,"end":271.92,"text":"بس أسبقك وأروح أسوي عليه كابيرايت"},{"start":271.92,"end":273.28,"text":"فما يصير ملكك"},{"start":273.28,"end":275.28,"text":"أول شيء يجب أن تكون تقريباً"},{"start":275.28,"end":277.28,"text":"ثاني شيء"},{"start":277.28,"end":279.28,"text":"يجب أن تكون أشخاص"},{"start":279.28,"end":281.28,"text":"ليس في الجميع، ليس في كل العالم يعرفون عنه"},{"start":281.28,"end":282.28,"text":"لا"},{"start":282.28,"end":283.28,"text":"مثلاً الآن السكر"},{"start":283.28,"end":284.28,"text":"أنا لم أصنع السكر"},{"start":284.28,"end":286.28,"text":"كلنا نعرف عن السكر"},{"start":286.28,"end":287.28,"text":"هل يمكنني أن أقوم بها كابيرايت؟"},{"start":287.28,"end":288.28,"text":"لا"},{"start":288.28,"end":289.28,"text":"نفس الفكرة"},{"start":289.28,"end":290.28,"text":"يجب أن يكون شيء أشخاص"},{"start":290.28,"end":294.28,"text":"والناس قليلة التي تطلعوا هذه الفكرة"},{"start":294.28,"end":295.28,"text":"طبعاً"},{"start":295.28,"end":298.28,"text":"كابيرايت لا تقوم بعمل عملية تقريباً"},{"start":298.28,"end":299.28,"text":"مثلاً"},{"start":299.28,"end":305.12,"text":"الحين بتشوفون المشهورين اللي يروحون على\nالستيج وسوون رقصات معينة"},{"start":305.12,"end":307.98,"text":"هم ما هيقدرون يسوون كابيرايت على هذا\nالرقصة"},{"start":307.98,"end":309.62,"text":"لأنه شو انتانجبل"},{"start":309.62,"end":311.36,"text":"ما في شي كذا إثبات"},{"start":311.36,"end":313.92,"text":"اللي عدلوا يوم نقشت الدكتورة يوم بعدين"},{"start":313.92,"end":318.18,"text":"قلنا إنه ممكن إنه يصير فيه فيديو ركوردين\nعن الرقصة"},{"start":318.18,"end":322.78,"text":"قلت ممكن إيه إذا كان فيه مقطع وقدرت تثبت\nإنه"},{"start":322.78,"end":326.66,"text":"إنه الكمبنيشن الرقصة ما خدت من ناس تانين"},{"start":326.66,"end":328.36,"text":"إيه ممكن بس إنه مرة صعب"},{"start":328.36,"end":333.22,"text":"ففكروا \"Intangible\" زي الرقص لأنه صعب أن\nالواحد يثبت أن هذا الرقص تبعه"},{"start":333.22,"end":335.06,"text":"بني عندنا الحين \"Copyrights\""},{"start":335.06,"end":338.26,"text":"قال لكم \"The copyright owner does not have\nto do anything to get copyright\""},{"start":338.26,"end":339.06,"text":"يعني ايش؟"},{"start":339.06,"end":340.56,"text":"يعني أنا الحين عندي موقع"},{"start":340.56,"end":344.26,"text":"موقعي اللي ودي يستفيد ممكن يشوف شيء مفيد"},{"start":344.26,"end":345.86,"text":"اللي هو هذا"},{"start":346.86,"end":352.15999999999997,"text":"الحين إذا كتبتوه على جوجل بيطلع لكم كل\nالملخصات والنوت والأشياء زي كذا صح؟"},{"start":352.15999999999997,"end":355.46,"text":"يعني الحين كيف أنا أقدر أحمي نفسي من أي\nأحد ثاني"},{"start":355.46,"end":358.15999999999997,"text":"إنه يروح ينسخ الشغلي ويروح مثلا يبيعه"},{"start":358.15999999999997,"end":359.5,"text":"في كابيرايت"},{"start":359.5,"end":362.4,"text":"وهذا الشيء لأنه تحت برنامجي"},{"start":362.4,"end":363.22,"text":"تحت موقعي"},{"start":363.22,"end":364.5,"text":"تحت اسمي"},{"start":364.5,"end":366.3,"text":"وحطة الاد سيمبل"},{"start":366.3,"end":367.6,"text":"و2026"},{"start":367.6,"end":368.26,"text":"ودى التفاصيل"},{"start":368.26,"end":369.04,"text":"هذه الكابيرايت"},{"start":369.04,"end":369.84,"text":"خلاص"},{"start":369.84,"end":371.56,"text":"هنا عرفوا أنه كابيرايت"},{"start":371.56,"end":372.6,"text":"بس هو قاعد يقول لكم"},{"start":372.6,"end":373.78,"text":"أنه حتى هذا الشيء"},{"start":373.78,"end":374.44,"text":"مو بلازم نسير"},{"start":374.44,"end":376.66,"text":"أنا مو بلازم أسوي أي شيء"},{"start":376.66,"end":377.64,"text":"غير أن أثبت"},{"start":377.64,"end":379.14,"text":"أنه أنا اللي كاتبته"},{"start":379.14,"end":380.08,"text":"أنا اللي مسويته"},{"start":380.08,"end":380.58,"text":"بس"},{"start":380.58,"end":381.24,"text":"بني قال لكم هنا"},{"start":381.24,"end":382.36,"text":"once a creation appears"},{"start":382.36,"end":383.52,"text":"in a fixed medium"},{"start":383.52,"end":385.88,"text":"it automatically protected by copyright"},{"start":385.88,"end":386.4,"text":"يعني وشو"},{"start":386.4,"end":387.88,"text":"أول ما ينصنع على طول"},{"start":388.16,"end":394.563,"text":"والله لازم اروح مثلا الوزارة اقدم لهم شيء\nمع انه سووا الوزارة هذا الشيء من باب انه"},{"start":394.563,"end":397.92,"text":"تحسين القدرة ان الواحد يدافع عن نفسه\nوزياده"},{"start":397.92,"end":401.9,"text":"بس انه مفروض automatically protected بدون\nما تون شيء"},{"start":401.9,"end":406.52,"text":"وقولوا شوق طيب المدة لهذا كم؟ هل هو سنة\nسنتين؟ لا"},{"start":406.52,"end":413.311,"text":"يا جماعة مدة حياتكم حياة الشخص اللي مأسس\nهذا الشيء زائد خمسين سنة يعني عقب وفاة"},{"start":413.311,"end":415.46,"text":"الشخص اللي مأسس هذا الشيء"},{"start":415.46,"end":423.52,"text":"الآن ندخل في الأربع الأشياء التي نحق الشخص\nالذي أسس ومسوّل هذا الشيء"},{"start":423.52,"end":425.92,"text":"قال لكم أول شيء \"Reproduction rights\""},{"start":425.92,"end":434.4,"text":"يعني أنا الآن لي الحق أني أقول مين ومين ما\nيسموح له يسوي نسخ من شغلي"},{"start":434.4,"end":437.5,"text":"صح يقول لكم \"The right to reproduce the\ncopyrighted work\""},{"start":437.5,"end":440.86,"text":"مثلا أنكم تطبعون صورة أنا مصورتها"},{"start":440.86,"end":444.7,"text":"أو مثلا تروحون تحولون كتب الأفلام"},{"start":444.7,"end":445.8,"text":"هذا أنا كتابي"},{"start":445.8,"end":448.34,"text":"ما لكم حق أنكم تقوموا فيلم"},{"start":448.34,"end":449.54,"text":"إلا مع موافقتي"},{"start":449.54,"end":451.38,"text":"هذا هو reproduction right"},{"start":451.38,"end":452.72,"text":"نفس الحكاية مع audio"},{"start":452.72,"end":453.6,"text":"or digital format"},{"start":453.6,"end":454.4,"text":"duplication"},{"start":454.4,"end":455.82,"text":"computer media"},{"start":455.82,"end":456.58,"text":"such as discs"},{"start":456.58,"end":457.56,"text":"الزبدة"},{"start":457.56,"end":459.96,"text":"إن أي شيء أنا مسويته"},{"start":459.96,"end":461.6,"text":"إذا تبغى تروح تغيره"},{"start":461.6,"end":462.58,"text":"ولا تنشره"},{"start":462.58,"end":464.12,"text":"لازم تجيني تستأذمني"},{"start":464.12,"end":465.8,"text":"هذا أول حقوق من حقوقي"},{"start":465.8,"end":466.76,"text":"بدين عندكم الحين"},{"start":466.76,"end":469.12,"text":"derivative right"},{"start":469.12,"end":470.48,"text":"هذا مرة مشابه"},{"start":470.48,"end":471.64,"text":"مع هذا النقطة"},{"start":471.64,"end":472.42,"text":"اللي يقول لكم هنا"},{"start":472.42,"end":473.62,"text":"digital format"},{"start":473.62,"end":477.62,"text":"نفس الفكرة"},{"start":477.62,"end":479.62,"text":"أن تأخذ نفس الفكرة"},{"start":479.62,"end":481.62,"text":"لكن تحولها بشكل مختلف"},{"start":481.62,"end":482.62,"text":"مثلاً"},{"start":482.62,"end":483.62,"text":"كتاب إذا سويت نسخة"},{"start":483.62,"end":485.62,"text":"بلغة مختلفة"},{"start":485.62,"end":487.62,"text":"أو حطيت كتاب"},{"start":487.62,"end":488.62,"text":"سويت لفلم"},{"start":488.62,"end":489.62,"text":"كما هنا تشوفون أصلاً"},{"start":489.62,"end":490.62,"text":"أضع لكم أفضل"},{"start":490.62,"end":491.62,"text":"تركيز الأعمال"},{"start":491.62,"end":492.62,"text":"أخرى من الإشارة"},{"start":492.62,"end":493.62,"text":"أو"},{"start":493.62,"end":494.62,"text":"تقوم بشكل موضوع"},{"start":494.62,"end":496.62,"text":"هل هم قرروا أعطونكم إياه"},{"start":496.62,"end":498.62,"text":"بس الزبدة أنه"},{"start":498.62,"end":501.62,"text":"قبل أن أحد يأخذ شغلك وغيره شوي"},{"start":501.62,"end":502.62,"text":"أن تتوافق عليه"},{"start":502.62,"end":503.66,"text":"أن تتوافق عليه"},{"start":503.66,"end":506.28,"text":"بدأي عندكم الآن الـ Performance Right"},{"start":506.28,"end":508.44,"text":"والـ Performance Right انتبهوا أن"},{"start":508.44,"end":512.0,"text":"يعني ما تتلخبطون مع الـ Distributive"},{"start":512.0,"end":512.62,"text":"لماذا؟"},{"start":512.62,"end":514.24,"text":"لأن أول شيء Performance يقول لكم"},{"start":514.24,"end":516.36,"text":"Perform or Display Work Publicly"},{"start":516.36,"end":518.66,