  "transcript": [
    {
      "start": 0.0,
      "end": 4.76,
      "text": "السلام عليكم. اليوم نكمل عند الفرس\nفورميلايشن وترى لازم تعرفون"
    },
    {
      "start": 4.76,
      "end": 9.36,
      "text": "الفرس فورميلايشن وشو وسكن فورميلايشن وشو\nلانا بيقولون لكم"
    },
    {
      "start": 9.36,
      "end": 15.46,
      "text": "باستخدام الكانتينيزم فرس فورميلا وشو مو\nبقايلين لكم وشو الفرس فورميلا"
    },
    {
      "start": 15.46,
      "end": 20.98,
      "text": "عرفتوا زي كأن الرياضيات مم معطينكم\nالفورميلا فاول الفورميلا يقول لكم ان"
    },
    {
      "start": 20.98,
      "end": 28.58,
      "text": "وشو الفعل اللي يقدر يسير يونيفورسلايز اذا\nقدر تتون لينيفورسلايز معنات الوضع تمام"
    },
    { "start": 28.58, "end": 31.12, "text": "فقال لكم هنا" },
    { "start": 31.12, "end": 33.92, "text": "اسألوا نفسكم" },
    { "start": 33.92, "end": 35.0, "text": "إذا جاكم سيناريو" },
    { "start": 35.0, "end": 38.7, "text": "هل هذا الشي إذا كل العالم" },
    { "start": 38.7, "end": 40.5, "text": "استمروا أنهم يسوونه" },
    { "start": 40.5, "end": 42.24, "text": "هل بيستمر يعني بيكمل" },
    { "start": 42.24, "end": 44.56, "text": "ولا فجأة بيخرب على نفسه" },
    { "start": 44.56, "end": 45.78, "text": "إذا الجواب E" },
    { "start": 45.78, "end": 47.44, "text": "معناته أنه potentially" },
    { "start": 47.44, "end": 48.68, "text": "لاحظوا كمية potentially" },
    { "start": 48.68, "end": 51.56, "text": "طبعا النسبة أنه يصبح immoral" },
    { "start": 51.56, "end": 53.62, "text": "بس أن الغالبين بيكون moral" },
    { "start": 53.62, "end": 55.14, "text": "وإذا كان الجواب لا" },
    { "start": 55.14, "end": 57.88, "text": "عندكم هذا المثالين" },
    {
      "start": 57.88,
      "end": 64.473,
      "text": "هو عبارة عنها حين هذا الذي يقول لكم إذا\nالشخص كذب وهذا إذا كان الشخص والله مسك"
    },
    { "start": 64.473, "end": 64.98, "text": "كلمتها" },
    {
      "start": 64.98,
      "end": 68.3,
      "text": "الحين خلقوا أنت كذبت كان ما أحد تصدق\nالوعود"
    },
    {
      "start": 68.3,
      "end": 73.8,
      "text": "إذا وعدت أحد يقول أغلب الناس يكذبون فخلاص\nأنا مو مصدقة"
    },
    {
      "start": 73.8,
      "end": 76.14,
      "text": "طبعا هذا دفيت the purpose of a promise"
    },
    { "start": 76.14, "end": 79.1, "text": "يعني قيمة الوعيد ما لا قيمة صار" },
    { "start": 79.1, "end": 82.6, "text": "صار ما له قيمة فعشان كذا" },
    {
      "start": 82.6,
      "end": 88.68,
      "text": "بس والله الناس اللي إذا كلمة الشخص كمل\nاستمر بوعده"
    },
    {
      "start": 88.68,
      "end": 93.53999999999999,
      "text": "لا والله الناس بيصدقون وبيستمرون يعدون\nوبيصير له قيمة"
    },
    {
      "start": 93.53999999999999,
      "end": 95.94,
      "text": "فهذا الـ action can be universalized"
    },
    { "start": 95.94, "end": 97.1, "text": "هذا أول فورميلة" },
    { "start": 97.1, "end": 99.28, "text": "عندكم الحين الـ illustration" },
    {
      "start": 99.28,
      "end": 103.36,
      "text": "نفس الشي اللي أنا شرحت لكم إياه فوق عن\nالوعود"
    },
    { "start": 103.36, "end": 104.2, "text": "بس مختصر" },
    { "start": 104.2, "end": 107.38, "text": "فبس هوي لـ skip" },
    {
      "start": 107.38,
      "end": 111.32,
      "text": "بس هذا برضو سؤال ثاني يعني example ثاني\nللي بيقراه"
    },
    { "start": 111.32, "end": 112.52000000000001, "text": "بس أتوقع أنه واضح" },
    { "start": 112.52000000000001, "end": 114.3, "text": "نحن لديكم الحين" },
    { "start": 114.3, "end": 116.28, "text": "الثاني يقول لكم" },
    { "start": 116.28, "end": 118.28, "text": "استخدموا نفسكم" },
    { "start": 118.28, "end": 119.9, "text": "والناس ك" },
    {
      "start": 119.9,
      "end": 122.8,
      "text": "ends and never as a means to an end"
    },
    { "start": 122.8, "end": 124.06, "text": "يعني وشوا" },
    { "start": 124.06, "end": 125.98, "text": "لا تستخدمون الناس" },
    { "start": 125.98, "end": 127.52, "text": "عشان أنتم مستفيدين" },
    { "start": 127.52, "end": 130.04, "text": "خلوا الناس من أسباب" },
    { "start": 130.04, "end": 132.02, "text": "نجاحكم وخليهمهم" },
    { "start": 132.02, "end": 133.1, "text": "بعد ينجحوا معاكم" },
    { "start": 133.1, "end": 135.72, "text": "لا تستغلونهم نهائيا" },
    { "start": 135.72, "end": 138.02, "text": "فإذا كشفتوا كلمة" },
    { "start": 138.02, "end": 139.1, "text": "means عرفوا أن" },
    {
      "start": 139.1,
      "end": 141.16,
      "text": "something you use to achieve your goal"
    },
    {
      "start": 141.16,
      "end": 144.4,
      "text": "تخيلوا انكم تستخدمون بشر كيعني tool"
    },
    { "start": 144.4, "end": 145.16, "text": "ما يصلح" },
    {
      "start": 145.16,
      "end": 147.9,
      "text": "والend something valuable in itself"
    },
    { "start": 147.9, "end": 150.7, "text": "فاتردجاكم سيناريو عن ال can't" },
    { "start": 150.7, "end": 151.48, "text": "وش تكتبون" },
    { "start": 151.48, "end": 152.76, "text": "دائما تودكم تقولون" },
    { "start": 152.76, "end": 155.72, "text": "you should use them as an end" },
    { "start": 155.72, "end": 157.72, "text": "and not as a means to an end" },
    { "start": 157.72, "end": 159.2, "text": "هذا مر مهم انكم تكتبونه" },
    { "start": 159.2, "end": 161.14, "text": "طبعا can't كان يقول" },
    { "start": 161.14, "end": 163.38, "text": "ان الناس مبعفشك" },
    {
      "start": 163.38,
      "end": 165.74,
      "text": "they're not objects or tools or resources"
    },
    { "start": 165.74, "end": 168.94, "text": "فلا تستخدمهم كأن هذول الصفات" },
    {
      "start": 168.94,
      "end": 173.06,
      "text": "هذا يعني أننا يجب أن نستخدمهم و نستخدمهم\nلنافسنا"
    },
    { "start": 173.06, "end": 175.28, "text": "و نكمل هنا المثال" },
    { "start": 175.28, "end": 177.52, "text": "بعد حتى نرى الشخص كيف يطاه" },
    { "start": 177.52, "end": 179.82, "text": "عشان يوصل الهدف" },
    {
      "start": 179.82,
      "end": 182.04,
      "text": "طبعا أنا حكيت بصلكم في هذا المثال"
    },
    { "start": 182.04, "end": 184.34, "text": "كان بإمكانة يستخدم هذا الشخص" },
    { "start": 184.34, "end": 186.22, "text": "أن يشتغلون مع بعض" },
    { "start": 186.22, "end": 187.48, "text": "عشان يسوون سلم" },
    { "start": 187.48, "end": 189.26, "text": "أو يعني يسوون حاجز" },
    { "start": 189.26, "end": 191.2, "text": "من حيث أن يمكنوا يمشون مع بعض" },
    { "start": 191.2, "end": 193.36, "text": "وكلهم يستلمون الهدية" },
    { "start": 193.36, "end": 194.78, "text": "فقال لكم هنا" },
    {
      "start": 194.78,
      "end": 196.16,
      "text": "The Categorial Imperative says"
    },
    {
      "start": 196.16,
      "end": 199.66,
      "text": "إنه غير حقًا لإستخدام أحد أخرى لإستخدام\nأحده"
    },
    { "start": 199.66, "end": 201.46, "text": "في غير كل إستخدام مع أخرى" },
    {
      "start": 201.46,
      "end": 204.46,
      "text": "يجب عليهم أن يستخدمون أشخاص بهم"
    },
    {
      "start": 204.46,
      "end": 209.16,
      "text": "يعني عيب عليك أن تأتي أحد وظهر أحد عشان\nتصل للي أنت بيه"
    },
    {
      "start": 209.16,
      "end": 215.46,
      "text": "لازم تجدون حل من حيث أن كلكم تمشون مع بعض\nللنتيجة التي تبونها"
    },
    {
      "start": 216.46,
      "end": 221.46,
      "text": "وبعدين طبعًا برضو ترى إنه أسان تستغلون\nالناس"
    },
    { "start": 222.16, "end": 223.66, "text": "وبعدين قال لكم" },
    {
      "start": 223.66,
      "end": 237.66,
      "text": "تعتقد أن الناس يفكرون بلوجيك و الأهمية يجب\nأن يحسن أنه قيمة عالية جداً."
    },
    {
      "start": 237.66,
      "end": 244.66,
      "text": "لتعتقد أن الناس يجب أن يتعرفون بلوجيك و\nالأهمية."
    },
    {
      "start": 244.66,
      "end": 249.74,
      "text": "لازم نثق إن كل واحد ترى عنده رأي ونرأيهم\nمبعا على طول اوتوماتيك لي غلط"
    },
    {
      "start": 249.74,
      "end": 253.42,
      "text": "وإن كل واحد قادي حاول يطمح للأحسن شايف\nممكن"
    },
    {
      "start": 253.42,
      "end": 257.08,
      "text": "عشان كذا إنه مفروض ممنوع نستخدمهم كأغراض"
    },
    {
      "start": 257.08,
      "end": 261.85,
      "text": "We can't express this by saying that we\nshould never treat humanity merely as"
    },
    { "start": 261.85, "end": 262.16, "text": "means" },
    {
      "start": 262.16,
      "end": 266.44,
      "text": "to get what you want but always as it ends\nin themselves"
    },
    {
      "start": 266.44,
      "end": 269.16,
      "text": "يعني النتيجة دون ما تستخدمونهم الزبدة"
    },
    {
      "start": 269.16,
      "end": 274.2,
      "text": "اولا عندكم الحين هذا السيناريو انه والله\nانا عندي مصنع"
    },
    {
      "start": 274.2,
      "end": 280.82,
      "text": "ترى التفاصيل المصنع مو مهمة يعني بس اوشو\nانه داريا انه بيسكر بعد سنة"
    },
    {
      "start": 280.82,
      "end": 290.26,
      "text": "وبنقل المكان الثاني وبوسع بس وشو انا خلال\nهذا السنة احتاج موظفين جديدين"
    },
    {
      "start": 290.26,
      "end": 296.15999999999997,
      "text": "اوكي عشان اكمل شغلي بس وشو دول الناس جايين\nمن مناطق مختلفة"
    },
    {
      "start": 296.15999999999997,
      "end": 300.16,
      "text": "فكروا الى حين اللي جاي من جدة الرياض"
    },
    {
      "start": 300.16,
      "end": 304.16,
      "text": "هو فجأة خلاص يعني بيقى وظيفة في الرياض"
    },
    {
      "start": 304.16,
      "end": 309.16,
      "text": "وقال بنقل كل عفشي وعيالي وعائلتي عشان هذا\nالوظيفة"
    },
    {
      "start": 309.16,
      "end": 318.16,
      "text": "والشغل ما علموهم ان ترى يا جماعة حنا ترى\nبننقل الجزان بعد سنة"
    },
    {
      "start": 318.16,
      "end": 323.16,
      "text": "تخيلوا ما قالوا لهم الناس يعني ممكن شروا\nبيت استأجروا شقة"
    },
    {
      "start": 323.16,
      "end": 328.16,
      "text": "يعني ما يمديهم الناس فاجئة يخذون كل عفجهم\nبيقدونك شوية ينقلون مع الشركة صح"
    },
    {
      "start": 328.16,
      "end": 335.15999999999997,
      "text": "فهل هو اثيكل واللي مو اثيكل ان الشركة ما\nوضحت ان في ترا نقلة"
    },
    {
      "start": 335.15999999999997,
      "end": 343.15999999999997,
      "text": "لان وشو اذا كان بلغوا الناس ان اوترا احنا\nبننقل بعد سنة كان الناس رافضوا الوظيفة صح"
    },
    {
      "start": 343.15999999999997,
      "end": 349.15999999999997,
      "text": "فوشو بيقلوني وضفون الناس مع اقل\nكواليفيكيشنز للوكل ووركرز عرفتو"
    },
    {
      "start": 349.15999999999997,
      "end": 357.419,
      "text": "طبعا الجواب ايه لازم تبلغونهم ان يعني\nبتحركون الشركة لانكم لو ما علمتوهم بيصير"
    },
    { "start": 357.419, "end": 358.15999999999997, "text": "وشو كذا" },
    {
      "start": 358.15999999999997,
      "end": 366.254,
      "text": "بتصير مشكلة انكم تستخدمون الناس كتول وليس\nان تخلون الناس سبب من نجاح شركتكم"
    },
    {
      "start": 366.254,
      "end": 373.16,
      "text": "وتساعدونهم من حيث ان ما يضيعون استثمارهم\nوتسببون لهم مشاكل شخصية"
    },
    {
      "start": 373.16,
      "end": 378.16,
      "text": "وبعدين هنا قاد يقول لكم من ناحية السكند\nفورميلاشن"
    },
    {
      "start": 378.16,
      "end": 382.16,
      "text": "\"إنه يجب أن تتعلم المستخدمين لأن\nالمستخدمين تؤديهم لأجهزاء المستخدمين\""
    },
    {
      "start": 382.16,
      "end": 385.16,
      "text": "يعني نفس جواب اللي أنا هنا حطيته لكم"
    },
    {
      "start": 385.16,
      "end": 389.52,
      "text": "\"إن المستخدمين يتعلمين المستخدمين لأجهزاء\nالمستخدمين وليس كم يخدمين لأجهزاء"
    },
    { "start": 389.52, "end": 390.16, "text": "المستخدمين\"" },
    {
      "start": 390.16,
      "end": 394.15999999999997,
      "text": "بنعندكم سيناريو ثاني إنه كلارا هي والله أم"
    },
    {
      "start": 394.15999999999997,
      "end": 402.15999999999997,
      "text": "ما عندها أحد يساعدها مع أطفالها تشتغل فول\nتايم وتاخذ كورسين في النهار في السمستر"
    },
    {
      "start": 402.15999999999997,
      "end": 408.15999999999997,
      "text": "واحد من الاستير كلاس هي اصلا اني مجموعتها\nخمسة وخمسين"
    },
    {
      "start": 408.15999999999997,
      "end": 414.15999999999997,
      "text": "يعني هي شدة حيلها ويعني المادة هذة ممكن\nتطلب شغل اكثر من الطبيعي"
    },
    {
      "start": 414.15999999999997,
      "end": 420.16,
      "text": "وان ما عندها وقت يعني بين كل هذة التاسك\nانها تروح تكتب ربورت من نفسها"
    },
    {
      "start": 420.16,
      "end": 426.16,
      "text": "ولا راحت وشرت كلام يعني احد دفعت لاحد يسوي\nلها المشروع"
    },
    {
      "start": 426.16,
      "end": 431.34,
      "text": "كملنا هنا يقولكم ان ان استخدمنا الفرس\nفورمليشن اللي هو"
    },
    {
      "start": 431.34,
      "end": 436.4,
      "text": "هل بامكانكم تخلونا يونيفورساليز ولا لا"
    },
    {
      "start": 436.4,
      "end": 440.98,
      "text": "قال لكم كارلا تبغى درجات للشغل ما هي سواتي\nصح"
    },
    { "start": 440.98, "end": 443.0, "text": "فالقانون وش يقول يقول لك" },
    {
      "start": 443.0,
      "end": 445.74,
      "text": "يقول لك you may claim credit for work\nperformed by someone else"
    },
    {
      "start": 445.74,
      "end": 448.12,
      "text": "if this rule is universalizing"
    },
    { "start": 448.12, "end": 450.2, "text": "اذا فعلا انطبقنا هذا القانون" },
    { "start": 450.2, "end": 452.7, "text": "وش بصير بصير الربورت" },
    {
      "start": 452.7,
      "end": 454.34000000000003,
      "text": "الدوكيمنت اللي حنا نسويها"
    },
    { "start": 454.34000000000003, "end": 455.96, "text": "ما لها قيمة" },
    { "start": 455.96, "end": 457.4, "text": "ما لها فايدة" },
    { "start": 457.4, "end": 459.42, "text": "ولا نقدر نعطي درجات" },
    { "start": 459.42, "end": 461.8, "text": "على الشغل صدق نفسه" },
    { "start": 461.8, "end": 463.06, "text": "لأنه مو بشغلك" },
    { "start": 463.06, "end": 465.7, "text": "فطبعا شان كده يقول لكم" },
    {
      "start": 465.7,
      "end": 468.82,
      "text": "أن الـ Proposal Moral Rule is\nSelf-Defecating"
    },
    { "start": 468.82, "end": 470.4, "text": "يعني ما لها قيمة" },
    { "start": 470.4, "end": 471.18, "text": "بيذبح نفسها" },
    { "start": 471.18, "end": 473.18, "text": "بيصير لما أحد يعني يصير" },
    { "start": 473.18, "end": 474.86, "text": "يستقبل الدوكيمنت" },
    { "start": 474.86, "end": 477.18, "text": "طبعا كلارا هي في النهاية" },
    { "start": 477.18, "end": 479.06, "text": "غلطانة انهشرت الـ Report" },
    { "start": 479.06, "end": 481.34, "text": "وهنا قاعد يقول لكم" },
    { "start": 481.34, "end": 482.18, "text": "نفس الشيء" },
    { "start": 482.18, "end": 483.56, "text": "ان this theory" },
    { "start": 483.56, "end": 485.28, "text": "what clara did was wrong" },
    { "start": 485.28, "end": 486.56, "text": "نفس الشيء" },
    { "start": 486.56, "end": 487.76, "text": "والحين خلونا نكمل" },
    { "start": 487.76, "end": 489.28, "text": "عند الperfect والimperfect" },
    { "start": 489.28, "end": 490.26, "text": "وش يقول لكم" },
    { "start": 490.26, "end": 491.22, "text": "الدوتي" },
    {
      "start": 491.22,
      "end": 493.16,
      "text": "لاحظوا انه كانت نزم عبارة عن الدوتي"
    },
    { "start": 493.16, "end": 493.5, "text": "صح" },
    { "start": 493.5, "end": 494.16, "text": "في نوعين" },
    { "start": 494.16, "end": 495.8, "text": "في الperfect وفي الimperfect" },
    { "start": 495.8, "end": 496.88, "text": "قال لكم طبعا" },
    {
      "start": 496.88,
      "end": 499.08,
      "text": "the distinction between perfect and\nimperfect duties"
    },
    { "start": 499.08, "end": 500.48, "text": "is crucial for understanding" },
    { "start": 500.48, "end": 501.52, "text": "how moral obligations" },
    {
      "start": 501.52,
      "end": 503.92,
      "text": "are characterized and prioritized"
    },
    { "start": 503.92, "end": 504.94, "text": "يعني احيانا" },
    { "start": 504.94, "end": 507.48, "text": "في اشياء الاجباري" },
    { "start": 507.48, "end": 508.48, "text": "انسويها" },
    { "start": 508.48, "end": 510.36, "text": "وفي اشياء اختياري" },
    { "start": 510.36, "end": 511.74, "text": "وفيه أهمية" },
    { "start": 511.74, "end": 513.8, "text": "وفيه بالتدريج" },
    { "start": 513.8, "end": 515.68, "text": "كيف نوضح أول شيء" },
    { "start": 515.68, "end": 516.38, "text": "البرفكت" },
    { "start": 516.38, "end": 517.74, "text": "لاحظوا أننا كتبتنا MCQ" },
    { "start": 517.74, "end": 520.38, "text": "لأنك جتني أنا كمسي كيو" },
    { "start": 520.38, "end": 521.86, "text": "وش هو البرفكت" },
    { "start": 521.86, "end": 523.82, "text": "هل هو نكتف أو بوزيتف" },
    { "start": 523.82, "end": 525.76, "text": "طبعا البرفكت يقول لكم" },
    {
      "start": 525.76,
      "end": 529.1,
      "text": "إنه absolute unconditional obligation"
    },
    { "start": 529.1, "end": 530.98, "text": "اللي إجباري تسوونا" },
    { "start": 530.98, "end": 532.42, "text": "مهما كان الوضع" },
    {
      "start": 532.42,
      "end": 535.16,
      "text": "Always be followed without exception"
    },
    { "start": 535.16, "end": 535.96, "text": "مهما صار" },
    {
      "start": 535.96,
      "end": 538.76,
      "text": "مثلا الآن زي الصلاة تفكروا فيها"
    },
    {
      "start": 538.76,
      "end": 541.38,
      "text": "والله انت ما فيك شيء لازم تصلي"
    },
    { "start": 541.38, "end": 543.76, "text": "انت والله توقي طالع من عملية" },
    { "start": 543.76, "end": 546.2, "text": "ولا تعبان ما تقدر تسجد" },
    { "start": 546.2, "end": 547.96, "text": "تصلي بعد الكرسي" },
    { "start": 547.96, "end": 549.32, "text": "ولا تصلي ان شاء الله بعيونك" },
    { "start": 549.32, "end": 552.46, "text": "هذا الشيء لازم اجباري تتوونه" },
    { "start": 552.46, "end": 554.12, "text": "without exception صح" },
    {
      "start": 554.12,
      "end": 556.76,
      "text": "فهذا فكروا فيه ان البرفكت زي الصلاة"
    },
    { "start": 556.76, "end": 557.7, "text": "لازم تصير perfect" },
    { "start": 557.7, "end": 559.52, "text": "قال لكم وشو characteristics" },
    { "start": 559.52, "end": 561.86, "text": "ان مرة شديد" },
    {
      "start": 561.86,
      "end": 565.4,
      "text": "ما فيه room for flexibility or exception\nصح"
    },
    { "start": 565.4, "end": 567.18, "text": "فانا وشو كيف حفظته" },
    { "start": 567.18, "end": 568.66, "text": "لأنه negative duty" },
    { "start": 568.66, "end": 570.12, "text": "ترى هذا اللي جعني كامسكيو" },
    {
      "start": 570.12,
      "end": 571.46,
      "text": "إنه هل هو negative ولا positive"
    },
    {
      "start": 571.46,
      "end": 574.72,
      "text": "لأن imperfect duty هو يعتبر positive"
    },
    { "start": 574.72, "end": 575.6, "text": "فأنا كيف حفظتها" },
    {
      "start": 575.6,
      "end": 578.96,
      "text": "قلت إنه لأنه مر strict وشديد علي"
    },
    { "start": 578.96, "end": 580.92, "text": "والله خلاص negative سلبي" },
    {
      "start": 580.92,
      "end": 583.44,
      "text": "فقال لكم negative duties are often framed\nas duties"
    },
    { "start": 583.44, "end": 584.8, "text": "not to do something" },
    { "start": 584.8, "end": 586.54, "text": "يعني لا تسوي هذا الشيء" },
    { "start": 586.54, "end": 588.5, "text": "لا تكذب لا تسرق" },
    { "start": 588.5, "end": 590.24, "text": "لا تعتذر الناس" },
    { "start": 590.24, "end": 592.52, "text": "فدامها عبارة عن كل الأشياء" },
    { "start": 592.52, "end": 594.32, "text": "اللي ما تقدر تسويها" },
    { "start": 594.32, "end": 595.8, "text": "صارت negative" },
    { "start": 595.8, "end": 597.12, "text": "هذا الطريقة ثانية تحفظونها" },
    {
      "start": 597.12,
      "end": 599.24,
      "text": "و بنعندكم الأخر نقطة universalize"
    },
    { "start": 599.24, "end": 600.48, "text": "اللي هو يتكلم عن" },
    {
      "start": 600.48,
      "end": 602.58,
      "text": "these duties must be able to be applied"
    },
    { "start": 602.58, "end": 604.56, "text": "universally without condition" },
    { "start": 604.56, "end": 606.58, "text": "ايش يعني معناته" },
    { "start": 606.58, "end": 609.26, "text": "ان ما في سبب ان ما يصير" },
    { "start": 609.26, "end": 609.86, "text": "universalize" },
    { "start": 609.86, "end": 611.98, "text": "يعني لازم اجباري" },
    { "start": 611.98, "end": 614.22, "text": "كل الناس في كل العالم" },
    { "start": 614.22, "end": 615.48, "text": "يطابقون نفس القانون" },
    { "start": 615.48, "end": 618.12, "text": "طبعا المثال زي ان لا تكذب" },
    { "start": 618.12, "end": 619.34, "text": "طبعا هذا كانت يقول" },
    {
      "start": 619.34,
      "end": 621.78,
      "text": "يقول لا lying is always morally wrong"
    },
    {
      "start": 621.78,
      "end": 623.8,
      "text": "regardless of the situation or\nconsequences"
    },
    {
      "start": 623.8,
      "end": 627.98,
      "text": "يعني مهما كان العقابات والضرر والموقف"
    },
    { "start": 627.98, "end": 629.88, "text": "ما يجوز انك تكذب" },
    { "start": 629.88, "end": 631.42, "text": "هذا عاد طبعا كلام can't" },
    {
      "start": 631.42,
      "end": 633.58,
      "text": "هذا يعني يعتبر الperfect duties"
    },
    { "start": 633.58, "end": 635.74, "text": "وبنعندكم الان الامperfect" },
    {
      "start": 635.74,
      "end": 639.18,
      "text": "اذا عرفتوا الperfect فخلاص انتم عرفتوا\nالامperfect"
    },
    {
      "start": 639.18,
      "end": 642.48,
      "text": "اعكسوا كل افكار الperfect عشان يصير\nالامperfect"
    },
    {
      "start": 642.48,
      "end": 645.12,
      "text": "قال لكم ان a moral obligation is more\nflexible"
    },
    {
      "start": 645.12,
      "end": 648.74,
      "text": "and allows for discrete discretion in how\nyou fulfill it"
    },
    {
      "start": 648.74,
      "end": 651.88,
      "text": "يعني تقدرون تختارون متى تطبقونه"
    },
    { "start": 651.88, "end": 654.1, "text": "وكم مرة تطبقونا" },
    { "start": 654.1, "end": 656.56, "text": "بس إنه كويس إذا طبقته" },
    { "start": 656.56, "end": 662.36, "text": "طبعا هو فلكسبل" },
    { "start": 662.36, "end": 663.48, "text": "فعشان كيف قال لكم" },
    {
      "start": 663.48,
      "end": 670.86,
      "text": "مثلا تساعدون صديقكم في إنجاز شغلة صح"
    },
    {
      "start": 670.86,
      "end": 675.08,
      "text": "مو بإجباري مية بالمية إنك تساعده"
    },
    {
      "start": 675.08,
      "end": 680.12,
      "text": "وتقدر تختار متى تساعده وكيف تساعده صح"
    },
    { "start": 680.12, "end": 681.6, "text": "فهذا ميزة" },
    { "start": 681.6, "end": 682.5, "text": "لأنه فليكسبل" },
    { "start": 682.5, "end": 684.38, "text": "وبنه طبعا هو بوزيتب" },
    { "start": 684.38, "end": 685.04, "text": "لأنه يعلم" },
    { "start": 685.04, "end": 686.62, "text": "يعني هو عبارة عن الأشياء" },
    { "start": 686.62, "end": 688.4, "text": "اللي تقدر تسويها" },
    { "start": 688.4, "end": 691.26, "text": "عكس البرفكت" },
    { "start": 691.26, "end": 692.8, "text": "اللي هو ممنوع ممنوع ممنوع" },
    { "start": 692.8, "end": 694.26, "text": "هذا يقولك لا تقدر تساعد" },
    { "start": 694.26, "end": 695.16, "text": "تقدر تسوي كذا" },
    { "start": 695.16, "end": 696.28, "text": "تقدر تقدر تقدر" },
    { "start": 696.28, "end": 697.16, "text": "وبنه" },
    { "start": 697.16, "end": 700.0, "text": "هذا اللي يقليه فليكسبل" },
    { "start": 700.0, "end": 700.36, "text": "ليش" },
    { "start": 700.36, "end": 708.04, "text": "والله صديقي بنا ساعدة" },
    { "start": 708.04, "end": 709.96, "text": "بس أنا مضغوطة حاليا" },
    { "start": 709.96, "end": 711.28, "text": "معاناة عادي" },
    { "start": 711.28, "end": 712.4, "text": "مو بلازم أساعده" },
    { "start": 712.4, "end": 713.36, "text": "هذا اللي يسمح لي" },
    { "start": 713.36, "end": 714.54, "text": "هنا في مثال قال لكم" },
    { "start": 714.54, "end": 715.74, "text": "The duty to help others" },
    {
      "start": 715.74,
      "end": 719.18,
      "text": "You are morally obligated to help people"
    },
    {
      "start": 719.18,
      "end": 721.92,
      "text": "But you choose when, where and how to do\nso"
    },
    {
      "start": 721.92,
      "end": 725.44,
      "text": "And you're not required to help every\nsingle person you encounter"
    },
    { "start": 725.44, "end": 727.72, "text": "يعني مو بكل شخص في العمر" },
    { "start": 727.72, "end": 730.08, "text": "يمر عليك إجباري تساعده" },
    { "start": 730.08, "end": 732.58, "text": "رغم أنه يعني morally obliged" },
    {
      "start": 732.58,
      "end": 737.38,
      "text": "يعني مرضو أكثر مدفوعاً أنك تساعد الشخص"
    },
    {
      "start": 737.38,
      "end": 741.16,
      "text": "ونحن نأخذ سلائد بخصوص الperfect vs\nimperfect duties"
    },
    {
      "start": 741.16,
      "end": 744.44,
      "text": "هنا summary قال لكم أول شيء rigidity"
    },
    {
      "start": 744.44,
      "end": 748.3,
      "text": "واحد flexible يسمح لك تسوي أشياء اللي هو\nالimperfect"
    },
    {
      "start": 748.3,
      "end": 751.74,
      "text": "والثاني strict اللي هو ما يخليك تسوي أشياء\nاللي هو perfect"
    },
    {
      "start": 751.74,
      "end": 754.94,
      "text": "بلن قال لكم form perfect duties اللي هي\nnegative"
    },
    { "start": 754.94, "end": 757.28, "text": "والimperfect اللي هي positive" },
    {
      "start": 757.28,
      "end": 763.12,
      "text": "والapplication هذي يقولك مهما كان الموقف\nلازم تسوي وتنفذه سمعا وطاعة"
    },
    {
      "start": 763.12,
      "end": 765.62,
      "text": "وهذا الimperfect لا والله عندك options"
    },
    { "start": 765.62, "end": 767.68, "text": "والحين إن شاء الله بنكمل" },
    {
      "start": 767.68,
      "end": 769.94,
      "text": "Cases for Cantonism بالمقطع الجاي"
    }
  ]
}
