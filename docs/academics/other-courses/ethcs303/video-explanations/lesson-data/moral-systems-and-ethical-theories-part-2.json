  "chapters": [
    { "time": 0, "title": "What ethical theories share" },
    { "time": 58.9, "title": "Obligations and personal choice" },
    { "time": 114.02, "title": "Beneficence" },
    { "time": 155.12, "title": "Least harm" },
    { "time": 248.92, "title": "Respect for autonomy" },
    { "time": 329.22, "title": "Justice" },
    { "time": 358.26, "title": "Theories covered next" }
  ],
  "transcript": [
    { "start": 0.0, "end": 0.68, "text": "السلام عليكم" },
    { "start": 0.68, "end": 1.8, "text": "اليوم نتكلم عن" },
    {
      "start": 1.8,
      "end": 5.98,
      "text": "وش الأشياء اللي هم كلهم متشابهين فيه"
    },
    { "start": 5.98, "end": 7.06, "text": "أول شيء" },
    { "start": 7.06, "end": 7.94, "text": "يعلمونك" },
    { "start": 7.94, "end": 9.0, "text": "يعني ولي وضحون لك" },
    { "start": 9.0, "end": 11.02, "text": "وش الأشياء الصح" },
    { "start": 11.02, "end": 12.64, "text": "فمعنات برضو يعلمونك" },
    { "start": 12.64, "end": 13.94, "text": "وش الأشياء الغلط" },
    { "start": 13.94, "end": 14.96, "text": "اللي ممنوع تويها" },
    { "start": 14.96, "end": 16.04, "text": "بس إنه" },
    { "start": 16.04, "end": 17.76, "text": "أصلا فكرة الأثيكس بشكل عام" },
    { "start": 17.76, "end": 18.54, "text": "إذا نسيته" },
    { "start": 18.54, "end": 20.22, "text": "إنه نبغى نميز" },
    { "start": 20.22, "end": 21.5, "text": "وش الصح وش غلط" },
    { "start": 21.5, "end": 22.62, "text": "وبنقول لكم" },
    {
      "start": 22.62,
      "end": 24.64,
      "text": "they assume that people have free choice"
    },
    { "start": 24.64, "end": 25.14, "text": "إيش" },
    { "start": 25.14, "end": 27.12, "text": "يعني ما في أحد جابركم" },
    { "start": 27.12, "end": 27.92, "text": "ما في أحد يقل" },
    { "start": 27.92, "end": 29.58, "text": "لو ما سويت كذا" },
    { "start": 29.58, "end": 31.34, "text": "ترابحكم عليك قصاص" },
    { "start": 31.34, "end": 33.32, "text": "لا يقول ان البشر عنده" },
    { "start": 33.32, "end": 35.3, "text": "الاختيار الحر من ناحية ان" },
    { "start": 35.3, "end": 36.64, "text": "يتخذون القرارات اللي هي" },
    { "start": 36.64, "end": 38.62, "text": "لاحظتوا كلمة" },
    { "start": 38.62, "end": 41.22, "text": "يعني مب والله شخص" },
    { "start": 41.22, "end": 42.38, "text": "مهبول يسوي اشياء" },
    { "start": 42.38, "end": 44.84, "text": "يعني منطقية" },
    { "start": 44.84, "end": 45.88, "text": "برضو قال لكم" },
    { "start": 45.88, "end": 50.38, "text": "طبعا طبعا طبعا" },
    { "start": 50.38, "end": 51.76, "text": "الاثيكس بشكل عام" },
    { "start": 51.76, "end": 54.06, "text": "هو يبغى يحسن جودة" },
    { "start": 54.06, "end": 55.72, "text": "الحياة وبذلك" },
    { "start": 55.72, "end": 57.48, "text": "يحسن جودة المجتمع" },
    { "start": 57.48, "end": 58.9, "text": "واخر نقطة قال لكم" },
    {
      "start": 58.9,
      "end": 61.62,
      "text": "they distinguish obligations and\nresponsibilities"
    },
    {
      "start": 61.62,
      "end": 63.74,
      "text": "from choice and personal preference"
    },
    { "start": 63.74, "end": 65.46, "text": "احنا نحن نفكروا كيف" },
    { "start": 65.46, "end": 66.3, "text": "احفظكم ايا" },
    { "start": 66.3, "end": 68.7, "text": "obligations and responsibilities" },
    { "start": 68.7, "end": 70.92, "text": "فكروا بالمواد مثل اثيكس" },
    { "start": 70.92, "end": 72.78, "text": "اثيكس هل هو اختياري" },
    { "start": 72.78, "end": 74.16, "text": "مادة اختيارية لا" },
    {
      "start": 74.16,
      "end": 76.96000000000001,
      "text": "هو عندكم كابلغيشن اجباري تسوونا"
    },
    { "start": 76.96000000000001, "end": 78.7, "text": "و عندكم ملتزمات له" },
    { "start": 78.7, "end": 80.48, "text": "عكس مثلا خنقول والله" },
    { "start": 80.48, "end": 82.44, "text": "مواد الاختيارية" },
    { "start": 82.44, "end": 83.98, "text": "اللي يقولونك math" },
    { "start": 83.98, "end": 86.58, "text": "خنقول math 223" },
    { "start": 86.58, "end": 89.52, "text": "وبعدين CS223" },
    { "start": 89.52, "end": 91.53999999999999, "text": "واحدة منها" },
    { "start": 91.53999999999999, "end": 92.28, "text": "اللي هي" },
    { "start": 92.28, "end": 93.62, "text": "Obligational Responsibility" },
    { "start": 93.62, "end": 94.86, "text": "بس الثانية" },
    { "start": 94.86, "end": 96.12, "text": "القرار بينهم" },
    { "start": 96.12, "end": 96.58, "text": "هو" },
    { "start": 96.58, "end": 98.36, "text": "Choice and Personal Preference" },
    { "start": 98.36, "end": 99.08, "text": "صح؟" },
    { "start": 99.08, "end": 100.68, "text": "فهذا اللي لازم تعرفون" },
    { "start": 100.68, "end": 103.1, "text": "وش الاشياء اللي يشبهون بعض فيه" },
    { "start": 103.1, "end": 103.6, "text": "Theories" },
    { "start": 103.6, "end": 104.9, "text": "طبعا اذا ما يقلنا في ستة" },
    { "start": 104.9, "end": 105.9, "text": "فالحين خلونا" },
    { "start": 105.9, "end": 106.84, "text": "نتكلم عن" },
    { "start": 106.84, "end": 107.62, "text": "The Four Goals" },
    { "start": 107.62, "end": 108.75999999999999, "text": "وشو الأهداف" },
    { "start": 108.75999999999999, "end": 109.9, "text": "وترى هذا ممكن برضو" },
    { "start": 109.9, "end": 111.22, "text": "يجيكم كتعداد" },
    { "start": 111.22, "end": 111.75999999999999, "text": "خلونا نسوي" },
    {
      "start": 111.75999999999999,
      "end": 112.84,
      "text": "Highlight as we go"
    },
    { "start": 112.84, "end": 114.02000000000001, "text": "أول شي عندكم" },
    { "start": 114.02000000000001, "end": 114.78, "text": "Benevolence" },
    { "start": 114.78, "end": 116.03999999999999, "text": "هذا يقول لكم" },
    {
      "start": 116.03999999999999,
      "end": 120.81,
      "text": "The principle of what beneficence guides\nthe decision maker to do what is right and"
    },
    { "start": 120.81, "end": 121.04, "text": "good" },
    { "start": 121.04, "end": 122.82, "text": "ايش يعني right and good" },
    {
      "start": 122.82,
      "end": 128.52,
      "text": "اهم شيء هذا النقطة يتكلم عن تسووا الاشياء\nالصح و تسووا الاشياء المفيدة"
    },
    {
      "start": 128.52,
      "end": 131.78,
      "text": "ما جاب طاري ان لا تسووا شيء اللي شنيع"
    },
    {
      "start": 131.78,
      "end": 134.7,
      "text": "ولا تسووا شيء اللي ممكن انظر غيرك"
    },
    {
      "start": 134.7,
      "end": 137.28,
      "text": "لا بس هدفه ان تسووا الشيء الصح والزين"
    },
    { "start": 137.28, "end": 137.76, "text": "قال لكم" },
    {
      "start": 137.76,
      "end": 141.808,
      "text": "The priority to do good makes an ethical\nperspective and possible solutions and"
    },
    { "start": 141.808, "end": 143.14, "text": "ethical dilemma acceptable" },
    { "start": 143.14, "end": 145.86, "text": "مثلا طالما انت قاعد تسوي خير" },
    { "start": 145.86, "end": 147.56, "text": "حتى لو كان يعني" },
    { "start": 147.56, "end": 149.78, "text": "الديلمة اثك" },
    { "start": 149.78, "end": 151.44, "text": "غريبة" },
    { "start": 151.44, "end": 152.46, "text": "تصير acceptable" },
    { "start": 152.46, "end": 155.12, "text": "وبنعندكم الحين النقطة الثانية" },
    { "start": 155.12, "end": 155.94, "text": "least harm" },
    { "start": 155.94, "end": 158.54, "text": "طبعا احنا قدر الامكان نحاول" },
    { "start": 158.54, "end": 160.78, "text": "نقلل الضرر بكل حالات" },
    { "start": 160.78, "end": 161.76, "text": "فقال لكم هنا" },
    {
      "start": 161.76,
      "end": 164.38,
      "text": "least harm deals with situations which"
    },
    {
      "start": 164.38,
      "end": 166.57999999999998,
      "text": "no choice appears beneficial"
    },
    {
      "start": 166.57999999999998,
      "end": 168.56,
      "text": "هذه لازم نسوي لها highlight"
    },
    { "start": 168.56, "end": 170.24, "text": "لان مرة مرة توضح" },
    { "start": 170.24, "end": 172.4, "text": "no choice appears beneficial" },
    {
      "start": 172.4,
      "end": 177.109,
      "text": "In such cases decision makers seek to\nchoose to do the least harm possible and"
    },
    {
      "start": 177.109,
      "end": 178.98,
      "text": "to do harm to the fewest people"
    },
    { "start": 178.98, "end": 180.76, "text": "أبغى أعطيكم مثال" },
    {
      "start": 180.76,
      "end": 183.58,
      "text": "الحين خنقول لقدر الله طاح الطيارة"
    },
    { "start": 183.58, "end": 186.12, "text": "وفي هذا الطيارة أربعين شخص" },
    { "start": 186.12, "end": 188.56, "text": "وكلهم رايحين لنفس المستشفى" },
    {
      "start": 188.56,
      "end": 191.9,
      "text": "خنقول إنه ما في مستشفى إلا واحدة اللي\nحولهم"
    },
    { "start": 191.9, "end": 192.34, "text": "حلو" },
    {
      "start": 192.34,
      "end": 200.028,
      "text": "فالحين عدد الدكاترة عدد السراير عدد\nالإكوبمنت العدة يعني عشان تساعد الناس"
    },
    { "start": 200.028, "end": 200.66, "text": "محدودة" },
    {
      "start": 200.66,
      "end": 203.04,
      "text": "فهم وش بيسوون هم بيقسمون الناس"
    },
    {
      "start": 203.04,
      "end": 209.14,
      "text": "الناس مثلا اللي اول شي يعني لازم هذا الشخص\nيحتاج الان مؤنقاذ ولا بيموت"
    },
    {
      "start": 209.14,
      "end": 213.66,
      "text": "او اللي يقدر ينتظر او اللي عارفين لغدرها"
    },
    {
      "start": 213.66,
      "end": 220.38,
      "text": "بس يعني اللي خير شرم خلاص هم ما نقدر نخسر\nوقتنا ونساعدهم لنا هم مبعايشين"
    },
    { "start": 220.38, "end": 223.24, "text": "فلازم نشوف يعني كيف نقيس" },
    {
      "start": 223.24,
      "end": 227.84,
      "text": "طبعا احنا ما نبغى انه والله اي شخص يموت صح"
    },
    { "start": 227.84, "end": 229.98, "text": "هذا شي احنا ما نبيه نهائيا" },
    {
      "start": 229.98,
      "end": 236.26,
      "text": "بس لا قدر الله إذا كنتم في حالة زي كذا\nمحدود الوضع الوقت الريسورس كل شي"
    },
    {
      "start": 236.26,
      "end": 241.34,
      "text": "لازم تحاولون قدر الأمكان تنقذون الأكثر من\nالقليل"
    },
    { "start": 241.34, "end": 242.34, "text": "عشان كذا يقول لكم" },
    {
      "start": 242.34,
      "end": 246.18,
      "text": "Do the least harm possible and do harm to\nthe fewest people"
    },
    {
      "start": 246.18,
      "end": 248.92,
      "text": "يعني قدر الأمكان حاولوا تقلون الأقل عدد"
    },
    {
      "start": 248.92,
      "end": 252.66,
      "text": "هذا هو بدنا عندكم الحين respect for\nautonomy"
    },
    { "start": 252.66, "end": 253.64, "text": "يعني إيش" },
    {
      "start": 253.64,
      "end": 259.1,
      "text": "تخيلوا أنتم جسدكم مثلا أنتم الآن تعبانين\nوفي علاج"
    },
    { "start": 259.1, "end": 261.04, "text": "بس ان هذا العلاج متعب اكثر" },
    { "start": 261.04, "end": 263.1, "text": "يتعبكم وان خلاص انت" },
    { "start": 263.1, "end": 264.62, "text": "الريدي مسوي كورس" },
    { "start": 264.62, "end": 266.76, "text": "انت مفروض يصير عندك اتونمي" },
    { "start": 266.76, "end": 268.84, "text": "يصير عندك القدرة انك تقرر" },
    { "start": 268.84, "end": 270.44, "text": "يعني حياتك صح" },
    { "start": 270.44, "end": 272.76, "text": "فيقول لكم هنا ان الناس" },
    { "start": 272.76, "end": 274.38, "text": "يحترمون هذا الشي يحترمون" },
    { "start": 274.38, "end": 275.98, "text": "قرارك يعني وش تسوي" },
    { "start": 275.98, "end": 276.62, "text": "فقال لكم" },
    {
      "start": 276.62,
      "end": 282.84000000000003,
      "text": "يعني هم كل واحد الحالة"
    },
    { "start": 282.84000000000003, "end": 283.48, "text": "مع نفسه" },
    { "start": 283.48, "end": 286.86, "text": "يعني اي شي" },
    { "start": 286.86, "end": 288.7, "text": "يعني له علاقة" },
    { "start": 288.7, "end": 290.46, "text": "في حياتك" },
    { "start": 290.46, "end": 291.26, "text": "مثلا حتى" },
    { "start": 291.26, "end": 292.06, "text": "respect for autonomy" },
    { "start": 292.06, "end": 294.2, "text": "مو بس عن جسدك نفسيا" },
    { "start": 294.2, "end": 295.32, "text": "مثلا انت حين" },
    { "start": 295.32, "end": 297.38, "text": "تبغى تطلع من الجامعة" },
    { "start": 297.38, "end": 297.72, "text": "فجأة" },
    { "start": 297.72, "end": 299.18, "text": "ولا تبغى تطلع من شركة هذه" },
    { "start": 299.18, "end": 300.04, "text": "وتروح شركة ثانية" },
    { "start": 300.04, "end": 301.84, "text": "انت مفروض يصير عندك" },
    { "start": 301.84, "end": 303.94, "text": "هذا القدرة" },
    { "start": 303.94, "end": 305.18, "text": "انك تتويل هذا النقلة" },
    { "start": 305.18, "end": 307.6, "text": "ما حد مفروض يدخل بهذا الشيء" },
    {
      "start": 307.6,
      "end": 310.1,
      "text": "thus people should have control over their\nlives"
    },
    { "start": 310.1, "end": 311.08, "text": "as much as possible" },
    {
      "start": 311.08,
      "end": 312.5,
      "text": "because they are the only people"
    },
    { "start": 312.5, "end": 313.56, "text": "who completely understand" },
    {
      "start": 313.56,
      "end": 315.14,
      "text": "their chosen type of lifestyle"
    },
    { "start": 315.14, "end": 316.82, "text": "يعني ما حد ما حد ما حد" },
    { "start": 316.82, "end": 318.08, "text": "صديق بيفهم" },
    { "start": 318.08, "end": 320.2, "text": "طبيعتك" },
    { "start": 320.2, "end": 321.14, "text": "ورغبتك" },
    { "start": 321.14, "end": 324.14, "text": "الطريقة الحيشة" },
    {
      "start": 324.14,
      "end": 326.0,
      "text": "اللي أنت بغت تعيشها أكثر من نفسك"
    },
    { "start": 326.0, "end": 328.4, "text": "وبعدين عندنا آخر نقطة" },
    { "start": 328.4, "end": 329.22, "text": "اللي هي" },
    { "start": 329.22, "end": 330.86, "text": "الجستس" },
    { "start": 330.86, "end": 332.38, "text": "قال لكم في الجستس وشو" },
    { "start": 332.38, "end": 340.46, "text": "هنا أبيكم تلاحظون شيئا" },
    { "start": 340.46, "end": 341.24, "text": "أول شيء قالوا" },
    { "start": 341.24, "end": 343.58, "text": "يعني مين" },
    { "start": 343.58, "end": 346.28, "text": "فكروا رئيس الدولة" },
    {
      "start": 346.28,
      "end": 349.46,
      "text": "عرفتوا هم اللي يتخذون القرارات على الناس\nصح"
    },
    {
      "start": 349.46,
      "end": 358.26,
      "text": "فلازم يتأكدون ايش انهم عدلين بالناس اللي\nلهم علاقة في القوانين اللي قاعدين يطلعونها"
    },
    {
      "start": 358.26,
      "end": 361.82,
      "text": "وبعدين انحين بقنا لكم الانواع قلت لكم فيه\nستة"
    },
    {
      "start": 361.82,
      "end": 365.94,
      "text": "طبعا واحدة منهم اول شي اللي بنغطيها في\nالمقطع الجاي ان شاء الله"
    },
    {
      "start": 365.94,
      "end": 369.74,
      "text": "هي تنقسم ترائلة جزئتين اللي هو الاندفجو\nوالكوتشو"
    },
    {
      "start": 369.74,
      "end": 375.16,
      "text": "والدوتي بيستر هذا اسم الثاني اللي اصلا\nغالبيا ديكاتريا بيستخدمون اسم هذا"
    },
    {
      "start": 375.16,
      "end": 381.149,
      "text": "ما توقع انكم تشوفون دوتي بيس برفته بس انه\nبتشوفون كانت نزم هذا ملاحظة يعني بس"
    },
    { "start": 381.149, "end": 382.16, "text": "بيقولكم الحين" },
    {
      "start": 382.16,
      "end": 389.586,
      "text": "وبنغطين كل هذولي طبعاً بالمقاطع القادمة\nفان شاء الله نكمل في المقطع الجاي الاثيكال"
    },
    { "start": 389.586, "end": 390.22, "text": "روليتزم" }
  ]
}
