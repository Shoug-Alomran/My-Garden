  "url": "https://pub-1ae2691df7364eea93afb4e67996d97c.r2.dev/ethics/Moral%20Systems%2C%20Ethical%20Concepts%2C%20and%20Theories/Utilitarianism.mp4",
  "page": "/academics/other-courses/ethcs303/video-explanations/slides/utilitarianism-part-1/",
  "caption": "/academics/other-courses/ethcs303/video-explanations/captions/utilitarianism-part-1.vtt",
  "chapters": [
    { "time": 0, "title": "Consequences and utility" },
    { "time": 84.64, "title": "Happiness and its synonyms" },
    { "time": 132.78, "title": "The greatest happiness principle" },
    { "time": 316.84, "title": "Act and rule utilitarianism" },
    { "time": 375.96, "title": "Medical triage example" },
    { "time": 587, "title": "Highway cost-benefit example" },
    { "time": 721.3, "title": "Arguments for utilitarianism" }
  ],
  "transcript": [
    { "start": 0.0, "end": 0.66, "text": "السلام عليكم" },
    { "start": 0.66, "end": 2.74, "text": "اليوم نكمل عند الـ utilitarianism" },
    {
      "start": 2.74,
      "end": 6.42,
      "text": "لاحظوا انه بيكون رابع نقطة باللست اللي هو\nعن الانواعه"
    },
    { "start": 6.42, "end": 8.24, "text": "وهو consequence based" },
    {
      "start": 8.24,
      "end": 11.88,
      "text": "اذا فهمتوا كلمة consequence انتم خلاص\nفهمتوا فكرة utilitarianism"
    },
    { "start": 11.88, "end": 14.56, "text": "اللهم باقي نفسفس ان فيه نوعين" },
    {
      "start": 14.56,
      "end": 17.74,
      "text": "في القانون الـ rule وفي الـ act التمثيل"
    },
    {
      "start": 17.74,
      "end": 21.96,
      "text": "بعدين خلونا الحين نتكلم عن القواعد والـ\nprinciples of utility"
    },
    { "start": 21.96, "end": 23.72, "text": "اول شي مين مسوي" },
    { "start": 23.72, "end": 26.1, "text": "جيرمي بنثم and جون ستوارت ميل" },
    {
      "start": 26.1,
      "end": 30.2,
      "text": "أنا الآن ما شفت إختبار يجيبون طاري اسم\nفلان"
    },
    {
      "start": 30.2,
      "end": 35.92,
      "text": "بس يعني لو كان زي مثلا مادة سايكولوجي\nبيجيبون أسامي"
    },
    {
      "start": 35.92,
      "end": 39.46,
      "text": "فنصيحة أحاولوا وقدروا لمكان أنكم ترفون مين\nهذا سوى"
    },
    { "start": 39.46, "end": 40.76, "text": "قال لكم برضو" },
    { "start": 40.76, "end": 44.1, "text": "لاحظوا هذا الكلمة" },
    { "start": 44.1, "end": 45.38, "text": "أنا بيسوي لكم هنا هايلايت" },
    { "start": 45.38, "end": 49.02, "text": "في أحد قاعد يكسب الموضوع" },
    { "start": 49.02, "end": 51.32, "text": "وهذا من يجي من كلمة يوتيلتي" },
    {
      "start": 51.32,
      "end": 55.22,
      "text": "لأننا شفتوا يوتيلتي معاته هو تندنسي معاته\nالنسبة"
    },
    { "start": 55.22, "end": 56.2, "text": "فكروا النسب" },
    { "start": 56.2, "end": 59.9, "text": "يعني الفوائد" },
    { "start": 59.9, "end": 64.84, "text": "يعني يمنع من الشيء يضررك" },
    { "start": 64.84, "end": 66.24, "text": "ولا يضيق صدرك" },
    {
      "start": 66.24,
      "end": 70.48,
      "text": "فدايما فكروا أن utility هو نوع من كأن حسبة\nرياضية"
    },
    {
      "start": 70.48,
      "end": 74.2,
      "text": "يقول لك النسبة أنك أنت تصير فرحان"
    },
    { "start": 74.2, "end": 76.26, "text": "ويحميك من الحزن" },
    { "start": 76.26, "end": 78.92, "text": "يعني كم مرة من المرات" },
    { "start": 78.92, "end": 82.36, "text": "For an individual or community" },
    {
      "start": 82.36,
      "end": 84.64,
      "text": "يعني يا أنت شخصيا يا المجتمع لنت فيه"
    },
    {
      "start": 84.64,
      "end": 90.423,
      "text": "طبعاً إذا أخبركم هنا \"Synonyms\",\n\"Happiness\" يأتي بكلمة \"Advantage\" أو"
    },
    {
      "start": 90.423,
      "end": 94.14,
      "text": "\"Benefit\" أو \"Good\" أو \"Pleasure\" أو\n\"Profit\""
    },
    {
      "start": 94.14,
      "end": 97.74000000000001,
      "text": "هؤلاء كلهم \"Synonyms\" لنفس المعنى"
    },
    {
      "start": 97.74000000000001,
      "end": 102.77600000000001,
      "text": "ولكن \"Happiness\" لديهم نفس الشيء\n\"Disadvantage\", \"Cost\", \"Evil\", \"Pain\""
    },
    { "start": 102.77600000000001, "end": 103.84, "text": "كلهم \"Synonyms\"" },
    {
      "start": 103.84,
      "end": 107.94,
      "text": "يعني ممكن هنا يبدلون \"Happiness\" ويقولون\nلكم \"Benefit\""
    },
    {
      "start": 107.94,
      "end": 111.64,
      "text": "لازم أنتم تربطون أنه ما زال نفس الشيء"
    },
    {
      "start": 111.64,
      "end": 114.75999999999999,
      "text": "مثلاً بإدال \"Happiness Good\" أو \"Pleasure\""
    },
    {
      "start": 114.75999999999999,
      "end": 116.18,
      "text": "نفس الحكاية مع \"Unhappiness\""
    },
    {
      "start": 116.18,
      "end": 118.1,
      "text": "لا يمكنك إضافة \"Disadvantage\" أو \"Cost\""
    },
    { "start": 118.1, "end": 119.92, "text": "لكن الزبدة من \"Nutility\"" },
    { "start": 119.92, "end": 121.86, "text": "إنه عبارة عن كم النسبة" },
    { "start": 121.86, "end": 123.76, "text": "لهذا الشيء مثلاً" },
    {
      "start": 123.76,
      "end": 126.56,
      "text": "إنه أنا أخلي أعطيكم \"Past Exams\""
    },
    {
      "start": 126.56,
      "end": 129.76,
      "text": "وإنه النسبة إنه سيجيب لكم سعادة"
    },
    { "start": 129.76, "end": 131.28, "text": "ويخفض الحزن" },
    { "start": 131.28, "end": 131.86, "text": "عرفتوه" },
    { "start": 131.86, "end": 132.78, "text": "بنا خلونا نكمل" },
    {
      "start": 132.78,
      "end": 136.76,
      "text": "هنا عندكم \"The Greatest Happiness\nPrinciple\""
    },
    { "start": 136.76, "end": 137.56, "text": "قال لكم هنا" },
    {
      "start": 137.56,
      "end": 140.92000000000002,
      "text": "\"When makes behavior right or wrong\ndepends wholly on the consequence\""
    },
    { "start": 140.92000000000002, "end": 142.36, "text": "على حسب العقاب" },
    { "start": 142.36, "end": 143.34, "text": "لنقدر نقول" },
    { "start": 143.34, "end": 143.66, "text": "أوكي" },
    { "start": 143.66, "end": 144.72, "text": "هذا الشيء" },
    { "start": 144.72, "end": 145.28, "text": "كويس" },
    { "start": 145.28, "end": 146.24, "text": "وهذا الشيء" },
    { "start": 146.24, "end": 146.66, "text": "مضر" },
    { "start": 146.66, "end": 147.56, "text": "فقال لكم" },
    { "start": 147.56, "end": 148.84, "text": "focus on the outcome" },
    { "start": 148.84, "end": 150.4, "text": "طبعا كيف تعرفون العقابات" },
    { "start": 150.4, "end": 151.0, "text": "إذا شفتوا" },
    { "start": 151.0, "end": 151.6, "text": "الأوتكم" },
    { "start": 151.6, "end": 152.68, "text": "بدون الأوتكم" },
    { "start": 152.68, "end": 153.68, "text": "أنتم ما تعرفون" },
    { "start": 153.68, "end": 154.54, "text": "يعني إذا هذا الشيء" },
    { "start": 154.54, "end": 154.9, "text": "مضر" },
    { "start": 154.9, "end": 155.38, "text": "أو لا" },
    { "start": 155.38, "end": 156.3, "text": "of an act" },
    { "start": 156.3, "end": 156.92000000000002, "text": "or application" },
    { "start": 156.92000000000002, "end": 157.52, "text": "of a rule" },
    { "start": 157.52, "end": 158.5, "text": "and not intention" },
    { "start": 158.5, "end": 159.54, "text": "or behavior" },
    { "start": 159.54, "end": 160.1, "text": "of an attitude" },
    { "start": 160.1, "end": 161.18, "text": "يعني لاحظتم" },
    { "start": 161.18, "end": 161.86, "text": "كانت نزم" },
    { "start": 161.86, "end": 162.74, "text": "كان يشوف النية" },
    { "start": 162.74, "end": 163.38, "text": "كان يشوف" },
    { "start": 163.38, "end": 163.94, "text": "ال good will" },
    { "start": 163.94, "end": 164.38, "text": "كان يشوف" },
    { "start": 164.38, "end": 165.66, "text": "أنتم منيتكم" },
    { "start": 165.66, "end": 166.22, "text": "كويسة" },
    { "start": 166.22, "end": 167.22, "text": "ولا مو كويسة" },
    { "start": 167.22, "end": 167.98, "text": "ال utility" },
    { "start": 167.98, "end": 168.3, "text": "يقول" },
    { "start": 168.3, "end": 170.72, "text": "بالطقاق نيتك أنت نيتك" },
    { "start": 170.72, "end": 172.2, "text": "ما لها أي دخل" },
    { "start": 172.2, "end": 174.62, "text": "العقابات والله أنت سويت شيء" },
    {
      "start": 174.62,
      "end": 176.34,
      "text": "وإن شاء الله نيتك كان أفضل نية"
    },
    {
      "start": 176.34,
      "end": 178.5,
      "text": "مثلا حين دكتور سوى عملية المريض"
    },
    { "start": 178.5, "end": 180.96, "text": "حلو هو ما بنيت أن يذبح المريض" },
    { "start": 180.96, "end": 181.7, "text": "بس والله مات" },
    { "start": 181.7, "end": 184.22, "text": "هل يعني بالكان تنزف" },
    { "start": 184.22, "end": 185.94, "text": "والله هو ما سوى شيء غلط" },
    {
      "start": 185.94,
      "end": 187.92,
      "text": "هو morally correct لأنه كان نيتك كويسة"
    },
    { "start": 187.92, "end": 190.42, "text": "بس باليوتيلتي جاب أم العيد" },
    { "start": 190.42, "end": 191.68, "text": "فقال لكم هنا" },
    { "start": 191.68, "end": 193.26, "text": "they don't care about details" },
    { "start": 193.26, "end": 194.68, "text": "they just want answers" },
    { "start": 194.68, "end": 195.74, "text": "اللي هو يعني الزبدة" },
    {
      "start": 195.74,
      "end": 201.832,
      "text": "ما يبغون التفاصيل العميقة أنت وشنيتك أنت\nليش سويت أنت ليش فعلت لا لا لا بس يبغون"
    },
    {
      "start": 201.832,
      "end": 205.64,
      "text": "الزبداء اللي هو الكونسيكوينسيز اللي تجي من\nالنتيجة"
    },
    {
      "start": 205.64,
      "end": 210.89,
      "text": "وبالعندنا طبعا زي هذا الميزان هذا الميزان\nفكر بيوتوليتي زي الميزان فعلا لأنه قاعد"
    },
    {
      "start": 210.89,
      "end": 214.52,
      "text": "يقيس البنيفت بنيفت بنيفت بنيفت بنيفت حوله\nهارم هارم هارم"
    },
    {
      "start": 214.52,
      "end": 222.088,
      "text": "يعني هنا لاحظوا أن الهارم والله أثقل يعني\nأخف معليش من البنيفت فمعنات لنا جيد بس لو"
    },
    {
      "start": 222.088,
      "end": 225.28,
      "text": "كان الميزان معاكس لو كان هنا الهارم"
    },
    {
      "start": 225.28,
      "end": 234.92000000000002,
      "text": "وهنا والله البنفت كان هنا صار الزيادة باد"
    },
    {
      "start": 234.92000000000002,
      "end": 239.78,
      "text": "فيوتيلتي يقيس على حسب يعني اللي قاعدين\nتستفيدون منا"
    },
    { "start": 239.78, "end": 242.94, "text": "طبعا جعب لكم هنا برضو اسمه" },
    { "start": 242.94, "end": 244.22, "text": "Greatest Happiness Principle" },
    {
      "start": 244.22,
      "end": 248.38,
      "text": "لو مثلا جعبوا لكم يا بدان اسم utility or\nutilerism"
    },
    { "start": 248.38, "end": 249.68, "text": "وبنين قال لكم هنا" },
    { "start": 249.68, "end": 250.84, "text": "الوتيلاريان" },
    {
      "start": 250.84,
      "end": 254.603,
      "text": "\"ستress the social usefulness of a\nparticular action and policies by focusing"
    },
    {
      "start": 254.603,
      "end": 257.78,
      "text": "on the consequences that results from\nthose actions and policies\""
    },
    { "start": 257.78, "end": 258.98, "text": "يعني ايش" },
    { "start": 258.98, "end": 260.04, "text": "احنا" },
    {
      "start": 260.04,
      "end": 264.24,
      "text": "قبر يعني في الكنت نظم يقول انا بقيس هذا\nالشخص على حسب"
    },
    {
      "start": 264.24,
      "end": 267.62,
      "text": "نياته ومدر ايش الدوتي حق و الابليغيشن"
    },
    { "start": 267.62, "end": 268.52, "text": "هنا يقولك لا" },
    { "start": 268.52, "end": 270.78, "text": "انت لك فايدة بالمجتمع" },
    { "start": 270.78, "end": 272.72, "text": "والله اي لك فايدة من المجتمع" },
    { "start": 272.72, "end": 273.68, "text": "يلا نحبك" },
    { "start": 273.68, "end": 275.14, "text": "والله ما لك اي فايدة" },
    {
      "start": 275.14,
      "end": 277.08,
      "text": "بالعكس انت قاعد تاخد اكثر من ما تعطي"
    },
    { "start": 277.08, "end": 278.68, "text": "لا عرفته وقاعد تشوفون" },
    { "start": 278.68, "end": 281.36, "text": "يريدون أن تكون مفيداً" },
    { "start": 281.36, "end": 284.14, "text": "بأكشنات أو بأكشنات" },
    { "start": 284.14, "end": 286.96, "text": "و ترى كيف يحدث العقابات" },
    {
      "start": 286.96,
      "end": 289.46,
      "text": "يعني أن أكشنات بأكشنات أو بأكشنات"
    },
    { "start": 289.46, "end": 295.6, "text": "حسب سعادة الآخرين" },
    { "start": 295.6, "end": 297.15999999999997, "text": "الذين يتأثرون" },
    { "start": 297.15999999999997, "end": 298.72, "text": "مثلاً مثلاً الآن" },
    {
      "start": 298.72,
      "end": 302.14,
      "text": "غرفة العمليات والدكتور الذين يبحث هذا\nالمريض"
    },
    { "start": 302.14, "end": 304.64, "text": "والله العائلة" },
    {
      "start": 304.64,
      "end": 308.14,
      "text": "التي يجبها ضرر أكثر لأن تسبب وفاة هذا\nالشخص"
    },
    {
      "start": 308.14,
      "end": 314.74,
      "text": "ويجعلون أكثر ويتلمون أكثر من الدكتور الشخص\nالواحد"
    },
    {
      "start": 314.74,
      "end": 316.84,
      "text": "وبنحن عندنا الـ Types of Euterisms"
    },
    {
      "start": 316.84,
      "end": 318.94,
      "text": "عندكم الـ Act إما قلت لكم وعندكم Rule"
    },
    { "start": 318.94, "end": 320.74, "text": "بهذا المقطع بنغطي الـ Act" },
    { "start": 320.74, "end": 322.04, "text": "المقطع الجاي بنغطي Rule" },
    {
      "start": 322.04,
      "end": 324.44,
      "text": "بس انا قلت لكم هنا بترا نوت مرة مهم"
    },
    {
      "start": 324.44,
      "end": 326.94,
      "text": "انه ممكن جدا يجيبون لكم سيناريو"
    },
    { "start": 326.94, "end": 331.94, "text": "يقولون اوكي قارني Rule مع Act" },
    {
      "start": 331.94,
      "end": 337.44,
      "text": "وكيف هو كل واحد ينتج نتيجة مختلفة بخصوص\nهذا السيناريو"
    },
    {
      "start": 337.44,
      "end": 345.707,
      "text": "انا كنت دائما اقول ان اكت دائما يقيس على\nهذا السيناريو وليس صورة خاصة قانون واحد"
    },
    { "start": 345.707, "end": 347.98, "text": "وطبق مهما كان الشيء لا" },
    {
      "start": 347.98,
      "end": 355.72,
      "text": "يعرفت فصفص مرة فقدر امكان حاولوا تفسفسون\nعشان يعني تقدرون تكتبون ويصير صح"
    },
    {
      "start": 355.72,
      "end": 358.46,
      "text": "طبعا وش هو الفرق وش هو الحين او شي اكت"
    },
    {
      "start": 358.46,
      "end": 363.524,
      "text": "اكت قال لكم ان الاندفجال اكت is morally\nacceptable the consequences that result"
    },
    {
      "start": 363.524,
      "end": 365.96,
      "text": "from x produces a great amount of good"
    },
    { "start": 365.96, "end": 368.96, "text": "أو أكثر من أجل من أجل أجل" },
    {
      "start": 368.96,
      "end": 370.96,
      "text": "بسيطة، يجب أن نحن نحن نقوم بأكثر من نفسنا"
    },
    {
      "start": 370.96,
      "end": 373.96,
      "text": "من المرأة عن كثير من أجل نحن نحن نقوم\nبإمكانهم"
    },
    { "start": 373.96, "end": 375.96, "text": "شوفوا، هنا يقول لكم" },
    { "start": 375.96, "end": 379.96, "text": "مثلا، الحين، والله أنا في حرب" },
    {
      "start": 379.96,
      "end": 383.96,
      "text": "أنا دكتور وفي غرفة عملية محدود جدا العدة"
    },
    { "start": 383.96, "end": 386.96, "text": "هذا الشخص يعني" },
    { "start": 386.96, "end": 389.96, "text": "يحتاج أني أفتحه بسكينة" },
    { "start": 389.96, "end": 391.96, "text": "وأنا ما عنده سكينة واحدة" },
    { "start": 391.96, "end": 394.96, "text": "ويعني يالله معقمة وحالته حالة" },
    {
      "start": 394.96,
      "end": 403.272,
      "text": "طبعا هي مو أفضل شي بس وشو بدون السكينة\nوالله بموت مع السكينة ممكن يجيها التهابات"
    },
    {
      "start": 403.272,
      "end": 407.22,
      "text": "بس نقدر نعالج الالتهابات بالأنتيبويتكس"
    },
    {
      "start": 407.22,
      "end": 415.64,
      "text": "طبعا الوفاة ضرر أكبر صح فوشو هم بيغرحون\nيستخدمون السكينة اللي مو بنظيفة مرة ليش"
    },
    { "start": 415.64, "end": 415.96, "text": "لأن" },
    {
      "start": 415.96,
      "end": 422.32,
      "text": "يجب أن يصنع الكثير من الشيء من الشيء لأحدث\nالناس"
    },
    { "start": 422.32, "end": 423.84, "text": "هذا الـ Act" },
    { "start": 423.84, "end": 426.1, "text": "بس بس بشرح لكم بسرعة سرعة" },
    {
      "start": 426.1,
      "end": 428.24,
      "text": "الـ Rule عشان تفهمون بعد قانون بينه"
    },
    { "start": 428.24, "end": 430.68, "text": "الـ Rule يعطيك كذا قانون واحد" },
    { "start": 430.68, "end": 433.66, "text": "ومهما كان السيناريو يطبقونه" },
    { "start": 433.66, "end": 434.94, "text": "زي ما قلت لكم" },
    {
      "start": 434.94,
      "end": 437.26,
      "text": "الحين هذا الشخص اللي في غرفة عملية"
    },
    {
      "start": 437.26,
      "end": 439.28,
      "text": "لو والله في حرب ايه ايه اكيد بيستخدمون\nالسكينة"
    },
    { "start": 439.28, "end": 440.5, "text": "طبعا الـ Act يقول اوكي" },
    { "start": 440.5, "end": 443.04, "text": "تم لان ما عندك إلا هذي" },
    { "start": 443.04, "end": 445.18, "text": "بس لو كان بيمشون على الـ Rule" },
    {
      "start": 445.18,
      "end": 449.12,
      "text": "عندنا عالمياً يعني ممنوع تستخدمون يعني"
    },
    {
      "start": 449.12,
      "end": 454.18,
      "text": "Unsterilized equipment بالعمليات لازم سير\nمعقم ما مدر إيش لو كنا نطبق الرول"
    },
    {
      "start": 454.18,
      "end": 461.695,
      "text": "كان ما عطينا المريض السكينة اللي بتعالجه\nصح بس بالآكت لنا عقاس على الحالة اللي هو"
    },
    { "start": 461.695, "end": 463.18, "text": "حالياً فيه بسمحه" },
    {
      "start": 463.18,
      "end": 467.18,
      "text": "وهنا عطتكم بعد مثال ثاني يوضح لكم الفكرة\nأكثر مثلاً"
    },
    {
      "start": 467.18,
      "end": 473.18,
      "text": "نحين صار زلزال وصار يعني ناس تأذوا كثير\nوحاتم حالة والمستشفى يعني فل"
    },
    {
      "start": 473.18,
      "end": 476.18,
      "text": "قال لكم إنه عشرة جوا وصلوا للمستشفى"
    },
    {
      "start": 476.18,
      "end": 482.18,
      "text": "وقال للمستشفى أنه أنا بس ترى عندي كفاية\nعدة ودكاترا أني أسعف ستة شخاص"
    },
    {
      "start": 482.18,
      "end": 486.18,
      "text": "طبعا بعضهم يعني عندهم ممكن كسر بسيط"
    },
    {
      "start": 486.18,
      "end": 491.18,
      "text": "أو يعني جرح يبيل أخياط بس عرفته مو بشي\nبيأدي إلى وفاة"
    },
    {
      "start": 491.18,
      "end": 495.18,
      "text": "وبعضهم أصلا حتى إذا حاولت تعالجهم مبعايشين"
    },
    {
      "start": 495.18,
      "end": 503.68,
      "text": "فيوشوا دكاترا لازم يعطون العدة ووقتهم\nللناس اللي النسبة اكثر يعيشون صح ؟"
    },
    {
      "start": 503.68,
      "end": 508.48,
      "text": "فقالكم هنا they need to use act in this\ncase because the severity matters"
    },
    {
      "start": 508.48,
      "end": 514.38,
      "text": "طبعا يعني الحين فيه شخص من شخص هم تخيلوا\nلو يجون بطبقون اللي يجي اول هو البساعدة"
    },
    {
      "start": 514.38,
      "end": 518.88,
      "text": "تخيلوا الناس اللي بسرون يحتجون مساعدة ممكن\nيجيهم الدور و يموفتون"
    },
    {
      "start": 518.88,
      "end": 524.48,
      "text": "فطبعا عشان كده يقول لكم they need to use\nact in this case because severity matters"
    },
    {
      "start": 524.48,
      "end": 530.48,
      "text": "لذا لديه رواية و تستخدمها على كل حالات مثل\nرولي ترونيه ليس لطيفة هذه الحالة."
    },
    {
      "start": 530.48,
      "end": 539.066,
      "text": "لأن حالات دقيقة يجب أن تتخدم بين الحالة و\nترونيه. لا يصلح على رولي. يجب أن تستخدمون"
    },
    { "start": 539.066, "end": 539.48, "text": "أكت." },
    {
      "start": 539.48,
      "end": 544.48,
      "text": "و نكمل هنا زيادة. لذي نختار الأكت."
    },
    {
      "start": 544.48,
      "end": 549.427,
      "text": "قال لكم: \"A state is considering replacing\na curvy stretch of highway that passes"
    },
    {
      "start": 549.427,
      "end": 552.48,
      "text": "along the borders of a large city with\nbuildings.\""
    },
    {
      "start": 552.48,
      "end": 555.24,
      "text": "شوفوا كيف يعني نخيلوا الحين برسم لكم اياه"
    },
    {
      "start": 555.24,
      "end": 558.52,
      "text": "تخيلوا خلونا نحط اخضر هذا الشارع"
    },
    {
      "start": 558.52,
      "end": 563.36,
      "text": "يبونا يخلون يعني بدل الكيرف وصير يعني"
    },
    {
      "start": 563.36,
      "end": 569.82,
      "text": "هنا فيه مثلا خنقول شجار وعمارات ودنيا"
    },
    {
      "start": 569.82,
      "end": 573.58,
      "text": "قالوا والله بنهدها هذي بنشيلها كذا"
    },
    { "start": 573.58, "end": 575.82, "text": "حتى بنشيل هذي" },
    { "start": 575.82, "end": 578.72, "text": "وبنخلي والله الشارع كذا" },
    {
      "start": 578.72,
      "end": 587.0,
      "text": "هنا قاعدين يستخدمون داخل أكت يوتيرزم هل\nهذا القرار يعني بيكون شيء كويس ولا لا"
    },
    {
      "start": 587.0,
      "end": 590.4,
      "text": "فقال لكم زيادة تفاصيل صراح هذا الحين"
    },
    {
      "start": 590.4,
      "end": 596.5,
      "text": "أن الصحي كان فيه بيوت اللي هنا شلناها طبعا\nهم يعني أنت قاعد تأخذ بيوت بشر"
    },
    {
      "start": 596.5,
      "end": 604.769,
      "text": "فلازم نتعوضهم فقال لكم هنا في 150 بيت اللي\nلازم يعني يشلونها عشان يعني يعمرون المسار"
    },
    { "start": 604.769, "end": 605.36, "text": "الجديد" },
    {
      "start": 605.36,
      "end": 609.8,
      "text": "وقال لكم انه تقريبا بيكلفهم عشرين مليون من\nهذا الشيء"
    },
    {
      "start": 609.8,
      "end": 613.0,
      "text": "وبعدين قال لكم \"constructing the new\nhighway which is three miles long\""
    },
    { "start": 613.0, "end": 614.28, "text": "يعني تخيل بس ثلاثة متار" },
    {
      "start": 614.28,
      "end": 619.76,
      "text": "\"which costs the taxpayers\" يعني تخيلوا\nانه بعد فلوس الضريبة يبيلها عشر مليون"
    },
    {
      "start": 619.76,
      "end": 624.8,
      "text": "وبعدين قال لكم \"suppose the environmental\nimpact of the new highway in terms of lost"
    },
    { "start": 624.8, "end": 625.28, "text": "habitat\"" },
    {
      "start": 625.28,
      "end": 629.64,
      "text": "يعني ممكن هنا فيه كما قلت لكم بتجرات\nوحيوانات ودنيا غابة"
    },
    { "start": 629.64, "end": 632.68, "text": "هذا بياخذ يعني مليون" },
    {
      "start": 632.68,
      "end": 637.0,
      "text": "فإلى الآن شوفوا كم مليون عشرين، ثلاثين،\nواحدة ثلاثين"
    },
    {
      "start": 637.0,
      "end": 641.44,
      "text": "و بلس قال لكم ان كل يوم، كل weekday يعني\nخلال الأسبوع"
    },
    {
      "start": 641.44,
      "end": 648.76,
      "text": "خمسة عشر الف سيارة من المفترض انها تمر من\nالشارع وان بيختصر عليهم الوقت"
    },
    {
      "start": 648.76,
      "end": 653.12,
      "text": "فقال لكم assume it costs 40 cents per mile\nto operate a vehicle"
    },
    {
      "start": 653.12,
      "end": 658.579,
      "text": "construction of the new highway will save\ndrivers 6,000 per weekday in operating"
    },
    { "start": 658.579, "end": 658.92, "text": "costs" },
    {
      "start": 658.92,
      "end": 662.72,
      "text": "يعني ايش يعني بيوفر ست هلاف بالاسبوع"
    },
    {
      "start": 662.72,
      "end": 666.0,
      "text": "فthe highway has expected operating\nlifetime of 25 years"
    },
    {
      "start": 666.0,
      "end": 673.42,
      "text": "يعني مفروض ان هذا الشارع يصير يعني ما ينظر\nولا ما يحتاج صيانه لمدة 25 سنة"
    },
    {
      "start": 673.42,
      "end": 678.42,
      "text": "اوكي خلال هذا 25 سنة السيفينك مفروض يكون\n39"
    },
    {
      "start": 678.42,
      "end": 683.22,
      "text": "لاحظوا انه هو بيكلف 31 عشان يعمرونه\nويسوونا"
    },
    { "start": 683.22, "end": 686.36, "text": "فالربح والشو 8 مليون" },
    {
      "start": 686.36,
      "end": 690.32,
      "text": "ثماني مليون مليون أغلب يستفيد منه"
    },
    {
      "start": 690.32,
      "end": 701.56,
      "text": "فعشان كذا يعني في هذا الحالة يستهق أني\nأنفذ القانون وأعمر ذا الشارع"
    },
    {
      "start": 701.56,
      "end": 704.88,
      "text": "بس خيلوا لو كانوا يطبقون مثلا زي الرول"
    },
    {
      "start": 704.88,
      "end": 709.4,
      "text": "الرول ترى زي ما قلت لكم هو يعني قانون واحد\nيسوي سيلكت أول على كل شي"
    },
    {
      "start": 709.4,
      "end": 713.86,
      "text": "ما يحسب هذا الحسابات كيف يحسبنا هنا أوكي\nهنا مليون هنا عشرة هنا عشرين"
    },
    {
      "start": 713.86,
      "end": 717.04,
      "text": "و يجب أن يحسب لهذا السيناريو الذي أعرفته"
    },
    { "start": 717.04, "end": 718.4, "text": "فهذا ما يستعلم" },
    { "start": 718.4, "end": 719.46, "text": "و قال لكم طبعاً" },
    { "start": 719.46, "end": 720.66, "text": "Cases for active tourism" },
    { "start": 720.66, "end": 721.3, "text": "أن أول شيء" },
    {
      "start": 721.3,
      "end": 723.04,
      "text": "Focus on happiness is reasonable"
    },
    { "start": 723.04, "end": 724.6, "text": "يعني طبيعي منطقي" },
    { "start": 724.6, "end": 725.78, "text": "و بين practical" },
    { "start": 725.78, "end": 727.22, "text": "Attractive to most people" },
    { "start": 727.22, "end": 729.28, "text": "أي شيء practical و عملي" },
    { "start": 729.28, "end": 730.26, "text": "أي شيء عملي" },
    { "start": 730.26, "end": 732.4, "text": "يعرفوا أن الناس" },
    { "start": 732.4, "end": 733.72, "text": "بصير فيهم إغراء" },
    { "start": 733.72, "end": 734.72, "text": "بيبغونا" },
    { "start": 734.72, "end": 735.78, "text": "ليش لأن" },
    { "start": 735.78, "end": 737.22, "text": "ما نبغى نتعب أنفسنا" },
    { "start": 737.22, "end": 738.24, "text": "وبناء عندنا الآن" },
    { "start": 738.24, "end": 739.96, "text": "Cases against active tourism" },
    { "start": 739.96, "end": 740.24, "text": "طبعاً" },
    { "start": 740.24, "end": 742.12, "text": "كل شيء يعني فيه شيء ضده" },
    { "start": 742.12, "end": 742.86, "text": "أول شيء" },
    { "start": 742.86, "end": 747.9, "text": "صح احنا قال لكم ان على حسب" },
    {
      "start": 747.9,
      "end": 751.18,
      "text": "the greatest amount of happiness"
    },
    {
      "start": 751.18,
      "end": 753.1,
      "text": "for the greatest amount of people"
    },
    { "start": 753.1, "end": 756.86, "text": "احنا نبغى يعني اعلى شيء سعادة" },
    { "start": 756.86, "end": 759.0, "text": "احلو اعلى شيء العدد" },
    { "start": 759.0, "end": 760.76, "text": "ف احنا نبغى نعرف" },
    { "start": 760.76, "end": 762.48, "text": "اذا جينا نحسب العدد" },
    { "start": 762.48, "end": 764.06, "text": "the amount of people" },
    { "start": 764.06, "end": 765.64, "text": "مين نحسب" },
    {
      "start": 765.64,
      "end": 768.12,
      "text": "هل نحسب يعني مثلا خلالي نقول الشارع"
    },
    { "start": 768.12, "end": 770.56, "text": "هل نحسب بس الناس اللي سوقون" },
    { "start": 770.56, "end": 772.08, "text": "ولا الناس اللي ما يسوقون" },
    { "start": 772.08, "end": 773.18, "text": "يأخذون تكسي" },
    { "start": 773.18, "end": 775.36, "text": "الناس اللي أطفال" },
    { "start": 775.36, "end": 776.64, "text": "كبار بالسن" },
    { "start": 776.64, "end": 778.22, "text": "اللي عندهم شغل" },
    { "start": 778.22, "end": 779.16, "text": "اللي ما عندهم شغل" },
    { "start": 779.16, "end": 779.92, "text": "عرفتوا" },
    { "start": 779.92, "end": 781.18, "text": "فعندهم هذا المشكل" },
    { "start": 781.18, "end": 782.22, "text": "لأنه ما يعرفون" },
    { "start": 782.22, "end": 783.14, "text": "مين يحسبون" },
    { "start": 783.14, "end": 784.2, "text": "وبلد نقول لكم هنا" },
    {
      "start": 784.2,
      "end": 786.54,
      "text": "ignores our innate inherent sense of duty"
    },
    { "start": 786.54, "end": 788.24, "text": "يعني كانت نزم كان يقول" },
    { "start": 788.24, "end": 789.5, "text": "واجبي أنا والشوك" },
    { "start": 789.5, "end": 790.28, "text": "واجبي يعني" },
    { "start": 790.28, "end": 791.22, "text": "لازم أساعد" },
    { "start": 791.22, "end": 792.32, "text": "واجبي كده واجبي كده" },
    { "start": 792.32, "end": 793.96, "text": "هنا الأكتوترزم لا" },
    { "start": 793.96, "end": 795.44, "text": "طالما أنه" },
    { "start": 795.44, "end": 796.68, "text": "يعني مثلا خلنا نقول" },
    { "start": 796.68, "end": 799.22, "text": "الشركة قاعدة تسوي غسيل أموال" },
    { "start": 799.22, "end": 801.8, "text": "طالما أنه أقصى عدد معين" },
    {
      "start": 801.8,
      "end": 809.524,
      "text": "وقال أكثر شيء يجبون لهم سعادة عادة ينفذونه\nرغم أننا لدينا دوتي أننا لا نغش و لا نلعب"
    },
    { "start": 809.524, "end": 809.8, "text": "صح؟" },
    {
      "start": 809.8,
      "end": 817.164,
      "text": "لكن بالأكت يقول لك لا يخص في التوريزم وليس\nبقط الأكت يقول لك لا لا أعلم لأني أجلب"
    },
    { "start": 817.164, "end": 817.8, "text": "النتائج" },
    {
      "start": 817.8,
      "end": 822.8,
      "text": "يقول لكم هنا كيس اكس ميد ابرميس تواي يعني\nوشو قال لكم؟"
    },
    {
      "start": 822.8,
      "end": 828.8,
      "text": "هنا خلال نقول أنا وعدت وشركة أني بقدم لهم\nشي معين"
    },
    {
      "start": 828.8,
      "end": 832.7,
      "text": "يقول لكم: \"Key promise will produce 1000\nunits of good for Y\""
    },
    {
      "start": 832.7,
      "end": 837.9,
      "text": "يعني \"Y\" لو كملت وعدي بيسترمون 1000"
    },
    {
      "start": 837.9,
      "end": 844.5,
      "text": "بس لو انا ما مسكت وعدي بأنا باستفيد و بأخذ\nواحد زيادة"
    },
    {
      "start": 844.5,
      "end": 847.5,
      "text": "يعني شفون بغشيتهم و أخذ واحد زيادة"
    },
    {
      "start": 847.5,
      "end": 853.2,
      "text": "فيقول لكم: \"أنا لا تحتفظ بالوعد\""
    },
    {
      "start": 853.2,
      "end": 856.5,
      "text": "الوعد لا قيمة داميني انا اكسرت وعدي بأكسب\nزيادة"
    },
    { "start": 856.5, "end": 858.3, "text": "مو بلازم امسك الوعد" },
    {
      "start": 858.3,
      "end": 861.82,
      "text": "فطبعاً هذا إشكالية جداً كبيرة بالمورالز"
    },
    {
      "start": 861.82,
      "end": 866.78,
      "text": "وبنى خلونا نكمل عند الهو \"workable theory\"\nو \"summary\" بشكل عام"
    },
    {
      "start": 866.78,
      "end": 869.96,
      "text": "قال لكم أنه هنا نفس الكلام اللي قال لكم\nبآخر شيء"
    },
    {
      "start": 869.96,
      "end": 872.86,
      "text": "بس لاحظوا نكرره لأنه مرة مرة مرة مرة مرة\nمهم"
    },
    { "start": 872.86, "end": 875.26, "text": "أنا أبيكم حتى تحفظونا" },
    {
      "start": 875.26,
      "end": 879.82,
      "text": "يعني إذا جاء وقت الاختبار أبيكم بالسيناريو\nتكتبونا"
    },
    { "start": 879.82, "end": 881.8, "text": "هذا اللي أبيكم تكتبونا" },
    { "start": 881.8, "end": 882.52, "text": "شوفوا" },
    {
      "start": 882.52,
      "end": 886.86,
      "text": "Produce the greatest amount of good for\nthe greatest number of person"
    },
    {
      "start": 886.86,
      "end": 892.86,
      "text": "أنا أصبح أصبح أصبح أصبح أصبح أصبح أكتب\n\"people\""
    },
    {
      "start": 894.86,
      "end": 897.86,
      "text": "ولكن لن تكتبون \"affected by the act\""
    },
    {
      "start": 897.86,
      "end": 901.545,
      "text": "أهم شيء \"produces the greatest amount of\ngood for the greatest amount of number of"
    },
    { "start": 901.545, "end": 901.86, "text": "people\"" },
    { "start": 901.86, "end": 903.86, "text": "هذا الـ \"utilism\"" },
    {
      "start": 903.86,
      "end": 907.86,
      "text": "و ترى مرة مرة مرة مرة مرة مرة مهم"
    },
    { "start": 907.86, "end": 909.86, "text": "أنك تكتبون كده" },
    { "start": 909.86, "end": 911.86, "text": "لكي يصير جوابكم كامل" },
    {
      "start": 911.86,
      "end": 917.7139999999999,
      "text": "يصيري حس الدكتور او دكتورة انكم مركزين\nفاهمين ويعطونكم الدرجة حتى لو كان جوابكم"
    },
    {
      "start": 917.7139999999999,
      "end": 919.64,
      "text": "شوي ناقص اسر هذا يعني يملي"
    },
    {
      "start": 919.64,
      "end": 925.72,
      "text": "وبنين طبعا هذا a workable theory ليش انه\nهو يبغى يعني يقيس السعادة"
    },
    {
      "start": 925.72,
      "end": 930.939,
      "text": "اللي هو اكيد طبيعي ان احنا اذا انا نسوي\nننفذ شيء نبغى نقيس سعادتنا يعني اذا احنا"
    },
    { "start": 930.939, "end": 932.44, "text": "بنجيب يعني نتيجة ولا لا" },
    {
      "start": 932.44,
      "end": 936.72,
      "text": "فعشان كذا يقول لك also the theory is\npractical which appeals to most people"
    },
    {
      "start": 936.72,
      "end": 940.5,
      "text": "يعني الناس غالبين بطبقون هذا قانون دامهم\nمرتاحين له"
    },
    {
      "start": 940.5,
      "end": 944.62,
      "text": "وإن شاء الله بالمقطع الجاي بنكمل عند\nالروليو تيريزم"
    }
  ]
}
