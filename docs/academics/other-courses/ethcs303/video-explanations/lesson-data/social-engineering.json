    { "start": 45.08, "end": 48.36, "text": "مثلا رموز" },
    { "start": 48.36, "end": 50.26, "text": "يعني تخيلوا احد لعبته عليه" },
    { "start": 50.26, "end": 51.28, "text": "يعطيكم رمز البنك" },
    { "start": 51.28, "end": 53.84, "text": "يعني انتوا من الحين ريحتوا نفسك" },
    { "start": 53.84, "end": 55.76, "text": "ما رحتوا هكرتوا البنك" },
