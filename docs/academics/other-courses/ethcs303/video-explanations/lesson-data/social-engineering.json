    { "start": 277.0, "end": 278.92, "text": "الى حد تحاتنا الواقعية" },
    { "start": 278.92, "end": 280.54, "text": "اللي يعني ممكن يصيري" },
    { "start": 280.54, "end": 283.1, "text": "يعرف رمز حق باب بيتي" },
    {
      "start": 283.1,
      "end": 287.1,
      "text": "يالله الحين عارف يدخلوا بيتي هذا ليس\nفيزيكل الا فيزيكل"
    },
    { "start": 287.1, "end": 290.1, "text": "وبعدين طبعا عندنا وشو البنيفتس" },
    {
      "start": 290.1,
      "end": 292.1,
      "text": "احنا وش فوائد ان نتعلم عن سوشال انجينيرينج"
