    {
      "start": 157.32,
      "end": 161.42000000000002,
      "text": "It's easier to exploit people's natural\ninclination to trust"
    },
    {
      "start": 161.42000000000002,
      "end": 164.1,
      "text": "يعني ترى طبيعة الانسان ان يثق"
