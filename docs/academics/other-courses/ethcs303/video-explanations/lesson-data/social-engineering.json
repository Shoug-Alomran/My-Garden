    {
      "start": 244.44,
      "end": 252.152,
      "text": "يجي فوقت فجأة السيستم يعلق ما يستقبل\nللطلبات هنا واشتوا مبصط طايح سوقكم مبخارب"
    },
    { "start": 252.152, "end": 254.92, "text": "سمعتكم مبمأثر في البزنس حقكم" },
    { "start": 254.92, "end": 256.92, "text": "فعشان كلا مهم السيستم" },
    { "start": 256.92, "end": 258.3, "text": "داون تايم وانا تخيله" },
    { "start": 258.3, "end": 260.58, "text": "يعني مو بنا والله زي البنك قال" },
    { "start": 260.58, "end": 262.36, "text": "ترى من الساعة تسع مساء" },
    { "start": 262.36, "end": 264.04, "text": "الى الساعة عشر الليل" },
    { "start": 264.04, "end": 266.96, "text": "بنسوي السيكوريتي شاكس" },
    { "start": 266.96, "end": 268.56, "text": "ومدر ايش ان ترى هذا داون تايم" },
