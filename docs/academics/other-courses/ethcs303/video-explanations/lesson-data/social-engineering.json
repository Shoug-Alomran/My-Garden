    {
      "start": 189.76,
      "end": 194.16,
      "text": "أغلب الأوقات يصير بعملية الاحتيال الشخصية\nصح"
    },
    { "start": 194.16, "end": 196.34, "text": "يصير أحد يعني عنده بياناتك" },
    {
      "start": 196.34,
      "end": 199.0,
      "text": "ويسوي نفسه أنه هو أنت ويروح يستخدم بلاقتك\nصح"
    },
    {
      "start": 199.0,
      "end": 201.62,
      "text": "هو أغلب المرات يصير بسبة social\nengineering"
    },
    {
      "start": 201.62,
      "end": 206.26,
      "text": "او حتى مو بس يعني ترى احنا دايما نفكر فلوس\nفلوس معلومات خاصة"
