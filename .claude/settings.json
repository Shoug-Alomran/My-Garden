{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/*.py)",
      "Bash(python3 /Users/shougalomran/Desktop/My-Garden/scripts/*.py)",
      "Bash(node scripts/*.js)",
      "Bash(node /Users/shougalomran/Desktop/My-Garden/scripts/*.js)",
      "Bash(bash scripts/*.sh)",
      "Bash(python3 /tmp/*.py)",
      "Bash(python3 /private/tmp/**)",
      "Bash(python3 -m http.server *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null *)",
      "Bash(pkill -f http.server)",
      "Bash(lsof *)",
      "Bash(perl -i *)",
      "Bash(sed -i *)",
      "Bash(xargs perl *)",
      "Bash(xargs -I{} perl *)",
      "Bash(xargs -0 perl *)",
      "Bash(xargs sed *)",
      "Bash(xargs -I{} sed *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod +x *)",
      "Bash(git -C /Users/shougalomran/Desktop/My-Garden *)"
    ],
    "additionalDirectories": [
      "/Users/shougalomran/Desktop/My-Garden"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-html.py",
            "timeout": 15,
            "statusMessage": "Checking HTML structure..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-site.sh",
            "timeout": 90,
            "statusMessage": "Validating site routes and links..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/snapshot-bulk-edit.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/kill-preview-servers.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
